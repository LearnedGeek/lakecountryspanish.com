@model LakeCountrySpanish.Web.Models.ViewModels.PixabayBrowseViewModel
@{
    ViewData["Title"] = "Browse Pixabay";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Browse Pixabay</h1>
                <p class="text-sm text-gray-600 mt-1">Search and import images directly into the LCS media library.</p>
            </div>
            <a href="@Url.Action("Index")" class="text-sm text-indigo-600 hover:text-indigo-800">← Back to library</a>
        </div>

        @if (TempData["SuccessMessage"] is string ok)
        {
            <div class="mb-4 px-4 py-3 rounded bg-green-50 text-green-800 border border-green-200">@ok</div>
        }
        @if (TempData["ErrorMessage"] is string err)
        {
            <div class="mb-4 px-4 py-3 rounded bg-red-50 text-red-800 border border-red-200">@err</div>
        }

        @if (!Model.PixabayAvailable)
        {
            <div class="px-4 py-3 rounded bg-yellow-50 text-yellow-800 border border-yellow-200">@Model.ErrorMessage</div>
        }
        else
        {
            <form method="get" class="bg-white rounded-lg shadow p-4 mb-6">
            <div class="flex flex-col sm:flex-row gap-3">
                <input type="text" name="q" value="@Model.Query" placeholder="e.g. llama, peru flag, color crayons"
                       class="flex-1 rounded border-gray-300 shadow-sm" autofocus />
                <select name="contentType" class="rounded border-gray-300 shadow-sm">
                    @foreach (var ct in Enum.GetValues<LakeCountrySpanish.Web.Services.Media.ImageContentType>())
                    {
                        if (ct == Model.ContentType)
                        {
                            <option value="@ct" selected>@ct</option>
                        }
                        else
                        {
                            <option value="@ct">@ct</option>
                        }
                    }
                </select>
                <button type="submit" class="inline-flex items-center px-4 py-2 bg-pink-600 text-white rounded-md hover:bg-pink-700">Search</button>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage) && Model.PixabayAvailable)
        {
            <div class="mb-4 px-4 py-3 rounded bg-red-50 text-red-800 border border-red-200">@Model.ErrorMessage</div>
        }

        @if (Model.Results is null && !string.IsNullOrWhiteSpace(Model.Query))
        {
            <div class="bg-white rounded-lg shadow p-12 text-center text-gray-500">No results.</div>
        }
        else if (Model.Results is not null)
        {
            <p class="text-sm text-gray-600 mb-3">@Model.Results.TotalHits result@(Model.Results.TotalHits == 1 ? "" : "s") (showing page @Model.Results.Page)</p>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                @foreach (var hit in Model.Results.Hits)
                {
                    <div class="bg-white rounded-lg shadow overflow-hidden">
                        <div class="aspect-square bg-gray-100 flex items-center justify-center overflow-hidden">
                            <img src="@hit.PreviewUrl" alt="@string.Join(", ", hit.Tags)" class="object-cover w-full h-full" loading="lazy" />
                        </div>
                        <div class="p-3 space-y-2">
                            <div class="text-[11px] text-gray-500 truncate" title="@string.Join(", ", hit.Tags)">@string.Join(", ", hit.Tags)</div>
                            <div class="text-[10px] text-gray-400">📷 @hit.Photographer · @hit.Width×@hit.Height</div>

                            <form asp-action="ImportPixabay" method="post" class="space-y-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnQuery" value="@Model.Query" />
                                <input type="hidden" name="SourceId" value="@hit.SourceId" />
                                <input type="hidden" name="PageUrl" value="@hit.PageUrl" />
                                <input type="hidden" name="PreviewUrl" value="@hit.PreviewUrl" />
                                <input type="hidden" name="WebUrl" value="@hit.WebUrl" />
                                <input type="hidden" name="FullUrl" value="@hit.FullUrl" />
                                <input type="hidden" name="Width" value="@hit.Width" />
                                <input type="hidden" name="Height" value="@hit.Height" />
                                <input type="hidden" name="Photographer" value="@hit.Photographer" />
                                <input type="hidden" name="PhotographerUrl" value="@hit.PhotographerUrl" />
                                <input type="hidden" name="TagsCsv" value="@string.Join(", ", hit.Tags)" />
                                <select name="Category" class="block w-full rounded border-gray-300 text-xs">
                                    @foreach (var cat in Enum.GetValues<LakeCountrySpanish.Web.Models.Entities.MediaCategory>())
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                </select>
                                <input type="text" name="AltText" placeholder="Alt text" class="block w-full rounded border-gray-300 text-xs" />
                                <button type="submit" class="w-full px-2 py-1 bg-indigo-600 text-white text-xs rounded hover:bg-indigo-700">Import</button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            var totalHits = Model.Results.TotalHits;
            var pageSize = Model.Results.Hits.Count > 0 ? Math.Max(1, Model.Results.Hits.Count) : 24;
            var totalPages = (int)Math.Ceiling((double)totalHits / pageSize);
            if (totalPages > 1)
            {
                <nav class="mt-6 flex justify-center gap-2 text-sm">
                    @for (int p = 1; p <= Math.Min(totalPages, 20); p++)
                    {
                        if (p == Model.Results.Page)
                        {
                            <span class="px-3 py-1 rounded bg-pink-600 text-white">@p</span>
                        }
                        else
                        {
                            <a href="?q=@Model.Query&contentType=@Model.ContentType&page=@p" class="px-3 py-1 rounded bg-white border border-gray-300 hover:bg-gray-50">@p</a>
                        }
                    }
                </nav>
            }
        }
        }
    </div>
</div>
