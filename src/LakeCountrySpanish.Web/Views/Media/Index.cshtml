@model LakeCountrySpanish.Web.Models.ViewModels.MediaIndexViewModel
@{
    ViewData["Title"] = "Media Library";

    string ThumbFor(LakeCountrySpanish.Web.Models.Entities.MediaAsset a)
    {
        if (string.IsNullOrEmpty(a.ThumbnailsJson)) return a.FilePath;
        try
        {
            var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(a.ThumbnailsJson);
            if (dict is not null && dict.TryGetValue("thumb", out var t)) return t;
        }
        catch { /* malformed thumbnails json — fall through to the original file */ }
        return a.FilePath;
    }
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Media Library</h1>
                <p class="text-sm text-gray-600 mt-1">@Model.Page.TotalItems asset@(Model.Page.TotalItems == 1 ? "" : "s") in the library.</p>
            </div>
            <div class="flex gap-2">
                <a href="@Url.Action("BrowsePixabay")" class="inline-flex items-center px-4 py-2 bg-pink-600 text-white rounded-md hover:bg-pink-700">Browse Pixabay</a>
                <a href="@Url.Action("Upload")" class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700">Upload</a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] is string ok)
        {
            <div class="mb-4 px-4 py-3 rounded bg-green-50 text-green-800 border border-green-200">@ok</div>
        }
        @if (TempData["ErrorMessage"] is string err)
        {
            <div class="mb-4 px-4 py-3 rounded bg-red-50 text-red-800 border border-red-200">@err</div>
        }

        @if (Model.Page.Items.Count == 0)
        {
            <div class="bg-white rounded-lg shadow p-12 text-center text-gray-500">
                <p class="text-lg mb-2">No media assets yet.</p>
                <p class="text-sm">Upload an image or browse Pixabay to get started.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
                @foreach (var a in Model.Page.Items)
                {
                    <div class="bg-white rounded-lg shadow overflow-hidden">
                        <div class="aspect-square bg-gray-100 flex items-center justify-center overflow-hidden">
                            <img src="@ThumbFor(a)" alt="@(a.AltText ?? a.Title)" class="object-cover w-full h-full" loading="lazy" />
                        </div>
                        <div class="p-2">
                            <div class="text-xs font-semibold text-gray-900 truncate" title="@a.Title">@a.Title</div>
                            <div class="text-[10px] text-gray-500 uppercase tracking-wide">@a.Source · @a.Category</div>
                            @if (!string.IsNullOrEmpty(a.Photographer))
                            {
                                <div class="text-[10px] text-gray-400 truncate" title="@a.Photographer">📷 @a.Photographer</div>
                            }
                            <form asp-action="Delete" method="post" class="mt-1" onsubmit="return confirm('Delete this asset?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.Id" />
                                <button type="submit" class="text-[10px] text-red-600 hover:text-red-800">Delete</button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            var totalPages = (int)Math.Ceiling((double)Model.Page.TotalItems / Model.Page.PageSize);
            if (totalPages > 1)
            {
                <nav class="mt-6 flex justify-center gap-2 text-sm">
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        if (p == Model.Page.Page)
                        {
                            <span class="px-3 py-1 rounded bg-indigo-600 text-white">@p</span>
                        }
                        else
                        {
                            <a href="?page=@p" class="px-3 py-1 rounded bg-white border border-gray-300 hover:bg-gray-50">@p</a>
                        }
                    }
                </nav>
            }
        }
    </div>
</div>
