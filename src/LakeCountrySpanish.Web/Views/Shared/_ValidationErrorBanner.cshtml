@{
    // Shared "please fix these" banner used at the top of admin forms
    // (Program form, Binder upload). No model — reads directly from
    // ViewData.ModelState so callers just <partial name="..."/> and the
    // banner shows itself iff there are errors.
    var modelState = ViewData.ModelState;
    var errors = modelState
        .Where(entry => entry.Value?.Errors.Count > 0)
        .SelectMany(entry => entry.Value!.Errors.Select(err => new
        {
            Field = entry.Key,
            Message = string.IsNullOrEmpty(err.ErrorMessage) ? "Invalid value" : err.ErrorMessage
        }))
        .ToList();
}
@if (errors.Count > 0)
{
    <div class="rounded-xl border-2 border-red-300 bg-red-50 p-4 shadow-sm">
        <div class="flex items-start gap-2">
            <span class="text-red-600 text-lg leading-none mt-0.5">⚠</span>
            <div class="flex-1">
                <div class="text-sm font-bold text-red-800 mb-1">Please fix the following before saving:</div>
                <ul class="list-disc list-inside text-sm text-red-700 space-y-0.5">
                    @foreach (var err in errors)
                    {
                        <li>
                            @if (!string.IsNullOrEmpty(err.Field))
                            {
                                <span class="font-semibold">@err.Field:</span>
                            }
                            @err.Message
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
}
