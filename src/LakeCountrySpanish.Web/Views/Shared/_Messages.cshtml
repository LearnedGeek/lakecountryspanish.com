@if (TempData["SuccessMessage"] != null)
{
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-4">
        @await Component.InvokeAsync("Alert", new { type = "success", message = TempData["SuccessMessage"]?.ToString() })
    </div>
}
