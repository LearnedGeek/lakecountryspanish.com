@model LakeCountrySpanish.Web.ViewComponents.EmptyStateViewModel

<div class="text-center py-12">
    @if (Model.UseLlamaMascot)
    {
        <div class="mx-auto mb-2">
            <img src="~/img/lake-country-spanish-logo.jpg" alt="Llama mascot" class="h-20 w-20 mx-auto rounded-full object-cover opacity-60" />
        </div>
    }
    else
    {
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="@Model.IconSvgPath" />
        </svg>
    }
    <h3 class="mt-2 text-sm font-semibold text-gray-900">@Model.Title</h3>
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <p class="mt-1 text-sm text-gray-500">@Model.Message</p>
    }
    @if (Model.HasAction)
    {
        <div class="mt-6">
            <a href="@Model.ActionUrl" class="inline-flex items-center rounded-md bg-secondary-500 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-secondary-600 transition">
                <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
                </svg>
                @Model.ActionText
            </a>
        </div>
    }
</div>
