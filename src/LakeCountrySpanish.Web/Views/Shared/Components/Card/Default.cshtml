@model LakeCountrySpanish.Web.ViewComponents.CardViewModel

<div class="bg-white rounded-lg shadow @Model.CssClass">
    @if (Model.HasHeader)
    {
        <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
            <h2 class="text-lg font-semibold text-gray-900">@Model.Title</h2>
            @if (Model.HasHeaderAction)
            {
                <a href="@Model.HeaderActionUrl" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">
                    @Model.HeaderAction
                </a>
            }
        </div>
    }
    <div class="@Model.BodyPadding">
        @RenderBody()
    </div>
</div>
