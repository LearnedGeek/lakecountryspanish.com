@using Microsoft.AspNetCore.Identity
@using LakeCountrySpanish.Web.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<nav class="bg-gradient-to-r from-primary-600 to-primary-700 shadow-lg">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
            <div class="flex items-center">
                <a asp-controller="Home" asp-action="Index" class="flex-shrink-0">
                    <span class="text-2xl font-bold text-white">Lake Country Spanish</span>
                </a>
                <div class="hidden md:block ml-10">
                    <div class="flex items-baseline space-x-4">
                        <a asp-controller="Home" asp-action="Index" class="text-white hover:bg-primary-500 hover:bg-opacity-75 rounded-md px-3 py-2 text-sm font-medium">Home</a>
                        <a asp-controller="Home" asp-action="About" class="text-white hover:bg-primary-500 hover:bg-opacity-75 rounded-md px-3 py-2 text-sm font-medium">About</a>
                        <a asp-controller="Contact" asp-action="Index" class="text-white hover:bg-primary-500 hover:bg-opacity-75 rounded-md px-3 py-2 text-sm font-medium">Contact</a>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Admin" asp-action="Dashboard" class="text-secondary-300 hover:bg-primary-500 hover:bg-opacity-75 rounded-md px-3 py-2 text-sm font-medium">Admin Dashboard</a>
                            }
                            else
                            {
                                <a asp-controller="Student" asp-action="Dashboard" class="text-secondary-300 hover:bg-primary-500 hover:bg-opacity-75 rounded-md px-3 py-2 text-sm font-medium">My Dashboard</a>
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="hidden md:block">
                <div class="ml-4 flex items-center md:ml-6">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var user = await UserManager.GetUserAsync(User);
                        <span class="text-white text-sm mr-4">Welcome, @user?.FirstName</span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="bg-primary-800 hover:bg-primary-900 text-white rounded-md px-4 py-2 text-sm font-medium transition">
                                Sign Out
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="bg-white text-primary-600 hover:bg-gray-100 rounded-md px-4 py-2 text-sm font-medium transition">
                            Sign In
                        </a>
                    }
                </div>
            </div>
            <!-- Mobile menu button -->
            <div class="md:hidden">
                <button type="button" onclick="toggleMobileMenu()" class="text-white hover:bg-primary-500 hover:bg-opacity-75 p-2 rounded-md">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile menu -->
    <div class="md:hidden hidden" id="mobile-menu">
        <div class="space-y-1 px-2 pb-3 pt-2">
            <a asp-controller="Home" asp-action="Index" class="text-white hover:bg-primary-500 hover:bg-opacity-75 block rounded-md px-3 py-2 text-base font-medium">Home</a>
            <a asp-controller="Home" asp-action="About" class="text-white hover:bg-primary-500 hover:bg-opacity-75 block rounded-md px-3 py-2 text-base font-medium">About</a>
            <a asp-controller="Contact" asp-action="Index" class="text-white hover:bg-primary-500 hover:bg-opacity-75 block rounded-md px-3 py-2 text-base font-medium">Contact</a>
            @if (SignInManager.IsSignedIn(User))
            {
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Dashboard" class="text-secondary-300 hover:bg-primary-500 hover:bg-opacity-75 block rounded-md px-3 py-2 text-base font-medium">Admin Dashboard</a>
                }
                else
                {
                    <a asp-controller="Student" asp-action="Dashboard" class="text-secondary-300 hover:bg-primary-500 hover:bg-opacity-75 block rounded-md px-3 py-2 text-base font-medium">My Dashboard</a>
                }
                <form asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
                    <button type="submit" class="w-full text-left text-white hover:bg-primary-500 hover:bg-opacity-75 block rounded-md px-3 py-2 text-base font-medium">
                        Sign Out
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="text-white hover:bg-primary-500 hover:bg-opacity-75 block rounded-md px-3 py-2 text-base font-medium">Sign In</a>
            }
        </div>
    </div>
</nav>
