@using Microsoft.AspNetCore.Identity
@using LakeCountrySpanish.Web.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<nav class="bg-gradient-to-r from-primary-600 to-teal-500 shadow-lg">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-20 items-center justify-between">
            <div class="flex items-center">
                <a asp-controller="Home" asp-action="Index" class="flex-shrink-0 flex items-center gap-3 group">
                    <img src="~/img/llama-logo-painted.png" alt="Lake Country Spanish" class="h-16 w-16 rounded-full object-cover ring-2 ring-white/50 shadow-md group-hover:scale-105 transition-transform" />
                    <span class="text-2xl sm:text-3xl font-bold text-white leading-tight">Lake Country Spanish</span>
                </a>
                <div class="hidden md:block ml-10">
                    <div class="flex items-baseline space-x-4">
                        <a asp-controller="Home" asp-action="Index" class="text-white hover:bg-primary-700 rounded-md px-3 py-2 text-sm font-medium transition">Home</a>
                        <a asp-controller="Home" asp-action="About" class="text-white hover:bg-primary-700 rounded-md px-3 py-2 text-sm font-medium transition">Meet Us</a>
                        <a asp-controller="Programs" asp-action="Index" class="text-white hover:bg-primary-700 rounded-md px-3 py-2 text-sm font-medium transition">Programs</a>
                        <a asp-controller="Contact" asp-action="Index" class="text-white hover:bg-primary-700 rounded-md px-3 py-2 text-sm font-medium transition">Contact</a>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                            {
                                // Admin/Teacher tools collapsed into a single dropdown — the
                                // 4 (Admin) or 3 (Teacher) items previously listed inline
                                // pushed the nav past the site name at typical desktop
                                // widths. Dropdown keeps top-level nav compact regardless
                                // of role.
                                var isAdminRole = User.IsInRole("Admin");
                                <div class="relative">
                                    <button type="button"
                                            id="role-menu-toggle"
                                            class="inline-flex items-center gap-1 text-secondary-300 hover:text-secondary-200 hover:bg-primary-700 rounded-md px-3 py-2 text-sm font-medium transition"
                                            aria-haspopup="true"
                                            aria-expanded="false">
                                        @(isAdminRole ? "Admin" : "Teacher")
                                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                                            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.4a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                                        </svg>
                                    </button>
                                    <div id="role-menu"
                                         class="hidden absolute left-0 mt-2 w-56 rounded-lg shadow-lg bg-white ring-1 ring-black/5 z-40 py-1"
                                         role="menu">
                                        @if (isAdminRole)
                                        {
                                            <a asp-controller="Admin" asp-action="Dashboard" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900" role="menuitem">Admin Dashboard</a>
                                            <a asp-controller="Curriculum" asp-action="Lessons" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900" role="menuitem">Curriculum</a>
                                            <a asp-controller="AdminPrograms" asp-action="Index" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900" role="menuitem">Manage Programs</a>
                                            <a asp-controller="Media" asp-action="Index" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900" role="menuitem">Media</a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Teacher" asp-action="Dashboard" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900" role="menuitem">Teacher Dashboard</a>
                                            <a asp-controller="Curriculum" asp-action="Lessons" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900" role="menuitem">Curriculum</a>
                                            <a asp-controller="AdminPrograms" asp-action="Index" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900" role="menuitem">Manage Programs</a>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <a asp-controller="Student" asp-action="Dashboard" class="text-secondary-300 hover:text-secondary-200 hover:bg-primary-700 rounded-md px-3 py-2 text-sm font-medium transition">My Dashboard</a>
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="hidden md:block">
                <div class="ml-4 flex items-center md:ml-6">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var user = await UserManager.GetUserAsync(User);
                        <span class="text-primary-200 text-sm mr-4">Welcome, @user?.FirstName</span>
                        <form asp-controller="Account" asp-action="LogoutPost" method="post">
                            <button type="submit" class="bg-primary-700 hover:bg-primary-600 text-white rounded-md px-4 py-2 text-sm font-medium transition">
                                Sign Out
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="bg-secondary-500 text-white hover:bg-secondary-600 rounded-md px-4 py-2 text-sm font-medium transition shadow-sm">
                            Sign In
                        </a>
                    }
                </div>
            </div>
            <!-- Mobile menu button -->
            <div class="md:hidden">
                <button type="button" onclick="toggleMobileMenu()" class="text-white hover:bg-primary-700 p-2 rounded-md transition">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Peruvian-style pom pom garland softens the sharp nav-to-hero edge.
         Each pom pom hangs on a short string at a varied length so the row
         reads handmade, not stamped. Colors cycle the brand quartet (purple,
         coral, yellow, teal) plus pink as a nod to Lola's brand-bible ears.
         pointer-events-none so it never blocks nav clicks. -->
    <div aria-hidden="true" class="relative h-12 -mb-12 z-30 pointer-events-none">
        <div class="absolute inset-x-0 top-0 flex justify-between px-4 sm:px-8 lg:px-12">
            @{
                var pomColors = new[] { "#FFD63D", "#FF6F61", "#1E8189", "#EC4899", "#1E3A8A", "#FFD63D", "#FF6F61", "#1E8189", "#EC4899", "#1E3A8A", "#FFD63D", "#FF6F61", "#1E8189", "#EC4899" };
                var pomStringLengths = new[] { 10, 16, 6, 14, 8, 12, 18, 5, 13, 9, 15, 7, 11, 14 };
                var pomSizes = new[] { "h-3 w-3", "h-4 w-4", "h-3.5 w-3.5", "h-4 w-4", "h-3 w-3", "h-4 w-4", "h-3.5 w-3.5", "h-4 w-4", "h-3 w-3", "h-4 w-4", "h-3.5 w-3.5", "h-3 w-3", "h-4 w-4", "h-3.5 w-3.5" };
            }
            @for (var i = 0; i < pomColors.Length; i++)
            {
                <div class="flex flex-col items-center">
                    <div class="w-px bg-white/40" style="height: @(pomStringLengths[i])px;"></div>
                    <div class="@(pomSizes[i]) rounded-full shadow-md" style="background-color: @(pomColors[i]);"></div>
                </div>
            }
        </div>
    </div>

    <!-- Role dropdown (Admin/Teacher) toggle. Vanilla JS matching the rest of
         the site's interaction patterns. Click outside or Esc to close. -->
    <script>
        (function () {
            const toggle = document.getElementById('role-menu-toggle');
            const menu = document.getElementById('role-menu');
            if (!toggle || !menu) return;

            function close() {
                menu.classList.add('hidden');
                toggle.setAttribute('aria-expanded', 'false');
            }
            function open() {
                menu.classList.remove('hidden');
                toggle.setAttribute('aria-expanded', 'true');
            }

            toggle.addEventListener('click', function (e) {
                e.stopPropagation();
                if (menu.classList.contains('hidden')) open(); else close();
            });
            document.addEventListener('click', function (e) {
                if (!menu.contains(e.target) && !toggle.contains(e.target)) close();
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') close();
            });
        })();
    </script>

    <!-- Mobile menu -->
    <div class="md:hidden hidden" id="mobile-menu">
        <div class="space-y-1 px-2 pb-3 pt-2 border-t border-primary-700">
            <a asp-controller="Home" asp-action="Index" class="text-white hover:bg-primary-700 block rounded-md px-3 py-2 text-base font-medium transition">Home</a>
            <a asp-controller="Home" asp-action="About" class="text-white hover:bg-primary-700 block rounded-md px-3 py-2 text-base font-medium transition">Meet Us</a>
            <a asp-controller="Programs" asp-action="Index" class="text-white hover:bg-primary-700 block rounded-md px-3 py-2 text-base font-medium transition">Programs</a>
            <a asp-controller="Contact" asp-action="Index" class="text-white hover:bg-primary-700 block rounded-md px-3 py-2 text-base font-medium transition">Contact</a>
            @if (SignInManager.IsSignedIn(User))
            {
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Dashboard" class="text-secondary-300 hover:bg-primary-700 block rounded-md px-3 py-2 text-base font-medium transition">Admin Dashboard</a>
                    <a asp-controller="Curriculum" asp-action="Lessons" class="text-secondary-300 hover:bg-primary-700 block rounded-md px-3 py-2 text-base font-medium transition">Curriculum</a>
                    <a asp-controller="AdminPrograms" asp-action="Index" class="text-secondary-300 hover:bg-primary-700 block rounded-md px-3 py-2 text-base font-medium transition">Manage Programs</a>
                    <a asp-controller="Media" asp-action="Index" class="text-secondary-300 hover:bg-primary-700 block rounded-md px-3 py-2 text-base font-medium transition">Media</a>
                }
                else if (User.IsInRole("Teacher"))
                {
                    <a asp-controller="Teacher" asp-action="Dashboard" class="text-secondary-300 hover:bg-primary-700 block rounded-md px-3 py-2 text-base font-medium transition">Teacher Dashboard</a>
                    <a asp-controller="Curriculum" asp-action="Lessons" class="text-secondary-300 hover:bg-primary-700 block rounded-md px-3 py-2 text-base font-medium transition">Curriculum</a>
                    <a asp-controller="AdminPrograms" asp-action="Index" class="text-secondary-300 hover:bg-primary-700 block rounded-md px-3 py-2 text-base font-medium transition">Manage Programs</a>
                }
                else
                {
                    <a asp-controller="Student" asp-action="Dashboard" class="text-secondary-300 hover:bg-primary-700 block rounded-md px-3 py-2 text-base font-medium transition">My Dashboard</a>
                }
                <form asp-controller="Account" asp-action="LogoutPost" method="post" class="mt-2">
                    <button type="submit" class="w-full text-left text-white hover:bg-primary-700 block rounded-md px-3 py-2 text-base font-medium transition">
                        Sign Out
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="bg-secondary-500 text-white hover:bg-secondary-600 block rounded-md px-3 py-2 text-base font-medium text-center mt-2 transition">Sign In</a>
            }
        </div>
    </div>
</nav>
