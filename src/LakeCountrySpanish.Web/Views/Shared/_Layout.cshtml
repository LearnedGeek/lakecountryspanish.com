@{
    var baseUrl = "https://lakecountryspanish.com";
    var currentPath = Context.Request.Path.ToString();
    var canonicalUrl = $"{baseUrl}{currentPath}";
    var ogImage = ViewData["OgImage"]?.ToString() ?? $"{baseUrl}/img/og-image.jpg";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Home";
    var fullTitle = $"{pageTitle} | Lake Country Spanish";
    var metaDescription = ViewData["MetaDescription"]?.ToString()
        ?? ViewData["Description"]?.ToString()
        ?? "Personalized online Spanish lessons with Karen, a native Peruvian teacher. Learn conversational Spanish, improve pronunciation, and discover Latin American culture. Flexible scheduling, earn rewards, and have fun learning!";
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullTitle</title>

    <!-- Canonical URL -->
    <link rel="canonical" href="@canonicalUrl" />

    <!-- SEO Meta Tags -->
    <meta name="description" content="@metaDescription" />
    <meta name="keywords" content="Spanish lessons, learn Spanish, Spanish tutor, online Spanish classes, Peruvian Spanish teacher, conversational Spanish, Lake Country Wisconsin, private Spanish lessons" />
    <meta name="author" content="Lake Country Spanish - Karen" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Lake Country Spanish" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@fullTitle" />
    <meta name="twitter:description" content="@metaDescription" />
    <meta name="twitter:image" content="@ogImage" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/img/lake-country-spanish-logo.png" />
    <link rel="apple-touch-icon" href="~/img/lake-country-spanish-logo.png" />

    <!-- Editorial type pairing: Fraunces (display) + Nunito (body). Pulls the
         page away from the generic system-sans bootstrap feel. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,900&family=Nunito:wght@400;600;700;800&display=swap" />

    <!-- LocalBusiness Schema Markup -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "LocalBusiness",
        "name": "Lake Country Spanish",
        "description": "Personalized online Spanish lessons with a native Peruvian teacher. Learn conversational Spanish, improve pronunciation, and discover Latin American culture.",
        "image": "https://lakecountryspanish.com/img/lake-country-spanish-logo.png",
        "priceRange": "$20-$30",
        "address": {
            "@@type": "PostalAddress",
            "addressLocality": "Lake Country",
            "addressRegion": "WI",
            "addressCountry": "US"
        },
        "areaServed": [
            {
                "@@type": "State",
                "name": "Wisconsin",
                "containsPlace": [
                    { "@@type": "City", "name": "Oconomowoc" },
                    { "@@type": "City", "name": "Waukesha" },
                    { "@@type": "City", "name": "Delafield" },
                    { "@@type": "City", "name": "Hartland" },
                    { "@@type": "City", "name": "Pewaukee" },
                    { "@@type": "City", "name": "Brookfield" },
                    { "@@type": "City", "name": "Menomonee Falls" },
                    { "@@type": "City", "name": "Muskego" },
                    { "@@type": "City", "name": "New Berlin" },
                    { "@@type": "City", "name": "Wales" },
                    { "@@type": "City", "name": "Dousman" },
                    { "@@type": "City", "name": "Summit" }
                ]
            },
            {
                "@@type": "Place",
                "name": "Online - Worldwide"
            }
        ],
        "serviceType": ["Spanish Language Lessons", "Online Tutoring", "Language Education"],
        "hasOfferCatalog": {
            "@@type": "OfferCatalog",
            "name": "Spanish Lesson Packages",
            "itemListElement": [
                {
                    "@@type": "Offer",
                    "itemOffered": {
                        "@@type": "Service",
                        "name": "Trial Spanish Lesson",
                        "description": "Single class trial for new students"
                    }
                },
                {
                    "@@type": "Offer",
                    "itemOffered": {
                        "@@type": "Service",
                        "name": "Monthly Spanish Subscription",
                        "description": "Flexible monthly subscription plans with 4, 8, or 12 classes"
                    }
                }
            ]
        }
    }
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        // Deep violet — LCS brand anchor (Karen's preferred Futura
                        // palette direction). The 800 sits at #3B1E5C, the deep
                        // violet from the Futura poster banners. Used for primary
                        // CTAs, nav/footer, active states, key headlines. Replaced
                        // the prior pink palette — pink is no longer a brand pillar.
                        primary: {
                            50: '#F4ECFA',
                            100: '#E7D9F2',
                            200: '#CFBCE7',
                            300: '#AE91D8',
                            400: '#8B65C7',
                            500: '#7045B0',
                            600: '#5E3895',
                            700: '#4C2A7A',
                            800: '#3B1E5C',
                            900: '#25103D',
                        },
                        // Living coral — secondary, warmth between pink and orange.
                        // Used on accent badges, secondary CTAs, decorative pops.
                        secondary: {
                            50: '#FFF1EF',
                            100: '#FFDFD8',
                            200: '#FFBBAB',
                            300: '#FF9A85',
                            400: '#FF8674',
                            500: '#FF6F61',
                            600: '#E85543',
                            700: '#C03E2E',
                            800: '#93291F',
                            900: '#661B14',
                        },
                        // Sunshine yellow — the third color in Karen's coral/pink/yellow
                        // palette. Used for badges ("Save 17%"), highlights, "fun"
                        // emphasis text in the hero, and the occasional callout.
                        accent: {
                            50: '#FFFBEB',
                            100: '#FFF3C2',
                            200: '#FFE685',
                            300: '#FFDD55',
                            400: '#FFD63D',
                            500: '#FFCC1A',
                            600: '#E8B300',
                            700: '#BA8E00',
                            800: '#876700',
                            900: '#5C4500',
                        },
                        // Override Tailwind's default gray-50 to a warm cream so the
                        // ~74 files that use `bg-gray-50` as page background pick up
                        // the warmer tone automatically. gray-100 through gray-900
                        // stay at Tailwind defaults (Tailwind merges within the
                        // extended object).
                        gray: {
                            50: '#FFFDF7',
                        },
                        // Deep navy — pulls double-duty as Lola's outline color
                        // (brand-bible #1E3A8A) and the structural cool anchor that
                        // grounds the warm pink/coral/yellow palette. Used for
                        // body-text-dark, structural lines, dashed paths.
                        ink: {
                            50: '#EEF1F8',
                            100: '#D6DDED',
                            200: '#A8B5D6',
                            300: '#7287BB',
                            400: '#4760A0',
                            500: '#2A4485',
                            600: '#1E3A8A',
                            700: '#172E6E',
                            800: '#102453',
                            900: '#0A1A3D',
                        },
                        // Turquoise/teal — the cool counterbalance from the Futura
                        // poster (speech-bubble fills) and the painting llama's
                        // mountain layers. Pulled slightly toward Futura's
                        // bluer-teal (#206080-#208080 range) rather than the
                        // tropical aqua of default Tailwind teal.
                        teal: {
                            50: '#EBF6F7',
                            100: '#C7E7EB',
                            200: '#92CFD6',
                            300: '#5DB6BF',
                            400: '#369AA4',
                            500: '#1E8189',
                            600: '#1A6F7E',
                            700: '#155967',
                            800: '#0F4350',
                            900: '#0A2E37',
                        },
                        // Deep violet — Karen's preferred Futura anchor. The Futura
                        // poster uses #200040-ish deep purple as the dominant dark,
                        // NOT pure navy. Plum sits in that family but lifted toward
                        // #3B2E78 so it stays readable for text and won't read as
                        // "school bus" primary. Used for structural elements:
                        // dashed paths, headlines on cream, nav highlights, footer.
                        plum: {
                            50: '#F1EEF8',
                            100: '#DDD5EE',
                            200: '#B9A8DA',
                            300: '#937CC4',
                            400: '#6E54AE',
                            500: '#523696',
                            600: '#3F2782',
                            700: '#311E68',
                            800: '#24164D',
                            900: '#170D33',
                        },
                        // Warm gold — Futura's "Tradiciones" brushstroke yellow
                        // (#E0C040 cleaned). Deeper and warmer than our neon
                        // accent-500 (#FFCC1A). Use where neon yellow reads cheap
                        // (badges, ribbons, brushstroke backgrounds). Accent stays
                        // for bright highlights; gold stays for editorial warmth.
                        gold: {
                            50: '#FCF8E7',
                            100: '#F9EFC2',
                            200: '#F2DD85',
                            300: '#EBCC52',
                            400: '#E0B832',
                            500: '#C99C1F',
                            600: '#A57D17',
                            700: '#7F5F12',
                            800: '#59420C',
                            900: '#332606',
                        },
                    },
                    fontFamily: {
                        // Body sans: warm humanist sans used for paragraphs, buttons,
                        // labels — replaces the system-default ui-sans that reads
                        // "bootstrap template."
                        sans: ['Nunito', 'system-ui', 'sans-serif'],
                        // Display serif: Fraunces is a variable-axis serif with a
                        // friendly editorial cadence (no stuffy old-newspaper feel).
                        // Used on h1/h2 via the `font-display` utility.
                        display: ['Fraunces', 'Georgia', 'serif'],
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Gamification Libraries - Toast Notifications -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js@@1.12.0/src/toastify.min.css" />
    <link rel="stylesheet" href="~/css/gamification.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="h-full bg-gray-50">
    <div class="min-h-full">
        @await Html.PartialAsync("_Navigation")

        <main>
            @await Html.PartialAsync("_Messages")
            @RenderBody()
        </main>

        @await Html.PartialAsync("_Footer")
    </div>

    <!-- Core Scripts -->
    <script src="~/js/modals.js" asp-append-version="true"></script>
    <script src="~/js/forms.js" asp-append-version="true"></script>
    <script src="~/js/ratings.js" asp-append-version="true"></script>

    <!-- HTMX for server-rendered partial swaps (curriculum block editor, etc.) -->
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script>
        // Forward the ASP.NET antiforgery token on every HTMX request so endpoints
        // protected by [ValidateAntiForgeryToken] accept the call. The token is
        // emitted by @@Html.AntiForgeryToken() wherever it appears on the page.
        document.body.addEventListener('htmx:configRequest', function (evt) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                evt.detail.headers['RequestVerificationToken'] = token.value;
            }
        });
    </script>

    <!-- Gamification Libraries -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://unpkg.com/@@lottiefiles/lottie-player@@2.0.8/dist/lottie-player.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@@1.9.3/dist/confetti.browser.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/howler/2.2.4/howler.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/toastify-js@@1.12.0/src/toastify.min.js"></script>

    <!-- Gamification Services -->
    <script src="~/js/sound-service.js" asp-append-version="true"></script>
    <script src="~/js/animation-service.js" asp-append-version="true"></script>
    <script src="~/js/gamification-effects.js" asp-append-version="true"></script>

    <script>
        function toggleMobileMenu() {
            var menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
