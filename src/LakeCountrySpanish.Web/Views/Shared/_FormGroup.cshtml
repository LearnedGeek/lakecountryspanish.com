@* FormGroup partial for consistent form field styling *@
@* Usage: @Html.Partial("_FormGroup", new { Label = "Field Name", For = "PropertyName", Type = "text", Placeholder = "Enter value", Required = true, HelpText = "Optional help text" }) *@

@{
    var label = ViewData["Label"]?.ToString() ?? "";
    var forField = ViewData["For"]?.ToString() ?? "";
    var type = ViewData["Type"]?.ToString() ?? "text";
    var placeholder = ViewData["Placeholder"]?.ToString() ?? "";
    var required = ViewData["Required"] as bool? ?? false;
    var helpText = ViewData["HelpText"]?.ToString();
    var cssClass = ViewData["CssClass"]?.ToString() ?? "";
}

<div class="mb-4">
    <label for="@forField" class="block text-sm font-medium text-gray-700 mb-1">
        @label
        @if (required)
        {
            <span class="text-red-500">*</span>
        }
    </label>
    @if (type == "textarea")
    {
        <textarea id="@forField"
                  name="@forField"
                  class="w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm @cssClass"
                  placeholder="@placeholder"
                  @(required ? "required" : "")></textarea>
    }
    else if (type == "select")
    {
        <select id="@forField"
                name="@forField"
                class="w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm @cssClass"
                @(required ? "required" : "")>
            @RenderBody()
        </select>
    }
    else
    {
        <input id="@forField"
               name="@forField"
               type="@type"
               class="w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm @cssClass"
               placeholder="@placeholder"
               @(required ? "required" : "") />
    }
    @if (!string.IsNullOrEmpty(helpText))
    {
        <p class="mt-1 text-xs text-gray-500">@helpText</p>
    }
    <span class="text-red-600 text-sm" data-valmsg-for="@forField" data-valmsg-replace="true"></span>
</div>
