@model ErrorViewModel
@{
    ViewData["Title"] = "Oops!";
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 -mt-16">
    <div class="max-w-md w-full text-center">
        <!-- Llama mascot -->
        <div class="mb-6">
            <img src="~/img/mascot/llama-mascot-waving.png" alt="Lola the llama waving" class="h-40 w-auto mx-auto drop-shadow-lg" />
        </div>

        <div class="bg-white rounded-xl shadow-lg p-8 border border-gray-100">
            <h1 class="text-3xl font-bold text-gray-900 mb-4">Something Went Wrong</h1>
            <p class="text-gray-600 mb-6">
                Don't worry, our llama is working on it! Let's get you back on track.
            </p>

            @if (Model?.ShowRequestId ?? false)
            {
                <div class="mb-6 p-3 bg-gray-50 rounded-lg text-left">
                    <p class="text-xs text-gray-500">
                        <strong>Request ID:</strong> <code class="text-xs">@Model.RequestId</code>
                    </p>
                </div>
            }

            <div class="space-y-3">
                <a href="@Url.Action("Index", "Home")" class="block w-full px-4 py-3 bg-secondary-500 text-white font-medium rounded-lg hover:bg-secondary-600 transition shadow-md">
                    Go to Home Page
                </a>
                <a href="javascript:history.back()" class="block w-full px-4 py-3 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition">
                    Go Back
                </a>
            </div>

            <p class="mt-6 text-sm text-gray-500">
                If this keeps happening, please <a asp-controller="Contact" asp-action="Index" class="text-secondary-600 hover:text-secondary-700 underline">contact us</a>.
            </p>
        </div>
    </div>
</div>
