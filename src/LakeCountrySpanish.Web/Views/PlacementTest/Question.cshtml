@model LakeCountrySpanish.Web.Models.ViewModels.PlacementTestQuestionViewModel
@{
    ViewData["Title"] = "Placement Test - Question " + Model.QuestionNumber;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Progress Bar -->
            <div class="mb-4">
                <div class="d-flex justify-content-between mb-1">
                    <small class="text-muted">Question @Model.QuestionNumber of ~@Model.MaxQuestions</small>
                    <small class="text-muted">Level: <strong>@Model.CurrentLevel</strong></small>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar" role="progressbar"
                         style="width: @Model.ProgressPercentage%"
                         aria-valuenow="@Model.ProgressPercentage"
                         aria-valuemin="0" aria-valuemax="100">
                    </div>
                </div>
            </div>

            @if (TempData["LastAnswerCorrect"] != null)
            {
                var wasCorrect = (bool)TempData["LastAnswerCorrect"]!;
                <div class="alert @(wasCorrect ? "alert-success" : "alert-warning") alert-dismissible fade show" role="alert">
                    @if (wasCorrect)
                    {
                        <strong><i class="bi bi-check-circle"></i> Correct!</strong>
                    }
                    else
                    {
                        <strong><i class="bi bi-x-circle"></i> Not quite.</strong>
                        if (TempData["LastCorrectAnswer"] != null)
                        {
                            <span>The answer was: <strong>@TempData["LastCorrectAnswer"]</strong></span>
                        }
                    }
                    @if (TempData["LastExplanation"] != null)
                    {
                        <br /><small>@TempData["LastExplanation"]</small>
                    }
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Question Card -->
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Question @Model.QuestionNumber</h5>
                    <span class="badge bg-secondary">@Model.CurrentLevel</span>
                </div>
                <div class="card-body">
                    <p class="fs-5 mb-4">@Model.QuestionText</p>

                    @if (Model.Hint != null)
                    {
                        <div class="alert alert-light mb-4">
                            <i class="bi bi-lightbulb text-warning"></i>
                            <small>Hint: @Model.Hint</small>
                        </div>
                    }

                    <form asp-action="Submit" method="post" id="answerForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="SessionId" value="@Model.SessionId" />

                        @if (Model.QuestionType == "multiple_choice" && Model.Options != null)
                        {
                            <div class="d-grid gap-2">
                                @foreach (var option in Model.Options)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio"
                                               name="Answer" id="opt_@option" value="@option" required>
                                        <label class="form-check-label w-100 py-2 px-3 border rounded option-label"
                                               for="opt_@option">
                                            @option
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <input type="text" class="form-control form-control-lg"
                                       name="Answer" id="answerInput"
                                       placeholder="Type your answer..."
                                       required autofocus>
                            </div>
                        }

                        <div class="d-flex justify-content-between mt-4">
                            <form asp-action="Abandon" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="sessionId" value="@Model.SessionId" />
                                <button type="submit" class="btn btn-outline-secondary"
                                        onclick="return confirm('Are you sure you want to abandon this test? Your progress will be lost.')">
                                    <i class="bi bi-x-circle"></i> Quit Test
                                </button>
                            </form>
                            <button type="submit" class="btn btn-primary btn-lg" id="submitBtn">
                                <i class="bi bi-arrow-right"></i> Submit Answer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<style>
    .option-label {
        cursor: pointer;
        transition: all 0.2s;
    }
    .option-label:hover {
        background-color: #f8f9fa;
        border-color: #0d6efd !important;
    }
    .form-check-input:checked + .option-label {
        background-color: #cfe2ff;
        border-color: #0d6efd !important;
    }
</style>
<script>
    // Show loading state on submit
    document.getElementById('answerForm').addEventListener('submit', function() {
        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Checking...';
    });

    // Auto-focus first option or input
    const firstOption = document.querySelector('input[name="Answer"]');
    if (firstOption) {
        firstOption.focus();
    }
</script>
}
