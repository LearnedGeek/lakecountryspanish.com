@model LakeCountrySpanish.Web.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 -mt-16">
    <div class="max-w-md w-full space-y-8">
        <div>
            <h2 class="mt-6 text-center text-3xl font-bold tracking-tight text-gray-900">
                Change Your Password
            </h2>
            @if (Model.IsRequired)
            {
                <div class="mt-4">
                    @await Component.InvokeAsync("Alert", new {
                        type = "warning",
                        message = "For security, you must change your password before continuing."
                    })
                </div>
            }
            else
            {
                <p class="mt-2 text-center text-sm text-gray-600">
                    Update your account password
                </p>
            }
        </div>

        <form asp-action="ChangePassword" method="post" class="mt-8 space-y-6">
            <div asp-validation-summary="ModelOnly" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative"></div>

            <div class="space-y-4">
                <div>
                    <label asp-for="CurrentPassword" class="block text-sm font-medium text-gray-700">Current Password</label>
                    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-3 py-2 border"
                           placeholder="Enter your current password" />
                    <span asp-validation-for="CurrentPassword" class="text-red-500 text-sm"></span>
                </div>

                <div>
                    <label asp-for="NewPassword" class="block text-sm font-medium text-gray-700">New Password</label>
                    <input asp-for="NewPassword" type="password" autocomplete="new-password" required
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-3 py-2 border"
                           placeholder="Enter your new password" />
                    <span asp-validation-for="NewPassword" class="text-red-500 text-sm"></span>
                    <p class="mt-1 text-xs text-gray-500">Must be at least 8 characters with uppercase, lowercase, and a number.</p>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-3 py-2 border"
                           placeholder="Confirm your new password" />
                    <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm"></span>
                </div>
            </div>

            <div>
                @await Component.InvokeAsync("Button", new {
                    text = "Change Password",
                    type = "primary",
                    cssClass = "w-full justify-center py-3"
                })
            </div>
        </form>

        @if (!Model.IsRequired)
        {
            <div class="text-center">
                <a asp-action="Dashboard" asp-controller="Student" class="text-sm font-medium text-primary-600 hover:text-primary-500">
                    Cancel and return to dashboard
                </a>
            </div>
        }
    </div>
</div>
