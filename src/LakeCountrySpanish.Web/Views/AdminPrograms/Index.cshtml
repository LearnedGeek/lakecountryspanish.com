@model IReadOnlyList<LakeCountrySpanish.Web.Models.ViewModels.ProgramListItemViewModel>
@{
    ViewData["Title"] = "Enrollment Programs";
    var includeInactive = (bool)(ViewBag.IncludeInactive ?? false);
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

        <div class="flex items-center justify-between mb-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Enrollment Programs</h1>
                <p class="text-sm text-gray-600 mt-1">Unlisted /join/{slug} landing pages for open houses, camps, and workshops.</p>
            </div>
            <a href="@Url.Action("Create")"
               class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-md hover:bg-indigo-700">
                + New program
            </a>
        </div>

        <div class="mb-3">
            <a href="@Url.Action("Index", new { includeInactive = !includeInactive })"
               class="text-xs text-gray-500 hover:text-gray-700">
                @(includeInactive ? "Hide inactive" : "Show inactive too")
            </a>
        </div>

        @if (Model.Count == 0)
        {
            <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500">
                <p>No programs yet.</p>
                <p class="text-sm mt-2">Create one to generate a QR code for the booth.</p>
            </div>
        }
        else
        {
            <div class="bg-white rounded-lg shadow overflow-hidden">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Name / Slug</th>
                            <th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Location</th>
                            <th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Dates</th>
                            <th class="px-4 py-2 text-right text-xs font-semibold text-gray-500 uppercase">Price</th>
                            <th class="px-4 py-2 text-right text-xs font-semibold text-gray-500 uppercase">Enrolled</th>
                            <th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var p in Model)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-4 py-2">
                                    <a href="@Url.Action("Detail", new { id = p.Id })" class="text-sm font-medium text-indigo-700 hover:text-indigo-900">@p.Name</a>
                                    <div class="text-xs text-gray-500 font-mono">/join/@p.Slug</div>
                                </td>
                                <td class="px-4 py-2 text-sm text-gray-700">@p.LocationName</td>
                                <td class="px-4 py-2 text-xs text-gray-600">@p.StartDate.ToString("MMM d") – @p.EndDate.ToString("MMM d, yyyy")</td>
                                <td class="px-4 py-2 text-sm text-right text-gray-700">$@p.FullPrice.ToString("N2")</td>
                                <td class="px-4 py-2 text-sm text-right">
                                    <a href="@Url.Action("Enrollments", new { id = p.Id })" class="hover:underline" title="View roster">
                                        <span class="font-semibold text-gray-900">@p.PaidCount</span>
                                        <span class="text-gray-400">/ @p.EnrollmentCount</span>
                                    </a>
                                </td>
                                <td class="px-4 py-2 text-xs">
                                    @if (p.IsActive)
                                    {
                                        <span class="inline-flex px-2 py-0.5 rounded-full bg-green-100 text-green-800">Active</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex px-2 py-0.5 rounded-full bg-gray-100 text-gray-700">Inactive</span>
                                    }
                                    @if (p.IsListed)
                                    {
                                        <span class="ml-1 inline-flex px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-800">Listed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
