@model IReadOnlyList<LakeCountrySpanish.Web.Models.ViewModels.ProgramListItemViewModel>
@{
    ViewData["Title"] = "Enrollment Programs";
}

<div class="bg-gray-100 min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-6">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Enrollment Programs</h1>
                <p class="text-sm text-gray-600 mt-1">Each program has its own <span class="font-mono text-gray-700">/join/{slug}</span> landing page for parents to sign up.</p>
            </div>
            <a href="@Url.Action("Create")"
               class="inline-flex items-center gap-2 px-6 py-3 bg-indigo-600 text-white text-base font-bold rounded-xl shadow-lg shadow-indigo-500/30 hover:bg-indigo-700 hover:shadow-indigo-500/40 focus:outline-none focus:ring-4 focus:ring-indigo-500/30 transition-all">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                New program
            </a>
        </div>

        @* The old "show inactive too" toggle was removed 2026-08-26 — drafts
           (IsActive=false) are always visible in the admin list now that they're
           a first-class state, distinguished by the Draft badge in the Status
           column instead of hidden behind a filter. *@

        @if (Model.Count == 0)
        {
            <div class="bg-white rounded-2xl shadow-md border-2 border-dashed border-gray-300 p-12 text-center">
                <div class="text-5xl mb-3">📋</div>
                <p class="text-lg font-bold text-gray-800">No programs yet</p>
                <p class="text-sm text-gray-600 mt-2">Create one to generate a QR code for the booth.</p>
                <a href="@Url.Action("Create")" class="inline-flex items-center gap-2 mt-5 px-5 py-2.5 bg-indigo-600 text-white text-sm font-bold rounded-xl shadow-md hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-500/30 transition-all">
                    + New program
                </a>
            </div>
        }
        else
        {
            <div class="bg-white rounded-2xl shadow-md overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="min-w-full">
                        <thead class="bg-gray-50 border-b-2 border-gray-200">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-bold text-gray-600 uppercase tracking-wide">Name / Slug</th>
                                <th class="px-6 py-3 text-left text-xs font-bold text-gray-600 uppercase tracking-wide">Location</th>
                                <th class="px-6 py-3 text-left text-xs font-bold text-gray-600 uppercase tracking-wide">Dates</th>
                                <th class="px-6 py-3 text-right text-xs font-bold text-gray-600 uppercase tracking-wide">Price</th>
                                <th class="px-6 py-3 text-right text-xs font-bold text-gray-600 uppercase tracking-wide">Enrolled</th>
                                <th class="px-6 py-3 text-left text-xs font-bold text-gray-600 uppercase tracking-wide">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @foreach (var p in Model)
                            {
                                // Draft rows also show placeholder dashes for fields Karen
                                // may not have filled in yet (dates/location default to
                                // MinValue / empty on the entity for drafts).
                                var displayName = string.IsNullOrEmpty(p.Name) ? "(untitled draft)" : p.Name;
                                var displayLocation = string.IsNullOrEmpty(p.LocationName) ? "—" : p.LocationName;
                                var displayDates = p.StartDate == DateTime.MinValue
                                    ? "—"
                                    : $"{p.StartDate:MMM d} – {p.EndDate:MMM d, yyyy}";
                                var displayPrice = p.FullPrice > 0 ? $"${p.FullPrice:N2}" : "—";
                                <tr class="hover:bg-indigo-50/40 transition-colors @(!p.IsActive ? "bg-amber-50/30" : "")">
                                    <td class="px-6 py-4">
                                        <a href="@Url.Action("Detail", new { id = p.Id })" class="text-base font-bold text-indigo-700 hover:text-indigo-900">@displayName</a>
                                        <div class="text-xs text-gray-500 font-mono mt-0.5">/join/@p.Slug</div>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-700">@displayLocation</td>
                                    <td class="px-6 py-4 text-sm text-gray-700">@displayDates</td>
                                    <td class="px-6 py-4 text-right">
                                        <span class="text-sm font-bold text-gray-900">@displayPrice</span>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <a href="@Url.Action("Enrollments", new { id = p.Id })" class="inline-flex items-center gap-1 hover:underline" title="View roster">
                                            <span class="text-lg font-bold text-gray-900">@p.PaidCount</span>
                                            <span class="text-sm text-gray-400">/ @p.EnrollmentCount</span>
                                        </a>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex flex-wrap gap-1.5">
                                            @if (p.IsActive)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-green-100 text-green-800 text-xs font-semibold border border-green-200">
                                                    <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
                                                    Live
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800 text-xs font-semibold border border-amber-200">
                                                    <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                                                    Draft
                                                </span>
                                            }
                                            @if (p.IsListed && p.IsActive)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-indigo-100 text-indigo-800 text-xs font-semibold border border-indigo-200">
                                                    Listed
                                                </span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
