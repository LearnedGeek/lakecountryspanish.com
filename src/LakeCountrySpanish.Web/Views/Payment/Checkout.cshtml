@model LakeCountrySpanish.Web.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-lg px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8 text-center">
            <h1 class="text-3xl font-bold text-gray-900">Checkout</h1>
            <p class="mt-2 text-gray-600">Complete your purchase securely with Stripe</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="bg-white rounded-lg shadow p-6">
            <!-- Order Summary -->
            <div class="mb-6 pb-6 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Order Summary</h2>

                @if (Model.Package != null)
                {
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="font-medium text-gray-900">@Model.Package.Name</p>
                            <p class="text-sm text-gray-500">@Model.Package.Description</p>
                            <p class="text-sm text-gray-500 mt-1">@Model.Package.ClassCount class @(Model.Package.ClassCount == 1 ? "credit" : "credits")</p>
                        </div>
                        <p class="font-semibold text-gray-900">$@Model.Amount.ToString("0.00")</p>
                    </div>

                    @if (Model.Savings > 0)
                    {
                        <div class="mt-4 bg-green-50 border border-green-200 rounded-lg p-3">
                            <div class="flex items-center">
                                <svg class="h-5 w-5 text-green-600 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span class="text-green-700 font-medium">You're saving $@Model.Savings.ToString("0.00")!</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="font-medium text-gray-900">@Model.Description</p>
                        </div>
                        <p class="font-semibold text-gray-900">$@Model.Amount.ToString("0.00")</p>
                    </div>
                }
            </div>

            <!-- What You Get -->
            <div class="mb-6 pb-6 border-b border-gray-200">
                <h3 class="text-sm font-medium text-gray-900 mb-3">What you get:</h3>
                <ul class="space-y-2">
                    <li class="flex items-center text-sm text-gray-600">
                        <svg class="h-4 w-4 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                        @Model.Package?.ClassCount class @(Model.Package?.ClassCount == 1 ? "credit" : "credits") to use anytime
                    </li>
                    <li class="flex items-center text-sm text-gray-600">
                        <svg class="h-4 w-4 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                        Schedule at your own pace
                    </li>
                    <li class="flex items-center text-sm text-gray-600">
                        <svg class="h-4 w-4 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                        Credits never expire
                    </li>
                </ul>
            </div>

            <!-- Total -->
            <div class="flex justify-between items-center mb-6">
                <p class="text-lg font-semibold text-gray-900">Total</p>
                <p class="text-2xl font-bold text-gray-900">$@Model.Amount.ToString("0.00")</p>
            </div>

            <!-- Checkout Button -->
            <form asp-action="CreateCheckoutSession" method="post">
                <input type="hidden" name="packageId" value="@Model.PackageId" />

                <button type="submit"
                        class="w-full flex justify-center items-center rounded-md bg-primary-600 py-4 px-4 text-base font-semibold text-white hover:bg-primary-700 transition">
                    <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                    </svg>
                    Pay $@Model.Amount.ToString("0.00") with Stripe
                </button>
            </form>

            <p class="mt-4 text-xs text-center text-gray-500">
                Secure payment powered by Stripe. Your card details are never stored on our servers.
            </p>
        </div>

        <div class="mt-6 text-center">
            <a asp-controller="Student" asp-action="TokenStore" class="text-primary-600 hover:text-primary-700 text-sm font-medium">
                Cancel and return to Token Store
            </a>
        </div>
    </div>
</div>
