@{
    ViewData["Title"] = "Thank You";
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 -mt-16">
    <div class="max-w-md w-full text-center">
        <!-- Llama mascot -->
        <div class="mb-6">
            <img src="~/img/mascot/llama-mascot-waving.png" alt="Lola the llama waving" class="h-40 w-auto mx-auto drop-shadow-lg" />
        </div>

        <div class="bg-white rounded-xl shadow-lg p-8 border border-gray-100">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-green-100 mb-4">
                <svg class="h-7 w-7 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <h1 class="text-3xl font-bold text-gray-900 mb-4">Message Sent!</h1>
            <p class="text-gray-600 mb-6">
                Your message has been sent successfully. We'll get back to you within 24 hours.
            </p>
            <p class="text-sm text-primary-600 italic mb-6">
                "Can't wait to help you on your Spanish journey!"
            </p>
            @await Component.InvokeAsync("Button", new {
                text = "Back to Home",
                href = Url.Action("Index", "Home"),
                type = "primary"
            })
        </div>
    </div>
</div>
