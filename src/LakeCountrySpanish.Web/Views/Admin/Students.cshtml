@model LakeCountrySpanish.Web.Models.ViewModels.StudentListViewModel
@{
    ViewData["Title"] = "Students";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8 flex justify-between items-center">
            @await Component.InvokeAsync("PageHeader", new {
                title = "Students",
                subtitle = "Manage your student accounts."
            })
            @await Component.InvokeAsync("Button", new {
                text = "Add Student",
                href = Url.Action("CreateStudent"),
                type = "primary",
                icon = "plus"
            })
        </div>

        <!-- Search -->
        <div class="bg-white rounded-lg shadow p-4 mb-6">
            <form asp-action="Students" method="get" class="flex gap-4">
                <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search by name or email..."
                       class="flex-1 rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border" />
                @await Component.InvokeAsync("Button", new {
                    text = "Search",
                    type = "secondary"
                })
            </form>
        </div>

        <!-- Student List -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Student</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Rate</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Upcoming</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Balance</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var student in Model.Students)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div>
                                    <a asp-action="StudentProfile" asp-route-id="@student.Id" class="text-sm font-medium text-primary-600 hover:text-primary-700 hover:underline">@student.FullName</a>
                                    <p class="text-sm text-gray-500">@student.Email</p>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (student.CustomHourlyRate.HasValue)
                                {
                                    <span class="text-sm text-gray-900">$@student.CustomHourlyRate.Value.ToString("0.00")</span>
                                }
                                else
                                {
                                    <span class="text-sm text-gray-500">Default</span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="text-sm text-gray-900">@student.UpcomingClassCount classes</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (student.Balance > 0)
                                {
                                    <span class="text-sm text-yellow-600 font-medium">$@student.Balance.ToString("0.00")</span>
                                }
                                else
                                {
                                    <span class="text-sm text-gray-500">$0.00</span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @await Component.InvokeAsync("StatusBadge", new {
                                    text = student.IsActive ? "Active" : "Inactive",
                                    color = student.IsActive ? "green" : "gray"
                                })
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-3">
                                <a asp-action="ManageCredits" asp-route-id="@student.Id" class="text-green-600 hover:text-green-900">Credits</a>
                                <a asp-action="EditStudent" asp-route-id="@student.Id" class="text-primary-600 hover:text-primary-900">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Students.Any())
            {
                @await Component.InvokeAsync("EmptyState", new {
                    title = "No students found",
                    icon = "users",
                    actionText = "Add your first student",
                    actionUrl = Url.Action("CreateStudent")
                })
            }
        </div>
    </div>
</div>
