@model LakeCountrySpanish.Web.Models.ViewModels.EditTeacherViewModel
@{
    ViewData["Title"] = "Edit Teacher";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-2xl px-4 py-8 sm:px-6 lg:px-8">
        @await Component.InvokeAsync("PageHeader", new {
            title = "Edit Teacher",
            backUrl = Url.Action("Teachers"),
            backText = "Back to Teachers"
        })

        <div class="bg-white rounded-lg shadow p-6">
            <form asp-action="EditTeacher" method="post">
                <div asp-validation-summary="ModelOnly" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6"></div>

                <input asp-for="Id" type="hidden" />

                <div class="space-y-6">
                    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                        <div>
                            <label asp-for="FirstName" class="block text-sm font-medium text-gray-700"></label>
                            <input asp-for="FirstName" type="text" required
                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border" />
                            <span asp-validation-for="FirstName" class="text-red-500 text-sm"></span>
                        </div>

                        <div>
                            <label asp-for="LastName" class="block text-sm font-medium text-gray-700"></label>
                            <input asp-for="LastName" type="text" required
                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border" />
                            <span asp-validation-for="LastName" class="text-red-500 text-sm"></span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="Email" class="block text-sm font-medium text-gray-700"></label>
                        <input asp-for="Email" type="email" required
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border" />
                        <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                    </div>

                    <div class="flex items-center">
                        <input asp-for="IsActive" type="checkbox"
                               class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
                        <label asp-for="IsActive" class="ml-2 block text-sm text-gray-700"></label>
                    </div>

                    <div>
                        <label asp-for="NewPassword" class="block text-sm font-medium text-gray-700"></label>
                        <input asp-for="NewPassword" type="password"
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border" />
                        <p class="mt-1 text-sm text-gray-500">Leave blank to keep the current password.</p>
                        <span asp-validation-for="NewPassword" class="text-red-500 text-sm"></span>
                    </div>

                    <fieldset class="border-t border-gray-200 pt-6">
                        <legend class="text-sm font-semibold text-gray-800 mb-1">Roles</legend>
                        <p class="text-xs text-gray-500 mb-3">
                            <strong>Admin</strong> unlocks curriculum authoring, binder upload, and program management.
                            <strong>Teacher</strong> can view + print lessons and download binders, plus the teacher dashboard — no write access.
                            Every staff account needs at least one.
                        </p>
                        @{
                            var adminChecked = Model.SelectedRoles.Contains(LakeCountrySpanish.Web.AppRoles.Admin);
                            var teacherChecked = Model.SelectedRoles.Contains(LakeCountrySpanish.Web.AppRoles.Teacher);
                            var adminDisabled = Model.IsSelf && adminChecked;
                        }
                        <div class="space-y-2">
                            <label class="flex items-start gap-3 p-3 rounded-lg border-2 @(adminDisabled ? "border-gray-200 bg-gray-50" : "border-gray-200 bg-white hover:bg-gray-50") cursor-pointer transition-colors">
                                <input type="checkbox" name="SelectedRoles" value="@LakeCountrySpanish.Web.AppRoles.Admin"
                                       class="mt-0.5 h-5 w-5 rounded border-2 border-gray-300 text-primary-600 focus:ring-4 focus:ring-primary-500/15"
                                       @(adminChecked ? "checked" : "")
                                       @(adminDisabled ? "disabled" : "") />
                                <div>
                                    <div class="text-sm font-semibold text-gray-900">Admin</div>
                                    <div class="text-xs text-gray-600">
                                        Full write access — curriculum authoring, binder upload, manage programs, manage other users' roles.
                                    </div>
                                    @if (adminDisabled)
                                    {
                                        <div class="text-xs font-semibold text-amber-700 mt-1">You can't remove your own Admin role. Ask another admin to change it.</div>
                                        <!-- Disabled checkboxes don't post, so re-post the current
                                             value via a hidden input to keep the reconcile delta clean. -->
                                        <input type="hidden" name="SelectedRoles" value="@LakeCountrySpanish.Web.AppRoles.Admin" />
                                    }
                                </div>
                            </label>

                            <label class="flex items-start gap-3 p-3 rounded-lg border-2 border-gray-200 bg-white hover:bg-gray-50 cursor-pointer transition-colors">
                                <input type="checkbox" name="SelectedRoles" value="@LakeCountrySpanish.Web.AppRoles.Teacher"
                                       class="mt-0.5 h-5 w-5 rounded border-2 border-gray-300 text-primary-600 focus:ring-4 focus:ring-primary-500/15"
                                       @(teacherChecked ? "checked" : "") />
                                <div>
                                    <div class="text-sm font-semibold text-gray-900">Teacher</div>
                                    <div class="text-xs text-gray-600">
                                        View + print lessons, download binders, and the teacher dashboard. Cannot edit lessons or upload binders.
                                    </div>
                                </div>
                            </label>
                        </div>
                        <span asp-validation-for="SelectedRoles" class="text-red-500 text-sm mt-2 block"></span>
                    </fieldset>
                </div>

                <div class="mt-8">
                    @await Component.InvokeAsync("Button", new {
                        text = "Save Changes",
                        type = "primary",
                        submit = true,
                        cssClass = "w-full justify-center py-3"
                    })
                </div>
            </form>
        </div>
    </div>
</div>
