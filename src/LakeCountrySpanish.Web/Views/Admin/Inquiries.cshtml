@model LakeCountrySpanish.Web.Models.ViewModels.AdminInquiriesViewModel
@{
    ViewData["Title"] = "Inquiries";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
        @await Component.InvokeAsync("PageHeader", new {
            title = "Contact Inquiries",
            subtitle = "Review and respond to potential student inquiries."
        })

        <!-- Filter -->
        <div class="bg-white rounded-lg shadow p-4 mb-6">
            <form asp-action="Inquiries" method="get" class="flex gap-4">
                <select name="status" class="rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border">
                    <option value="">All Status</option>
                    <option value="New" selected="@(Model.FilterStatus == LakeCountrySpanish.Web.Models.Entities.InquiryStatus.New)">New</option>
                    <option value="Responded" selected="@(Model.FilterStatus == LakeCountrySpanish.Web.Models.Entities.InquiryStatus.Responded)">Responded</option>
                    <option value="Closed" selected="@(Model.FilterStatus == LakeCountrySpanish.Web.Models.Entities.InquiryStatus.Closed)">Closed</option>
                </select>
                @await Component.InvokeAsync("Button", new {
                    text = "Filter",
                    type = "secondary"
                })
            </form>
        </div>

        <!-- Inquiries List -->
        <div class="space-y-4">
            @if (Model.Inquiries.Any())
            {
                @foreach (var inquiry in Model.Inquiries)
                {
                    <div class="bg-white rounded-lg shadow p-6">
                        <div class="flex justify-between items-start mb-4">
                            <div>
                                <h3 class="text-lg font-medium text-gray-900">@inquiry.Name</h3>
                                <p class="text-sm text-gray-500">
                                    <a href="mailto:@inquiry.Email" class="text-primary-600 hover:text-primary-700">@inquiry.Email</a>
                                    @if (!string.IsNullOrEmpty(inquiry.Phone))
                                    {
                                        <span class="mx-2">|</span>
                                        <span>@inquiry.Phone</span>
                                    }
                                </p>
                            </div>
                            <div class="text-right">
                                @{
                                    var statusColor = inquiry.Status == LakeCountrySpanish.Web.Models.Entities.InquiryStatus.New ? "blue" :
                                                      inquiry.Status == LakeCountrySpanish.Web.Models.Entities.InquiryStatus.Responded ? "green" : "gray";
                                }
                                @await Component.InvokeAsync("StatusBadge", new { text = inquiry.Status.ToString(), color = statusColor })
                                <p class="text-xs text-gray-400 mt-1">@inquiry.CreatedAt.ToString("MMM d, yyyy 'at' h:mm tt")</p>
                            </div>
                        </div>

                        <div class="bg-gray-50 rounded-lg p-4 mb-4">
                            <p class="text-gray-700 whitespace-pre-wrap">@inquiry.Message</p>
                        </div>

                        <div class="flex justify-end space-x-2">
                            @if (inquiry.Status == LakeCountrySpanish.Web.Models.Entities.InquiryStatus.New)
                            {
                                <form asp-action="UpdateInquiryStatus" method="post">
                                    <input type="hidden" name="id" value="@inquiry.Id" />
                                    <input type="hidden" name="status" value="Responded" />
                                    <button type="submit" class="text-green-600 hover:text-green-800 text-sm font-medium">
                                        Mark as Responded
                                    </button>
                                </form>
                            }
                            @if (inquiry.Status != LakeCountrySpanish.Web.Models.Entities.InquiryStatus.Closed)
                            {
                                <form asp-action="UpdateInquiryStatus" method="post">
                                    <input type="hidden" name="id" value="@inquiry.Id" />
                                    <input type="hidden" name="status" value="Closed" />
                                    <button type="submit" class="text-gray-600 hover:text-gray-800 text-sm font-medium">
                                        Close
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="bg-white rounded-lg shadow">
                    @await Component.InvokeAsync("EmptyState", new {
                        title = "No inquiries found",
                        icon = "inbox"
                    })
                </div>
            }
        </div>
    </div>
</div>
