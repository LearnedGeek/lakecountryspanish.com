@model LakeCountrySpanish.Web.Models.ViewModels.EditTopicViewModel
@{
    ViewData["Title"] = "Edit Topic";
}

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="max-w-2xl mx-auto">
        @await Component.InvokeAsync("PageHeader", new {
            title = "Edit Topic",
            backUrl = Url.Action("Topics")
        })

        <div class="bg-white rounded-lg shadow">
            <div class="p-6">
                @await Html.PartialAsync("_TopicForm", Model)
            </div>
        </div>
    </div>
</div>
