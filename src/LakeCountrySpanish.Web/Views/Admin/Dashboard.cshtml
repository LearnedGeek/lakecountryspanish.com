@model LakeCountrySpanish.Web.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        @await Component.InvokeAsync("PageHeader", new {
            title = "Admin Dashboard",
            subtitle = "Welcome back, Karen! Here's your business overview."
        })

        <!-- Key Metrics Row -->
        @if (Model.Metrics != null)
        {
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 mb-8">
                @await Component.InvokeAsync("StatCard", new {
                    value = "$" + Model.Metrics.MRR.ToString("N2"),
                    label = "Monthly Recurring Revenue",
                    color = "primary",
                    icon = "currency",
                    borderLeft = true
                })

                @await Component.InvokeAsync("StatCard", new {
                    value = (Model.Metrics.RevenueChangePercent >= 0 ? "+" : "") + Model.Metrics.RevenueChangePercent.ToString("N1") + "%",
                    label = "Revenue Change",
                    color = Model.Metrics.RevenueChangePercent >= 0 ? "green" : "red",
                    icon = "chart",
                    borderLeft = true
                })

                @await Component.InvokeAsync("StatCard", new {
                    value = Model.Metrics.ActiveSubscriptions.ToString(),
                    label = "Active Subscriptions",
                    color = "blue",
                    icon = "users",
                    borderLeft = true
                })

                @await Component.InvokeAsync("StatCard", new {
                    value = Model.Metrics.ChurnRate.ToString("N1") + "%",
                    label = "Churn Rate",
                    color = Model.Metrics.ChurnRate <= 5 ? "green" : "yellow",
                    icon = "users",
                    borderLeft = true
                })
            </div>
        }

        <!-- Original Stats Cards -->
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 mb-8">
            @await Component.InvokeAsync("StatCard", new {
                value = Model.ActiveStudents + " / " + Model.TotalStudents,
                label = "Active Students",
                color = "blue",
                icon = "users"
            })

            @await Component.InvokeAsync("StatCard", new {
                value = Model.TodaysClasses.ToString(),
                label = "Today's Classes",
                color = "green",
                icon = "calendar"
            })

            @await Component.InvokeAsync("StatCard", new {
                value = "$" + Model.TotalRevenueThisMonth.ToString("0.00"),
                label = "Revenue This Month",
                color = "yellow",
                icon = "currency"
            })

            @await Component.InvokeAsync("StatCard", new {
                value = Model.NewInquiries.ToString(),
                label = "New Inquiries",
                color = "red",
                icon = "mail"
            })
        </div>

        <!-- Quick Actions -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            @await Component.InvokeAsync("Button", new {
                text = "Add Student",
                href = Url.Action("CreateStudent"),
                type = "primary",
                icon = "user-plus",
                cssClass = "w-full justify-center p-4"
            })
            @await Component.InvokeAsync("Button", new {
                text = "Add Time Slot",
                href = Url.Action("CreateTimeSlot"),
                type = "secondary",
                icon = "clock",
                cssClass = "w-full justify-center p-4"
            })
            <form asp-action="RepairPendingCheckouts" method="post" class="contents">
                <button type="submit" onclick="return confirm('This will repair any classes that were paid for but not confirmed. Continue?')"
                        class="w-full justify-center p-4 inline-flex items-center gap-2 rounded-lg border border-orange-300 bg-orange-50 text-orange-700 hover:bg-orange-100 transition">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" />
                    </svg>
                    Repair Checkouts
                </button>
            </form>
            @await Component.InvokeAsync("Button", new {
                text = "New Assignment",
                href = Url.Action("GenerateAssignment"),
                type = "secondary",
                icon = "document",
                cssClass = "w-full justify-center p-4"
            })
            @await Component.InvokeAsync("Button", new {
                text = "View Inquiries",
                href = Url.Action("Inquiries"),
                type = "secondary",
                icon = "mail",
                cssClass = "w-full justify-center p-4"
            })
        </div>

        <!-- Navigation Links -->
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-4 mb-8">
            <a asp-action="Students" class="bg-white rounded-lg shadow p-4 hover:shadow-md transition text-center">
                <svg class="h-8 w-8 mx-auto text-gray-400 mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
                </svg>
                <p class="text-sm font-medium text-gray-900">Students</p>
            </a>
            <a asp-action="Schedule" class="bg-white rounded-lg shadow p-4 hover:shadow-md transition text-center relative">
                @if (Model.HasScheduleConflicts)
                {
                    @await Component.InvokeAsync("StatusBadge", new { text = "!", color = "red", size = "xs" })
                }
                <svg class="h-8 w-8 mx-auto text-gray-400 mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                </svg>
                <p class="text-sm font-medium text-gray-900">Schedule</p>
            </a>
            <a asp-action="Assignments" class="bg-white rounded-lg shadow p-4 hover:shadow-md transition text-center">
                <svg class="h-8 w-8 mx-auto text-gray-400 mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                </svg>
                <p class="text-sm font-medium text-gray-900">Assignments</p>
            </a>
            <div class="bg-white rounded-lg shadow p-4 hover:shadow-md transition text-center group relative cursor-pointer">
                <svg class="h-8 w-8 mx-auto text-gray-400 mb-2 group-hover:text-primary-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" />
                </svg>
                <p class="text-sm font-medium text-gray-900">Scheduling</p>
                <svg class="h-4 w-4 mx-auto text-gray-400 mt-1 group-hover:text-primary-500 transition-transform group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
                <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 ease-out transform translate-y-1 group-hover:translate-y-0 z-20" style="min-width: 160px;">
                    <div class="bg-white rounded-xl shadow-xl border border-gray-100 overflow-hidden">
                        <a asp-action="TimeSlots" class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-primary-50 hover:text-primary-700 transition-colors">
                            <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            Time Slots
                        </a>
                        <div class="border-t border-gray-100"></div>
                        <a asp-action="BlockedDates" class="flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-primary-50 hover:text-primary-700 transition-colors">
                            <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15zm0 2.25h.008v.008H12v-.008zM9.75 15h.008v.008H9.75V15zm0 2.25h.008v.008H9.75v-.008zM7.5 15h.008v.008H7.5V15zm0 2.25h.008v.008H7.5v-.008zm6.75-4.5h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V15zm0 2.25h.008v.008h-.008v-.008zm2.25-4.5h.008v.008H16.5v-.008zm0 2.25h.008v.008H16.5V15z" />
                            </svg>
                            Blocked Dates
                        </a>
                    </div>
                </div>
            </div>
            <a asp-action="Payments" class="bg-white rounded-lg shadow p-4 hover:shadow-md transition text-center">
                <svg class="h-8 w-8 mx-auto text-gray-400 mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
                </svg>
                <p class="text-sm font-medium text-gray-900">Payments</p>
            </a>
            <a asp-action="Documents" class="bg-white rounded-lg shadow p-4 hover:shadow-md transition text-center">
                <svg class="h-8 w-8 mx-auto text-gray-400 mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
                <p class="text-sm font-medium text-gray-900">Documents</p>
            </a>
            <a asp-action="Testimonials" class="bg-white rounded-lg shadow p-4 hover:shadow-md transition text-center">
                <svg class="h-8 w-8 mx-auto text-gray-400 mb-2" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
                <p class="text-sm font-medium text-gray-900">Testimonials</p>
            </a>
            <a asp-action="DifficultyAnalysis" class="bg-white rounded-lg shadow p-4 hover:shadow-md transition text-center">
                <svg class="h-8 w-8 mx-auto text-gray-400 mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                </svg>
                <p class="text-sm font-medium text-gray-900">Analytics</p>
            </a>
        </div>

        <!-- Revenue Chart and Engagement -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <!-- Revenue Trend Chart -->
            <div class="bg-white rounded-lg shadow">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h2 class="text-lg font-semibold text-gray-900">Revenue Trend (6 Months)</h2>
                </div>
                <div class="p-6">
                    <canvas id="revenueChart" height="200"></canvas>
                </div>
            </div>

            <!-- Revenue Breakdown -->
            @if (Model.RevenueBreakdown != null)
            {
                <div class="bg-white rounded-lg shadow">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h2 class="text-lg font-semibold text-gray-900">Revenue Breakdown (This Month)</h2>
                    </div>
                    <div class="p-6">
                        <canvas id="revenueBreakdownChart" height="200"></canvas>
                        <div class="mt-4 grid grid-cols-2 gap-4 text-sm">
                            <div class="flex items-center">
                                <span class="w-3 h-3 bg-primary-500 rounded-full mr-2"></span>
                                <span>Subscriptions: $@Model.RevenueBreakdown.SubscriptionRevenue.ToString("N2") (@Model.RevenueBreakdown.SubscriptionPercent%)</span>
                            </div>
                            <div class="flex items-center">
                                <span class="w-3 h-3 bg-green-500 rounded-full mr-2"></span>
                                <span>Tokens: $@Model.RevenueBreakdown.TokenRevenue.ToString("N2") (@Model.RevenueBreakdown.TokenPercent%)</span>
                            </div>
                            <div class="flex items-center">
                                <span class="w-3 h-3 bg-yellow-500 rounded-full mr-2"></span>
                                <span>Packages: $@Model.RevenueBreakdown.PackageRevenue.ToString("N2") (@Model.RevenueBreakdown.PackagePercent%)</span>
                            </div>
                            <div class="flex items-center">
                                <span class="w-3 h-3 bg-purple-500 rounded-full mr-2"></span>
                                <span>Single Classes: $@Model.RevenueBreakdown.CustomRateRevenue.ToString("N2") (@Model.RevenueBreakdown.CustomRatePercent%)</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Student Engagement Section -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <!-- Top Engaged Students -->
            <div class="bg-white rounded-lg shadow">
                <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                    <h2 class="text-lg font-semibold text-gray-900">Top Engaged Students</h2>
                    @await Component.InvokeAsync("StatusBadge", new { text = "By points earned", color = "gray", size = "xs" })
                </div>
                <div class="p-6">
                    @if (Model.TopEngagedStudents.Any())
                    {
                        <div class="space-y-4">
                            @foreach (var student in Model.TopEngagedStudents)
                            {
                                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                                    <div>
                                        <a asp-action="StudentProfile" asp-route-id="@student.StudentId" class="font-medium text-primary-600 hover:text-primary-700">@student.StudentName</a>
                                        <div class="text-xs text-gray-500">
                                            @student.TotalPoints pts | @student.CurrentStreak day streak
                                        </div>
                                    </div>
                                    <div class="text-right text-sm">
                                        <span class="text-gray-600">@student.ClassesAttended classes</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        @await Component.InvokeAsync("EmptyState", new {
                            title = "No engagement data yet",
                            icon = "users"
                        })
                    }
                </div>
            </div>

            <!-- At-Risk Students -->
            <div class="bg-white rounded-lg shadow">
                <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                    <h2 class="text-lg font-semibold text-gray-900">At-Risk Students</h2>
                    @await Component.InvokeAsync("StatusBadge", new { text = "Inactive 14+ days", color = "red", size = "xs" })
                </div>
                <div class="p-6">
                    @if (Model.AtRiskStudents.Any())
                    {
                        <div class="space-y-4">
                            @foreach (var student in Model.AtRiskStudents)
                            {
                                <div class="flex items-center justify-between p-3 bg-red-50 rounded-lg border border-red-100">
                                    <div>
                                        <a asp-action="StudentProfile" asp-route-id="@student.StudentId" class="font-medium text-primary-600 hover:text-primary-700">@student.StudentName</a>
                                        <div class="text-xs text-red-600">
                                            Last active @student.DaysSinceLastActivity days ago
                                        </div>
                                    </div>
                                    <div class="text-right text-sm">
                                        <span class="text-gray-600">@student.TotalPoints pts</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-green-600 text-center py-4">No at-risk students</p>
                    }
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Upcoming Schedule (3 Days) -->
            <div class="bg-white rounded-lg shadow">
                <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                    <h2 class="text-lg font-semibold text-gray-900">Upcoming Schedule</h2>
                    <a asp-action="Schedule" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">View All</a>
                </div>
                <div class="p-6">
                    @if (Model.UpcomingDays.Any(d => d.Classes.Any()))
                    {
                        <div class="space-y-6">
                            @foreach (var day in Model.UpcomingDays)
                            {
                                <div>
                                    <h3 class="text-sm font-medium text-gray-500 mb-3">
                                        @if (day.Date.Date == DateTime.Today)
                                        {
                                            <span>Today</span>
                                        }
                                        else if (day.Date.Date == DateTime.Today.AddDays(1))
                                        {
                                            <span>Tomorrow</span>
                                        }
                                        else
                                        {
                                            @day.Date.ToString("dddd, MMM d")
                                        }
                                    </h3>
                                    @if (day.Classes.Any())
                                    {
                                        <div class="space-y-3">
                                            @foreach (var cls in day.Classes)
                                            {
                                                <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                                                    <div>
                                                        <a asp-action="StudentProfile" asp-route-id="@cls.StudentId" class="font-medium text-primary-600 hover:text-primary-700 hover:underline">@cls.Student.FullName</a>
                                                        <p class="text-sm text-gray-500">@cls.ClassDateTime.ToString("h:mm tt")</p>
                                                    </div>
                                                    <div class="flex space-x-2">
                                                        <form asp-action="CompleteClass" method="post">
                                                            <input type="hidden" name="id" value="@cls.Id" />
                                                            @await Component.InvokeAsync("Button", new {
                                                                text = "Complete",
                                                                type = "success",
                                                                size = "sm",
                                                                submit = true
                                                            })
                                                        </form>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-sm text-gray-400 italic">No classes</p>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        @await Component.InvokeAsync("EmptyState", new {
                            title = "No upcoming classes",
                            message = "No classes scheduled for the next 3 days",
                            icon = "calendar"
                        })
                    }
                </div>
            </div>

            <!-- Recent Inquiries -->
            <div class="bg-white rounded-lg shadow">
                <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                    <h2 class="text-lg font-semibold text-gray-900">New Inquiries</h2>
                    <a asp-action="Inquiries" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">View All</a>
                </div>
                <div class="p-6">
                    @if (Model.RecentInquiries.Any())
                    {
                        <div class="space-y-4">
                            @foreach (var inquiry in Model.RecentInquiries)
                            {
                                <div class="p-4 bg-gray-50 rounded-lg">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <p class="font-medium text-gray-900">@inquiry.Name</p>
                                            <p class="text-sm text-gray-500">@inquiry.Email</p>
                                        </div>
                                        @await Component.InvokeAsync("StatusBadge", new { text = inquiry.CreatedAt.ToString("MMM d"), color = "gray", size = "xs" })
                                    </div>
                                    <p class="text-sm text-gray-600 mt-2 line-clamp-2">@inquiry.Message</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        @await Component.InvokeAsync("EmptyState", new {
                            title = "No new inquiries",
                            icon = "inbox"
                        })
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Revenue Trend Chart
        var revenueCtx = document.getElementById('revenueChart').getContext('2d');
        var revenueChart = new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: [@Html.Raw(string.Join(",", Model.RevenueChart.Select(r => $"'{r.MonthName}'")))],
                datasets: [{
                    label: 'Total Revenue',
                    data: [@string.Join(",", Model.RevenueChart.Select(r => r.TotalRevenue.ToString("F2")))],
                    borderColor: '#4F46E5',
                    backgroundColor: 'rgba(79, 70, 229, 0.1)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return '$' + value;
                            }
                        }
                    }
                }
            }
        });

        // Revenue Breakdown Chart
        @if (Model.RevenueBreakdown != null)
        {
            <text>
        var breakdownCtx = document.getElementById('revenueBreakdownChart').getContext('2d');
        var breakdownChart = new Chart(breakdownCtx, {
            type: 'doughnut',
            data: {
                labels: ['Subscriptions', 'Tokens', 'Packages', 'Single Classes'],
                datasets: [{
                    data: [
                        @Model.RevenueBreakdown.SubscriptionRevenue.ToString("F2"),
                        @Model.RevenueBreakdown.TokenRevenue.ToString("F2"),
                        @Model.RevenueBreakdown.PackageRevenue.ToString("F2"),
                        @Model.RevenueBreakdown.CustomRateRevenue.ToString("F2")
                    ],
                    backgroundColor: ['#4F46E5', '#10B981', '#F59E0B', '#8B5CF6']
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });
            </text>
        }
    </script>
}
