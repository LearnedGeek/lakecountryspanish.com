@model LakeCountrySpanish.Web.Models.ViewModels.CreateBlockedDateViewModel
@{
    ViewData["Title"] = "Block Dates";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-lg px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a asp-action="BlockedDates" class="text-primary-600 hover:text-primary-700 flex items-center text-sm mb-4">
                <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
                Back to Blocked Dates
            </a>
            <h1 class="text-3xl font-bold text-gray-900">Block Dates</h1>
            <p class="mt-2 text-gray-600">Mark dates as unavailable for scheduling.</p>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <form asp-action="CreateBlockedDate" method="post">
                <div class="space-y-6">
                    <div>
                        <label asp-for="StartDate" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="StartDate" type="date" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500" />
                        <span asp-validation-for="StartDate" class="text-red-600 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="EndDate" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="EndDate" type="date" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500" />
                        <span asp-validation-for="EndDate" class="text-red-600 text-sm"></span>
                        <p class="mt-1 text-sm text-gray-500">For a single day, set both dates to the same day.</p>
                    </div>

                    <div>
                        <label asp-for="Reason" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="Reason" type="text" placeholder="e.g., Vacation, Holiday, Conference"
                               class="block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500" />
                        <span asp-validation-for="Reason" class="text-red-600 text-sm"></span>
                    </div>

                    <!-- Common reasons quick buttons -->
                    <div>
                        <p class="text-sm text-gray-500 mb-2">Quick fill:</p>
                        <div class="flex flex-wrap gap-2">
                            <button type="button" onclick="document.getElementById('Reason').value = 'Vacation'"
                                    class="px-3 py-1 text-sm bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full transition">
                                Vacation
                            </button>
                            <button type="button" onclick="document.getElementById('Reason').value = 'Holiday'"
                                    class="px-3 py-1 text-sm bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full transition">
                                Holiday
                            </button>
                            <button type="button" onclick="document.getElementById('Reason').value = 'Personal Day'"
                                    class="px-3 py-1 text-sm bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full transition">
                                Personal Day
                            </button>
                            <button type="button" onclick="document.getElementById('Reason').value = 'Sick Day'"
                                    class="px-3 py-1 text-sm bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full transition">
                                Sick Day
                            </button>
                        </div>
                    </div>
                </div>

                <div class="mt-8 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                    <div class="flex">
                        <svg class="h-5 w-5 text-yellow-600 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                        </svg>
                        <div class="text-sm text-yellow-700">
                            <p class="font-medium">Note:</p>
                            <p>If there are already scheduled classes during this period, you'll need to reschedule them manually. You'll be notified if any conflicts exist.</p>
                        </div>
                    </div>
                </div>

                <div class="mt-6 flex justify-end space-x-3">
                    <a asp-action="BlockedDates" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium py-2 px-4 rounded-md transition">
                        Cancel
                    </a>
                    <button type="submit" class="bg-primary-600 hover:bg-primary-700 text-white font-medium py-2 px-4 rounded-md transition">
                        Block Dates
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
