@model LakeCountrySpanish.Web.Models.ViewModels.ManageTimeSlotsViewModel
@{
    ViewData["Title"] = "Time Slots";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8 flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Time Slots</h1>
                <p class="mt-2 text-gray-600">Manage your available teaching hours.</p>
            </div>
            <a asp-action="CreateTimeSlot" class="bg-primary-600 hover:bg-primary-700 text-white rounded-lg px-4 py-2 font-medium transition">
                Add Time Slot
            </a>
        </div>

        <div class="bg-white rounded-lg shadow">
            @if (Model.TimeSlots.Any())
            {
                <div class="divide-y divide-gray-200">
                    @foreach (var item in Model.TimeSlots)
                    {
                        <div class="p-6 flex items-center justify-between">
                            <div>
                                <p class="font-medium text-gray-900">
                                    @if (item.TimeSlot.IsRecurring && item.TimeSlot.DayOfWeek.HasValue)
                                    {
                                        <span>Every @item.TimeSlot.DayOfWeek.Value</span>
                                    }
                                    else if (item.TimeSlot.SpecificDate.HasValue)
                                    {
                                        <span>@item.TimeSlot.SpecificDate.Value.ToString("MMMM d, yyyy")</span>
                                    }
                                </p>
                                <p class="text-sm text-gray-500">
                                    @(DateTime.Today.Add(item.TimeSlot.StartTime).ToString("h:mm tt")) - @(DateTime.Today.Add(item.TimeSlot.EndTime).ToString("h:mm tt"))
                                </p>
                                @if (item.ScheduledStudentCount > 0)
                                {
                                    <p class="text-sm text-blue-600 mt-1">
                                        <svg class="inline h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
                                        </svg>
                                        @item.ScheduledStudentCount student@(item.ScheduledStudentCount != 1 ? "s" : "") scheduled
                                    </p>
                                }
                            </div>
                            <div class="flex items-center space-x-4">
                                @if (item.TimeSlot.IsActive)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Active</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">Inactive</span>
                                }
                                @if (item.TimeSlot.IsActive)
                                {
                                    @if (item.CanDelete)
                                    {
                                        <form asp-action="DeleteTimeSlot" method="post">
                                            <input type="hidden" name="id" value="@item.TimeSlot.Id" />
                                            <button type="submit" class="text-red-600 hover:text-red-800 text-sm font-medium"
                                                    onclick="return confirm('Are you sure you want to delete this time slot? This action cannot be undone.')">
                                                Delete
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="DeactivateTimeSlot" method="post">
                                            <input type="hidden" name="id" value="@item.TimeSlot.Id" />
                                            <button type="submit" class="text-amber-600 hover:text-amber-800 text-sm font-medium"
                                                    onclick="return confirm('This time slot has @item.ScheduledStudentCount scheduled class(es). Deactivating will prevent new bookings but keep existing classes. Continue?')">
                                                Deactivate
                                            </button>
                                        </form>
                                    }
                                }
                                else
                                {
                                    <form asp-action="ReactivateTimeSlot" method="post">
                                        <input type="hidden" name="id" value="@item.TimeSlot.Id" />
                                        <button type="submit" class="text-green-600 hover:text-green-800 text-sm font-medium">
                                            Reactivate
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="p-12 text-center">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <p class="mt-2 text-gray-500">No time slots configured</p>
                    <a asp-action="CreateTimeSlot" class="mt-4 inline-flex items-center text-primary-600 hover:text-primary-700 font-medium">
                        Add your first time slot
                    </a>
                </div>
            }
        </div>
    </div>
</div>
