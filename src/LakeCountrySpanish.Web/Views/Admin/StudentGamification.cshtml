@model LakeCountrySpanish.Web.Models.ViewModels.StudentGamificationSummaryViewModel
@{
    ViewData["Title"] = $"Gamification - {Model.StudentName}";
}

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">@Model.StudentName</h1>
            <p class="text-gray-500">@Model.Email</p>
        </div>
        <div class="flex space-x-2">
            <a asp-action="AwardBadge" asp-route-studentId="@Model.StudentId" class="inline-flex items-center px-4 py-2 border border-indigo-600 text-indigo-600 rounded-md hover:bg-indigo-50 text-sm font-medium">
                Award Badge
            </a>
            <a asp-action="AdjustPoints" asp-route-studentId="@Model.StudentId" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                Adjust Points
            </a>
            <a asp-action="StudentProfile" asp-route-id="@Model.StudentId" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                View Profile
            </a>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-indigo-600 rounded-lg shadow p-4 text-center text-white">
            <p class="text-3xl font-bold">@Model.TotalPoints.ToString("N0")</p>
            <p class="text-sm opacity-90">Total Points</p>
        </div>
        <div class="bg-green-600 rounded-lg shadow p-4 text-center text-white">
            <p class="text-3xl font-bold">@Model.CurrentStreak / @Model.LongestStreak</p>
            <p class="text-sm opacity-90">Current / Best Streak</p>
        </div>
        <div class="bg-yellow-500 rounded-lg shadow p-4 text-center text-white">
            <p class="text-3xl font-bold">@Model.BadgesEarned</p>
            <p class="text-sm opacity-90">Badges Earned</p>
        </div>
        <div class="bg-cyan-600 rounded-lg shadow p-4 text-center text-white">
            <p class="text-3xl font-bold">@Model.TokensEarnedFromPoints</p>
            <p class="text-sm opacity-90">Tokens from Points</p>
        </div>
    </div>

    <!-- Multiplier Status -->
    <div class="bg-white rounded-lg shadow mb-6">
        <div class="p-4 flex justify-between items-center">
            <div>
                <h2 class="font-semibold text-gray-900">Points Multiplier</h2>
                <p class="text-sm text-gray-500">
                    @if (Model.HasActiveSubscription)
                    {
                        <span class="text-green-600">Active Subscriber - @Model.PointsMultiplier.ToString("0.0")x multiplier on all points</span>
                    }
                    else
                    {
                        <span>Standard rate (1.0x) - Subscribe for 1.5x bonus</span>
                    }
                </p>
            </div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-lg font-bold @(Model.HasActiveSubscription ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800")">
                @Model.PointsMultiplier.ToString("0.0")x
            </span>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Recent Badges -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-900">Recent Badges</h2>
            </div>
            <div class="p-6">
                @if (!Model.RecentBadges.Any())
                {
                    <p class="text-gray-500">No badges earned yet.</p>
                }
                else
                {
                    <ul class="divide-y divide-gray-200">
                        @foreach (var badge in Model.RecentBadges)
                        {
                            <li class="py-3 flex justify-between items-center">
                                <div class="flex items-center">
                                    @if (!string.IsNullOrEmpty(badge.Badge?.IconUrl))
                                    {
                                        <img src="@badge.Badge.IconUrl" alt="" class="w-6 h-6 mr-3">
                                    }
                                    else
                                    {
                                        <span class="mr-3 text-xl">🏆</span>
                                    }
                                    <span class="font-medium text-gray-900">@badge.Badge?.Name</span>
                                </div>
                                <span class="text-sm text-gray-500">@badge.EarnedAt.ToString("MMM d, yyyy")</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <!-- Recent Points -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-900">Recent Point Activity</h2>
            </div>
            @if (!Model.RecentPoints.Any())
            {
                <div class="p-6">
                    <p class="text-gray-500">No point activity yet.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Source</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Points</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            @foreach (var point in Model.RecentPoints)
                            {
                                <tr class="hover:bg-gray-50">
                                    <td class="px-6 py-3 text-sm text-gray-500">@point.CreatedAt.ToString("MMM d")</td>
                                    <td class="px-6 py-3 text-sm text-gray-900">
                                        @point.Source
                                        @if (point.Multiplier > 1)
                                        {
                                            <span class="ml-1 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-cyan-100 text-cyan-800">@point.Multiplier.ToString("0.0")x</span>
                                        }
                                    </td>
                                    <td class="px-6 py-3 text-right text-sm font-medium @(point.FinalPoints >= 0 ? "text-green-600" : "text-red-600")">
                                        @(point.FinalPoints >= 0 ? "+" : "")@point.FinalPoints
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="mt-6">
        <a asp-action="Students" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to Students
        </a>
    </div>
</div>
