@model LakeCountrySpanish.Web.Models.ViewModels.StudentGamificationSummaryViewModel
@{
    ViewData["Title"] = $"Gamification - {Model.StudentName}";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0">@Model.StudentName</h1>
            <p class="text-muted mb-0">@Model.Email</p>
        </div>
        <div class="btn-group">
            <a asp-action="AwardBadge" asp-route-studentId="@Model.StudentId" class="btn btn-outline-primary">
                Award Badge
            </a>
            <a asp-action="AdjustPoints" asp-route-studentId="@Model.StudentId" class="btn btn-outline-secondary">
                Adjust Points
            </a>
            <a asp-action="StudentProfile" asp-route-id="@Model.StudentId" class="btn btn-outline-info">
                View Profile
            </a>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white h-100">
                <div class="card-body text-center">
                    <h3 class="display-5">@Model.TotalPoints.ToString("N0")</h3>
                    <p class="mb-0">Total Points</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white h-100">
                <div class="card-body text-center">
                    <h3 class="display-5">@Model.CurrentStreak / @Model.LongestStreak</h3>
                    <p class="mb-0">Current / Best Streak</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark h-100">
                <div class="card-body text-center">
                    <h3 class="display-5">@Model.BadgesEarned</h3>
                    <p class="mb-0">Badges Earned</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white h-100">
                <div class="card-body text-center">
                    <h3 class="display-5">@Model.TokensEarnedFromPoints</h3>
                    <p class="mb-0">Tokens from Points</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Multiplier Status -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="mb-0">Points Multiplier</h5>
                    <p class="text-muted mb-0">
                        @if (Model.HasActiveSubscription)
                        {
                            <span class="text-success">Active Subscriber - @Model.PointsMultiplier.ToString("0.0")x multiplier on all points</span>
                        }
                        else
                        {
                            <span>Standard rate (1.0x) - Subscribe for 1.5x bonus</span>
                        }
                    </p>
                </div>
                <div class="col-auto">
                    <span class="badge bg-@(Model.HasActiveSubscription ? "success" : "secondary") fs-5">
                        @Model.PointsMultiplier.ToString("0.0")x
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Recent Badges -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Recent Badges</h5>
                </div>
                <div class="card-body">
                    @if (!Model.RecentBadges.Any())
                    {
                        <p class="text-muted mb-0">No badges earned yet.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var badge in Model.RecentBadges)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        @if (!string.IsNullOrEmpty(badge.Badge?.IconUrl))
                                        {
                                            <img src="@badge.Badge.IconUrl" alt="" style="width: 24px; height: 24px;" class="me-2">
                                        }
                                        else
                                        {
                                            <span class="me-2">🏆</span>
                                        }
                                        <strong>@badge.Badge?.Name</strong>
                                    </div>
                                    <small class="text-muted">@badge.EarnedAt.ToString("MMM d, yyyy")</small>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Points -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Recent Point Activity</h5>
                </div>
                <div class="card-body p-0">
                    @if (!Model.RecentPoints.Any())
                    {
                        <p class="text-muted p-3 mb-0">No point activity yet.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Source</th>
                                        <th class="text-end">Points</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var point in Model.RecentPoints)
                                    {
                                        <tr>
                                            <td>@point.CreatedAt.ToString("MMM d")</td>
                                            <td>
                                                @point.Source
                                                @if (point.Multiplier > 1)
                                                {
                                                    <span class="badge bg-info">@point.Multiplier.ToString("0.0")x</span>
                                                }
                                            </td>
                                            <td class="text-end @(point.FinalPoints >= 0 ? "text-success" : "text-danger")">
                                                @(point.FinalPoints >= 0 ? "+" : "")@point.FinalPoints
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Students" class="btn btn-outline-secondary">Back to Students</a>
    </div>
</div>
