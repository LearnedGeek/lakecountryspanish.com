@model LakeCountrySpanish.Web.Models.ViewModels.EditStudentViewModel
@{
    ViewData["Title"] = "Edit Student";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-2xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a asp-action="Students" class="text-primary-600 hover:text-primary-700 flex items-center text-sm mb-4">
                <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
                Back to Students
            </a>
            <h1 class="text-3xl font-bold text-gray-900">Edit Student</h1>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <form asp-action="EditStudent" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6"></div>

                <div class="space-y-6">
                    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                        <div>
                            <label asp-for="FirstName" class="block text-sm font-medium text-gray-700"></label>
                            <input asp-for="FirstName" type="text" required
                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border" />
                            <span asp-validation-for="FirstName" class="text-red-500 text-sm"></span>
                        </div>

                        <div>
                            <label asp-for="LastName" class="block text-sm font-medium text-gray-700"></label>
                            <input asp-for="LastName" type="text" required
                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border" />
                            <span asp-validation-for="LastName" class="text-red-500 text-sm"></span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="Email" class="block text-sm font-medium text-gray-700"></label>
                        <input asp-for="Email" type="email" required
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border" />
                        <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="CustomHourlyRate" class="block text-sm font-medium text-gray-700"></label>
                        <div class="mt-1 relative rounded-md shadow-sm">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <span class="text-gray-500 sm:text-sm">$</span>
                            </div>
                            <input asp-for="CustomHourlyRate" type="number" step="0.01" min="0"
                                   class="block w-full pl-7 rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border"
                                   placeholder="Leave blank for default rate" />
                        </div>
                        <span asp-validation-for="CustomHourlyRate" class="text-red-500 text-sm"></span>
                    </div>

                    <div class="flex items-center">
                        <input asp-for="IsActive" type="checkbox"
                               class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
                        <label asp-for="IsActive" class="ml-2 block text-sm text-gray-900"></label>
                    </div>

                    <div class="border-t border-gray-200 pt-6">
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Change Password</h3>
                        <div>
                            <label asp-for="NewPassword" class="block text-sm font-medium text-gray-700"></label>
                            <input asp-for="NewPassword" type="password"
                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border" />
                            <span asp-validation-for="NewPassword" class="text-red-500 text-sm"></span>
                        </div>
                    </div>
                </div>

                <div class="mt-8">
                    <button type="submit"
                            class="w-full flex justify-center rounded-md bg-primary-600 py-3 px-4 text-sm font-semibold text-white hover:bg-primary-700 transition">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
