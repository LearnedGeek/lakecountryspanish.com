@model LakeCountrySpanish.Web.Models.ViewModels.ManageCreditsViewModel
@{
    ViewData["Title"] = "Manage Credits";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
        @await Component.InvokeAsync("PageHeader", new {
            title = "Manage Credits",
            subtitle = Model.StudentName + " (" + Model.StudentEmail + ")",
            backUrl = Url.Action("Students"),
            backText = "Back to Students"
        })

        @if (TempData["SuccessMessage"] != null)
        {
            @await Component.InvokeAsync("Alert", new {
                type = "success",
                message = TempData["SuccessMessage"]!.ToString()
            })
        }

        @if (TempData["ErrorMessage"] != null)
        {
            @await Component.InvokeAsync("Alert", new {
                type = "error",
                message = TempData["ErrorMessage"]!.ToString()
            })
        }

        <!-- Current Credits Summary -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
            @await Component.InvokeAsync("StatCard", new {
                value = Model.TotalCreditsRemaining.ToString(),
                label = "Total Credits Remaining",
                color = "success",
                icon = "currency"
            })
        </div>

        <!-- Add Credits Form -->
        <div class="bg-white rounded-lg shadow p-6 mb-8">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Add Credits</h2>
            <form asp-action="AddCredits" method="post">
                <input type="hidden" name="studentId" value="@Model.StudentId" />
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label for="credits" class="block text-sm font-medium text-gray-700 mb-1">Number of Credits</label>
                        <input type="number" name="credits" id="credits" min="1" value="1" required
                               class="block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500" />
                    </div>
                    <div>
                        <label for="reason" class="block text-sm font-medium text-gray-700 mb-1">Reason</label>
                        <input type="text" name="reason" id="reason" required placeholder="e.g., Makeup class, bonus, etc."
                               class="block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500" />
                    </div>
                    <div class="flex items-end">
                        @await Component.InvokeAsync("Button", new {
                            text = "Add Credits",
                            type = "success",
                            cssClass = "w-full justify-center"
                        })
                    </div>
                </div>
            </form>
        </div>

        <!-- Package History -->
        <div class="bg-white rounded-lg shadow">
            <div class="p-6 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-900">Credit History</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Package</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Credits Remaining</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var package in Model.StudentPackages)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    @package.PurchaseDate.ToString("MMM d, yyyy")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    @package.Package.Name
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @await Component.InvokeAsync("StatusBadge", new {
                                        text = package.ClassesRemaining + " / " + package.Package.ClassCount,
                                        color = package.ClassesRemaining > 0 ? "green" : "gray"
                                    })
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    @if (package.PaymentId.HasValue)
                                    {
                                        @await Component.InvokeAsync("StatusBadge", new { text = "Paid", color = "green" })
                                    }
                                    else
                                    {
                                        <span class="text-gray-500">Admin Granted</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <button type="button" onclick="showAdjustModal(@package.Id, @package.ClassesRemaining)"
                                            class="text-primary-600 hover:text-primary-700 font-medium">
                                        Adjust
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!Model.StudentPackages.Any())
                        {
                            <tr>
                                <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                                    No credit history found for this student.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Adjust Credits Modal -->
<div id="adjustModal" class="fixed inset-0 bg-gray-500 bg-opacity-75 hidden flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full mx-4">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Adjust Credits</h3>
        <form asp-action="AdjustPackageCredits" method="post">
            <input type="hidden" name="packageId" id="adjustPackageId" />
            <div class="space-y-4">
                <div>
                    <label for="newCredits" class="block text-sm font-medium text-gray-700 mb-1">New Credit Amount</label>
                    <input type="number" name="newCredits" id="newCredits" min="0" required
                           class="block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500" />
                </div>
                <div>
                    <label for="adjustReason" class="block text-sm font-medium text-gray-700 mb-1">Reason for Adjustment</label>
                    <input type="text" name="reason" id="adjustReason" required placeholder="e.g., Correction, refund, etc."
                           class="block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500" />
                </div>
            </div>
            <div class="mt-6 flex justify-end space-x-3">
                @await Component.InvokeAsync("Button", new { text = "Cancel", type = "secondary", onclick = "hideAdjustModal()" })
                @await Component.InvokeAsync("Button", new { text = "Save Changes", type = "primary" })
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function showAdjustModal(packageId, currentCredits) {
            document.getElementById('adjustPackageId').value = packageId;
            document.getElementById('newCredits').value = currentCredits;
            document.getElementById('adjustModal').classList.remove('hidden');
        }

        function hideAdjustModal() {
            document.getElementById('adjustModal').classList.add('hidden');
        }
    </script>
}
