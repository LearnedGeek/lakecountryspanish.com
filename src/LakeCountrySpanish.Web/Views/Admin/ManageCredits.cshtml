@model LakeCountrySpanish.Web.Models.ViewModels.ManageCreditsViewModel
@{
    ViewData["Title"] = "Manage Credits";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a asp-action="Students" class="text-primary-600 hover:text-primary-700 flex items-center text-sm mb-4">
                <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
                Back to Students
            </a>
            <h1 class="text-3xl font-bold text-gray-900">Manage Credits</h1>
            <p class="mt-2 text-gray-600">@Model.StudentName (@Model.StudentEmail)</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- Current Credits Summary -->
        <div class="bg-white rounded-lg shadow p-6 mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Total Credits Remaining</p>
                    <p class="text-4xl font-bold text-gray-900">@Model.TotalCreditsRemaining</p>
                </div>
                <div class="flex-shrink-0 p-4 bg-green-100 rounded-full">
                    <svg class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Add Credits Form -->
        <div class="bg-white rounded-lg shadow p-6 mb-8">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Add Credits</h2>
            <form asp-action="AddCredits" method="post">
                <input type="hidden" name="studentId" value="@Model.StudentId" />
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label for="credits" class="block text-sm font-medium text-gray-700 mb-1">Number of Credits</label>
                        <input type="number" name="credits" id="credits" min="1" value="1" required
                               class="block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500" />
                    </div>
                    <div>
                        <label for="reason" class="block text-sm font-medium text-gray-700 mb-1">Reason</label>
                        <input type="text" name="reason" id="reason" required placeholder="e.g., Makeup class, bonus, etc."
                               class="block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500" />
                    </div>
                    <div class="flex items-end">
                        <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-md transition">
                            Add Credits
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Package History -->
        <div class="bg-white rounded-lg shadow">
            <div class="p-6 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-900">Credit History</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Package</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Credits Remaining</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var package in Model.StudentPackages)
                        {
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    @package.PurchaseDate.ToString("MMM d, yyyy")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    @package.Package.Name
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @(package.ClassesRemaining > 0 ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800")">
                                        @package.ClassesRemaining / @package.Package.ClassCount
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    @if (package.PaymentId.HasValue)
                                    {
                                        <span class="text-green-600">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-500">Admin Granted</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <button type="button" onclick="showAdjustModal(@package.Id, @package.ClassesRemaining)"
                                            class="text-primary-600 hover:text-primary-700 font-medium">
                                        Adjust
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!Model.StudentPackages.Any())
                        {
                            <tr>
                                <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                                    No credit history found for this student.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Adjust Credits Modal -->
<div id="adjustModal" class="fixed inset-0 bg-gray-500 bg-opacity-75 hidden flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full mx-4">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Adjust Credits</h3>
        <form asp-action="AdjustPackageCredits" method="post">
            <input type="hidden" name="packageId" id="adjustPackageId" />
            <div class="space-y-4">
                <div>
                    <label for="newCredits" class="block text-sm font-medium text-gray-700 mb-1">New Credit Amount</label>
                    <input type="number" name="newCredits" id="newCredits" min="0" required
                           class="block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500" />
                </div>
                <div>
                    <label for="adjustReason" class="block text-sm font-medium text-gray-700 mb-1">Reason for Adjustment</label>
                    <input type="text" name="reason" id="adjustReason" required placeholder="e.g., Correction, refund, etc."
                           class="block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500" />
                </div>
            </div>
            <div class="mt-6 flex justify-end space-x-3">
                <button type="button" onclick="hideAdjustModal()"
                        class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium py-2 px-4 rounded-md transition">
                    Cancel
                </button>
                <button type="submit"
                        class="bg-primary-600 hover:bg-primary-700 text-white font-medium py-2 px-4 rounded-md transition">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function showAdjustModal(packageId, currentCredits) {
            document.getElementById('adjustPackageId').value = packageId;
            document.getElementById('newCredits').value = currentCredits;
            document.getElementById('adjustModal').classList.remove('hidden');
        }

        function hideAdjustModal() {
            document.getElementById('adjustModal').classList.add('hidden');
        }
    </script>
}
