@model LakeCountrySpanish.Web.Models.ViewModels.TimeSlotViewModel
@{
    ViewData["Title"] = "Add Time Slot";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-2xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a asp-action="TimeSlots" class="text-primary-600 hover:text-primary-700 flex items-center text-sm mb-4">
                <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
                Back to Time Slots
            </a>
            <h1 class="text-3xl font-bold text-gray-900">Add Time Slot</h1>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <form asp-action="CreateTimeSlot" method="post">
                <div asp-validation-summary="ModelOnly" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6"></div>

                <div class="space-y-6">
                    <div class="flex items-center">
                        <input asp-for="IsRecurring" type="checkbox" checked
                               class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500"
                               onchange="toggleRecurring(this.checked)" />
                        <label asp-for="IsRecurring" class="ml-2 block text-sm text-gray-900"></label>
                    </div>

                    <div id="recurringSection">
                        <label asp-for="DayOfWeek" class="block text-sm font-medium text-gray-700"></label>
                        <select asp-for="DayOfWeek" asp-items="Html.GetEnumSelectList<DayOfWeek>()"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border">
                            <option value="">Select a day</option>
                        </select>
                        <span asp-validation-for="DayOfWeek" class="text-red-500 text-sm"></span>
                    </div>

                    <div id="specificDateSection" class="hidden">
                        <label asp-for="SpecificDate" class="block text-sm font-medium text-gray-700"></label>
                        <input asp-for="SpecificDate" type="date"
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border" />
                        <span asp-validation-for="SpecificDate" class="text-red-500 text-sm"></span>
                    </div>

                    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                        <div>
                            <label asp-for="StartTime" class="block text-sm font-medium text-gray-700"></label>
                            <input asp-for="StartTime" type="time" required
                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border" />
                            <span asp-validation-for="StartTime" class="text-red-500 text-sm"></span>
                        </div>

                        <div>
                            <label asp-for="EndTime" class="block text-sm font-medium text-gray-700"></label>
                            <input asp-for="EndTime" type="time" required
                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border" />
                            <span asp-validation-for="EndTime" class="text-red-500 text-sm"></span>
                        </div>
                    </div>

                    <div class="flex items-center">
                        <input asp-for="IsActive" type="checkbox" checked
                               class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
                        <label asp-for="IsActive" class="ml-2 block text-sm text-gray-900"></label>
                    </div>
                </div>

                <div class="mt-8">
                    <button type="submit"
                            class="w-full flex justify-center rounded-md bg-primary-600 py-3 px-4 text-sm font-semibold text-white hover:bg-primary-700 transition">
                        Create Time Slot
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleRecurring(isRecurring) {
            document.getElementById('recurringSection').classList.toggle('hidden', !isRecurring);
            document.getElementById('specificDateSection').classList.toggle('hidden', isRecurring);
        }
    </script>
}
