@model LakeCountrySpanish.Web.Models.ViewModels.UploadDocumentViewModel
@{
    ViewData["Title"] = "Upload Document";
    var students = ViewBag.Students as IEnumerable<LakeCountrySpanish.Web.Models.Entities.ApplicationUser>;
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-2xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a asp-action="Documents" class="text-primary-600 hover:text-primary-700 flex items-center text-sm mb-4">
                <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
                Back to Documents
            </a>
            <h1 class="text-3xl font-bold text-gray-900">Upload Document</h1>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <form asp-action="UploadDocument" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6"></div>

                <div class="space-y-6">
                    <div>
                        <label asp-for="Title" class="block text-sm font-medium text-gray-700"></label>
                        <input asp-for="Title" type="text" required
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border" />
                        <span asp-validation-for="Title" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="File" class="block text-sm font-medium text-gray-700"></label>
                        <input asp-for="File" type="file" required
                               class="mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-primary-50 file:text-primary-700 hover:file:bg-primary-100" />
                        <span asp-validation-for="File" class="text-red-500 text-sm"></span>
                    </div>

                    <div class="flex items-center">
                        <input asp-for="IsGlobal" type="checkbox"
                               class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500"
                               onchange="toggleStudentSelection(this.checked)" />
                        <label asp-for="IsGlobal" class="ml-2 block text-sm text-gray-900"></label>
                    </div>

                    <div id="studentSelection">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Assign to Students</label>
                        <div class="max-h-48 overflow-y-auto border border-gray-200 rounded-md p-2">
                            @if (students != null)
                            {
                                @foreach (var student in students)
                                {
                                    <label class="flex items-center py-2 px-2 hover:bg-gray-50 rounded">
                                        <input type="checkbox" name="SelectedStudentIds" value="@student.Id"
                                               class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
                                        <span class="ml-2 text-sm text-gray-700">@student.FullName</span>
                                    </label>
                                }
                            }
                        </div>
                        <p class="mt-1 text-sm text-gray-500">Leave empty to not assign to anyone initially.</p>
                    </div>
                </div>

                <div class="mt-8">
                    <button type="submit"
                            class="w-full flex justify-center rounded-md bg-primary-600 py-3 px-4 text-sm font-semibold text-white hover:bg-primary-700 transition">
                        Upload Document
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleStudentSelection(isGlobal) {
            document.getElementById('studentSelection').classList.toggle('hidden', isGlobal);
        }
    </script>
}
