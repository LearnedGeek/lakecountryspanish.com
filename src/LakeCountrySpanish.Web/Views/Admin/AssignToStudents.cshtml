@model LakeCountrySpanish.Web.Models.ViewModels.AssignToStudentsViewModel
@{
    ViewData["Title"] = "Assign to Students";
}

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-900">
            <svg class="w-8 h-8 inline-block mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            Assign to Students
        </h1>
        <a asp-action="Assignments" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
            @TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Assignment Info -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-lg shadow">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h2 class="text-lg font-semibold text-gray-900">Assignment</h2>
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-900">@Model.AssignmentTitle</h3>
                    @if (!string.IsNullOrEmpty(Model.AssignmentDescription))
                    {
                        <p class="mt-2 text-gray-600">@Model.AssignmentDescription</p>
                    }
                    <div class="mt-4 flex flex-wrap gap-2">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
                            @Model.CefrLevel
                        </span>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                            @Model.AssignmentType
                        </span>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                            @Model.TotalPoints pts
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Student Selection -->
        <div class="lg:col-span-2">
            <form asp-action="AssignToStudents" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="AssignmentId" />

                <div class="bg-white rounded-lg shadow mb-6">
                    <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                        <h2 class="text-lg font-semibold text-gray-900">Select Students</h2>
                        <div class="flex space-x-2">
                            <button type="button" onclick="selectAll()" class="inline-flex items-center px-3 py-1.5 border border-indigo-600 text-xs font-medium rounded text-indigo-600 bg-white hover:bg-indigo-50">
                                Select All
                            </button>
                            <button type="button" onclick="deselectAll()" class="inline-flex items-center px-3 py-1.5 border border-gray-300 text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50">
                                Deselect All
                            </button>
                        </div>
                    </div>
                    <div class="p-6">
                        @if (!Model.AvailableStudents.Any())
                        {
                            <div class="text-center py-8">
                                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                                </svg>
                                <p class="mt-2 text-gray-500">No students available</p>
                            </div>
                        }
                        else
                        {
                            <div class="overflow-x-auto">
                                <table class="min-w-full divide-y divide-gray-200">
                                    <thead class="bg-gray-50">
                                        <tr>
                                            <th class="w-12 px-4 py-3"></th>
                                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Student</th>
                                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Level</th>
                                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="bg-white divide-y divide-gray-200">
                                        @foreach (var student in Model.AvailableStudents)
                                        {
                                            <tr class="@(student.AlreadyAssigned ? "bg-gray-50" : "hover:bg-gray-50")">
                                                <td class="px-4 py-3">
                                                    <input type="checkbox" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded student-checkbox"
                                                           name="SelectedStudentIds" value="@student.Id"
                                                           @(student.AlreadyAssigned ? "disabled checked" : "") />
                                                </td>
                                                <td class="px-4 py-3">
                                                    <div class="font-medium text-gray-900">@student.Name</div>
                                                    <div class="text-sm text-gray-500">@student.Email</div>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                                        @(student.CefrLevel ?? "N/A")
                                                    </span>
                                                </td>
                                                <td class="px-4 py-3">
                                                    @if (student.AlreadyAssigned)
                                                    {
                                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                                            Already Assigned
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-sm text-gray-500">Available</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow mb-6">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h2 class="text-lg font-semibold text-gray-900">Assignment Options</h2>
                    </div>
                    <div class="p-6">
                        <div class="max-w-sm">
                            <label asp-for="DueDate" class="block text-sm font-medium text-gray-700 mb-1">Due Date (Optional)</label>
                            <input asp-for="DueDate" type="datetime-local" class="w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
                            <p class="mt-1 text-sm text-gray-500">Leave empty for no deadline</p>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end space-x-3">
                    <a asp-action="Assignments" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                        Cancel
                    </a>
                    <button type="submit" class="inline-flex items-center px-6 py-3 border border-transparent rounded-md shadow-sm text-base font-medium text-white bg-green-600 hover:bg-green-700">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                        </svg>
                        Assign to Selected Students
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function selectAll() {
        document.querySelectorAll('.student-checkbox:not(:disabled)').forEach(cb => cb.checked = true);
    }

    function deselectAll() {
        document.querySelectorAll('.student-checkbox:not(:disabled)').forEach(cb => cb.checked = false);
    }
</script>
