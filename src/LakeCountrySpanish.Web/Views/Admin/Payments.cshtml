@model LakeCountrySpanish.Web.Models.ViewModels.AdminPaymentsViewModel
@{
    ViewData["Title"] = "Payments";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        @await Component.InvokeAsync("PageHeader", new {
            title = "Payments",
            subtitle = "Track all student payments."
        })

        <!-- Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
            @await Component.InvokeAsync("StatCard", new {
                value = "$" + Model.TotalRevenue.ToString("0.00"),
                label = "Total Revenue (filtered)",
                color = "success"
            })
            @await Component.InvokeAsync("StatCard", new {
                value = "$" + Model.PendingPayments.ToString("0.00"),
                label = "Pending Payments",
                color = "warning"
            })
        </div>

        <!-- Filters -->
        <div class="bg-white rounded-lg shadow p-4 mb-6">
            <form asp-action="Payments" method="get" class="flex flex-wrap gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Start Date</label>
                    <input type="date" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")"
                           class="rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">End Date</label>
                    <input type="date" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")"
                           class="rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Student</label>
                    <select name="studentId" class="rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-4 py-2 border">
                        <option value="">All Students</option>
                        @foreach (var student in Model.Students)
                        {
                            <option value="@student.Id" selected="@(Model.StudentId == student.Id)">@student.FullName</option>
                        }
                    </select>
                </div>
                <div class="flex items-end">
                    @await Component.InvokeAsync("Button", new {
                        text = "Filter",
                        type = "secondary"
                    })
                </div>
            </form>
        </div>

        <!-- Payments List -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Student</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var payment in Model.Payments)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <p class="text-sm text-gray-900">@payment.CreatedAt.ToString("MMM d, yyyy")</p>
                                <p class="text-xs text-gray-500">@payment.CreatedAt.ToString("h:mm tt")</p>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <a asp-action="StudentProfile" asp-route-id="@payment.StudentId" class="text-sm text-primary-600 hover:text-primary-700 hover:underline">@payment.Student.FullName</a>
                            </td>
                            <td class="px-6 py-4">
                                <p class="text-sm text-gray-900">@payment.Description</p>
                                <p class="text-xs text-gray-500">@payment.PaymentType</p>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <p class="text-sm font-medium text-gray-900">$@payment.Amount.ToString("0.00")</p>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @{
                                    var statusColor = payment.Status == LakeCountrySpanish.Web.Models.Entities.PaymentStatusType.Completed ? "green" :
                                                      payment.Status == LakeCountrySpanish.Web.Models.Entities.PaymentStatusType.Pending ? "yellow" :
                                                      payment.Status == LakeCountrySpanish.Web.Models.Entities.PaymentStatusType.Failed ? "red" : "gray";
                                }
                                @await Component.InvokeAsync("StatusBadge", new { text = payment.Status.ToString(), color = statusColor })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Payments.Any())
            {
                @await Component.InvokeAsync("EmptyState", new {
                    title = "No payments found",
                    icon = "document"
                })
            }
        </div>
    </div>
</div>
