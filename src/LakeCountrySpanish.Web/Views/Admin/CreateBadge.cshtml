@model LakeCountrySpanish.Web.Models.ViewModels.BadgeEditViewModel
@using LakeCountrySpanish.Web.Models.Entities
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit Badge" : "Create Badge";
}

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    @await Component.InvokeAsync("PageHeader", new {
        title = isEdit ? "Edit Badge" : "Create Badge",
        backUrl = Url.Action("Badges")
    })

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2">
            <div class="bg-white rounded-lg shadow">
                <div class="p-6">
                    @await Html.PartialAsync("_BadgeForm", Model)
                </div>
            </div>
        </div>
        <div class="lg:col-span-1">
            <div class="bg-white rounded-lg shadow">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h2 class="text-lg font-semibold text-gray-900">Requirement Types</h2>
                </div>
                <div class="p-6">
                    <dl class="space-y-3">
                        <div>
                            <dt class="font-medium text-gray-900">Points</dt>
                            <dd class="text-sm text-gray-500">Earn X total points</dd>
                        </div>
                        <div>
                            <dt class="font-medium text-gray-900">Streak</dt>
                            <dd class="text-sm text-gray-500">Maintain X-day activity streak</dd>
                        </div>
                        <div>
                            <dt class="font-medium text-gray-900">ClassesCompleted</dt>
                            <dd class="text-sm text-gray-500">Complete X classes</dd>
                        </div>
                        <div>
                            <dt class="font-medium text-gray-900">PerfectScores</dt>
                            <dd class="text-sm text-gray-500">Get X perfect scores on assignments</dd>
                        </div>
                        <div>
                            <dt class="font-medium text-gray-900">TopicAssignments</dt>
                            <dd class="text-sm text-gray-500">Complete X assignments in a topic (use context)</dd>
                        </div>
                        <div>
                            <dt class="font-medium text-gray-900">CefrLevel</dt>
                            <dd class="text-sm text-gray-500">Reach CEFR level (use context for level)</dd>
                        </div>
                        <div>
                            <dt class="font-medium text-gray-900">Custom</dt>
                            <dd class="text-sm text-gray-500">Manually awarded by admin</dd>
                        </div>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
