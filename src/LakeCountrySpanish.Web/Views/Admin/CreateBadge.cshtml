@model LakeCountrySpanish.Web.Models.ViewModels.BadgeEditViewModel
@using LakeCountrySpanish.Web.Models.Entities
@{
    ViewData["Title"] = "Create Badge";
}

<div class="container py-4">
    <h1 class="mb-4">Create Badge</h1>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <form method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Badge Name</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g., First Steps" required>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="2"
                                      placeholder="e.g., Complete your first lesson" required></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IconUrl" class="form-label">Icon URL (optional)</label>
                            <input asp-for="IconUrl" class="form-control" placeholder="https://example.com/badge-icon.png">
                            <div class="form-text">Leave empty to use the default trophy icon.</div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Category" class="form-label">Category</label>
                                <select asp-for="Category" class="form-select" required>
                                    @foreach (BadgeCategory cat in Enum.GetValues(typeof(BadgeCategory)))
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="RequirementType" class="form-label">Requirement Type</label>
                                <select asp-for="RequirementType" class="form-select" required>
                                    @foreach (BadgeRequirementType req in Enum.GetValues(typeof(BadgeRequirementType)))
                                    {
                                        <option value="@req">@req</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="RequirementValue" class="form-label">Requirement Value</label>
                                <input asp-for="RequirementValue" type="number" class="form-control" min="0" required>
                                <div class="form-text">e.g., 100 for "Earn 100 points"</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="RequirementContext" class="form-label">Requirement Context (optional)</label>
                                <input asp-for="RequirementContext" class="form-control" placeholder="e.g., Grammar, A2">
                                <div class="form-text">Additional context for topic-specific badges.</div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="BonusPoints" class="form-label">Bonus Points</label>
                                <input asp-for="BonusPoints" type="number" class="form-control" min="0">
                                <div class="form-text">Points awarded when badge is earned.</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="DisplayOrder" class="form-label">Display Order</label>
                                <input asp-for="DisplayOrder" type="number" class="form-control" min="0">
                                <div class="form-text">Lower numbers display first.</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox">
                                <label asp-for="IsActive" class="form-check-label">Active</label>
                            </div>
                            <div class="form-text">Inactive badges won't be awarded to new students.</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Create Badge</button>
                            <a asp-action="Badges" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Requirement Types</h5>
                </div>
                <div class="card-body">
                    <dl class="mb-0">
                        <dt>Points</dt>
                        <dd class="text-muted">Earn X total points</dd>

                        <dt>Streak</dt>
                        <dd class="text-muted">Maintain X-day activity streak</dd>

                        <dt>ClassesCompleted</dt>
                        <dd class="text-muted">Complete X classes</dd>

                        <dt>PerfectScores</dt>
                        <dd class="text-muted">Get X perfect scores on assignments</dd>

                        <dt>TopicAssignments</dt>
                        <dd class="text-muted">Complete X assignments in a topic (use context)</dd>

                        <dt>CefrLevel</dt>
                        <dd class="text-muted">Reach CEFR level (use context for level)</dd>

                        <dt>Custom</dt>
                        <dd class="text-muted mb-0">Manually awarded by admin</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
