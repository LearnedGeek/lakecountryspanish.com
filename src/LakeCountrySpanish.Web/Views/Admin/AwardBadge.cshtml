@model LakeCountrySpanish.Web.Models.ViewModels.AwardBadgeViewModel
@{
    ViewData["Title"] = $"Award Badge - {Model.StudentName}";
}

<div class="container py-4">
    <h1 class="mb-4">Award Badge to @Model.StudentName</h1>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    @if (!Model.AvailableBadges.Any())
                    {
                        <div class="alert alert-info">
                            This student has already earned all available badges, or no badges are currently active.
                        </div>
                        <a asp-action="StudentGamification" asp-route-id="@Model.StudentId" class="btn btn-outline-secondary">
                            Back to Student
                        </a>
                    }
                    else
                    {
                        <form method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="StudentId" />

                            <div class="mb-3">
                                <label asp-for="BadgeId" class="form-label">Select Badge</label>
                                <select asp-for="BadgeId" class="form-select" required>
                                    <option value="">-- Select a badge --</option>
                                    @foreach (var badge in Model.AvailableBadges)
                                    {
                                        <option value="@badge.Id">
                                            @badge.Name (@badge.Category) - @badge.Description
                                            @if (badge.BonusPoints > 0)
                                            {
                                                @: [+@badge.BonusPoints pts]
                                            }
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Context" class="form-label">Context (optional)</label>
                                <input asp-for="Context" class="form-control"
                                       placeholder="e.g., Special achievement, contest winner">
                                <div class="form-text">Add context about why this badge is being awarded.</div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">Award Badge</button>
                                <a asp-action="StudentGamification" asp-route-id="@Model.StudentId"
                                   class="btn btn-outline-secondary">Cancel</a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Available Badges</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">@Model.AvailableBadges.Count() badge(s) available to award.</p>
                    <p class="text-muted small mb-0">
                        Badges that the student has already earned are not shown.
                        Manually awarded badges will trigger bonus points if configured.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
