@model LakeCountrySpanish.Web.Models.ViewModels.AdminAssignmentListViewModel
@{
    ViewData["Title"] = "Manage Assignments";
}

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex justify-between items-center mb-6">
        @await Component.InvokeAsync("PageHeader", new {
            title = "Assignments"
        })
        <div class="flex space-x-2">
            @await Component.InvokeAsync("Button", new {
                text = "Curriculum Topics",
                href = Url.Action("Topics"),
                type = "outline",
                icon = "document"
            })
            @await Component.InvokeAsync("Button", new {
                text = "AI Generate",
                href = Url.Action("GenerateAssignment"),
                type = "primary"
            })
            @await Component.InvokeAsync("Button", new {
                text = "Create Manual",
                href = Url.Action("CreateAssignment"),
                type = "success",
                icon = "plus"
            })
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-6 gap-4 mb-6">
        @await Component.InvokeAsync("StatCard", new {
            value = Model.Stats.DraftCount.ToString(),
            label = "Draft",
            color = "default"
        })
        @await Component.InvokeAsync("StatCard", new {
            value = Model.Stats.PendingReviewCount.ToString(),
            label = "Pending Review",
            color = "warning"
        })
        @await Component.InvokeAsync("StatCard", new {
            value = Model.Stats.ApprovedCount.ToString(),
            label = "Approved",
            color = "success"
        })
        @await Component.InvokeAsync("StatCard", new {
            value = Model.Stats.RejectedCount.ToString(),
            label = "Rejected",
            color = "danger"
        })
        @await Component.InvokeAsync("StatCard", new {
            value = Model.Stats.AiGeneratedCount.ToString(),
            label = "AI Generated",
            color = "primary"
        })
        @await Component.InvokeAsync("StatCard", new {
            value = Model.Stats.TotalSubmissions.ToString(),
            label = "Submissions",
            color = "primary"
        })
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-lg shadow mb-6 p-4">
        <form method="get" class="flex flex-wrap gap-4 items-end">
            <div class="w-40">
                <label class="block text-sm font-medium text-gray-700 mb-1">CEFR Level</label>
                <select name="cefrLevel" class="w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm">
                    <option value="">All Levels</option>
                    @foreach (var level in new[] { "A1", "A2", "B1", "B2", "C1", "C2" })
                    {
                        <option value="@level" selected="@(Model.FilterCefrLevel == level)">@level</option>
                    }
                </select>
            </div>
            <div class="w-40">
                <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                <select name="status" class="w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm">
                    <option value="">All Status</option>
                    @foreach (var status in Enum.GetValues<LakeCountrySpanish.Web.Models.Entities.AssignmentStatus>())
                    {
                        <option value="@status" selected="@(Model.FilterStatus == status)">@status</option>
                    }
                </select>
            </div>
            <div class="w-40">
                <label class="block text-sm font-medium text-gray-700 mb-1">Type</label>
                <select name="type" class="w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm">
                    <option value="">All Types</option>
                    @foreach (var type in Enum.GetValues<LakeCountrySpanish.Web.Models.Entities.AssignmentType>())
                    {
                        <option value="@type" selected="@(Model.FilterType == type)">@type</option>
                    }
                </select>
            </div>
            <div class="flex gap-2">
                @await Component.InvokeAsync("Button", new { text = "Filter", type = "primary" })
                <a asp-action="Assignments" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                    Clear
                </a>
            </div>
        </form>
    </div>

    <!-- Assignments Table -->
    @if (!Model.Assignments.Any())
    {
        @await Component.InvokeAsync("EmptyState", new {
            title = "No assignments found",
            message = "Create your first assignment or generate one with AI!",
            icon = "document"
        })
    }
    else
    {
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Level</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Points</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Submissions</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Avg Score</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var assignment in Model.Assignments)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4">
                                <a asp-action="ViewAssignment" asp-route-id="@assignment.Id" class="block">
                                    <div class="font-medium text-indigo-600 hover:text-indigo-900">
                                        @assignment.Title
                                        @if (assignment.IsAiGenerated)
                                        {
                                            @await Component.InvokeAsync("StatusBadge", new { text = "AI", color = "blue" })
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(assignment.TopicName))
                                    {
                                        <div class="text-sm text-gray-500">@assignment.TopicName</div>
                                    }
                                </a>
                            </td>
                            <td class="px-6 py-4">
                                @await Component.InvokeAsync("StatusBadge", new { text = assignment.CefrLevel, color = "gray" })
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500">@assignment.Type</td>
                            <td class="px-6 py-4">
                                @{
                                    var statusColor = assignment.Status switch {
                                        LakeCountrySpanish.Web.Models.Entities.AssignmentStatus.Draft => "gray",
                                        LakeCountrySpanish.Web.Models.Entities.AssignmentStatus.PendingReview => "yellow",
                                        LakeCountrySpanish.Web.Models.Entities.AssignmentStatus.Approved => "green",
                                        LakeCountrySpanish.Web.Models.Entities.AssignmentStatus.Rejected => "red",
                                        _ => "gray"
                                    };
                                }
                                @await Component.InvokeAsync("StatusBadge", new { text = assignment.Status.ToString(), color = statusColor })
                            </td>
                            <td class="px-6 py-4 text-center text-sm text-gray-500">@assignment.TotalPoints</td>
                            <td class="px-6 py-4 text-center text-sm text-gray-500">@assignment.SubmissionCount</td>
                            <td class="px-6 py-4 text-center text-sm">
                                @if (assignment.AverageScore.HasValue)
                                {
                                    var scoreColor = assignment.AverageScore >= 80 ? "text-green-600" : assignment.AverageScore >= 60 ? "text-yellow-600" : "text-red-600";
                                    <span class="@scoreColor font-medium">@assignment.AverageScore.Value.ToString("0")%</span>
                                }
                                else
                                {
                                    <span class="text-gray-400">-</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500">
                                @assignment.CreatedAt.ToString("MMM d")
                                @if (assignment.ReviewedAt.HasValue)
                                {
                                    <div class="text-xs text-gray-400">Reviewed @assignment.ReviewedAt.Value.ToString("MMM d")</div>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end space-x-2">
                                    @if (assignment.Status == LakeCountrySpanish.Web.Models.Entities.AssignmentStatus.PendingReview)
                                    {
                                        @await Component.InvokeAsync("Button", new {
                                            text = "Review",
                                            href = Url.Action("ReviewAssignment", new { id = assignment.Id }),
                                            type = "warning",
                                            size = "sm"
                                        })
                                    }
                                    else if (assignment.Status == LakeCountrySpanish.Web.Models.Entities.AssignmentStatus.Approved)
                                    {
                                        @await Component.InvokeAsync("Button", new {
                                            text = "Assign",
                                            href = Url.Action("AssignToStudents", new { id = assignment.Id }),
                                            type = "success",
                                            size = "sm"
                                        })
                                    }
                                    @await Component.InvokeAsync("Button", new {
                                        text = "Edit",
                                        href = Url.Action("EditAssignment", new { id = assignment.Id }),
                                        type = "outline",
                                        size = "sm"
                                    })
                                    <form asp-action="DeleteAssignment" asp-route-id="@assignment.Id"
                                          method="post" class="inline"
                                          onsubmit="return confirm('Delete this assignment?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="inline-flex items-center px-3 py-1.5 border border-red-300 text-xs font-medium rounded text-red-700 bg-white hover:bg-red-50">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
