@model LakeCountrySpanish.Web.Models.ViewModels.AdminDocumentsViewModel
@{
    ViewData["Title"] = "Documents";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8 flex justify-between items-center">
            @await Component.InvokeAsync("PageHeader", new {
                title = "Documents",
                subtitle = "Manage learning materials for students."
            })
            @await Component.InvokeAsync("Button", new {
                text = "Upload Document",
                href = Url.Action("UploadDocument"),
                type = "primary",
                icon = "plus"
            })
        </div>

        <div class="bg-white rounded-lg shadow">
            @if (Model.Documents.Any())
            {
                <div class="divide-y divide-gray-200">
                    @foreach (var doc in Model.Documents)
                    {
                        <div class="p-6 flex items-center justify-between">
                            <div class="flex items-center">
                                <svg class="h-10 w-10 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                                </svg>
                                <div class="ml-4">
                                    <p class="text-sm font-medium text-gray-900">@doc.Title</p>
                                    <p class="text-sm text-gray-500">@doc.FileName</p>
                                    <p class="text-xs text-gray-400 mt-1">
                                        Uploaded @doc.UploadedAt.ToString("MMM d, yyyy")
                                        @if (doc.IsGlobal)
                                        {
                                            @await Component.InvokeAsync("StatusBadge", new { text = "Global", color = "blue" })
                                        }
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center space-x-4">
                                <a asp-action="AssignDocument" asp-route-id="@doc.Id" class="text-primary-600 hover:text-primary-800 text-sm font-medium">
                                    Assign
                                </a>
                                <form asp-action="DeleteDocument" method="post">
                                    <input type="hidden" name="id" value="@doc.Id" />
                                    <button type="submit" class="text-red-600 hover:text-red-800 text-sm font-medium"
                                            onclick="return confirm('Are you sure you want to delete this document?')">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                @await Component.InvokeAsync("EmptyState", new {
                    title = "No documents uploaded yet",
                    icon = "document",
                    actionText = "Upload your first document",
                    actionUrl = Url.Action("UploadDocument")
                })
            }
        </div>
    </div>
</div>
