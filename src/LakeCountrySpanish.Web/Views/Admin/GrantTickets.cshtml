@model LakeCountrySpanish.Web.Models.ViewModels.GrantTicketsViewModel
@{
    ViewData["Title"] = "Grant Tickets";
    var studentName = ViewBag.StudentName as string;
}

<div class="container mx-auto px-4 py-8">
    <div class="mb-8">
        <a href="@Url.Action("StudentGamification", new { id = Model.StudentId })" class="inline-flex items-center text-blue-600 hover:text-blue-800 mb-4">
            <svg class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to Gamification
        </a>
        <h1 class="text-3xl font-bold text-gray-900">Grant Class Tickets</h1>
        <p class="text-gray-600 mt-2">Directly grant class tickets to @studentName.</p>
    </div>

    <div class="max-w-md">
        <div class="bg-white rounded-lg shadow p-6">
            <form method="post" asp-action="GrantTickets">
                @Html.AntiForgeryToken()
                <input type="hidden" name="StudentId" value="@Model.StudentId" />

                <div class="space-y-6">
                    <div>
                        <label for="Quantity" class="block text-sm font-medium text-gray-700 mb-2">Number of Tickets</label>
                        <input type="number" name="Quantity" id="Quantity" value="@Model.Quantity" min="1" max="20" required
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-green-500 focus:border-green-500" />
                        <p class="text-xs text-gray-500 mt-1">Each ticket can be used for one class</p>
                    </div>

                    <div>
                        <label for="ExpirationDays" class="block text-sm font-medium text-gray-700 mb-2">Expires In (days, optional)</label>
                        <input type="number" name="ExpirationDays" id="ExpirationDays" value="@Model.ExpirationDays" min="1" max="365"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-green-500 focus:border-green-500"
                               placeholder="Leave blank for no expiration" />
                        <p class="text-xs text-gray-500 mt-1">Leave empty for tickets that never expire</p>
                    </div>

                    <div>
                        <label for="Notes" class="block text-sm font-medium text-gray-700 mb-2">Reason/Notes</label>
                        <textarea name="Notes" id="Notes" rows="3" required
                                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-green-500 focus:border-green-500"
                                  placeholder="Reason for granting these tickets...">@Model.Notes</textarea>
                    </div>

                    <div class="p-4 bg-green-50 rounded-lg">
                        <p class="text-sm text-green-800">
                            <strong>Note:</strong> These tickets are granted directly at no cost to the student.
                            Use this for compensation, promotions, or as a gift for special circumstances.
                        </p>
                    </div>
                </div>

                <div class="mt-6 flex justify-end space-x-3">
                    <a href="@Url.Action("StudentGamification", new { id = Model.StudentId })" class="px-4 py-2 text-gray-700 bg-gray-100 rounded-md hover:bg-gray-200">
                        Cancel
                    </a>
                    <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700">
                        Grant Tickets
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
