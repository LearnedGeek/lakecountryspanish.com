@model LakeCountrySpanish.Web.Models.ViewModels.EditTopicViewModel
@{
    ViewData["Title"] = Model.IsNew ? "Create Topic" : "Edit Topic";
}

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="max-w-2xl mx-auto">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-900">@(Model.IsNew ? "Create Curriculum Topic" : "Edit Topic")</h1>
            <a asp-action="Topics" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Back
            </a>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg p-4 mb-6">
                <div class="flex">
                    <svg class="h-5 w-5 text-red-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            </div>
        }

        <div class="bg-white rounded-lg shadow">
            <div class="p-6">
                <form asp-action="@(Model.IsNew ? "CreateTopic" : "EditTopic")" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-4">
                        <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1">Topic Name</label>
                        <input asp-for="Name" class="w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" required
                               placeholder="e.g., Present Tense Conjugation" />
                        <span asp-validation-for="Name" class="text-red-600 text-sm"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                        <textarea asp-for="Description" class="w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" rows="2"
                                  placeholder="Brief description of what this topic covers..."></textarea>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                        <div>
                            <label asp-for="CefrLevel" class="block text-sm font-medium text-gray-700 mb-1">CEFR Level</label>
                            <select asp-for="CefrLevel" class="w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm">
                                @foreach (var level in new[] { "A1", "A2", "B1", "B2", "C1", "C2" })
                                {
                                    <option value="@level">@level</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label asp-for="Type" class="block text-sm font-medium text-gray-700 mb-1">Topic Type</label>
                            <select asp-for="Type" class="w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm">
                                @foreach (var type in Enum.GetValues<LakeCountrySpanish.Web.Models.Entities.TopicType>())
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label asp-for="DisplayOrder" class="block text-sm font-medium text-gray-700 mb-1">Display Order</label>
                            <input asp-for="DisplayOrder" type="number" class="w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" min="0" />
                            <p class="mt-1 text-xs text-gray-500">Lower numbers appear first</p>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Keywords" class="block text-sm font-medium text-gray-700 mb-1">Keywords (for AI generation)</label>
                        <input asp-for="Keywords" class="w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm"
                               placeholder="e.g., -ar verbs, -er verbs, regular verbs, present tense" />
                        <p class="mt-1 text-xs text-gray-500">
                            Comma-separated keywords to help AI generate relevant content.
                        </p>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ExampleContent" class="block text-sm font-medium text-gray-700 mb-1">Example Content (Optional)</label>
                        <textarea asp-for="ExampleContent" class="w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" rows="3"
                                  placeholder="Example vocabulary, sentences, or concepts for this topic..."></textarea>
                        <p class="mt-1 text-xs text-gray-500">
                            Provide examples to guide AI assignment generation.
                        </p>
                    </div>

                    <div class="mb-6">
                        <div class="flex items-center">
                            <input asp-for="IsActive" class="h-4 w-4 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500" type="checkbox" />
                            <label asp-for="IsActive" class="ml-2 text-sm text-gray-700">Active</label>
                        </div>
                        <p class="mt-1 text-xs text-gray-500 ml-6">Inactive topics won't appear in assignment generation.</p>
                    </div>

                    <div class="flex justify-end gap-3">
                        <a asp-action="Topics" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">Cancel</a>
                        <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700">
                            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                            </svg>
                            @(Model.IsNew ? "Create Topic" : "Save Changes")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
