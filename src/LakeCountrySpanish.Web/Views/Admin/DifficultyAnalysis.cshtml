@model LakeCountrySpanish.Web.Models.ViewModels.DifficultyAnalysisViewModel
@{
    ViewData["Title"] = "Assignment Difficulty Analysis";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8 flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Difficulty Analysis</h1>
                <p class="mt-2 text-gray-600">Student feedback on assignment difficulty to help tune content.</p>
            </div>
            <a asp-action="Dashboard" class="text-primary-600 hover:text-primary-700 text-sm font-medium">
                <i class="bi bi-arrow-left mr-1"></i> Back to Dashboard
            </a>
        </div>

        <!-- Overall Feedback Summary -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <!-- Feedback Distribution -->
            <div class="bg-white rounded-lg shadow">
                <div class="p-6 border-b border-gray-200">
                    <h2 class="text-lg font-semibold text-gray-900">Overall Feedback Distribution</h2>
                    <p class="text-sm text-gray-500 mt-1">Based on @Model.Report.TotalFeedbackCount student responses</p>
                </div>
                <div class="p-6">
                    @if (Model.Report.TotalFeedbackCount > 0)
                    {
                        <div class="space-y-4">
                            <div>
                                <div class="flex justify-between mb-1">
                                    <span class="text-sm font-medium text-gray-700">Too Easy</span>
                                    <span class="text-sm text-gray-500">@Model.Report.TooEasyCount (@Model.Report.TooEasyPercent%)</span>
                                </div>
                                <div class="w-full bg-gray-200 rounded-full h-3">
                                    <div class="bg-green-500 h-3 rounded-full" style="width: @Model.Report.TooEasyPercent%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between mb-1">
                                    <span class="text-sm font-medium text-gray-700">Just Right</span>
                                    <span class="text-sm text-gray-500">@Model.Report.JustRightCount (@Model.Report.JustRightPercent%)</span>
                                </div>
                                <div class="w-full bg-gray-200 rounded-full h-3">
                                    <div class="bg-blue-500 h-3 rounded-full" style="width: @Model.Report.JustRightPercent%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between mb-1">
                                    <span class="text-sm font-medium text-gray-700">Too Hard</span>
                                    <span class="text-sm text-gray-500">@Model.Report.TooHardCount (@Model.Report.TooHardPercent%)</span>
                                </div>
                                <div class="w-full bg-gray-200 rounded-full h-3">
                                    <div class="bg-red-500 h-3 rounded-full" style="width: @Model.Report.TooHardPercent%"></div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-6">
                            <canvas id="feedbackChart" height="200"></canvas>
                        </div>
                    }
                    else
                    {
                        <p class="text-gray-500 text-center py-8">No feedback data yet</p>
                    }
                </div>
            </div>

            <!-- Breakdown by CEFR Level -->
            <div class="bg-white rounded-lg shadow">
                <div class="p-6 border-b border-gray-200">
                    <h2 class="text-lg font-semibold text-gray-900">Feedback by CEFR Level</h2>
                </div>
                <div class="p-6">
                    @if (Model.Report.ByLevel.Any())
                    {
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead>
                                    <tr>
                                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Level</th>
                                        <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Too Easy</th>
                                        <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Just Right</th>
                                        <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Too Hard</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-200">
                                    @foreach (var level in Model.Report.ByLevel)
                                    {
                                        <tr>
                                            <td class="px-4 py-3">
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary-100 text-primary-800">
                                                    @level.CefrLevel
                                                </span>
                                            </td>
                                            <td class="px-4 py-3 text-center">
                                                <span class="text-green-600">@level.TooEasyPercent%</span>
                                            </td>
                                            <td class="px-4 py-3 text-center">
                                                <span class="text-blue-600">@level.JustRightPercent%</span>
                                            </td>
                                            <td class="px-4 py-3 text-center">
                                                <span class="text-red-600">@level.TooHardPercent%</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-gray-500 text-center py-8">No level data yet</p>
                    }
                </div>
            </div>
        </div>

        <!-- Assignments Needing Adjustment -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <!-- Too Easy Assignments -->
            <div class="bg-white rounded-lg shadow">
                <div class="p-6 border-b border-gray-200 bg-green-50">
                    <h2 class="text-lg font-semibold text-gray-900">
                        <i class="bi bi-arrow-up-circle text-green-600 mr-2"></i>
                        Assignments That May Be Too Easy
                    </h2>
                    <p class="text-sm text-gray-500 mt-1">Consider increasing difficulty</p>
                </div>
                <div class="p-6">
                    @if (Model.TooEasyAssignments.Any())
                    {
                        <div class="space-y-4">
                            @foreach (var assignment in Model.TooEasyAssignments)
                            {
                                <div class="p-4 bg-green-50 rounded-lg border border-green-100">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <a asp-action="EditAssignment" asp-route-id="@assignment.AssignmentId" class="font-medium text-primary-600 hover:text-primary-700">
                                                @assignment.Title
                                            </a>
                                            <div class="flex items-center gap-2 mt-1 text-sm text-gray-500">
                                                <span class="px-2 py-0.5 rounded bg-gray-100">@assignment.CefrLevel</span>
                                                <span>@assignment.Type</span>
                                            </div>
                                        </div>
                                        <div class="text-right">
                                            <span class="text-lg font-bold text-green-600">@assignment.AverageScore%</span>
                                            <div class="text-xs text-gray-500">avg score</div>
                                        </div>
                                    </div>
                                    <div class="mt-3 text-sm">
                                        <span class="text-green-700">@assignment.TooEasyCount</span> said too easy |
                                        <span class="text-blue-700">@assignment.JustRightCount</span> said just right |
                                        <span class="text-red-700">@assignment.TooHardCount</span> said too hard
                                    </div>
                                    <div class="mt-2 p-2 bg-white rounded text-sm text-gray-600">
                                        <i class="bi bi-lightbulb text-yellow-500 mr-1"></i>
                                        @assignment.RecommendedAction
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-gray-500 text-center py-8">No assignments flagged as too easy</p>
                    }
                </div>
            </div>

            <!-- Too Hard Assignments -->
            <div class="bg-white rounded-lg shadow">
                <div class="p-6 border-b border-gray-200 bg-red-50">
                    <h2 class="text-lg font-semibold text-gray-900">
                        <i class="bi bi-arrow-down-circle text-red-600 mr-2"></i>
                        Assignments That May Be Too Hard
                    </h2>
                    <p class="text-sm text-gray-500 mt-1">Consider reducing difficulty</p>
                </div>
                <div class="p-6">
                    @if (Model.TooHardAssignments.Any())
                    {
                        <div class="space-y-4">
                            @foreach (var assignment in Model.TooHardAssignments)
                            {
                                <div class="p-4 bg-red-50 rounded-lg border border-red-100">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <a asp-action="EditAssignment" asp-route-id="@assignment.AssignmentId" class="font-medium text-primary-600 hover:text-primary-700">
                                                @assignment.Title
                                            </a>
                                            <div class="flex items-center gap-2 mt-1 text-sm text-gray-500">
                                                <span class="px-2 py-0.5 rounded bg-gray-100">@assignment.CefrLevel</span>
                                                <span>@assignment.Type</span>
                                            </div>
                                        </div>
                                        <div class="text-right">
                                            <span class="text-lg font-bold text-red-600">@assignment.AverageScore%</span>
                                            <div class="text-xs text-gray-500">avg score</div>
                                        </div>
                                    </div>
                                    <div class="mt-3 text-sm">
                                        <span class="text-green-700">@assignment.TooEasyCount</span> said too easy |
                                        <span class="text-blue-700">@assignment.JustRightCount</span> said just right |
                                        <span class="text-red-700">@assignment.TooHardCount</span> said too hard
                                    </div>
                                    <div class="mt-2 p-2 bg-white rounded text-sm text-gray-600">
                                        <i class="bi bi-lightbulb text-yellow-500 mr-1"></i>
                                        @assignment.RecommendedAction
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-gray-500 text-center py-8">No assignments flagged as too hard</p>
                    }
                </div>
            </div>
        </div>

        <!-- All Assignments with Feedback -->
        <div class="bg-white rounded-lg shadow">
            <div class="p-6 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-900">All Assignments with Feedback</h2>
            </div>
            <div class="p-6">
                @if (Model.AllAssignments.Any())
                {
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead>
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Assignment</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Level</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Type</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Submissions</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Avg Score</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Feedback</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                                @foreach (var assignment in Model.AllAssignments)
                                {
                                    <tr class="@(assignment.NeedsAdjustment ? "bg-yellow-50" : "")">
                                        <td class="px-4 py-3">
                                            <a asp-action="EditAssignment" asp-route-id="@assignment.AssignmentId" class="text-primary-600 hover:text-primary-700">
                                                @assignment.Title
                                            </a>
                                        </td>
                                        <td class="px-4 py-3 text-center">
                                            <span class="px-2 py-0.5 rounded bg-primary-100 text-primary-800 text-xs">@assignment.CefrLevel</span>
                                        </td>
                                        <td class="px-4 py-3 text-center text-sm text-gray-600">@assignment.Type</td>
                                        <td class="px-4 py-3 text-center text-sm text-gray-600">@assignment.SubmissionCount</td>
                                        <td class="px-4 py-3 text-center">
                                            <span class="@(assignment.AverageScore >= 80 ? "text-green-600" : assignment.AverageScore >= 60 ? "text-yellow-600" : "text-red-600") font-medium">
                                                @assignment.AverageScore%
                                            </span>
                                        </td>
                                        <td class="px-4 py-3 text-center">
                                            <span class="@(assignment.DominantFeedback == "Too Easy" ? "text-green-600" : assignment.DominantFeedback == "Too Hard" ? "text-red-600" : "text-blue-600") text-sm">
                                                @assignment.DominantFeedback
                                            </span>
                                        </td>
                                        <td class="px-4 py-3 text-center">
                                            @if (assignment.NeedsAdjustment)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-800">
                                                    Needs Review
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                                                    OK
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-gray-500 text-center py-8">No assignments have received feedback yet</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        @if (Model.Report.TotalFeedbackCount > 0)
        {
            <text>
        var feedbackCtx = document.getElementById('feedbackChart').getContext('2d');
        var feedbackChart = new Chart(feedbackCtx, {
            type: 'pie',
            data: {
                labels: ['Too Easy', 'Just Right', 'Too Hard'],
                datasets: [{
                    data: [@Model.Report.TooEasyCount, @Model.Report.JustRightCount, @Model.Report.TooHardCount],
                    backgroundColor: ['#10B981', '#3B82F6', '#EF4444']
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
            </text>
        }
    </script>
}
