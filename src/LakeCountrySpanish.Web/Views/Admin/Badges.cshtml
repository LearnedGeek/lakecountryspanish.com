@model LakeCountrySpanish.Web.Models.ViewModels.AdminBadgeListViewModel
@using LakeCountrySpanish.Web.Models.Entities
@{
    ViewData["Title"] = "Badge Management";
}

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex justify-between items-center mb-6">
        @await Component.InvokeAsync("PageHeader", new {
            title = "Badge Management"
        })
        @await Component.InvokeAsync("Button", new {
            text = "Create Badge",
            href = Url.Action("CreateBadge"),
            type = "primary",
            icon = "plus"
        })
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-lg shadow mb-6 p-4">
        <form method="get" class="flex flex-wrap gap-4 items-end">
            <div class="w-48">
                <label class="block text-sm font-medium text-gray-700 mb-1">Category</label>
                <select name="category" class="w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm">
                    <option value="">All Categories</option>
                    @foreach (BadgeCategory cat in Enum.GetValues(typeof(BadgeCategory)))
                    {
                        if (Model.FilterCategory == cat)
                        {
                            <option value="@cat" selected>@cat</option>
                        }
                        else
                        {
                            <option value="@cat">@cat</option>
                        }
                    }
                </select>
            </div>
            <div class="flex items-center">
                <input type="checkbox" class="h-4 w-4 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500" name="showInactive" value="true"
                       id="showInactive" @(Model.ShowInactive ? "checked" : "")>
                <label class="ml-2 text-sm text-gray-700" for="showInactive">Show inactive badges</label>
            </div>
            <div class="flex gap-2">
                @await Component.InvokeAsync("Button", new { text = "Filter", type = "outline" })
                <a asp-action="Badges" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">Clear</a>
            </div>
        </form>
    </div>

    @if (!Model.Badges.Any())
    {
        @await Component.InvokeAsync("Alert", new {
            type = "info",
            message = "No badges found."
        })
        <p class="mt-2 text-sm text-gray-600">
            <a asp-action="CreateBadge" class="underline hover:text-primary-700">Create your first badge</a>.
        </p>
    }
    else
    {
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Badge</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Requirement</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Bonus Points</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Times Earned</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var badge in Model.Badges)
                    {
                        <tr class="hover:bg-gray-50 @(!badge.IsActive ? "bg-gray-100" : "")">
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    @if (!string.IsNullOrEmpty(badge.IconUrl))
                                    {
                                        <img src="@badge.IconUrl" alt="" class="w-8 h-8 mr-3">
                                    }
                                    else
                                    {
                                        <span class="mr-3 text-2xl">🏆</span>
                                    }
                                    <div>
                                        <div class="font-medium text-gray-900">@badge.Name</div>
                                        <div class="text-sm text-gray-500">@badge.Description</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500">@badge.Category</td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-gray-900">@badge.RequirementType: @badge.RequirementValue</div>
                                @if (!string.IsNullOrEmpty(badge.RequirementContext))
                                {
                                    <div class="text-xs text-gray-500">(@badge.RequirementContext)</div>
                                }
                            </td>
                            <td class="px-6 py-4 text-center text-sm text-gray-500">@badge.BonusPoints</td>
                            <td class="px-6 py-4 text-center">
                                <div class="text-sm text-gray-900">@badge.TimesEarned</div>
                                @if (badge.LastEarnedAt.HasValue)
                                {
                                    <div class="text-xs text-gray-500">Last: @badge.LastEarnedAt.Value.ToString("MMM d")</div>
                                }
                            </td>
                            <td class="px-6 py-4 text-center">
                                @await Component.InvokeAsync("StatusBadge", new {
                                    text = badge.IsActive ? "Active" : "Inactive",
                                    color = badge.IsActive ? "green" : "gray"
                                })
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end space-x-2">
                                    @await Component.InvokeAsync("Button", new {
                                        text = "Edit",
                                        href = Url.Action("EditBadge", new { id = badge.Id }),
                                        type = "outline",
                                        size = "sm"
                                    })
                                    @if (badge.IsActive)
                                    {
                                        <form method="post" asp-action="DisableBadge" asp-route-id="@badge.Id" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="inline-flex items-center px-3 py-1.5 border border-yellow-300 text-xs font-medium rounded text-yellow-700 bg-white hover:bg-yellow-50"
                                                    onclick="return confirm('Disable this badge? Students who earned it will keep it.');">
                                                Disable
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-action="EnableBadge" asp-route-id="@badge.Id" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="inline-flex items-center px-3 py-1.5 border border-green-300 text-xs font-medium rounded text-green-700 bg-white hover:bg-green-50">Enable</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
