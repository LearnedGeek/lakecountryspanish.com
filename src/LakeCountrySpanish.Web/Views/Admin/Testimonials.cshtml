@model LakeCountrySpanish.Web.Models.ViewModels.AdminTestimonialListViewModel
@{
    ViewData["Title"] = "Testimonials";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        @await Component.InvokeAsync("PageHeader", new {
            title = "Testimonials",
            subtitle = "Manage student testimonials displayed on the website."
        })

        <!-- Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
            @await Component.InvokeAsync("StatCard", new {
                value = Model.Testimonials.Count().ToString(),
                label = "Total Submitted"
            })
            @await Component.InvokeAsync("StatCard", new {
                value = Model.Testimonials.Count(t => t.IsApproved).ToString(),
                label = "Approved",
                color = "success"
            })
            @await Component.InvokeAsync("StatCard", new {
                value = Model.Testimonials.Count(t => !t.IsApproved).ToString(),
                label = "Pending Review",
                color = "warning"
            })
        </div>

        <!-- Testimonials List -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
            @if (Model.Testimonials.Any())
            {
                <div class="divide-y divide-gray-200">
                    @foreach (var testimonial in Model.Testimonials)
                    {
                        <div class="p-6 @(testimonial.IsFeatured ? "bg-yellow-50" : "")">
                            <div class="flex items-start justify-between">
                                <div class="flex-1">
                                    <div class="flex items-center gap-3 mb-2">
                                        <span class="font-medium text-gray-900">@testimonial.StudentName</span>
                                        <div class="flex items-center">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <svg class="h-5 w-5 @(i <= testimonial.Rating ? "text-yellow-400" : "text-gray-300")" fill="currentColor" viewBox="0 0 24 24">
                                                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                                </svg>
                                            }
                                        </div>
                                        @if (testimonial.IsFeatured)
                                        {
                                            @await Component.InvokeAsync("StatusBadge", new { text = "Featured", color = "yellow" })
                                        }
                                        @if (testimonial.IsApproved)
                                        {
                                            @await Component.InvokeAsync("StatusBadge", new { text = "Approved", color = "green" })
                                        }
                                        else
                                        {
                                            @await Component.InvokeAsync("StatusBadge", new { text = "Pending", color = "yellow" })
                                        }
                                    </div>
                                    <p class="text-gray-700 mb-2">"@testimonial.PublicTestimonial"</p>
                                    <div class="flex items-center gap-4 text-sm text-gray-500">
                                        <span>Class: @testimonial.ClassDate.ToString("MMM d, yyyy")</span>
                                        <span>Submitted: @testimonial.CreatedAt.ToString("MMM d, yyyy")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(testimonial.PrivateComment))
                                    {
                                        <div class="mt-3 p-3 bg-gray-100 rounded-lg">
                                            <p class="text-xs text-gray-500 font-medium mb-1">Private Comment (not public)</p>
                                            <p class="text-sm text-gray-600">@testimonial.PrivateComment</p>
                                        </div>
                                    }
                                </div>
                                <div class="ml-4 flex flex-col gap-2">
                                    @if (!testimonial.IsApproved)
                                    {
                                        <form asp-action="ApproveTestimonial" asp-route-id="@testimonial.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            @await Component.InvokeAsync("Button", new { text = "Approve", type = "success", size = "sm", cssClass = "w-full" })
                                        </form>
                                    }
                                    @if (!testimonial.IsFeatured)
                                    {
                                        <form asp-action="FeatureTestimonial" asp-route-id="@testimonial.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            @await Component.InvokeAsync("Button", new { text = "Feature", type = "warning", size = "sm", cssClass = "w-full" })
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="UnfeatureTestimonial" asp-route-id="@testimonial.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            @await Component.InvokeAsync("Button", new { text = "Unfeature", type = "secondary", size = "sm", cssClass = "w-full" })
                                        </form>
                                    }
                                    @if (testimonial.IsApproved)
                                    {
                                        <form asp-action="HideTestimonial" asp-route-id="@testimonial.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            @await Component.InvokeAsync("Button", new { text = "Hide", type = "danger", size = "sm", cssClass = "w-full" })
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                @await Component.InvokeAsync("EmptyState", new {
                    title = "No testimonials have been submitted yet",
                    message = "Students can submit testimonials after completing classes",
                    icon = "trophy"
                })
            }
        </div>
    </div>
</div>
