@model LakeCountrySpanish.Web.Models.ViewModels.AdminTestimonialListViewModel
@{
    ViewData["Title"] = "Testimonials";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Testimonials</h1>
            <p class="mt-2 text-gray-600">Manage student testimonials displayed on the website.</p>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
            <div class="bg-white rounded-lg shadow p-6">
                <p class="text-sm text-gray-500">Total Submitted</p>
                <p class="text-3xl font-bold text-gray-900">@Model.Testimonials.Count()</p>
            </div>
            <div class="bg-white rounded-lg shadow p-6">
                <p class="text-sm text-gray-500">Approved</p>
                <p class="text-3xl font-bold text-green-600">@Model.Testimonials.Count(t => t.IsApproved)</p>
            </div>
            <div class="bg-white rounded-lg shadow p-6">
                <p class="text-sm text-gray-500">Pending Review</p>
                <p class="text-3xl font-bold text-yellow-600">@Model.Testimonials.Count(t => !t.IsApproved)</p>
            </div>
        </div>

        <!-- Testimonials List -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
            @if (Model.Testimonials.Any())
            {
                <div class="divide-y divide-gray-200">
                    @foreach (var testimonial in Model.Testimonials)
                    {
                        <div class="p-6 @(testimonial.IsFeatured ? "bg-yellow-50" : "")">
                            <div class="flex items-start justify-between">
                                <div class="flex-1">
                                    <div class="flex items-center gap-3 mb-2">
                                        <span class="font-medium text-gray-900">@testimonial.StudentName</span>
                                        <div class="flex items-center">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <svg class="h-5 w-5 @(i <= testimonial.Rating ? "text-yellow-400" : "text-gray-300")" fill="currentColor" viewBox="0 0 24 24">
                                                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                                </svg>
                                            }
                                        </div>
                                        @if (testimonial.IsFeatured)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-800">
                                                Featured
                                            </span>
                                        }
                                        @if (testimonial.IsApproved)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                                                Approved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-800">
                                                Pending
                                            </span>
                                        }
                                    </div>
                                    <p class="text-gray-700 mb-2">"@testimonial.PublicTestimonial"</p>
                                    <div class="flex items-center gap-4 text-sm text-gray-500">
                                        <span>Class: @testimonial.ClassDate.ToString("MMM d, yyyy")</span>
                                        <span>Submitted: @testimonial.CreatedAt.ToString("MMM d, yyyy")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(testimonial.PrivateComment))
                                    {
                                        <div class="mt-3 p-3 bg-gray-100 rounded-lg">
                                            <p class="text-xs text-gray-500 font-medium mb-1">Private Comment (not public)</p>
                                            <p class="text-sm text-gray-600">@testimonial.PrivateComment</p>
                                        </div>
                                    }
                                </div>
                                <div class="ml-4 flex flex-col gap-2">
                                    @if (!testimonial.IsApproved)
                                    {
                                        <form asp-action="ApproveTestimonial" asp-route-id="@testimonial.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="w-full text-center bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-3 py-1.5 rounded transition">
                                                Approve
                                            </button>
                                        </form>
                                    }
                                    @if (!testimonial.IsFeatured)
                                    {
                                        <form asp-action="FeatureTestimonial" asp-route-id="@testimonial.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="w-full text-center bg-yellow-500 hover:bg-yellow-600 text-white text-sm font-medium px-3 py-1.5 rounded transition">
                                                Feature
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="UnfeatureTestimonial" asp-route-id="@testimonial.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="w-full text-center bg-gray-500 hover:bg-gray-600 text-white text-sm font-medium px-3 py-1.5 rounded transition">
                                                Unfeature
                                            </button>
                                        </form>
                                    }
                                    @if (testimonial.IsApproved)
                                    {
                                        <form asp-action="HideTestimonial" asp-route-id="@testimonial.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="w-full text-center bg-red-600 hover:bg-red-700 text-white text-sm font-medium px-3 py-1.5 rounded transition">
                                                Hide
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-12">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                    </svg>
                    <p class="mt-2 text-gray-500">No testimonials have been submitted yet</p>
                    <p class="text-sm text-gray-400 mt-1">Students can submit testimonials after completing classes</p>
                </div>
            }
        </div>
    </div>
</div>
