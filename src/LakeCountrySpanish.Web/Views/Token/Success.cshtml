@{
    ViewData["Title"] = "Purchase Successful";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-lg px-4 py-16 sm:px-6 lg:px-8">
        <div class="bg-white rounded-xl shadow-lg p-8 text-center border border-gray-100">
            <!-- Llama mascot with coins -->
            <div class="relative mb-4">
                <img src="~/img/lake-country-spanish-logo.jpg" alt="Llama mascot" class="mx-auto h-24 w-24 rounded-full object-cover" />
                <div class="absolute -bottom-1 right-1/3 bg-accent-100 rounded-full px-3 py-1 border-2 border-accent-400">
                    <span class="text-accent-700 font-bold text-sm">Excelente!</span>
                </div>
            </div>

            <div class="mx-auto flex items-center justify-center h-14 w-14 rounded-full bg-green-100 mb-4">
                <svg class="h-7 w-7 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
            </div>

            <h1 class="text-2xl font-bold text-gray-900">Purchase Successful!</h1>
            <p class="mt-2 text-gray-600">Your tokens have been added to your account and are ready to use.</p>

            @if (TempData["Success"] != null)
            {
                <div class="mt-4 p-4 bg-green-50 rounded-lg border border-green-200">
                    <p class="text-sm text-green-800">@TempData["Success"]</p>
                </div>
            }

            <div class="mt-8 space-y-4">
                <a href="@Url.Action("Index")" class="block w-full px-4 py-3 bg-secondary-500 text-white font-medium rounded-lg hover:bg-secondary-600 transition shadow-md">
                    View My Tokens
                </a>
                <a href="@Url.Action("Index", "Student")" class="block w-full px-4 py-3 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition">
                    Go to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
