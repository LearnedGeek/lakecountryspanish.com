@model LakeCountrySpanish.Web.Models.ViewModels.StudentAssignmentListViewModel
@{
    ViewData["Title"] = "My Assignments";
}

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-900">My Assignments</h1>
        <div class="flex gap-2">
            <a asp-action="History" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                View History
            </a>
            <a asp-controller="Student" asp-action="Dashboard" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Dashboard
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-indigo-600 rounded-lg shadow p-4 text-white">
            <p class="text-sm opacity-90">Assigned</p>
            <p class="text-3xl font-bold">@Model.Stats.AssignedCount</p>
        </div>
        <div class="bg-yellow-500 rounded-lg shadow p-4 text-white">
            <p class="text-sm opacity-90">In Progress</p>
            <p class="text-3xl font-bold">@Model.Stats.InProgressCount</p>
        </div>
        <div class="bg-green-600 rounded-lg shadow p-4 text-white">
            <p class="text-sm opacity-90">Completed</p>
            <p class="text-3xl font-bold">@Model.Stats.CompletedCount</p>
        </div>
        <div class="bg-cyan-600 rounded-lg shadow p-4 text-white">
            <p class="text-sm opacity-90">Total Points</p>
            <p class="text-3xl font-bold">@Model.Stats.TotalPointsEarned</p>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="border-b border-gray-200 mb-6">
        <nav class="-mb-px flex space-x-8">
            <a asp-action="Index" class="@(Context.Request.Query["status"].Count == 0 ? "border-indigo-500 text-indigo-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                All
            </a>
            <a asp-action="Index" asp-route-status="Assigned" class="@(Context.Request.Query["status"] == "Assigned" ? "border-indigo-500 text-indigo-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                Assigned
            </a>
            <a asp-action="Index" asp-route-status="InProgress" class="@(Context.Request.Query["status"] == "InProgress" ? "border-indigo-500 text-indigo-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                In Progress
            </a>
            <a asp-action="Index" asp-route-status="Completed" class="@(Context.Request.Query["status"] == "Completed" ? "border-indigo-500 text-indigo-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                Completed
            </a>
        </nav>
    </div>

    @if (!Model.Assignments.Any())
    {
        <div class="text-center py-12">
            <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"/>
            </svg>
            <h3 class="mt-4 text-lg font-medium text-gray-900">No assignments yet</h3>
            <p class="mt-2 text-gray-500">Check back soon - your teacher will assign exercises for you!</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var assignment in Model.Assignments)
            {
                <div class="bg-white rounded-lg shadow @(assignment.IsOverdue ? "ring-2 ring-red-500" : "") overflow-hidden">
                    <div class="px-4 py-3 bg-gray-50 border-b border-gray-200 flex justify-between items-center">
                        @{
                            var statusClass = assignment.Status switch
                            {
                                LakeCountrySpanish.Web.Models.Entities.StudentAssignmentStatus.Completed => "bg-green-100 text-green-800",
                                LakeCountrySpanish.Web.Models.Entities.StudentAssignmentStatus.InProgress => "bg-yellow-100 text-yellow-800",
                                _ => "bg-blue-100 text-blue-800"
                            };
                        }
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @statusClass">
                            @assignment.Status
                        </span>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                            @assignment.CefrLevel
                        </span>
                    </div>
                    <div class="p-4">
                        <h3 class="text-lg font-medium text-gray-900">@assignment.Title</h3>
                        <p class="mt-1 text-sm text-gray-500 line-clamp-2">@assignment.Description</p>

                        <div class="flex flex-wrap gap-2 mt-3">
                            <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-gray-100 text-gray-700">
                                @assignment.TypeDisplayName
                            </span>
                            @if (assignment.TopicName != null)
                            {
                                <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-gray-100 text-gray-700">
                                    @assignment.TopicName
                                </span>
                            }
                        </div>

                        <div class="grid grid-cols-3 gap-2 mt-4 text-center">
                            <div>
                                @if (assignment.Status == LakeCountrySpanish.Web.Models.Entities.StudentAssignmentStatus.Completed && assignment.PointsEarned.HasValue)
                                {
                                    <p class="text-xs text-gray-500">Earned</p>
                                    <p class="font-semibold @(assignment.PointsEarned > 0 ? "text-green-600" : "text-gray-900")">
                                        @assignment.PointsEarned / @(assignment.TotalPoints + assignment.BonusPoints)
                                    </p>
                                }
                                else
                                {
                                    <p class="text-xs text-gray-500">Possible</p>
                                    <p class="font-semibold text-gray-900">
                                        @assignment.TotalPoints
                                        @if (assignment.BonusPoints > 0)
                                        {
                                            <span class="text-green-600 text-xs">+@assignment.BonusPoints</span>
                                        }
                                    </p>
                                }
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Time</p>
                                <p class="font-semibold text-gray-900">~@assignment.EstimatedMinutes min</p>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Attempts</p>
                                <p class="font-semibold text-gray-900">@assignment.AttemptCount</p>
                            </div>
                        </div>

                        @if (assignment.BestScore.HasValue)
                        {
                            <div class="mt-4">
                                <div class="flex justify-between text-xs text-gray-500 mb-1">
                                    <span>Best Score</span>
                                    <span>@assignment.BestScore.Value.ToString("0")%</span>
                                </div>
                                @{
                                    var scoreColor = assignment.BestScore >= 80 ? "bg-green-600" : assignment.BestScore >= 60 ? "bg-yellow-500" : "bg-red-500";
                                }
                                <div class="w-full bg-gray-200 rounded-full h-2">
                                    <div class="@scoreColor h-2 rounded-full" style="width: @assignment.BestScore%"></div>
                                </div>
                            </div>
                        }

                        @if (assignment.DueDate.HasValue)
                        {
                            <p class="mt-4 text-sm @(assignment.IsOverdue ? "text-red-600" : "text-gray-500")">
                                Due: @assignment.DueDate.Value.ToString("MMM d, yyyy")
                                @if (assignment.IsOverdue)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800 ml-2">
                                        Overdue
                                    </span>
                                }
                            </p>
                        }
                    </div>
                    <div class="px-4 py-3 bg-gray-50 border-t border-gray-200">
                        @if (assignment.Status == LakeCountrySpanish.Web.Models.Entities.StudentAssignmentStatus.Completed)
                        {
                            <a asp-action="Take" asp-route-id="@assignment.StudentAssignmentId"
                               class="w-full inline-flex justify-center items-center px-4 py-2 border border-indigo-600 rounded-md shadow-sm text-sm font-medium text-indigo-600 bg-white hover:bg-indigo-50">
                                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                                </svg>
                                Retry
                            </a>
                        }
                        else if (assignment.Status == LakeCountrySpanish.Web.Models.Entities.StudentAssignmentStatus.InProgress)
                        {
                            <a asp-action="Take" asp-route-id="@assignment.StudentAssignmentId"
                               class="w-full inline-flex justify-center items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-yellow-500 hover:bg-yellow-600">
                                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                Continue
                            </a>
                        }
                        else
                        {
                            <div class="flex gap-2">
                                <a asp-action="Take" asp-route-id="@assignment.StudentAssignmentId"
                                   class="flex-1 inline-flex justify-center items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700">
                                    <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                    Start
                                </a>
                                <form asp-action="Skip" asp-route-id="@assignment.StudentAssignmentId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" onclick="return confirm('Skip this assignment?')"
                                            class="inline-flex items-center px-3 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"/>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
