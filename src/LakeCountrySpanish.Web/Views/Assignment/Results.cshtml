@model LakeCountrySpanish.Web.Models.ViewModels.AssignmentResultViewModel
@{
    ViewData["Title"] = "Assignment Results";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Score Header -->
            <div class="card mb-4 @(Model.IsPerfectScore ? "border-success border-3" : "")">
                <div class="card-body text-center py-5">
                    @if (Model.IsPerfectScore)
                    {
                        <div class="mb-3">
                            <i class="bi bi-trophy-fill text-warning display-1"></i>
                        </div>
                        <h1 class="text-success">Perfect Score!</h1>
                    }
                    else
                    {
                        <h1>Assignment Complete</h1>
                    }

                    <h2 class="display-1 fw-bold @(Model.PercentageScore >= 80 ? "text-success" : Model.PercentageScore >= 60 ? "text-warning" : "text-danger")">
                        @Model.PercentageScore.ToString("0")%
                    </h2>

                    <p class="lead text-muted">@Model.AssignmentTitle</p>

                    <div class="row justify-content-center mt-4">
                        <div class="col-auto">
                            <div class="card bg-light">
                                <div class="card-body py-2 px-4">
                                    <small class="text-muted d-block">Correct</small>
                                    <strong class="fs-4">@Model.CorrectAnswers / @Model.TotalQuestions</strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-auto">
                            <div class="card bg-light">
                                <div class="card-body py-2 px-4">
                                    <small class="text-muted d-block">Points Earned</small>
                                    <strong class="fs-4 text-primary">+@Model.PointsEarned</strong>
                                    @if (Model.BonusPointsEarned > 0)
                                    {
                                        <span class="text-success">+@Model.BonusPointsEarned</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-auto">
                            <div class="card bg-light">
                                <div class="card-body py-2 px-4">
                                    <small class="text-muted d-block">Time Taken</small>
                                    <strong class="fs-4">@Model.TimeTaken.ToString(@"mm\:ss")</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (Model.IsFirstAttempt && Model.IsPerfectScore)
                    {
                        <div class="alert alert-success mt-4 mb-0">
                            <i class="bi bi-star-fill"></i> First attempt perfect score bonus applied!
                        </div>
                    }
                </div>
            </div>

            <!-- Question Results -->
            <h4 class="mb-3">Question Review</h4>

            @foreach (var result in Model.QuestionResults)
            {
                <div class="card mb-3 @(result.IsCorrect ? "border-success" : "border-danger")">
                    <div class="card-header d-flex justify-content-between align-items-center @(result.IsCorrect ? "bg-success text-white" : "bg-danger text-white")">
                        <span>Question @result.QuestionId</span>
                        <span>
                            @if (result.IsCorrect)
                            {
                                <i class="bi bi-check-circle-fill"></i> @:Correct
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill"></i> @:Incorrect
                            }
                        </span>
                    </div>
                    <div class="card-body">
                        <p class="mb-3"><strong>@result.Question</strong></p>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-2">
                                    <small class="text-muted">Your Answer:</small>
                                    <p class="mb-0 @(result.IsCorrect ? "text-success" : "text-danger")">
                                        @(string.IsNullOrEmpty(result.StudentAnswer) ? "(No answer)" : result.StudentAnswer)
                                    </p>
                                </div>
                            </div>
                            @if (!result.IsCorrect)
                            {
                                <div class="col-md-6">
                                    <div class="mb-2">
                                        <small class="text-muted">Correct Answer:</small>
                                        <p class="mb-0 text-success fw-bold">@result.CorrectAnswer</p>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(result.Feedback))
                        {
                            <div class="alert alert-info mt-3 mb-0">
                                <i class="bi bi-lightbulb"></i> @result.Feedback
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(result.Explanation))
                        {
                            <div class="mt-3">
                                <small class="text-muted">Explanation:</small>
                                <p class="mb-0">@result.Explanation</p>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Actions -->
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Assignments
                </a>
                <a asp-controller="Student" asp-action="Progress" class="btn btn-primary">
                    <i class="bi bi-graph-up"></i> View Progress
                </a>
            </div>
        </div>
    </div>
</div>
