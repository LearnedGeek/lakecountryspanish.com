@model LakeCountrySpanish.Web.Models.ViewModels.AssignmentResultViewModel
@{
    ViewData["Title"] = "Assignment Results";
}

<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-8">
    <!-- Score Header -->
    <div class="bg-white rounded-lg shadow mb-6 @(Model.IsPerfectScore ? "ring-4 ring-green-400" : "")">
        <div class="py-10 text-center">
            @if (Model.IsPerfectScore)
            {
                <div class="mb-4">
                    <span class="text-6xl">🏆</span>
                </div>
                <h1 class="text-3xl font-bold text-green-600">Perfect Score!</h1>
            }
            else
            {
                <h1 class="text-3xl font-bold text-gray-900">Assignment Complete</h1>
            }

            @{
                var scoreColor = Model.PercentageScore >= 80 ? "text-green-600" : Model.PercentageScore >= 60 ? "text-yellow-600" : "text-red-600";
            }
            <p class="text-7xl font-bold mt-4 @scoreColor">
                @Model.PercentageScore.ToString("0")%
            </p>

            <p class="text-xl text-gray-500 mt-4">@Model.AssignmentTitle</p>

            <div class="flex justify-center gap-4 mt-6">
                <div class="bg-gray-100 rounded-lg px-6 py-3">
                    <p class="text-xs text-gray-500">Correct</p>
                    <p class="text-xl font-bold text-gray-900">@Model.CorrectAnswers / @Model.TotalQuestions</p>
                </div>
                <div class="bg-gray-100 rounded-lg px-6 py-3">
                    <p class="text-xs text-gray-500">Points Earned</p>
                    <p class="text-xl font-bold text-indigo-600">
                        +@Model.PointsEarned
                        @if (Model.BonusPointsEarned > 0)
                        {
                            <span class="text-green-600">+@Model.BonusPointsEarned</span>
                        }
                    </p>
                </div>
                <div class="bg-gray-100 rounded-lg px-6 py-3">
                    <p class="text-xs text-gray-500">Time Taken</p>
                    <p class="text-xl font-bold text-gray-900">@Model.TimeTaken.ToString(@"mm\:ss")</p>
                </div>
            </div>

            @if (Model.IsFirstAttempt && Model.IsPerfectScore)
            {
                <div class="mt-6 mx-auto max-w-md bg-green-50 border border-green-200 text-green-700 rounded-lg p-4">
                    <span class="text-yellow-500">⭐</span> First attempt perfect score bonus applied!
                </div>
            }
        </div>
    </div>

    <!-- Question Results -->
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Question Review</h3>

    @foreach (var result in Model.QuestionResults)
    {
        <div class="bg-white rounded-lg shadow mb-4 overflow-hidden @(result.IsCorrect ? "ring-2 ring-green-400" : "ring-2 ring-red-400")">
            <div class="px-6 py-3 flex justify-between items-center @(result.IsCorrect ? "bg-green-500 text-white" : "bg-red-500 text-white")">
                <span class="font-medium">Question @result.QuestionId</span>
                <span class="flex items-center">
                    @if (result.IsCorrect)
                    {
                        <svg class="h-5 w-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        @:Correct
                    }
                    else
                    {
                        <svg class="h-5 w-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        @:Incorrect
                    }
                </span>
            </div>
            <div class="p-6">
                <p class="font-medium text-gray-900 mb-4">@result.Question</p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <p class="text-xs text-gray-500 mb-1">Your Answer:</p>
                        <p class="@(result.IsCorrect ? "text-green-600" : "text-red-600")">
                            @(string.IsNullOrEmpty(result.StudentAnswer) ? "(No answer)" : result.StudentAnswer)
                        </p>
                    </div>
                    @if (!result.IsCorrect)
                    {
                        <div>
                            <p class="text-xs text-gray-500 mb-1">Correct Answer:</p>
                            <p class="text-green-600 font-bold">@result.CorrectAnswer</p>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(result.Feedback))
                {
                    <div class="mt-4 bg-blue-50 border border-blue-200 text-blue-700 rounded-lg p-4">
                        <svg class="inline h-5 w-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                        </svg>
                        @result.Feedback
                    </div>
                }

                @if (!string.IsNullOrEmpty(result.Explanation))
                {
                    <div class="mt-4">
                        <p class="text-xs text-gray-500 mb-1">Explanation:</p>
                        <p class="text-gray-700">@result.Explanation</p>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Actions -->
    <div class="flex justify-between mt-6">
        <a asp-action="Index" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to Assignments
        </a>
        <a asp-controller="Student" asp-action="Progress" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700">
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
            </svg>
            View Progress
        </a>
    </div>
</div>
