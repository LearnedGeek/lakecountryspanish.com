@model LakeCountrySpanish.Web.Models.ViewModels.TakeAssignmentViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="bg-white rounded-lg shadow mb-6">
        <div class="p-6">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <h2 class="text-2xl font-bold text-gray-900">@Model.Title</h2>
                    <p class="text-gray-500 mt-1">@Model.Description</p>
                </div>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
                    @Model.CefrLevel
                </span>
            </div>

            <div class="grid grid-cols-4 gap-4 text-center border-t border-gray-200 pt-4">
                <div>
                    <p class="text-xs text-gray-500">Type</p>
                    <p class="font-semibold text-gray-900">@Model.Type</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500">Points</p>
                    <p class="font-semibold text-gray-900">
                        @Model.TotalPoints
                        @if (Model.BonusPoints > 0)
                        {
                            <span class="text-green-600 text-xs">+@Model.BonusPoints bonus</span>
                        }
                    </p>
                </div>
                <div>
                    <p class="text-xs text-gray-500">Est. Time</p>
                    <p class="font-semibold text-gray-900">~@Model.EstimatedMinutes min</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500">Attempt</p>
                    <p class="font-semibold text-gray-900">#@Model.AttemptNumber</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Timer -->
    <div class="bg-gray-100 rounded-lg shadow mb-6">
        <div class="py-3 text-center">
            <svg class="inline h-5 w-5 mr-2 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span id="timer" class="font-mono text-lg font-semibold text-gray-700">00:00</span>
        </div>
    </div>

    <!-- Questions Form -->
    <form id="assignmentForm" asp-action="Submit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="AssignmentId" value="@Model.AssignmentId" />
        <input type="hidden" name="AnswersJson" id="answersJson" />
        <input type="hidden" name="TimeTakenSeconds" id="timeTakenSeconds" />

        <div id="questionsContainer">
            <!-- Questions will be rendered by JavaScript -->
        </div>

        <!-- Feedback Section -->
        <div class="bg-white rounded-lg shadow mb-6">
            <div class="px-6 py-4 border-b border-gray-200">
                <h3 class="text-lg font-semibold text-gray-900">Optional Feedback</h3>
            </div>
            <div class="p-6">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-3">How did you find this assignment?</label>
                    <div class="grid grid-cols-4 gap-2">
                        <label class="difficulty-option">
                            <input type="radio" class="sr-only peer" name="DifficultyFeedback" id="tooEasy" value="TooEasy">
                            <span class="block w-full text-center px-3 py-2 border-2 rounded-lg cursor-pointer transition-all
                                         border-gray-200 text-gray-700
                                         peer-checked:border-green-500 peer-checked:bg-green-50 peer-checked:text-green-700
                                         hover:border-green-300">
                                Too Easy
                            </span>
                        </label>

                        <label class="difficulty-option">
                            <input type="radio" class="sr-only peer" name="DifficultyFeedback" id="justRight" value="JustRight">
                            <span class="block w-full text-center px-3 py-2 border-2 rounded-lg cursor-pointer transition-all
                                         border-gray-200 text-gray-700
                                         peer-checked:border-indigo-500 peer-checked:bg-indigo-50 peer-checked:text-indigo-700
                                         hover:border-indigo-300">
                                Just Right
                            </span>
                        </label>

                        <label class="difficulty-option">
                            <input type="radio" class="sr-only peer" name="DifficultyFeedback" id="challenging" value="Challenging">
                            <span class="block w-full text-center px-3 py-2 border-2 rounded-lg cursor-pointer transition-all
                                         border-gray-200 text-gray-700
                                         peer-checked:border-yellow-500 peer-checked:bg-yellow-50 peer-checked:text-yellow-700
                                         hover:border-yellow-300">
                                Challenging
                            </span>
                        </label>

                        <label class="difficulty-option">
                            <input type="radio" class="sr-only peer" name="DifficultyFeedback" id="tooHard" value="TooHard">
                            <span class="block w-full text-center px-3 py-2 border-2 rounded-lg cursor-pointer transition-all
                                         border-gray-200 text-gray-700
                                         peer-checked:border-red-500 peer-checked:bg-red-50 peer-checked:text-red-700
                                         hover:border-red-300">
                                Too Hard
                            </span>
                        </label>
                    </div>
                </div>
                <div>
                    <label for="studentNotes" class="block text-sm font-medium text-gray-700 mb-2">Any notes or questions for your teacher?</label>
                    <textarea class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                              id="studentNotes" name="StudentNotes" rows="2"
                              placeholder="Optional: Leave a note about any questions or difficulties..."></textarea>
                </div>
            </div>
        </div>

        <!-- Submit Button -->
        <div class="flex justify-between">
            <a asp-action="Index" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Save & Exit
            </a>
            <button type="submit" class="inline-flex items-center px-6 py-3 border border-transparent rounded-md shadow-sm text-base font-medium text-white bg-indigo-600 hover:bg-indigo-700" id="submitBtn">
                <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Submit Assignment
            </button>
        </div>
    </form>
</div>

@section Scripts {
<script>
    const questionsJson = @Html.Raw(Model.QuestionsJson);
    const answers = {};
    let startTime = Date.now();
    let timerInterval;

    // Initialize
    document.addEventListener('DOMContentLoaded', function() {
        renderQuestions();
        startTimer();
    });

    function startTimer() {
        timerInterval = setInterval(function() {
            const elapsed = Math.floor((Date.now() - startTime) / 1000);
            const minutes = Math.floor(elapsed / 60).toString().padStart(2, '0');
            const seconds = (elapsed % 60).toString().padStart(2, '0');
            document.getElementById('timer').textContent = `${minutes}:${seconds}`;
        }, 1000);
    }

    function renderQuestions() {
        const container = document.getElementById('questionsContainer');
        container.innerHTML = '';

        questionsJson.forEach((q, index) => {
            const questionCard = document.createElement('div');
            questionCard.className = 'bg-white rounded-lg shadow mb-6';
            questionCard.innerHTML = `
                <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                    <span class="font-medium text-gray-900">Question ${index + 1}</span>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">${q.points || 1} pt${(q.points || 1) > 1 ? 's' : ''}</span>
                </div>
                <div class="p-6">
                    ${renderQuestion(q, index)}
                </div>
            `;
            container.appendChild(questionCard);
        });
    }

    function renderQuestion(q, index) {
        const questionId = q.id || index;

        switch (q.type?.toLowerCase()) {
            case 'multiplechoice':
            case 'multiple_choice':
                return renderMultipleChoice(q, questionId);
            case 'fillintheblank':
            case 'fill_in_the_blank':
                return renderFillInTheBlank(q, questionId);
            case 'translation':
                return renderTranslation(q, questionId);
            case 'matching':
                return renderMatching(q, questionId);
            case 'shortanswer':
            case 'short_answer':
                return renderShortAnswer(q, questionId);
            default:
                return renderShortAnswer(q, questionId);
        }
    }

    function renderMultipleChoice(q, questionId) {
        let html = `<p class="mb-4 text-gray-900">${escapeHtml(q.question)}</p>`;
        if (q.options && Array.isArray(q.options)) {
            q.options.forEach((opt, i) => {
                const optId = `q${questionId}_opt${i}`;
                html += `
                    <label class="flex items-center mb-3 cursor-pointer">
                        <input type="radio" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300"
                               name="q${questionId}" id="${optId}" value="${escapeHtml(opt)}"
                               onchange="setAnswer(${questionId}, '${escapeHtml(opt)}')">
                        <span class="ml-3 text-gray-700">${escapeHtml(opt)}</span>
                    </label>
                `;
            });
        }
        return html;
    }

    function renderFillInTheBlank(q, questionId) {
        let questionText = q.question || '';
        // Replace blanks with input fields
        let blankCount = 0;
        questionText = questionText.replace(/_{2,}|\[blank\]|\{\{blank\}\}/gi, () => {
            blankCount++;
            return `<input type="text" class="inline-block w-40 mx-1 px-3 py-1 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500"
                           id="q${questionId}_blank${blankCount}"
                           onchange="setFillInBlankAnswer(${questionId})">`;
        });

        return `<p class="text-gray-900">${questionText}</p>`;
    }

    function renderTranslation(q, questionId) {
        const direction = q.direction || 'Spanish to English';
        return `
            <p class="mb-2 font-medium text-gray-600">${direction}</p>
            <p class="mb-4 text-xl text-gray-900">${escapeHtml(q.question)}</p>
            <textarea class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" rows="2" id="q${questionId}"
                      placeholder="Enter your translation..."
                      onchange="setAnswer(${questionId}, this.value)"></textarea>
        `;
    }

    function renderMatching(q, questionId) {
        let html = `<p class="mb-4 text-gray-900">${escapeHtml(q.question || 'Match the items:')}</p>`;
        if (q.pairs && Array.isArray(q.pairs)) {
            html += '<div class="grid grid-cols-1 md:grid-cols-2 gap-3">';
            q.pairs.forEach((pair, i) => {
                html += `
                    <div class="flex items-center">
                        <span class="px-3 py-2 bg-gray-100 border border-r-0 border-gray-300 rounded-l-md text-gray-700">${escapeHtml(pair.left || pair.term)}</span>
                        <select class="flex-1 border-gray-300 rounded-r-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" onchange="setMatchAnswer(${questionId}, ${i}, this.value)">
                            <option value="">Select...</option>
                            ${(q.rightOptions || q.pairs.map(p => p.right || p.definition)).map(opt =>
                                `<option value="${escapeHtml(opt)}">${escapeHtml(opt)}</option>`
                            ).join('')}
                        </select>
                    </div>
                `;
            });
            html += '</div>';
        }
        return html;
    }

    function renderShortAnswer(q, questionId) {
        return `
            <p class="mb-4 text-gray-900">${escapeHtml(q.question)}</p>
            <textarea class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" rows="3" id="q${questionId}"
                      placeholder="Enter your answer..."
                      onchange="setAnswer(${questionId}, this.value)"></textarea>
        `;
    }

    function setAnswer(questionId, value) {
        answers[questionId] = value;
    }

    function setFillInBlankAnswer(questionId) {
        const blanks = document.querySelectorAll(`[id^="q${questionId}_blank"]`);
        const values = Array.from(blanks).map(b => b.value);
        answers[questionId] = values.length === 1 ? values[0] : values;
    }

    function setMatchAnswer(questionId, pairIndex, value) {
        if (!answers[questionId]) answers[questionId] = {};
        answers[questionId][pairIndex] = value;
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Form submission
    document.getElementById('assignmentForm').addEventListener('submit', function(e) {
        const elapsed = Math.floor((Date.now() - startTime) / 1000);
        document.getElementById('timeTakenSeconds').value = elapsed;

        // Convert answers to array format
        const answersArray = questionsJson.map((q, index) => {
            const questionId = q.id || index;
            return {
                questionId: questionId,
                answer: answers[questionId] || ''
            };
        });

        document.getElementById('answersJson').value = JSON.stringify(answersArray);

        // Confirm submission
        const unanswered = answersArray.filter(a => !a.answer || (typeof a.answer === 'string' && !a.answer.trim())).length;
        if (unanswered > 0) {
            if (!confirm(`You have ${unanswered} unanswered question(s). Submit anyway?`)) {
                e.preventDefault();
            }
        }
    });

    // Warn before leaving
    window.addEventListener('beforeunload', function(e) {
        if (Object.keys(answers).length > 0) {
            e.preventDefault();
            e.returnValue = '';
        }
    });
</script>
}
