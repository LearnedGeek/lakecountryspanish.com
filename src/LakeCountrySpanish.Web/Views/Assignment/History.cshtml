@model IEnumerable<LakeCountrySpanish.Web.Models.Entities.AssignmentSubmission>
@{
    ViewData["Title"] = "Assignment History";
}

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-900">Assignment History</h1>
        <a asp-action="Index" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to Assignments
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-12">
            <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"/>
            </svg>
            <h3 class="mt-4 text-lg font-medium text-gray-900">No submissions yet</h3>
            <p class="mt-2 text-gray-500">Complete some assignments to see your history here!</p>
            <a asp-action="Index" class="mt-4 inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700">
                View Assignments
            </a>
        </div>
    }
    else
    {
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Assignment</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Score</th>
                            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Correct</th>
                            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Points</th>
                            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Time</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"></th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var submission in Model)
                        {
                            var scoreColor = submission.PercentageScore >= 80 ? "text-green-600" :
                                             submission.PercentageScore >= 60 ? "text-yellow-600" : "text-red-600";
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4">
                                    <p class="font-medium text-gray-900">@submission.Assignment.Title</p>
                                    <p class="text-sm text-gray-500">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
                                            @submission.Assignment.CefrLevel
                                        </span>
                                        <span class="ml-2">@submission.Assignment.Type</span>
                                    </p>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <p class="text-sm text-gray-900">@submission.SubmittedAt.ToString("MMM d, yyyy")</p>
                                    <p class="text-sm text-gray-500">@submission.SubmittedAt.ToString("h:mm tt")</p>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <span class="text-lg font-bold @scoreColor">
                                        @submission.PercentageScore.ToString("0")%
                                    </span>
                                    @if (submission.PercentageScore == 100)
                                    {
                                        <span class="ml-1 text-yellow-500">⭐</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm text-gray-900">
                                    @submission.CorrectAnswers / @submission.TotalQuestions
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <span class="font-bold text-indigo-600">+@submission.PointsEarned</span>
                                    @if (submission.BonusPointsEarned > 0)
                                    {
                                        <br>
                                        <span class="text-xs text-green-600">+@submission.BonusPointsEarned bonus</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm text-gray-900">
                                    @{
                                        var time = TimeSpan.FromSeconds(submission.TimeTakenSeconds);
                                    }
                                    @time.ToString(@"mm\:ss")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right">
                                    <a asp-action="Results" asp-route-id="@submission.Id"
                                       class="inline-flex items-center px-3 py-1.5 border border-indigo-600 text-xs font-medium rounded text-indigo-600 bg-white hover:bg-indigo-50">
                                        <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Summary Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
            <div class="bg-white rounded-lg shadow p-4 text-center">
                <p class="text-3xl font-bold text-indigo-600">@Model.Count()</p>
                <p class="text-sm text-gray-500">Total Submissions</p>
            </div>
            <div class="bg-white rounded-lg shadow p-4 text-center">
                @{
                    var avgScore = Model.Any() ? Model.Average(s => s.PercentageScore) : 0;
                    var avgColor = avgScore >= 80 ? "text-green-600" : avgScore >= 60 ? "text-yellow-600" : "text-red-600";
                }
                <p class="text-3xl font-bold @avgColor">@avgScore.ToString("0")%</p>
                <p class="text-sm text-gray-500">Average Score</p>
            </div>
            <div class="bg-white rounded-lg shadow p-4 text-center">
                <p class="text-3xl font-bold text-green-600">@Model.Count(s => s.PercentageScore == 100)</p>
                <p class="text-sm text-gray-500">Perfect Scores</p>
            </div>
            <div class="bg-white rounded-lg shadow p-4 text-center">
                <p class="text-3xl font-bold text-indigo-600">@Model.Sum(s => s.PointsEarned + s.BonusPointsEarned)</p>
                <p class="text-sm text-gray-500">Total Points Earned</p>
            </div>
        </div>
    }
</div>
