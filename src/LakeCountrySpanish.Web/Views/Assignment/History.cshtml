@model IEnumerable<LakeCountrySpanish.Web.Models.Entities.AssignmentSubmission>
@{
    ViewData["Title"] = "Assignment History";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Assignment History</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Assignments
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-journal-x display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No submissions yet</h4>
            <p class="text-muted">Complete some assignments to see your history here!</p>
            <a asp-action="Index" class="btn btn-primary mt-2">
                View Assignments
            </a>
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Assignment</th>
                            <th>Date</th>
                            <th class="text-center">Score</th>
                            <th class="text-center">Correct</th>
                            <th class="text-center">Points</th>
                            <th class="text-center">Time</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var submission in Model)
                        {
                            var scoreClass = submission.PercentageScore >= 80 ? "text-success" :
                                             submission.PercentageScore >= 60 ? "text-warning" : "text-danger";
                            <tr>
                                <td>
                                    <strong>@submission.Assignment.Title</strong>
                                    <br>
                                    <small class="text-muted">
                                        <span class="badge bg-secondary">@submission.Assignment.CefrLevel</span>
                                        @submission.Assignment.Type
                                    </small>
                                </td>
                                <td>
                                    @submission.SubmittedAt.ToString("MMM d, yyyy")
                                    <br>
                                    <small class="text-muted">@submission.SubmittedAt.ToString("h:mm tt")</small>
                                </td>
                                <td class="text-center">
                                    <span class="fs-5 fw-bold @scoreClass">
                                        @submission.PercentageScore.ToString("0")%
                                    </span>
                                    @if (submission.PercentageScore == 100)
                                    {
                                        <i class="bi bi-star-fill text-warning"></i>
                                    }
                                </td>
                                <td class="text-center">
                                    @submission.CorrectAnswers / @submission.TotalQuestions
                                </td>
                                <td class="text-center">
                                    <span class="text-primary fw-bold">+@submission.PointsEarned</span>
                                    @if (submission.BonusPointsEarned > 0)
                                    {
                                        <br>
                                        <small class="text-success">+@submission.BonusPointsEarned bonus</small>
                                    }
                                </td>
                                <td class="text-center">
                                    @{
                                        var time = TimeSpan.FromSeconds(submission.TimeTakenSeconds);
                                    }
                                    @time.ToString(@"mm\:ss")
                                </td>
                                <td class="text-end">
                                    <a asp-action="Results" asp-route-id="@submission.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Summary Stats -->
        <div class="row g-3 mt-4">
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h3 class="text-primary">@Model.Count()</h3>
                        <small class="text-muted">Total Submissions</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        @{
                            var avgScore = Model.Any() ? Model.Average(s => s.PercentageScore) : 0;
                        }
                        <h3 class="@(avgScore >= 80 ? "text-success" : avgScore >= 60 ? "text-warning" : "text-danger")">
                            @avgScore.ToString("0")%
                        </h3>
                        <small class="text-muted">Average Score</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h3 class="text-success">@Model.Count(s => s.PercentageScore == 100)</h3>
                        <small class="text-muted">Perfect Scores</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h3 class="text-primary">@Model.Sum(s => s.PointsEarned + s.BonusPointsEarned)</h3>
                        <small class="text-muted">Total Points Earned</small>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
