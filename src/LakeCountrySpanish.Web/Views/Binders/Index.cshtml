@model LakeCountrySpanish.Web.Models.ViewModels.BinderListViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Teacher Binders";
    var canAuthor = User.IsInRole(LakeCountrySpanish.Web.AppRoles.Admin)
                 || User.IsInRole(LakeCountrySpanish.Web.AppRoles.Author);
}

<div class="bg-gray-100 min-h-screen">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">

        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-6">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Teacher Binders</h1>
                <p class="text-sm text-gray-600 mt-1">
                    Curriculum documents grouped by program family. Every program that shares a family shares the same binder.
                </p>
            </div>
            @if (canAuthor)
            {
                <a href="@Url.Action("Upload")"
                   class="inline-flex items-center gap-2 px-6 py-3 bg-indigo-600 text-white text-base font-bold rounded-xl shadow-lg shadow-indigo-500/30 hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-500/30 transition-all">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                    </svg>
                    Upload binder
                </a>
            }
        </div>

        @if (TempData["SuccessMessage"] is string success)
        {
            <div class="mb-6 rounded-xl border-2 border-emerald-300 bg-emerald-50 p-4 shadow-sm text-sm text-emerald-900">
                @success
            </div>
        }

        @if (canAuthor && Model.FamiliesWithoutBinders.Count > 0)
        {
            <div class="mb-6 rounded-xl border-2 border-amber-300 bg-amber-50 p-4 shadow-sm">
                <div class="flex items-start gap-2">
                    <span class="text-2xl leading-none mt-0.5" aria-hidden="true">📄</span>
                    <div class="flex-1 text-sm text-amber-900">
                        <div class="font-bold mb-1">@Model.FamiliesWithoutBinders.Count curriculum @(Model.FamiliesWithoutBinders.Count == 1 ? "family has" : "families have") no binder yet</div>
                        <p class="mb-2">Programs referencing these families are running without a teacher binder:</p>
                        <ul class="space-y-1">
                            @foreach (var family in Model.FamiliesWithoutBinders)
                            {
                                <li>
                                    <a asp-action="Upload" asp-route-family="@family" class="font-mono underline hover:no-underline">@family</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        @if (Model.FamilyGroups.Count == 0 && Model.FamiliesWithoutBinders.Count == 0)
        {
            <div class="bg-white rounded-2xl shadow-md border-2 border-dashed border-gray-300 p-12 text-center">
                <div class="text-5xl mb-3">📄</div>
                <p class="text-lg font-bold text-gray-800">No binders uploaded yet</p>
                @if (canAuthor)
                {
                    <p class="text-sm text-gray-600 mt-2">
                        Attach a curriculum family to a program via <a asp-controller="AdminPrograms" asp-action="Index" class="text-indigo-700 underline hover:no-underline">Manage Programs</a>, then upload a PDF here.
                    </p>
                }
                else
                {
                    <p class="text-sm text-gray-600 mt-2">Ask Karen or Cece to upload the teacher binders.</p>
                }
            </div>
        }

        <div class="space-y-6">
            @foreach (var group in Model.FamilyGroups)
            {
                <section class="bg-white rounded-2xl shadow-md overflow-hidden">
                    <header class="border-b border-gray-100 px-6 py-4 bg-indigo-50/40 flex items-center justify-between">
                        <div>
                            <h2 class="text-xl font-bold text-gray-900 flex items-baseline gap-2">
                                <span class="font-mono">@group.CurriculumFamily</span>
                                <span class="text-xs font-semibold text-gray-500">@group.ProgramCount program@(group.ProgramCount == 1 ? "" : "s") using this family</span>
                            </h2>
                        </div>
                        @if (canAuthor)
                        {
                            <a asp-action="Upload" asp-route-family="@group.CurriculumFamily" class="text-sm font-semibold text-indigo-700 hover:text-indigo-900">
                                + Add / replace
                            </a>
                        }
                    </header>
                    <ul class="divide-y divide-gray-100">
                        @foreach (var doc in group.Documents)
                        {
                            var bandLabel = LakeCountrySpanish.Web.Services.Programs.ProgramAudienceDisplay
                                .GradeLabel(LakeCountrySpanish.Web.Models.Entities.AudienceType.Grades,
                                            doc.GradeBands.Select(g => g.GradeBand))
                                ?? "All grades";
                            var sizeKb = (doc.FileSizeBytes + 1023) / 1024;
                            var updated = doc.UpdatedAt ?? doc.UploadedAt;
                            <li class="px-6 py-4 flex flex-col sm:flex-row sm:items-center gap-4">
                                <div class="flex-1 min-w-0">
                                    <div class="text-base font-semibold text-gray-900">@doc.Title</div>
                                    <div class="text-xs text-gray-600 mt-0.5">
                                        <span class="font-semibold">@doc.DocumentType</span>
                                        <span class="text-gray-300">·</span>
                                        <span>@bandLabel</span>
                                        <span class="text-gray-300">·</span>
                                        <span>@(sizeKb < 1024 ? $"{sizeKb} KB" : $"{sizeKb / 1024.0:F1} MB")</span>
                                        <span class="text-gray-300">·</span>
                                        <span>Updated @updated.ToString("MMM d, yyyy")</span>
                                    </div>
                                </div>
                                <div class="flex flex-wrap items-center gap-2">
                                    <a asp-action="Download" asp-route-id="@doc.Id"
                                       class="inline-flex items-center gap-1 px-4 py-2 bg-indigo-600 text-white text-sm font-bold rounded-lg shadow-sm hover:bg-indigo-700">
                                        ⬇ Download
                                    </a>
                                    @if (canAuthor)
                                    {
                                        <a asp-action="Upload" asp-route-family="@doc.CurriculumFamily" asp-route-docType="@doc.DocumentType"
                                           class="inline-flex items-center gap-1 px-3 py-2 bg-white border-2 border-gray-300 text-gray-700 text-sm font-semibold rounded-lg hover:bg-gray-50">
                                            Replace
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@doc.Id" method="post"
                                              onsubmit="return confirm('Delete this binder? Teachers will lose access to the PDF.');" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="inline-flex items-center gap-1 px-3 py-2 bg-white border-2 border-red-400 text-red-700 text-sm font-semibold rounded-lg hover:bg-red-50">
                                                Delete
                                            </button>
                                        </form>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    </div>
</div>
