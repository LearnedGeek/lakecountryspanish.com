@model LakeCountrySpanish.Web.Models.ViewModels.SubscriptionManageViewModel
@{
    ViewData["Title"] = "Manage Subscription";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Manage Subscription</h1>
            <p class="mt-2 text-gray-600">View and manage your subscription settings.</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="mb-6 rounded-md bg-green-50 p-4">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm font-medium text-green-800">@TempData["Success"]</p>
                    </div>
                </div>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="mb-6 rounded-md bg-red-50 p-4">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm font-medium text-red-800">@TempData["Error"]</p>
                    </div>
                </div>
            </div>
        }

        @if (Model.CurrentSubscription == null)
        {
            <!-- No Active Subscription -->
            <div class="bg-white rounded-lg shadow p-8 text-center">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <h3 class="mt-4 text-lg font-medium text-gray-900">No Active Subscription</h3>
                <p class="mt-2 text-gray-500">Start a subscription to enjoy automatic scheduling and exclusive benefits.</p>
                <a href="@Url.Action("Plans")" class="mt-6 inline-flex items-center px-4 py-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700">
                    View Plans
                </a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Subscription Overview -->
                <div class="lg:col-span-2 space-y-6">
                    <!-- Current Plan Card -->
                    <div class="bg-white rounded-lg shadow">
                        <div class="p-6 border-b border-gray-200">
                            <div class="flex items-center justify-between">
                                <h2 class="text-lg font-semibold text-gray-900">Current Plan</h2>
                                <span class="@Model.StatusBadgeClass px-3 py-1 rounded-full text-sm font-medium">
                                    @Model.StatusDisplay
                                </span>
                            </div>
                        </div>
                        <div class="p-6">
                            <div class="flex items-center justify-between mb-6">
                                <div>
                                    <h3 class="text-2xl font-bold text-gray-900">@Model.CurrentSubscription.Tier?.Name</h3>
                                    <p class="text-gray-500">@Model.CurrentSubscription.Tier?.Description</p>
                                </div>
                                <div class="text-right">
                                    <p class="text-3xl font-bold text-gray-900">$@Model.CurrentSubscription.Tier?.MonthlyPrice.ToString("0.00")</p>
                                    <p class="text-gray-500">per month</p>
                                </div>
                            </div>

                            <!-- Class Usage Progress -->
                            <div class="mb-6">
                                <div class="flex justify-between text-sm mb-2">
                                    <span class="text-gray-600">Classes this month</span>
                                    <span class="font-medium">@Model.CurrentSubscription.ClassesUsedThisMonth / @Model.ClassesPerMonth</span>
                                </div>
                                <div class="w-full bg-gray-200 rounded-full h-2">
                                    @{
                                        var usagePercent = Model.ClassesPerMonth > 0
                                            ? (double)Model.CurrentSubscription.ClassesUsedThisMonth / Model.ClassesPerMonth * 100
                                            : 0;
                                    }
                                    <div class="bg-blue-600 h-2 rounded-full" style="width: @usagePercent%"></div>
                                </div>
                                <p class="mt-2 text-sm text-gray-500">@Model.ClassesRemaining classes remaining this month</p>
                            </div>

                            <!-- Billing Period -->
                            <div class="grid grid-cols-2 gap-4 text-sm">
                                <div>
                                    <p class="text-gray-500">Current Period</p>
                                    <p class="font-medium">
                                        @Model.CurrentSubscription.CurrentPeriodStart?.ToString("MMM d") - @Model.CurrentSubscription.CurrentPeriodEnd?.ToString("MMM d, yyyy")
                                    </p>
                                </div>
                                <div>
                                    <p class="text-gray-500">Next Billing</p>
                                    <p class="font-medium">@Model.CurrentSubscription.CurrentPeriodEnd?.ToString("MMMM d, yyyy")</p>
                                </div>
                            </div>

                            @if (Model.IsCancellationPending)
                            {
                                <div class="mt-6 p-4 bg-yellow-50 rounded-lg">
                                    <p class="text-sm text-yellow-800">
                                        <strong>Cancellation Scheduled:</strong> Your subscription will end on @Model.EffectiveCancellationDate?.ToString("MMMM d, yyyy").
                                    </p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Recurring Schedule -->
                    <div class="bg-white rounded-lg shadow">
                        <div class="p-6 border-b border-gray-200">
                            <h2 class="text-lg font-semibold text-gray-900">Recurring Schedule</h2>
                            <p class="text-sm text-gray-500 mt-1">Your preferred class times for automatic scheduling</p>
                        </div>
                        <div class="p-6">
                            @if (Model.RecurringSchedules.Any())
                            {
                                <ul class="space-y-3">
                                    @foreach (var schedule in Model.RecurringSchedules)
                                    {
                                        <li class="flex items-center justify-between py-3 border-b border-gray-100 last:border-0">
                                            <div class="flex items-center">
                                                <svg class="h-5 w-5 text-blue-500 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                </svg>
                                                <span class="font-medium text-gray-900">@schedule.DayOfWeek</span>
                                            </div>
                                            <span class="text-gray-600">@schedule.Time.ToString(@"hh\:mm")</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-gray-500">No recurring schedule set. Set your preferred class times to have classes automatically scheduled each month.</p>
                            }

                            <button type="button"
                                    onclick="document.getElementById('scheduleModal').classList.remove('hidden')"
                                    class="mt-4 w-full px-4 py-2 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200">
                                @(Model.RecurringSchedules.Any() ? "Update Schedule" : "Set Schedule")
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Actions Sidebar -->
                <div class="space-y-6">
                    <!-- Quick Actions -->
                    <div class="bg-white rounded-lg shadow p-6">
                        <h2 class="text-lg font-semibold text-gray-900 mb-4">Quick Actions</h2>
                        <div class="space-y-3">
                            <a href="@Url.Action("Portal")"
                               class="block w-full px-4 py-2 text-center bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700">
                                Manage Billing
                            </a>

                            <a href="@Url.Action("Plans")"
                               class="block w-full px-4 py-2 text-center bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200">
                                View Plans
                            </a>

                            @if (Model.IsPaused)
                            {
                                <form method="post" asp-action="Resume">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="subscriptionId" value="@Model.CurrentSubscription.Id" />
                                    <button type="submit"
                                            class="block w-full px-4 py-2 text-center bg-green-600 text-white font-medium rounded-lg hover:bg-green-700">
                                        Resume Subscription
                                    </button>
                                </form>
                            }
                            else if (Model.IsActive && !Model.IsCancellationPending)
                            {
                                <button type="button"
                                        onclick="document.getElementById('pauseModal').classList.remove('hidden')"
                                        class="block w-full px-4 py-2 text-center bg-yellow-100 text-yellow-800 font-medium rounded-lg hover:bg-yellow-200">
                                    Pause Subscription
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Cancellation -->
                    @if (Model.IsActive && !Model.IsCancellationPending)
                    {
                        <div class="bg-white rounded-lg shadow p-6">
                            <h2 class="text-lg font-semibold text-gray-900 mb-4">Cancel Subscription</h2>
                            <p class="text-sm text-gray-500 mb-4">
                                @if (Model.CanCancelThisMonth)
                                {
                                    <text>Your subscription will end on @Model.EffectiveCancellationDate?.ToString("MMMM d, yyyy").</text>
                                }
                                else
                                {
                                    <text>Since it's past the 3rd week, cancellation will take effect on @Model.EffectiveCancellationDate?.ToString("MMMM d, yyyy").</text>
                                }
                            </p>
                            <form method="post" asp-action="RequestCancellation"
                                  onsubmit="return confirm('Are you sure you want to cancel your subscription?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="subscriptionId" value="@Model.CurrentSubscription.Id" />
                                <button type="submit"
                                        class="w-full px-4 py-2 text-center bg-red-100 text-red-700 font-medium rounded-lg hover:bg-red-200">
                                    Request Cancellation
                                </button>
                            </form>
                        </div>
                    }

                    <!-- Subscription History -->
                    @if (Model.AllSubscriptions.Count() > 1)
                    {
                        <div class="bg-white rounded-lg shadow p-6">
                            <h2 class="text-lg font-semibold text-gray-900 mb-4">Subscription History</h2>
                            <ul class="space-y-3 text-sm">
                                @foreach (var sub in Model.AllSubscriptions.Skip(1).Take(5))
                                {
                                    <li class="flex justify-between">
                                        <span class="text-gray-600">@sub.Tier?.Name</span>
                                        <span class="text-gray-500">@sub.StartDate.ToString("MMM yyyy")</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Pause Modal -->
<div id="pauseModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
        <div class="mt-3">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Pause Subscription</h3>
            <form method="post" asp-action="Pause">
                @Html.AntiForgeryToken()
                <input type="hidden" name="subscriptionId" value="@Model.CurrentSubscription?.Id" />

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Resume Date</label>
                    <input type="date" name="resumeDate"
                           min="@DateTime.Now.AddDays(7).ToString("yyyy-MM-dd")"
                           max="@DateTime.Now.AddMonths(3).ToString("yyyy-MM-dd")"
                           required
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500" />
                </div>

                <div class="flex justify-end space-x-3">
                    <button type="button"
                            onclick="document.getElementById('pauseModal').classList.add('hidden')"
                            class="px-4 py-2 text-gray-700 bg-gray-100 rounded-md hover:bg-gray-200">
                        Cancel
                    </button>
                    <button type="submit" class="px-4 py-2 bg-yellow-600 text-white rounded-md hover:bg-yellow-700">
                        Pause Subscription
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Schedule Modal -->
<div id="scheduleModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
    <div class="relative top-10 mx-auto p-5 border w-full max-w-lg shadow-lg rounded-md bg-white">
        <div class="mt-3">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Set Recurring Schedule</h3>
            <p class="text-sm text-gray-500 mb-4">Choose your preferred days and times for classes.</p>

            <form method="post" asp-action="SetSchedule">
                @Html.AntiForgeryToken()
                <input type="hidden" name="subscriptionId" value="@Model.CurrentSubscription?.Id" />

                <div class="space-y-4 max-h-96 overflow-y-auto">
                    @{
                        var daysOfWeek = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday };
                        var index = 0;
                    }
                    @foreach (var day in daysOfWeek)
                    {
                        var existingSchedule = Model.RecurringSchedules.FirstOrDefault(s => s.DayOfWeek == day);
                        <div class="border rounded-lg p-4">
                            <div class="flex items-center justify-between mb-2">
                                <label class="flex items-center">
                                    <input type="checkbox"
                                           name="schedules[@index].IsSelected"
                                           value="true"
                                           @(existingSchedule != null ? "checked" : "")
                                           class="h-4 w-4 text-blue-600 rounded" />
                                    <span class="ml-2 font-medium text-gray-900">@day</span>
                                </label>
                            </div>
                            <div class="ml-6">
                                <select name="schedules[@index].TimeSlotId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                                    @foreach (var slot in Model.AvailableTimeSlots)
                                    {
                                        var isSelected = existingSchedule?.TimeSlotId == slot.Id;
                                        if (isSelected)
                                        {
                                            <option value="@slot.Id" selected>
                                                @slot.StartTime.ToString(@"h\:mm tt")
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@slot.Id">
                                                @slot.StartTime.ToString(@"h\:mm tt")
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                            <input type="hidden" name="schedules[@index].DayOfWeek" value="@((int)day)" />
                            <input type="hidden" name="schedules[@index].Time" value="@(existingSchedule?.Time.ToString(@"hh\:mm") ?? "09:00")" />
                        </div>
                        index++;
                    }
                </div>

                <div class="flex justify-end space-x-3 mt-6">
                    <button type="button"
                            onclick="document.getElementById('scheduleModal').classList.add('hidden')"
                            class="px-4 py-2 text-gray-700 bg-gray-100 rounded-md hover:bg-gray-200">
                        Cancel
                    </button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
                        Save Schedule
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
