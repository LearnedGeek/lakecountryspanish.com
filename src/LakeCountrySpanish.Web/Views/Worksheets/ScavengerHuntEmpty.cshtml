@model string
@{
    ViewData["Title"] = "No worksheet yet";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="bg-white rounded-xl shadow-lg p-8 text-center border border-gray-100">
            <h1 class="text-2xl font-bold text-gray-900 mb-3">No worksheet yet for theme "@Model"</h1>
            <p class="text-gray-600 mb-6">
                The vocab terms exist, but none of them have an image generated yet. Generate
                the images first, then come back.
            </p>
            <a href="/Admin/Vocab" class="inline-flex items-center px-4 py-2 bg-secondary-500 text-white font-medium rounded-lg hover:bg-secondary-600 transition shadow-md">
                Go to Vocab Admin
            </a>
        </div>
    </div>
</div>
