@model IEnumerable<LakeCountrySpanish.Web.Models.Entities.Package>
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<div class="relative bg-gradient-to-r from-primary-600 to-primary-700 overflow-hidden">
    <div class="mx-auto max-w-7xl">
        <div class="relative z-10 pb-8 sm:pb-16 md:pb-20 lg:pb-28 xl:pb-32 pt-10 lg:pt-20">
            <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                <div class="lg:grid lg:grid-cols-12 lg:gap-8">
                    <div class="sm:text-center md:mx-auto lg:col-span-6 lg:text-left">
                        <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">
                            <span class="block">Learn Spanish</span>
                            <span class="block text-secondary-400">with a Native Speaker</span>
                        </h1>
                        <p class="mt-3 text-base text-gray-100 sm:mx-auto sm:mt-5 sm:max-w-xl sm:text-lg md:mt-5 md:text-xl lg:mx-0">
                            Personalized online Spanish lessons with Karen, a native Peruvian teacher.
                            Learn conversational Spanish, improve your pronunciation, and discover Latin American culture.
                        </p>
                        <div class="mt-5 sm:mt-8 sm:flex sm:justify-center lg:justify-start">
                            <div class="rounded-md shadow">
                                <a asp-controller="Contact" asp-action="Index" class="flex w-full items-center justify-center rounded-md border border-transparent bg-secondary-500 px-8 py-3 text-base font-medium text-white hover:bg-secondary-600 md:py-4 md:px-10 md:text-lg transition">
                                    Get Started
                                </a>
                            </div>
                            <div class="mt-3 sm:mt-0 sm:ml-3">
                                <a asp-controller="Home" asp-action="About" class="flex w-full items-center justify-center rounded-md border border-white px-8 py-3 text-base font-medium text-white hover:bg-primary-500 md:py-4 md:px-10 md:text-lg transition">
                                    Learn More
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="mt-12 lg:col-span-6 lg:mt-0">
                        <div class="bg-white rounded-xl shadow-xl p-8">
                            <h3 class="text-xl font-semibold text-gray-900 mb-4">Why Learn with Karen?</h3>
                            <ul class="space-y-4">
                                <li class="flex items-start">
                                    <svg class="h-6 w-6 text-green-500 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    <span class="text-gray-600">Native Peruvian speaker with clear pronunciation</span>
                                </li>
                                <li class="flex items-start">
                                    <svg class="h-6 w-6 text-green-500 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    <span class="text-gray-600">Personalized lessons tailored to your level</span>
                                </li>
                                <li class="flex items-start">
                                    <svg class="h-6 w-6 text-green-500 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    <span class="text-gray-600">Flexible online scheduling</span>
                                </li>
                                <li class="flex items-start">
                                    <svg class="h-6 w-6 text-green-500 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    <span class="text-gray-600">Cultural insights and real-world conversation</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
</div>

<!-- Pricing Section -->
<div class="bg-gray-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center">
            <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Simple, Transparent Pricing</h2>
            <p class="mt-4 text-lg text-gray-600">Choose the package that works best for your learning goals</p>
        </div>

        <div class="mt-12 grid gap-8 lg:grid-cols-4">
            @foreach (var package in Model)
            {
                var isPopular = package.ClassCount == 10;
                <div class="relative flex flex-col rounded-2xl border @(isPopular ? "border-primary-500 border-2" : "border-gray-200") bg-white p-8 shadow-sm">
                    @if (isPopular)
                    {
                        <div class="absolute -top-4 left-1/2 -translate-x-1/2">
                            <span class="bg-primary-500 text-white text-sm font-semibold px-4 py-1 rounded-full">Most Popular</span>
                        </div>
                    }
                    <div class="flex-1">
                        <h3 class="text-xl font-semibold text-gray-900">@package.Name</h3>
                        <p class="mt-4 flex items-baseline">
                            <span class="text-4xl font-bold tracking-tight text-gray-900">$@package.Price.ToString("0")</span>
                            @if (package.ClassCount > 1)
                            {
                                <span class="ml-2 text-sm text-gray-500">($@((package.Price / package.ClassCount).ToString("0.00"))/class)</span>
                            }
                        </p>
                        <p class="mt-4 text-gray-600">@package.Description</p>
                        <ul class="mt-6 space-y-3">
                            <li class="flex items-center text-gray-600">
                                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                </svg>
                                @package.ClassCount hour-long @(package.ClassCount == 1 ? "lesson" : "lessons")
                            </li>
                            <li class="flex items-center text-gray-600">
                                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                </svg>
                                Personalized curriculum
                            </li>
                            <li class="flex items-center text-gray-600">
                                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                </svg>
                                Learning materials included
                            </li>
                        </ul>
                    </div>
                    <a asp-controller="Contact" asp-action="Index" class="mt-8 block w-full rounded-lg @(isPopular ? "bg-primary-600 hover:bg-primary-700" : "bg-gray-800 hover:bg-gray-900") py-3 text-center text-sm font-semibold text-white transition">
                        Get Started
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Testimonials Section -->
@{
    var testimonials = ViewBag.Testimonials as IEnumerable<LakeCountrySpanish.Web.Models.ViewModels.TestimonialDisplayViewModel>;
}
@if (testimonials != null && testimonials.Any())
{
    <div class="bg-white py-16">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="text-center">
                <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">What Students Say</h2>
                <p class="mt-4 text-lg text-gray-600">Hear from our satisfied learners</p>
            </div>

            <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                @foreach (var testimonial in testimonials.Take(6))
                {
                    <div class="bg-gray-50 rounded-xl p-6 shadow-sm">
                        <div class="flex items-center mb-4">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <svg class="h-5 w-5 @(i <= testimonial.Rating ? "text-yellow-400" : "text-gray-300")" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                </svg>
                            }
                        </div>
                        <p class="text-gray-700 italic">"@testimonial.Testimonial"</p>
                        <p class="mt-4 text-sm font-medium text-gray-900">- @testimonial.StudentFirstName</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- How It Works Section -->
<div class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center">
            <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">How It Works</h2>
            <p class="mt-4 text-lg text-gray-600">Getting started is easy</p>
        </div>

        <div class="mt-12 grid gap-8 md:grid-cols-3">
            <div class="text-center">
                <div class="mx-auto h-16 w-16 flex items-center justify-center rounded-full bg-primary-100 text-primary-600">
                    <span class="text-2xl font-bold">1</span>
                </div>
                <h3 class="mt-6 text-lg font-semibold text-gray-900">Contact Karen</h3>
                <p class="mt-2 text-gray-600">Fill out the contact form to introduce yourself and discuss your learning goals.</p>
            </div>
            <div class="text-center">
                <div class="mx-auto h-16 w-16 flex items-center justify-center rounded-full bg-primary-100 text-primary-600">
                    <span class="text-2xl font-bold">2</span>
                </div>
                <h3 class="mt-6 text-lg font-semibold text-gray-900">Schedule Classes</h3>
                <p class="mt-2 text-gray-600">Once enrolled, easily book lessons that fit your schedule through your student portal.</p>
            </div>
            <div class="text-center">
                <div class="mx-auto h-16 w-16 flex items-center justify-center rounded-full bg-primary-100 text-primary-600">
                    <span class="text-2xl font-bold">3</span>
                </div>
                <h3 class="mt-6 text-lg font-semibold text-gray-900">Start Learning</h3>
                <p class="mt-2 text-gray-600">Join your online lessons and begin your journey to Spanish fluency!</p>
            </div>
        </div>
    </div>
</div>

<!-- CTA Section -->
<div class="bg-primary-700">
    <div class="mx-auto max-w-7xl py-12 px-4 sm:px-6 lg:flex lg:items-center lg:justify-between lg:py-16 lg:px-8">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
            <span class="block">Ready to start learning?</span>
            <span class="block text-secondary-400">Contact Karen today!</span>
        </h2>
        <div class="mt-8 flex lg:mt-0 lg:flex-shrink-0">
            <div class="inline-flex rounded-md shadow">
                <a asp-controller="Contact" asp-action="Index" class="inline-flex items-center justify-center rounded-md border border-transparent bg-secondary-500 px-5 py-3 text-base font-medium text-white hover:bg-secondary-600 transition">
                    Get in Touch
                </a>
            </div>
        </div>
    </div>
</div>
