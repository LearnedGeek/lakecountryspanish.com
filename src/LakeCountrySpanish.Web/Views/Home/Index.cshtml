@model LakeCountrySpanish.Web.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["MetaDescription"] = "Spanish lessons in Lake Country Wisconsin with Karen and Cece, native Peruvian teachers. Serving Oconomowoc, Waukesha, Delafield, Hartland, Pewaukee & surrounding areas. Personalized online lessons with flexible scheduling.";
}

<!-- Hero Section. Photographic-llama-on-right + headline-on-left layout from
     Karen & Cece's 2026-05-30 mock. Four pillar pills overlay the photo on
     lg+ (APRENDE / EXPLORA / RESPETA / CONECTA) — the curriculum's value-prop
     split in Spanish. Replaces the prior polaroid-and-cartoon-Lola hero. -->
<div class="relative bg-gradient-to-br from-gray-50 via-teal-50 to-accent-50 overflow-x-clip">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-40 -right-40 w-80 h-80 bg-secondary-500/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-primary-500/10 rounded-full blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl">
        <div class="relative z-10 pb-10 sm:pb-12 lg:pb-12 pt-10 lg:pt-14">
            <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                <div class="lg:grid lg:grid-cols-12 lg:gap-10 items-center">

                    <!-- Left column: text + CTAs (~50% on lg+) -->
                    <div class="sm:text-center md:mx-auto lg:col-span-6 lg:text-left">
                        <p class="text-xs sm:text-sm font-bold tracking-[0.2em] uppercase text-primary-700 mb-3">
                            Real Spanish. Real culture. Real conversation.
                        </p>

                        <h1 class="font-display text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl md:text-6xl leading-[1.05]">
                            <span class="block">Learn Spanish.</span>
                            <span class="block text-primary-600 italic">Explore the World.</span>
                        </h1>
                        <p class="mt-5 text-lg text-gray-700 sm:mx-auto sm:max-w-xl md:text-xl lg:mx-0">
                            Every lesson is a new adventure through a Spanish-speaking country —
                            its food, music, history, famous people, and traditions.
                        </p>
                        <p class="mt-2 text-sm text-gray-500 sm:mx-auto sm:max-w-xl lg:mx-0">
                            Serving Lake Country Wisconsin: Oconomowoc, Waukesha, Delafield, Hartland, Pewaukee, Brookfield &amp; beyond
                        </p>

                        <div class="mt-8 sm:flex sm:justify-center lg:justify-start gap-4">
                            <a href="#pricing" class="flex w-full sm:w-auto items-center justify-center rounded-xl bg-secondary-500 px-8 py-4 text-base font-semibold text-white hover:bg-secondary-600 shadow-lg shadow-secondary-500/30 hover:shadow-secondary-500/40 transition-all hover:-translate-y-0.5">
                                Our Programs
                                <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                                </svg>
                            </a>
                            <a asp-controller="Contact" asp-action="Index" asp-route-subject="school-inquiry" class="mt-4 sm:mt-0 flex w-full sm:w-auto items-center justify-center rounded-xl border-2 border-primary-600 px-8 py-4 text-base font-semibold text-primary-700 hover:bg-primary-50 transition">
                                Bring LCS to Your School
                            </a>
                        </div>
                    </div>

                    <!-- Right column: photographic llama (~50% on lg+). No frame —
                         the image fades on its left edge into the hero background.
                         rounded-2xl softens the other three edges; a subtle
                         drop-shadow grounds it without the block/grid feeling.
                         Pills sit immediately below the photo so they read as
                         part of the same composition, not a separate strip. -->
                    <div class="mt-12 lg:col-span-6 lg:mt-0">
                        <img src="~/img/llama-hero.jpg"
                             alt="A white llama with a Peruvian textile blanket and pom pom necklace by a Lake Country lake at golden hour"
                             class="w-full object-cover aspect-[4/3] rounded-2xl"
                             style="-webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.5) 8%, black 22%, black 100%); mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.5) 8%, black 22%, black 100%); filter: drop-shadow(0 8px 20px rgba(30, 58, 138, 0.15));" />

                        <!-- Pillar pills directly under the photo, aligned to the
                             photo column. Reads as part of the same composition. -->
                        <div class="mt-5 flex flex-wrap items-center justify-center lg:justify-start gap-2">
                            <span class="hidden lg:inline text-xs font-bold tracking-[0.2em] uppercase text-gray-500 mr-1">We teach:</span>
                            <a href="#aprende" class="px-4 py-1.5 bg-white border border-primary-200 text-primary-800 text-xs font-semibold tracking-wider uppercase rounded-full shadow-sm hover:bg-primary-50 hover:border-primary-400 transition-all">Learn</a>
                            <a href="#explora" class="px-4 py-1.5 bg-teal-500 text-white text-xs font-semibold tracking-wider uppercase rounded-full shadow-sm hover:bg-teal-600 transition-all">Explore</a>
                            <a href="#respeta" class="px-4 py-1.5 bg-secondary-500 text-white text-xs font-semibold tracking-wider uppercase rounded-full shadow-sm hover:bg-secondary-600 transition-all">Respect</a>
                            <a href="#conecta" class="px-4 py-1.5 bg-primary-700 text-white text-xs font-semibold tracking-wider uppercase rounded-full shadow-sm hover:bg-primary-800 transition-all">Connect</a>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
</div>

<!-- More than a Language — a Cultural Journey. Classroom photo anchors the
     left, headline + intro on the right. Five feature tiles span the full
     width below. The four pillar anchors (#aprende #explora #respeta
     #conecta) live on tiles so the hero pills scroll here. -->
<div class="bg-white pt-12 pb-12 lg:pt-16 lg:pb-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-12 lg:gap-10 items-center mb-12">
            <!-- Classroom photo, left ~5/12 cols -->
            <div class="lg:col-span-5 relative">
                <img src="~/img/classroom/classroom-class-in-action.jpg"
                     alt="Students with raised hands during a Lake Country Spanish lesson"
                     class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]"
                     loading="lazy" />
                <!-- Decorative accent square behind the photo for depth -->
                <div aria-hidden="true" class="hidden lg:block absolute -bottom-4 -right-4 -z-10 w-32 h-32 bg-accent-200 rounded-2xl"></div>
                <div aria-hidden="true" class="hidden lg:block absolute -top-4 -left-4 -z-10 w-24 h-24 bg-teal-200 rounded-2xl"></div>
            </div>

            <!-- Intro copy, right ~7/12 cols -->
            <div class="mt-10 lg:mt-0 lg:col-span-7">
                <p class="text-xs sm:text-sm font-bold tracking-[0.2em] uppercase text-secondary-600 mb-3">
                    🌎 More than a Language
                </p>
                <h2 class="font-display text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl leading-tight">
                    A <span class="italic text-primary-600">Cultural Journey</span> for every student.
                </h2>
                <p class="mt-5 text-lg text-gray-700 leading-relaxed">
                    At Lake Country Spanish, we believe language comes alive through culture. Each month
                    focuses on a different Spanish-speaking country — its food, music, holidays, traditions,
                    and famous people. Students travel the Spanish-speaking world without ever leaving the
                    classroom.
                </p>
                <p class="mt-4 text-base text-gray-600 leading-relaxed">
                    Taught by <strong>native Peruvian instructors</strong> — known for their clear pronunciation
                    and neutral accent, an excellent foundation for Spanish learners. Conversation first.
                    Vocabulary in context. Culture woven into every lesson.
                </p>
            </div>
        </div>

        <div class="grid gap-8 grid-cols-2 lg:grid-cols-5">
            <div id="aprende" class="text-center scroll-mt-24">
                <div class="mx-auto h-16 w-16 flex items-center justify-center rounded-full bg-secondary-100 text-secondary-600 mb-4">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                    </svg>
                </div>
                <h3 class="font-bold text-gray-900 mb-2">Spanish Immersion</h3>
                <p class="text-sm text-gray-600">Natural language acquisition through engaging, interactive experiences.</p>
            </div>

            <div id="conecta" class="text-center scroll-mt-24">
                <div class="mx-auto h-16 w-16 flex items-center justify-center rounded-full bg-primary-100 text-primary-600 mb-4">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                    </svg>
                </div>
                <h3 class="font-bold text-gray-900 mb-2">Cultural Connection</h3>
                <p class="text-sm text-gray-600">Celebrating Hispanic cultures and traditions in everything we do.</p>
            </div>

            <div id="respeta" class="text-center scroll-mt-24">
                <div class="mx-auto h-16 w-16 flex items-center justify-center rounded-full bg-teal-100 text-teal-600 mb-4">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
                    </svg>
                </div>
                <h3 class="font-bold text-gray-900 mb-2">Community Focused</h3>
                <p class="text-sm text-gray-600">Building confidence, curiosity, and a love for language together.</p>
            </div>

            <div id="explora" class="text-center scroll-mt-24">
                <div class="mx-auto h-16 w-16 flex items-center justify-center rounded-full bg-accent-100 text-accent-700 mb-4">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
                    </svg>
                </div>
                <h3 class="font-bold text-gray-900 mb-2">Play-Based Learning</h3>
                <p class="text-sm text-gray-600">Hands-on, age-appropriate activities that make learning joyful and meaningful.</p>
            </div>

            <div class="text-center scroll-mt-24">
                <div class="mx-auto h-16 w-16 flex items-center justify-center rounded-full bg-primary-100 text-primary-700 mb-4">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                    </svg>
                </div>
                <h3 class="font-bold text-gray-900 mb-2">Partnered with Schools</h3>
                <p class="text-sm text-gray-600">Bringing high-quality Spanish programs directly to your school.</p>
            </div>
        </div>
    </div>
</div>

<!-- Travel the Spanish-Speaking World With Us! Country tiles cycle through
     the curriculum's monthly country rotation. Launch four hardcoded; Karen
     & Cece swap them as the curriculum sequence is finalized. Tile images
     are placeholder color blocks with flag emoji — replace with real
     country photos when available. Cream bg so it stands out between the
     two white "More than a Language" and "Meet Karen" sections. -->
<div class="bg-gray-50 py-12 lg:py-14 border-y border-gray-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
            <p class="text-xs sm:text-sm font-bold tracking-[0.2em] uppercase text-teal-700 mb-3">
                ✈ One country. One adventure. One lesson at a time.
            </p>
            <h2 class="font-display text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
                Travel the Spanish-Speaking World <span class="italic text-primary-600">With Us!</span>
            </h2>
        </div>

        <div class="grid gap-6 grid-cols-2 lg:grid-cols-4">
            <!-- Peru — Karen and Cece's home country, the natural launch theme -->
            <a href="#" class="group block bg-white rounded-2xl shadow-md hover:shadow-xl transition-all hover:-translate-y-1 overflow-hidden">
                <div class="aspect-[4/3] relative overflow-hidden">
                    <img src="~/img/flags/peru-flag.jpg" alt="Flag of Peru" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                    <span class="absolute top-3 right-3 bg-white/95 text-xs font-bold text-gray-800 px-2.5 py-1 rounded-full shadow-md">This month</span>
                </div>
                <div class="p-5">
                    <h3 class="font-display text-xl font-bold text-primary-700 mb-2">PERU</h3>
                    <p class="text-sm text-gray-600">Meet our llama friend! Explore Machu Picchu, ceviche, Quechua, and delicious food.</p>
                    <p class="mt-3 text-xs font-semibold text-secondary-600 group-hover:text-secondary-700">Learn more →</p>
                </div>
            </a>

            <!-- Mexico — most students will have some cultural touchpoint -->
            <a href="#" class="group block bg-white rounded-2xl shadow-md hover:shadow-xl transition-all hover:-translate-y-1 overflow-hidden">
                <div class="aspect-[4/3] relative overflow-hidden">
                    <img src="~/img/flags/mexico-flag.jpg" alt="Flag of Mexico" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                </div>
                <div class="p-5">
                    <h3 class="font-display text-xl font-bold text-primary-700 mb-2">MEXICO</h3>
                    <p class="text-sm text-gray-600">Celebrate Día de los Muertos, mariachi music, and vibrant culture and traditions.</p>
                    <p class="mt-3 text-xs font-semibold text-secondary-600 group-hover:text-secondary-700">Learn more →</p>
                </div>
            </a>

            <!-- Costa Rica — Pura Vida + biodiversity hook -->
            <a href="#" class="group block bg-white rounded-2xl shadow-md hover:shadow-xl transition-all hover:-translate-y-1 overflow-hidden">
                <div class="aspect-[4/3] relative overflow-hidden">
                    <img src="~/img/flags/costa-rica-flag.jpg" alt="Flag of Costa Rica" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                </div>
                <div class="p-5">
                    <h3 class="font-display text-xl font-bold text-primary-700 mb-2">COSTA RICA</h3>
                    <p class="text-sm text-gray-600">Discover rainforests, amazing wildlife, and the beautiful spirit of "Pura Vida."</p>
                    <p class="mt-3 text-xs font-semibold text-secondary-600 group-hover:text-secondary-700">Learn more →</p>
                </div>
            </a>

            <!-- Spain — European Spanish, art and history angle -->
            <a href="#" class="group block bg-white rounded-2xl shadow-md hover:shadow-xl transition-all hover:-translate-y-1 overflow-hidden">
                <div class="aspect-[4/3] relative overflow-hidden">
                    <img src="~/img/flags/spain-flag.jpg" alt="Flag of Spain" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                </div>
                <div class="p-5">
                    <h3 class="font-display text-xl font-bold text-primary-700 mb-2">SPAIN</h3>
                    <p class="text-sm text-gray-600">Experience flamenco, famous landmarks, and rich history across the regions.</p>
                    <p class="mt-3 text-xs font-semibold text-secondary-600 group-hover:text-secondary-700">Learn more →</p>
                </div>
            </a>
        </div>

        <p class="text-center mt-8 text-sm text-gray-500 italic">
            New country, new adventure — every month of the school year.
        </p>
    </div>
</div>

<!-- Our Programs carousel. Hardcoded slides for now — Karen edits copy /
     adds slides directly here. Long-term this should render from the
     EnrollmentProgram table (see #13, public program calendar). Vanilla
     CSS/JS: transform-based track, auto-advance every 6s, dot nav,
     pause on hover, keyboard-accessible dots. -->
<div class="bg-white py-14 lg:py-16 border-b border-gray-100" id="our-programs">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
            <p class="text-xs sm:text-sm font-bold tracking-[0.2em] uppercase text-secondary-600 mb-3">
                ★ What we offer
            </p>
            <h2 class="font-display text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
                Our Programs
            </h2>
            <p class="mt-3 text-gray-600 max-w-2xl mx-auto">
                Each program blends real Spanish, real culture, and hands-on play. Slide through to see what we bring to schools, after-school programs, and community events.
            </p>
        </div>

        <div class="relative" id="programs-carousel" aria-roledescription="carousel" aria-label="Lake Country Spanish program offerings">
            <div class="overflow-hidden rounded-2xl">
                <div class="programs-track flex transition-transform duration-700 ease-in-out will-change-transform">

                    <!-- Slide 1: Dance & Learn Spanish -->
                    <article class="programs-slide flex-shrink-0 w-full" aria-roledescription="slide" aria-label="Dance and Learn Spanish">
                        <div class="grid md:grid-cols-2 gap-0 bg-white shadow-lg rounded-2xl overflow-hidden">
                            <div class="aspect-[4/3] md:aspect-auto md:min-h-[380px] relative bg-gray-100">
                                <img src="~/img/programs/dance-and-learn-spanish-after-school-program.jpeg"
                                     alt="Children dancing in a Dance and Learn Spanish after-school class"
                                     class="absolute inset-0 w-full h-full object-cover"
                                     loading="lazy" />
                            </div>
                            <div class="p-6 md:p-8 flex flex-col justify-center">
                                <p class="text-xs font-bold tracking-[0.15em] uppercase text-teal-700 mb-2">After-school program · Grades K–6</p>
                                <h3 class="font-display text-2xl md:text-3xl font-bold text-gray-900 mb-3">Dance &amp; Learn Spanish</h3>
                                <p class="text-gray-700 mb-4">
                                    Move, sing, and celebrate Spanish through dance, music, and traditions from across the Spanish-speaking world. Each session pairs a new country with age-appropriate songs, movement, and a hands-on activity kids take home.
                                </p>
                                <a href="@Url.Action("Index", "Contact", new { subject = "school-inquiry" })" class="inline-flex items-center text-sm font-semibold text-secondary-600 hover:text-secondary-700">
                                    Bring this to your school →
                                </a>
                            </div>
                        </div>
                    </article>

                    <!-- Slide 2: Bailamos y Aprendemos Español -->
                    <article class="programs-slide flex-shrink-0 w-full" aria-roledescription="slide" aria-label="Bailamos y Aprendemos Español">
                        <div class="grid md:grid-cols-2 gap-0 bg-white shadow-lg rounded-2xl overflow-hidden">
                            <div class="aspect-[4/3] md:aspect-auto md:min-h-[380px] relative bg-gray-100">
                                <img src="~/img/programs/bailamos-y-aprendemos-espanol-after-school-program.jpeg"
                                     alt="Children in a Bailamos y Aprendemos Español after-school class"
                                     class="absolute inset-0 w-full h-full object-cover"
                                     loading="lazy" />
                            </div>
                            <div class="p-6 md:p-8 flex flex-col justify-center">
                                <p class="text-xs font-bold tracking-[0.15em] uppercase text-teal-700 mb-2">Programa después de la escuela · Grados K–6</p>
                                <h3 class="font-display text-2xl md:text-3xl font-bold text-gray-900 mb-3">Bailamos y Aprendemos Español</h3>
                                <p class="text-gray-700 mb-4">
                                    ¡A bailar y aprender! An after-school program built around movement, music, and immersive Spanish. Kids explore a new Spanish-speaking country each session with rhythm, songs, and cultural celebrations that make the language stick.
                                </p>
                                <a href="@Url.Action("Index", "Contact", new { subject = "school-inquiry" })" class="inline-flex items-center text-sm font-semibold text-secondary-600 hover:text-secondary-700">
                                    Bring this to your school →
                                </a>
                            </div>
                        </div>
                    </article>

                </div>
            </div>

            <!-- Prev / Next arrows (hidden on mobile — dots below are enough there) -->
            <button type="button"
                    class="programs-prev hidden md:flex absolute top-1/2 -left-4 -translate-y-1/2 h-10 w-10 items-center justify-center rounded-full bg-white shadow-md text-gray-700 hover:bg-gray-50 hover:text-gray-900 z-10"
                    aria-label="Previous program">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
            </button>
            <button type="button"
                    class="programs-next hidden md:flex absolute top-1/2 -right-4 -translate-y-1/2 h-10 w-10 items-center justify-center rounded-full bg-white shadow-md text-gray-700 hover:bg-gray-50 hover:text-gray-900 z-10"
                    aria-label="Next program">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
            </button>

            <!-- Dot navigation -->
            <div class="programs-dots flex justify-center gap-2 mt-6" role="tablist" aria-label="Program slides">
                <button type="button" class="programs-dot h-2.5 w-2.5 rounded-full bg-gray-300 hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-secondary-500 focus:ring-offset-2" role="tab" aria-label="Show slide 1" data-index="0"></button>
                <button type="button" class="programs-dot h-2.5 w-2.5 rounded-full bg-gray-300 hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-secondary-500 focus:ring-offset-2" role="tab" aria-label="Show slide 2" data-index="1"></button>
            </div>
        </div>

        <p class="text-center mt-8 text-sm text-gray-500 italic">
            More programs coming — foods of the Spanish-speaking countries, animals, and seasonal celebrations.
        </p>
    </div>
</div>

<style>
    #programs-carousel .programs-dot.active {
        background-color: #FF6F61;
        transform: scale(1.25);
    }
</style>

<script>
    (function () {
        const carousel = document.getElementById('programs-carousel');
        if (!carousel) return;
        const track = carousel.querySelector('.programs-track');
        const slides = track.children;
        const dots = carousel.querySelectorAll('.programs-dot');
        const prevBtn = carousel.querySelector('.programs-prev');
        const nextBtn = carousel.querySelector('.programs-next');
        const advanceMs = 6000;
        let current = 0;
        let timer = null;

        function go(i) {
            current = (i + slides.length) % slides.length;
            track.style.transform = 'translateX(-' + (current * 100) + '%)';
            dots.forEach(function (d, k) {
                d.classList.toggle('active', k === current);
                d.setAttribute('aria-selected', k === current ? 'true' : 'false');
            });
        }

        function next() { go(current + 1); }
        function prev() { go(current - 1); }

        function start() { stop(); timer = setInterval(next, advanceMs); }
        function stop() { if (timer) { clearInterval(timer); timer = null; } }

        dots.forEach(function (d, i) {
            d.addEventListener('click', function () { go(i); start(); });
        });
        if (prevBtn) prevBtn.addEventListener('click', function () { prev(); start(); });
        if (nextBtn) nextBtn.addEventListener('click', function () { next(); start(); });

        carousel.addEventListener('mouseenter', stop);
        carousel.addEventListener('mouseleave', start);
        carousel.addEventListener('focusin', stop);
        carousel.addEventListener('focusout', start);

        // Respect reduced-motion preference: no auto-advance, but manual nav still works.
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        go(0);
        if (!reducedMotion) start();
    })();
</script>

