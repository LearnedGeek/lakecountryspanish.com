@model LakeCountrySpanish.Web.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Spanish Language & Cultural Enrichment";
    ViewData["MetaDescription"] = "Engaging Spanish programs where children learn to communicate with confidence while discovering the cultures of the Spanish-speaking world. Serving Lake Country Wisconsin.";
}

<!-- Hero Section. Photographic-llama-on-right + headline-on-left layout from
     Karen & Cece's 2026-05-30 mock. Four pillar pills overlay the photo on
     lg+ (APRENDE / EXPLORA / RESPETA / CONECTA) — the curriculum's value-prop
     split in Spanish. Replaces the prior polaroid-and-cartoon-Lola hero. -->
<div class="relative bg-gradient-to-br from-gray-50 via-teal-50 to-accent-50 overflow-x-clip">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-40 -right-40 w-80 h-80 bg-secondary-500/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-primary-500/10 rounded-full blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl">
        <div class="relative z-10 pb-10 sm:pb-12 lg:pb-12 pt-10 lg:pt-14">
            <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                <div class="lg:grid lg:grid-cols-12 lg:gap-10 items-center">

                    <!-- Left column: text + CTAs (~50% on lg+) -->
                    <div class="sm:text-center md:mx-auto lg:col-span-6 lg:text-left">
                        <p class="text-xs sm:text-sm font-bold tracking-[0.2em] uppercase text-primary-700 mb-3">
                            Language <span class="text-secondary-500">•</span> Culture <span class="text-secondary-500">•</span> Community
                        </p>

                        <h1 class="font-display text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl md:text-6xl leading-[1.05]">
                            <span class="block">Learn Spanish.</span>
                            <span class="block text-primary-600 italic">Explore the World.</span>
                        </h1>
                        <p class="mt-5 text-lg text-gray-700 sm:mx-auto sm:max-w-xl md:text-xl lg:mx-0">
                            Engaging Spanish programs where children learn to communicate with confidence
                            while discovering the cultures of the Spanish-speaking world.
                        </p>
                        <p class="mt-2 text-sm text-gray-500 sm:mx-auto sm:max-w-xl lg:mx-0">
                            Serving Lake Country Wisconsin: Oconomowoc, Waukesha, Delafield, Hartland, Pewaukee, Brookfield &amp; beyond
                        </p>

                        <div class="mt-8 sm:flex sm:justify-center lg:justify-start gap-4">
                            <a asp-controller="Programs" asp-action="Index" class="flex w-full sm:w-auto items-center justify-center rounded-xl bg-secondary-500 px-8 py-4 text-base font-semibold text-white hover:bg-secondary-600 shadow-lg shadow-secondary-500/30 hover:shadow-secondary-500/40 transition-all hover:-translate-y-0.5">
                                Explore Our Programs
                                <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                                </svg>
                            </a>
                            <a asp-controller="Contact" asp-action="Index" asp-route-subject="school-inquiry" class="mt-4 sm:mt-0 flex w-full sm:w-auto items-center justify-center rounded-xl border-2 border-primary-600 px-8 py-4 text-base font-semibold text-primary-700 hover:bg-primary-50 transition">
                                Bring Spanish to Your School
                            </a>
                        </div>
                    </div>

                    <!-- Right column: photograph of teacher + students in motion
                         (per Cece's 2026-08 feedback: hero should immediately read
                         "education + children," not brand mascot). Llama moves to
                         a small badge overlaid on the photo's bottom-right corner
                         so it stays visible as an LCS mark without dominating —
                         Karen liked the llama, just wanted it not front-and-center.
                         Pills sit immediately below the photo so they read as part
                         of the same composition. -->
                    <div class="mt-12 lg:col-span-6 lg:mt-0">
                        <div class="relative">
                            <img src="~/img/hero-classroom-dance.jpg"
                                 alt="A teacher and elementary-age students dancing and moving together in a Lake Country Spanish class"
                                 class="w-full object-cover aspect-[3/2] rounded-2xl shadow-xl"
                                 style="filter: drop-shadow(0 8px 20px rgba(30, 58, 138, 0.15));" />
                            <!-- Cartoon "hola" mascot floats over the photo's bottom-right
                                 corner. Distinct from the nav's painted-logo llama so it
                                 doesn't feel matchy-matchy; the speech bubble reinforces
                                 the Spanish angle. Natural silhouette (no circle clip) so
                                 the bubble stays legible. -->
                            <img src="~/img/mascot/llama-mascot-hola-bubble.png"
                                 alt="Cartoon llama mascot saying ¡Hola!"
                                 class="absolute -bottom-4 -right-4 h-32 w-auto drop-shadow-lg pointer-events-none select-none"
                                 loading="lazy" />
                        </div>

                        <!-- Pillar pills directly under the photo, aligned to the
                             photo column. Reads as part of the same composition. -->
                        <div class="mt-8 flex flex-wrap items-center justify-center lg:justify-start gap-2">
                            <span class="hidden lg:inline text-xs font-bold tracking-[0.2em] uppercase text-gray-500 mr-1">We teach:</span>
                            <a href="#aprende" class="px-4 py-1.5 bg-white border border-primary-200 text-primary-800 text-xs font-semibold tracking-wider uppercase rounded-full shadow-sm hover:bg-primary-50 hover:border-primary-400 transition-all">Learn</a>
                            <a href="#explora" class="px-4 py-1.5 bg-teal-500 text-white text-xs font-semibold tracking-wider uppercase rounded-full shadow-sm hover:bg-teal-600 transition-all">Explore</a>
                            <a href="#respeta" class="px-4 py-1.5 bg-secondary-500 text-white text-xs font-semibold tracking-wider uppercase rounded-full shadow-sm hover:bg-secondary-600 transition-all">Respect</a>
                            <a href="#conecta" class="px-4 py-1.5 bg-primary-700 text-white text-xs font-semibold tracking-wider uppercase rounded-full shadow-sm hover:bg-primary-800 transition-all">Connect</a>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
</div>

@if (Model.FeaturedPrograms.Count > 0)
{
    <!-- Now Enrolling — distinct programs (by Name) currently open for
         signup. Each tile links to /programs (NOT a specific /join/{slug})
         so the parent picks their location from the disambiguation on the
         programs page. Karen may run several instances of the same program
         at different schools; this section deliberately shows ONE tile per
         distinct name with an "N locations enrolling now" summary. Auto-
         hides when nothing is open. -->
    <div class="bg-gradient-to-br from-secondary-50 via-white to-primary-50 border-b border-gray-100 py-10 lg:py-12">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-center gap-3 mb-8">
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-[0.15em] bg-secondary-500 text-white shadow-sm">
                    <span class="h-2 w-2 rounded-full bg-white animate-pulse"></span>
                    Now Enrolling
                </span>
            </div>

            @{
                var tileGridCols = Model.FeaturedPrograms.Count switch
                {
                    1 => "grid-cols-1 max-w-3xl mx-auto",
                    2 => "grid-cols-1 md:grid-cols-2",
                    _ => "grid-cols-1 md:grid-cols-2 lg:grid-cols-3"
                };
            }
            <div class="grid gap-6 @tileGridCols">
                @foreach (var card in Model.FeaturedPrograms)
                {
                    var rep = card.Representative;
                    var img = !string.IsNullOrEmpty(rep.EventImagePath) ? rep.EventImagePath : rep.HeroImagePath;
                    <a href="@Url.Action("Index", "Programs")"
                       class="group flex flex-col bg-white shadow-md hover:shadow-xl rounded-2xl overflow-hidden border border-gray-200 hover:border-secondary-400 transition-all duration-200 ease-out hover:-translate-y-1">
                        <div class="aspect-[16/10] relative bg-gradient-to-br from-primary-400 to-secondary-500 overflow-hidden">
                            @if (!string.IsNullOrEmpty(img))
                            {
                                <img src="@img" alt="@rep.Name" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                            }
                            @if (card.InstanceCount > 1)
                            {
                                <span class="absolute top-4 right-4 inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold border shadow-sm bg-white/95 text-secondary-700 border-secondary-200">
                                    @card.InstanceCount locations
                                </span>
                            }
                        </div>
                        <div class="flex-1 flex flex-col p-5">
                            <p class="text-xs font-bold tracking-[0.15em] uppercase text-secondary-600 mb-2">Grades @rep.GradeRange</p>
                            <h3 class="font-display text-xl font-bold text-gray-900 mb-2">@rep.Name</h3>
                            <p class="text-sm text-gray-600 mb-4 flex items-center gap-1.5">
                                <span class="text-gray-400">📍</span>
                                <span class="font-medium">@card.LocationSummary</span>
                            </p>
                            <div class="mt-auto pt-3 border-t border-gray-100 flex items-center justify-between">
                                <div>
                                    <div class="text-xs text-gray-500 uppercase font-semibold tracking-wide">From</div>
                                    <div class="text-xl font-bold text-gray-900">$@rep.FullPrice.ToString("N2")</div>
                                </div>
                                <span class="inline-flex items-center gap-1 px-4 py-2 bg-secondary-500 text-white text-sm font-bold rounded-lg shadow-sm group-hover:bg-secondary-600 group-hover:shadow-md transition-all">
                                    See details →
                                </span>
                            </div>
                        </div>
                    </a>
                }
            </div>

            @if (Model.FeaturedPrograms.Count > 3 || Model.FeaturedPrograms.Any(c => c.InstanceCount > 1))
            {
                <p class="text-center mt-8">
                    <a href="@Url.Action("Index", "Programs")" class="inline-flex items-center gap-1 text-sm font-semibold text-primary-700 hover:text-primary-900">
                        See all programs and locations →
                    </a>
                </p>
            }
        </div>
    </div>
}

<!-- More than a Language — a Cultural Journey. Classroom photo anchors the
     left, headline + intro on the right. Five feature tiles span the full
     width below. The four pillar anchors (#aprende #explora #respeta
     #conecta) live on tiles so the hero pills scroll here. -->
<div class="bg-white pt-12 pb-12 lg:pt-16 lg:pb-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-12 lg:gap-10 items-center mb-12">
            <!-- Classroom photo, left ~5/12 cols -->
            <div class="lg:col-span-5 relative">
                <img src="~/img/classroom/classroom-class-in-action.jpg"
                     alt="Students with raised hands during a Lake Country Spanish lesson"
                     class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]"
                     loading="lazy" />
                <!-- Decorative accent square behind the photo for depth -->
                <div aria-hidden="true" class="hidden lg:block absolute -bottom-4 -right-4 -z-10 w-32 h-32 bg-accent-200 rounded-2xl"></div>
                <div aria-hidden="true" class="hidden lg:block absolute -top-4 -left-4 -z-10 w-24 h-24 bg-teal-200 rounded-2xl"></div>
            </div>

            <!-- Intro copy, right ~7/12 cols -->
            <div class="mt-10 lg:mt-0 lg:col-span-7">
                <p class="text-xs sm:text-sm font-bold tracking-[0.2em] uppercase text-secondary-600 mb-3">
                    🌎 More than a Language
                </p>
                <h2 class="font-display text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl leading-tight">
                    A <span class="italic text-primary-600">Cultural Journey</span> for every student.
                </h2>
                <p class="mt-5 text-lg text-gray-700 leading-relaxed">
                    At Lake Country Spanish, we believe language comes alive through culture. Each month
                    focuses on a different Spanish-speaking country — its food, music, holidays, traditions,
                    and famous people. Students travel the Spanish-speaking world without ever leaving the
                    classroom.
                </p>
                <p class="mt-4 text-base text-gray-600 leading-relaxed">
                    Taught by <strong>native Peruvian instructors</strong> — known for their clear pronunciation
                    and neutral accent, an excellent foundation for Spanish learners. Conversation first.
                    Vocabulary in context. Culture woven into every lesson.
                </p>
            </div>
        </div>

        <p class="text-center text-xs font-bold tracking-[0.2em] uppercase text-gray-500 mb-6">
            Why parents choose us
        </p>
        <div class="grid gap-8 grid-cols-2 lg:grid-cols-4">
            <!-- Communication First — anchor id preserved so the hero "Learn" pill still scrolls here -->
            <div id="aprende" class="text-center scroll-mt-24">
                <div class="mx-auto h-16 w-16 flex items-center justify-center rounded-full bg-secondary-100 text-secondary-600 mb-4">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                </div>
                <h3 class="font-bold text-gray-900 mb-2">Communication First</h3>
                <p class="text-sm text-gray-600">Kids learn to speak Spanish with confidence — real conversation, not just vocabulary drills.</p>
            </div>

            <!-- Culture in Every Lesson — anchor id preserved so the hero "Connect" pill scrolls here -->
            <div id="conecta" class="text-center scroll-mt-24">
                <div class="mx-auto h-16 w-16 flex items-center justify-center rounded-full bg-primary-100 text-primary-600 mb-4">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                    </svg>
                </div>
                <h3 class="font-bold text-gray-900 mb-2">Culture in Every Lesson</h3>
                <p class="text-sm text-gray-600">Music, food, holidays, and traditions from across the Spanish-speaking world woven into every session.</p>
            </div>

            <!-- Designed for Children — anchor id preserved so the hero "Explore" pill scrolls here -->
            <div id="explora" class="text-center scroll-mt-24">
                <div class="mx-auto h-16 w-16 flex items-center justify-center rounded-full bg-accent-100 text-accent-700 mb-4">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.546 5.974 5.974 0 01-2.133-1A3.75 3.75 0 0012 18z" />
                    </svg>
                </div>
                <h3 class="font-bold text-gray-900 mb-2">Designed for Children</h3>
                <p class="text-sm text-gray-600">Play-based, hands-on activities built around how kids actually learn — movement, games, and stories.</p>
            </div>

            <!-- Experienced Educators — anchor id preserved so the hero "Respect" pill scrolls here -->
            <div id="respeta" class="text-center scroll-mt-24">
                <div class="mx-auto h-16 w-16 flex items-center justify-center rounded-full bg-teal-100 text-teal-600 mb-4">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
                    </svg>
                </div>
                <h3 class="font-bold text-gray-900 mb-2">Experienced Educators</h3>
                <p class="text-sm text-gray-600">Native Peruvian teachers with decades of combined classroom experience across ages and levels.</p>
            </div>
        </div>
    </div>
</div>

<!-- Travel the Spanish-Speaking World With Us! Unified carousel of offerings —
     country themes (Peru, Mexico, Costa Rica, Spain) alongside the specific
     school-facing programs Karen sells (Dance & Learn Spanish, Bailamos y
     Aprendemos Español). One tile per slide; auto-advance every 6s; hover +
     focus pause; respects prefers-reduced-motion. Karen adds new offerings
     (foods, animals, seasonal celebrations) by copy-pasting a slide article
     below and adding a matching dot button. Long-term (#13): pull program
     slides from EnrollmentProgram where IsListed = true. -->
<div class="bg-gray-50 py-12 lg:py-14 border-y border-gray-100" id="offerings">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
            <p class="text-xs sm:text-sm font-bold tracking-[0.2em] uppercase text-teal-700 mb-3">
                ✈ One country. One adventure. One lesson at a time.
            </p>
            <h2 class="font-display text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
                Discover the <span class="italic text-primary-600">Spanish-Speaking World</span>
            </h2>
        </div>

        <div class="relative" id="offerings-carousel" aria-roledescription="carousel" aria-label="Lake Country Spanish offerings">
            <div class="overflow-hidden rounded-2xl">
                <div class="offerings-track flex transition-transform duration-700 ease-in-out will-change-transform">

                    <!-- Peru — Karen and Cece's home country, the natural launch theme -->
                    <article class="offerings-slide flex-shrink-0 w-full" aria-roledescription="slide" aria-label="Peru">
                        <div class="grid md:grid-cols-2 gap-0 bg-white shadow-lg rounded-2xl overflow-hidden">
                            <div class="aspect-[4/3] md:aspect-auto md:min-h-[360px] relative bg-gray-100">
                                <img src="~/img/flags/peru-flag.jpg" alt="Flag of Peru" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
                                <span class="absolute top-3 right-3 bg-white/95 text-xs font-bold text-gray-800 px-2.5 py-1 rounded-full shadow-md">This month</span>
                            </div>
                            <div class="p-6 md:p-8 flex flex-col justify-center">
                                <p class="text-xs font-bold tracking-[0.15em] uppercase text-teal-700 mb-2">Country adventure</p>
                                <h3 class="font-display text-2xl md:text-3xl font-bold text-primary-700 mb-3">Peru</h3>
                                <p class="text-gray-700">Meet our llama friend! Explore Machu Picchu, ceviche, Quechua, and delicious food.</p>
                            </div>
                        </div>
                    </article>

                    <!-- Mexico — most students will have some cultural touchpoint -->
                    <article class="offerings-slide flex-shrink-0 w-full" aria-roledescription="slide" aria-label="Mexico">
                        <div class="grid md:grid-cols-2 gap-0 bg-white shadow-lg rounded-2xl overflow-hidden">
                            <div class="aspect-[4/3] md:aspect-auto md:min-h-[360px] relative bg-gray-100">
                                <img src="~/img/flags/mexico-flag.jpg" alt="Flag of Mexico" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
                            </div>
                            <div class="p-6 md:p-8 flex flex-col justify-center">
                                <p class="text-xs font-bold tracking-[0.15em] uppercase text-teal-700 mb-2">Country adventure</p>
                                <h3 class="font-display text-2xl md:text-3xl font-bold text-primary-700 mb-3">Mexico</h3>
                                <p class="text-gray-700">Celebrate Día de los Muertos, mariachi music, and vibrant culture and traditions.</p>
                            </div>
                        </div>
                    </article>

                    <!-- Costa Rica — Pura Vida + biodiversity hook -->
                    <article class="offerings-slide flex-shrink-0 w-full" aria-roledescription="slide" aria-label="Costa Rica">
                        <div class="grid md:grid-cols-2 gap-0 bg-white shadow-lg rounded-2xl overflow-hidden">
                            <div class="aspect-[4/3] md:aspect-auto md:min-h-[360px] relative bg-gray-100">
                                <img src="~/img/flags/costa-rica-flag.jpg" alt="Flag of Costa Rica" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
                            </div>
                            <div class="p-6 md:p-8 flex flex-col justify-center">
                                <p class="text-xs font-bold tracking-[0.15em] uppercase text-teal-700 mb-2">Country adventure</p>
                                <h3 class="font-display text-2xl md:text-3xl font-bold text-primary-700 mb-3">Costa Rica</h3>
                                <p class="text-gray-700">Discover rainforests, amazing wildlife, and the beautiful spirit of "Pura Vida."</p>
                            </div>
                        </div>
                    </article>

                    <!-- Spain — European Spanish, art and history angle -->
                    <article class="offerings-slide flex-shrink-0 w-full" aria-roledescription="slide" aria-label="Spain">
                        <div class="grid md:grid-cols-2 gap-0 bg-white shadow-lg rounded-2xl overflow-hidden">
                            <div class="aspect-[4/3] md:aspect-auto md:min-h-[360px] relative bg-gray-100">
                                <img src="~/img/flags/spain-flag.jpg" alt="Flag of Spain" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
                            </div>
                            <div class="p-6 md:p-8 flex flex-col justify-center">
                                <p class="text-xs font-bold tracking-[0.15em] uppercase text-teal-700 mb-2">Country adventure</p>
                                <h3 class="font-display text-2xl md:text-3xl font-bold text-primary-700 mb-3">Spain</h3>
                                <p class="text-gray-700">Experience flamenco, famous landmarks, and rich history across the regions.</p>
                            </div>
                        </div>
                    </article>

                    <!-- Dance & Learn Spanish — English-branded after-school program -->
                    <article class="offerings-slide flex-shrink-0 w-full" aria-roledescription="slide" aria-label="Dance and Learn Spanish">
                        <div class="grid md:grid-cols-2 gap-0 bg-white shadow-lg rounded-2xl overflow-hidden">
                            <div class="aspect-[4/3] md:aspect-auto md:min-h-[360px] relative bg-gray-100">
                                <img src="~/img/programs/dance-and-learn-spanish-after-school-program.jpeg"
                                     alt="Children dancing in a Dance and Learn Spanish after-school class"
                                     class="absolute inset-0 w-full h-full object-cover"
                                     loading="lazy" />
                            </div>
                            <div class="p-6 md:p-8 flex flex-col justify-center">
                                <p class="text-xs font-bold tracking-[0.15em] uppercase text-secondary-600 mb-2">After-school program · Grades K–6</p>
                                <h3 class="font-display text-2xl md:text-3xl font-bold text-gray-900 mb-3">Dance &amp; Learn Spanish</h3>
                                <p class="text-gray-700 mb-4">
                                    Move, sing, and celebrate Spanish through dance, music, and traditions from across the Spanish-speaking world. Each session pairs a new country with age-appropriate songs and a hands-on activity kids take home.
                                </p>
                                <div class="flex flex-wrap gap-3 items-center text-sm">
                                    <a href="@Url.Action("Index", "Programs")" class="inline-flex items-center font-semibold text-secondary-600 hover:text-secondary-700">
                                        See upcoming sessions →
                                    </a>
                                    <span class="text-gray-300">·</span>
                                    <a href="@Url.Action("Index", "Contact", new { subject = "school-inquiry" })" class="inline-flex items-center font-semibold text-primary-600 hover:text-primary-700">
                                        Bring it to your school
                                    </a>
                                </div>
                            </div>
                        </div>
                    </article>

                    <!-- Bailamos y Aprendemos Español — Spanish-branded after-school program -->
