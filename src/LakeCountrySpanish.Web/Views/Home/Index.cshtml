@model LakeCountrySpanish.Web.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["MetaDescription"] = "Spanish lessons in Lake Country Wisconsin with Karen, a native Peruvian teacher. Serving Oconomowoc, Waukesha, Delafield, Hartland, Pewaukee & surrounding areas. Personalized online lessons with flexible scheduling.";
}

<!-- Hero Section. Uses overflow-x-clip (not overflow-hidden) so the floating
     polaroid on the right can bleed down past the section boundary into Meet
     Karen below, breaking the rectangle-stacked-on-rectangle reading.
     Background gradient: cream -> light teal -> light yellow. Earlier this was
     cream -> light-pink (via-primary-50), but with primary swapped to violet
     that mid-stop became lavender and washed the hero mauve. Teal-50 in the
     middle brightens it without losing the warm-corner feel. -->
<div class="relative bg-gradient-to-br from-gray-50 via-teal-50 to-accent-50 overflow-x-clip">
    <!-- Decorative background elements (kept clipped to the hero) -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-40 -right-40 w-80 h-80 bg-secondary-500/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-secondary-500/10 rounded-full blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl">
        <div class="relative z-10 pb-12 sm:pb-16 md:pb-20 lg:pb-12 pt-10 lg:pt-16">
            <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                <div class="lg:grid lg:grid-cols-12 lg:gap-8 items-center">
                    <div class="sm:text-center md:mx-auto lg:col-span-8 lg:text-left">
                        <!-- Brand-promise eyebrow — the positioning line. Karen
                             proposed "Real culture, native speakers" — swapped
                             the second half to avoid the lineage framing and
                             tie to the conversation-driven teaching philosophy. -->
                        <p class="text-xs sm:text-sm font-bold tracking-[0.2em] uppercase text-primary-700 mb-3">
                            Real culture. Real conversation.
                        </p>

                        <h1 class="font-display text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl md:text-6xl leading-[1.05]">
                            <span class="block">Spanish Lessons</span>
                            <span class="block text-primary-600 italic">that feel like fun.</span>
                        </h1>
                        <p class="mt-4 text-lg text-gray-700 sm:mx-auto sm:max-w-xl md:text-xl lg:mx-0">
                            Join Karen, a native Peruvian teacher, for personalized online lessons filled with
                            conversation, culture, and plenty of laughs. Learning Spanish has never been this enjoyable!
                        </p>
                        <p class="mt-2 text-sm text-gray-500 sm:mx-auto sm:max-w-xl lg:mx-0">
                            Serving Lake Country Wisconsin: Oconomowoc, Waukesha, Delafield, Hartland, Pewaukee, Brookfield & beyond
                        </p>

                        <!-- Key benefits inline -->
                        <div class="mt-6 flex flex-wrap gap-4 sm:justify-center lg:justify-start">
                            <div class="flex items-center gap-2 text-gray-700">
                                <svg class="h-5 w-5 text-secondary-500" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                </svg>
                                <span class="text-sm">Native Speaker</span>
                            </div>
                            <div class="flex items-center gap-2 text-gray-700">
                                <svg class="h-5 w-5 text-secondary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span class="text-sm">Flexible Schedule</span>
                            </div>
                            <div class="flex items-center gap-2 text-gray-700">
                                <svg class="h-5 w-5 text-secondary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
                                </svg>
                                <span class="text-sm">Earn Rewards</span>
                            </div>
                        </div>

                        <div class="mt-8 sm:flex sm:justify-center lg:justify-start gap-4">
                            <a asp-controller="Contact" asp-action="Index" class="flex w-full sm:w-auto items-center justify-center rounded-xl bg-primary-500 px-8 py-4 text-base font-semibold text-white hover:bg-primary-600 shadow-lg shadow-primary-500/30 hover:shadow-primary-500/40 transition-all hover:-translate-y-0.5">
                                Start Your Journey
                                <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                                </svg>
                            </a>
                            <a href="#pricing" class="mt-4 sm:mt-0 flex w-full sm:w-auto items-center justify-center rounded-xl border-2 border-gray-300 px-8 py-4 text-base font-semibold text-gray-700 hover:bg-gray-100 transition">
                                View Pricing
                            </a>
                        </div>
                    </div>

                    <!-- Logo polaroid + Lola, smaller and offset. The polaroid is
                         tilted, the "Specials" badge sits on top, and Lola peeks
                         from behind the lower-right corner. On lg+ the wrapper
                         translates down so the polaroid pokes into the section
                         below — visually breaking the section/section grid. -->
                    <div class="mt-12 lg:col-span-4 lg:mt-0 lg:translate-y-20 relative z-30">
                        <div class="relative mx-auto max-w-xs lg:rotate-3 transform-gpu">
                            <!-- Polaroid frame -->
                            <div class="bg-white rounded-2xl shadow-2xl p-5 pb-7 relative">
                                <img src="~/img/lake-country-spanish-logo.jpg"
                                     alt="Lake Country Spanish"
                                     class="w-full aspect-square object-cover rounded-lg shadow-inner" />
                                <p class="mt-3 text-center font-display text-lg text-gray-800 italic">
                                    Lake Country Spanish
                                </p>
                            </div>

                            <!-- "New Student Specials" pill — gold (Futura "Tradiciones"
                                 brushstroke color) so the warm-yellow anchor lands here too. -->
                            <div class="absolute -top-3 -left-6 bg-gold-400 text-plum-900 px-4 py-2 rounded-full text-xs font-bold shadow-lg -rotate-6 z-20">
                                ✨ New Student Specials
                            </div>

                            <!-- Lola peeking from behind the polaroid bottom-right -->
                            <img src="~/img/mascot/llama-mascot-waving.png"
                                 alt=""
                                 aria-hidden="true"
                                 class="hidden md:block absolute -right-12 -bottom-10 h-40 w-auto -rotate-12 drop-shadow-xl" />
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
</div>

<!-- Meet Karen Section — magazine-style asymmetric layout. Big photo of Karen
     teaching anchors the left, the quote card overlaps the photo bottom-right
     on lg+, and the headline + stats stack on the right. -->
<div class="bg-white pt-20 pb-20 lg:pt-36 lg:pb-24 overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-12 lg:gap-x-14 lg:gap-y-0 items-start">

            <!-- Photo + overlapping quote (left, ~58%) -->
            <div class="lg:col-span-7 relative">
                <!-- Painterly framed photo with subtle rotation so it reads as a
                     polaroid rather than a stock-corp banner. -->
                <div class="relative overflow-hidden rounded-3xl shadow-2xl ring-8 ring-white -rotate-1 transform-gpu">
                    <img src="~/img/karen-teaching.jpg"
                         alt="A Spanish teacher working through a workbook with a young student"
                         class="w-full h-auto object-cover"
                         loading="lazy" />
                </div>

                <!-- Decorative coral arc behind the photo, peeking on the left -->
                <div aria-hidden="true" class="hidden lg:block absolute -left-10 top-10 -z-10 h-64 w-64 rounded-full bg-secondary-100/60 blur-2xl"></div>

                <!-- Quote card pulled over the bottom-right of the photo on lg+ -->
                <div class="hidden lg:block absolute -bottom-12 -right-8 max-w-sm rotate-2">
                    <div class="bg-gradient-to-br from-primary-500 to-secondary-500 rounded-2xl p-6 text-white shadow-2xl ring-4 ring-white">
                        <svg class="h-8 w-8 text-white/40 mb-3" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                        </svg>
                        <p class="text-base font-medium leading-relaxed">
                            My goal isn't just to teach you Spanish — it's to help you fall in love with the language and feel confident using it in real life.
                        </p>
                        <p class="mt-3 font-semibold">— Karen</p>
                    </div>
                </div>

                <!-- Lola peeking from behind the photo, lower-left, lg+ only -->
                <img src="~/img/mascot/llama-mascot-hola-bubble.png"
                     alt=""
                     aria-hidden="true"
                     class="hidden lg:block absolute -left-6 -bottom-10 h-32 w-auto -rotate-6 drop-shadow-xl" />
            </div>

            <!-- Headline + body + stat chips (right, ~42%) -->
            <div class="mt-14 lg:mt-2 lg:col-span-5">
                <div class="inline-flex items-center gap-2 px-3 py-1 bg-plum-100 text-plum-700 rounded-full text-sm font-semibold mb-5">
                    <span>🇵🇪</span>
                    <span>Meet Your Teacher</span>
                </div>
                <h2 class="font-display text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl leading-[1.05]">
                    Hola, <span class="italic text-primary-600">I'm Karen.</span>
                </h2>
                <p class="mt-5 text-lg text-gray-700 leading-relaxed">
                    A native Spanish speaker from Peru, teaching students of all ages for over a decade.
                    My passion is making language learning feel natural, fun, and achievable.
                </p>
                <p class="mt-4 text-gray-600 leading-relaxed">
                    The best way to learn a language is real conversation, cultural connection,
                    patience, and encouragement. Whether you're brand new or polishing your
                    skills, I'll build a personalized path for you.
                </p>

                <!-- Stat chips — horizontal flow-wrap instead of a 2×2 grid -->
                <div class="mt-8 flex flex-wrap gap-3">
                    <span class="inline-flex items-center gap-2 rounded-full bg-primary-50 px-4 py-2 text-sm font-semibold text-primary-700 ring-1 ring-primary-200">
                        📚 10+ years teaching
                    </span>
                    <span class="inline-flex items-center gap-2 rounded-full bg-secondary-50 px-4 py-2 text-sm font-semibold text-secondary-700 ring-1 ring-secondary-200">
                        👧 All ages welcome
                    </span>
                    <span class="inline-flex items-center gap-2 rounded-full bg-accent-50 px-4 py-2 text-sm font-semibold text-accent-800 ring-1 ring-accent-200">
                        💛 Patient & supportive
                    </span>
                    <span class="inline-flex items-center gap-2 rounded-full bg-teal-50 px-4 py-2 text-sm font-semibold text-teal-700 ring-1 ring-teal-200">
                        🌎 Cultural immersion
                    </span>
                </div>

                <!-- Mobile-only quote card. On lg+ the quote overlaps the photo. -->
                <div class="lg:hidden mt-10">
                    <div class="bg-gradient-to-br from-primary-500 to-secondary-500 rounded-2xl p-6 text-white shadow-xl">
                        <svg class="h-8 w-8 text-white/40 mb-3" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                        </svg>
                        <p class="text-base font-medium leading-relaxed">
                            My goal isn't just to teach you Spanish — it's to help you fall in love with the language and feel confident using it in real life.
                        </p>
                        <p class="mt-3 font-semibold">— Karen</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mini pom pom transition — echoes the nav garland in miniature, centered.
     Used sparingly between same-toned sections where a wave divider would be
     overkill. Hangs from a short hairline so it reads as a continuation of the
     nav garland motif, not a bullet-list separator. -->
<div aria-hidden="true" class="bg-white flex flex-col items-center pb-12">
    <div class="w-px h-3 bg-gray-300"></div>
    <div class="flex items-end gap-3">
        <span class="block h-2 w-2 rounded-full shadow-sm" style="background-color: #7045B0;"></span>
        <span class="block h-2.5 w-2.5 rounded-full shadow-sm" style="background-color: #FF6F61;"></span>
        <span class="block h-2 w-2 rounded-full shadow-sm" style="background-color: #FFD63D;"></span>
        <span class="block h-2.5 w-2.5 rounded-full shadow-sm" style="background-color: #1E8189;"></span>
        <span class="block h-2 w-2 rounded-full shadow-sm" style="background-color: #EC4899;"></span>
        <span class="block h-2.5 w-2.5 rounded-full shadow-sm" style="background-color: #7045B0;"></span>
    </div>
</div>

<!-- Word of the Day Section -->
<div class="bg-gray-50 py-12 border-b border-gray-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-3 lg:gap-8 items-center">
            <div class="lg:col-span-2">
                <h2 class="font-display text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">Learn a New Word Every Day!</h2>
                <p class="mt-2 text-gray-600">
                    Expand your vocabulary one word at a time. Our daily Spanish word includes pronunciation,
                    meaning, and an example sentence to help you practice.
                </p>
                <p class="mt-2 text-sm text-gray-500">
                    Students get personalized vocabulary recommendations based on their level!
                </p>
            </div>
            <div class="mt-8 lg:mt-0">
                @await Component.InvokeAsync("WordOfTheDay")
            </div>
        </div>
    </div>
</div>

<!-- Pricing Section -->
<div id="pricing" class="bg-gray-50 py-16 scroll-mt-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center">
            <h2 class="font-display text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Flexible Pricing Options</h2>
            <p class="mt-4 text-lg text-gray-600">Start with a trial class or subscribe monthly. You choose your schedule, you control your budget!</p>
            <p class="mt-2 text-sm text-gray-500">All lessons include personalized curriculum, learning materials, and flexible scheduling.</p>
        </div>

        <div class="mt-12">
            @await Component.InvokeAsync("PricingCards", new {
                tiers = Model.SubscriptionTiers,
                isLoggedIn = User.Identity?.IsAuthenticated ?? false,
                showTrialCard = true,
                showScheduleButton = User.Identity?.IsAuthenticated ?? false
            })
        </div>

        <!-- Pricing Info -->
        <div class="mt-10 text-center">
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-white rounded-full shadow-sm border border-gray-200">
                <svg class="h-5 w-5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-sm text-gray-600">
                    <strong>Subscriptions are flexible:</strong> You choose how many classes to schedule each month. Renews automatically unless you adjust by the 3rd week.
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Wave divider: cream pricing -> teal rewards. Fill hex = teal-600. -->
<div aria-hidden="true" class="bg-gray-50 leading-[0]">
    <svg class="block w-full h-10 sm:h-16" viewBox="0 0 1440 80" preserveAspectRatio="none">
        <path d="M0,0 C420,70 1020,70 1440,0 L1440,80 L0,80 Z" fill="#1A6F7E"/>
    </svg>
</div>

<!-- Rewards Section. Flat solid teal (Futura cool anchor) instead of coral —
     coral is reserved for spotlight accents now, not full section bands. -->
<div class="bg-teal-600 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
            <div class="text-white">
                <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Earn Rewards While You Learn</h2>
                <p class="mt-4 text-lg text-teal-100">
                    Learning Spanish is more fun when you're earning rewards! Complete assignments, earn badges,
                    and unlock free classes as you progress.
                </p>
                <ul class="mt-8 space-y-4">
                    <li class="flex items-start">
                        <div class="flex-shrink-0 h-8 w-8 rounded-full bg-white/20 flex items-center justify-center mr-3">
                            <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-semibold">Earn Points</h4>
                            <p class="text-teal-100 text-sm">Complete exercises, give feedback, and stay consistent to earn points.</p>
                        </div>
                    </li>
                    <li class="flex items-start">
                        <div class="flex-shrink-0 h-8 w-8 rounded-full bg-white/20 flex items-center justify-center mr-3">
                            <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-semibold">Collect Badges</h4>
                            <p class="text-teal-100 text-sm">Unlock achievements for milestones, streaks, and mastering topics.</p>
                        </div>
                    </li>
                    <li class="flex items-start">
                        <div class="flex-shrink-0 h-8 w-8 rounded-full bg-white/20 flex items-center justify-center mr-3">
                            <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-semibold">Redeem Rewards</h4>
                            <p class="text-teal-100 text-sm">Use your points for free classes, bring-a-friend passes, and more!</p>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="mt-10 lg:mt-0">
                <div class="bg-white rounded-2xl shadow-xl p-8">
                    <div class="text-center">
                        <img src="~/img/mascot/llama-mascot-excelente.png" alt="Lola says excelente" class="h-28 w-auto mx-auto mb-2 drop-shadow-md" />
                        <h3 class="text-xl font-bold text-gray-900">Subscribers Earn 1.5x Points!</h3>
                        <p class="mt-2 text-gray-600">Monthly subscribers earn bonus points on every activity,
                        helping you unlock free classes faster.</p>
                    </div>
                    <div class="mt-6 pt-6 border-t border-gray-100">
                        <div class="grid grid-cols-3 gap-4 text-center">
                            <div>
                                <div class="text-2xl font-bold text-primary-600">100</div>
                                <div class="text-xs text-gray-500">Points = 1 Free Class</div>
                            </div>
                            <div>
                                <div class="text-2xl font-bold text-secondary-600">15+</div>
                                <div class="text-xs text-gray-500">Badges to Earn</div>
                            </div>
                            <div>
                                <div class="text-2xl font-bold text-green-600">Never</div>
                                <div class="text-xs text-gray-500">Points Expire</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Testimonials Section -->
@if (Model.Testimonials.Any())
{
    <!-- Wave divider: teal rewards -> white testimonials. Wrapper bg matches the
         teal section above so there's no seam on the wave's top edge. -->
    <div aria-hidden="true" class="bg-teal-600 leading-[0]">
        <svg class="block w-full h-10 sm:h-16" viewBox="0 0 1440 80" preserveAspectRatio="none">
            <path d="M0,0 C420,70 1020,70 1440,0 L1440,80 L0,80 Z" fill="#FFFFFF"/>
        </svg>
    </div>
    <div class="bg-white py-16">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="text-center">
                <h2 class="font-display text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">What Students Say</h2>
                <p class="mt-4 text-lg text-gray-600">Hear from our satisfied learners</p>
            </div>

            <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                @foreach (var testimonial in Model.Testimonials)
                {
                    <div class="bg-gray-50 rounded-xl p-6 shadow-sm">
                        <div class="flex items-center mb-4">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <svg class="h-5 w-5 @(i <= testimonial.Rating ? "text-yellow-400" : "text-gray-300")" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                </svg>
                            }
                        </div>
                        <p class="text-gray-700 italic">"@testimonial.Testimonial"</p>
                        <p class="mt-4 text-sm font-medium text-gray-900">- @testimonial.StudentFirstName</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

