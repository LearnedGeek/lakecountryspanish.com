@{
    ViewData["Title"] = "Meet Us";
    ViewData["MetaDescription"] = "Meet the native Peruvian Spanish teachers behind Lake Country Spanish. Personalized Spanish lessons for students throughout Lake Country Wisconsin and beyond.";
}

@*
    This page is intentionally a STUB. The two placeholder cards below are
    the structure for individual teacher bios; photos and personal content
    get added later by Karen + Cece. When per-person detail pages are ready,
    promote the "Learn more" links to their own routes.
*@

<div class="bg-white">
    <!-- Hero -->
    <div class="relative bg-gradient-to-r from-primary-600 to-primary-700 py-16">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="text-center">
                <p class="text-xs sm:text-sm font-bold tracking-[0.2em] uppercase text-primary-100 mb-3">
                    Real Spanish. Real culture. Real conversation.
                </p>
                <h1 class="font-display text-4xl font-bold tracking-tight text-white sm:text-5xl">
                    Meet Us
                </h1>
                <p class="mt-4 text-xl text-gray-100 max-w-2xl mx-auto">
                    Two native Peruvians sharing the language, culture, and joy of their home with
                    Lake Country Wisconsin.
                </p>
            </div>
        </div>
    </div>

    <!-- Two-card teacher placeholders -->
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="grid gap-10 md:grid-cols-2 max-w-5xl mx-auto">

            <!-- Karen card — classroom photo until headshot + bio land -->
            <div class="bg-white rounded-2xl shadow-md overflow-hidden border border-gray-100">
                <div class="aspect-[4/3] relative">
                    <img src="~/img/classroom/karen-jenga.jpg"
                         alt="Karen leading a Spanish class activity"
                         class="absolute inset-0 w-full h-full object-cover"
                         loading="lazy" />
                </div>
                <div class="p-6">
                    <h2 class="font-display text-2xl font-bold text-gray-900">Karen</h2>
                    <p class="text-sm font-semibold text-primary-700 mt-1 uppercase tracking-wide">Founding Teacher</p>
                    <p class="mt-4 text-gray-600 leading-relaxed">
                        Native Peruvian Spanish teacher with years of experience teaching learners of all ages.
                        Full bio coming soon — including teaching philosophy, certifications, and what makes
                        every Lake Country Spanish class an adventure.
                    </p>
                    <p class="mt-4 text-xs text-gray-400 italic">More about Karen — coming soon.</p>
                </div>
            </div>

            <!-- Cece card — placeholder until real photo + bio land -->
            <div class="bg-white rounded-2xl shadow-md overflow-hidden border border-gray-100">
                <div class="aspect-[4/3] bg-gradient-to-br from-secondary-100 via-accent-100 to-primary-100 flex items-center justify-center relative">
                    <span class="font-display text-7xl text-secondary-700 italic" aria-hidden="true">C</span>
                    <span class="absolute bottom-3 right-3 bg-white/90 text-xs font-semibold text-gray-700 px-3 py-1 rounded-full shadow-sm">
                        Photo coming soon
                    </span>
                </div>
                <div class="p-6">
                    <h2 class="font-display text-2xl font-bold text-gray-900">Cece</h2>
                    <p class="text-sm font-semibold text-secondary-700 mt-1 uppercase tracking-wide">Founding Teacher</p>
                    <p class="mt-4 text-gray-600 leading-relaxed">
                        Native Peruvian Spanish teacher bringing authentic language instruction and cultural
                        experience to every class. Full bio coming soon — including teaching background,
                        favorite age groups to teach, and her vision for Lake Country Spanish.
                    </p>
                    <p class="mt-4 text-xs text-gray-400 italic">More about Cece — coming soon.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- What we offer (generic, applies to both teachers) -->
    <div class="bg-gray-50 py-16">
        <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
            <h2 class="text-center font-display text-3xl font-bold text-gray-900 mb-10">What We Offer</h2>
            <div class="grid gap-6 md:grid-cols-2">
                <div class="flex items-start gap-4 bg-white rounded-xl p-6 shadow-sm">
                    <div class="flex-shrink-0 h-12 w-12 rounded-full bg-primary-100 flex items-center justify-center">
                        <svg class="h-6 w-6 text-primary-700" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-900">Beginner to Advanced</h3>
                        <p class="text-sm text-gray-600 mt-1">Lessons tailored to your current level and goals.</p>
                    </div>
                </div>
                <div class="flex items-start gap-4 bg-white rounded-xl p-6 shadow-sm">
                    <div class="flex-shrink-0 h-12 w-12 rounded-full bg-teal-100 flex items-center justify-center">
                        <svg class="h-6 w-6 text-teal-700" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-900">Conversational Focus</h3>
                        <p class="text-sm text-gray-600 mt-1">Build confidence through real-world dialogue.</p>
                    </div>
                </div>
                <div class="flex items-start gap-4 bg-white rounded-xl p-6 shadow-sm">
                    <div class="flex-shrink-0 h-12 w-12 rounded-full bg-secondary-100 flex items-center justify-center">
                        <svg class="h-6 w-6 text-secondary-700" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-900">Cultural Immersion</h3>
                        <p class="text-sm text-gray-600 mt-1">A new Spanish-speaking country each month — food, music, history.</p>
                    </div>
                </div>
                <div class="flex items-start gap-4 bg-white rounded-xl p-6 shadow-sm">
                    <div class="flex-shrink-0 h-12 w-12 rounded-full bg-accent-100 flex items-center justify-center">
                        <svg class="h-6 w-6 text-accent-700" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-900">Flexible Scheduling</h3>
                        <p class="text-sm text-gray-600 mt-1">Lessons that fit your week — online or in person.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA -->
    <div class="bg-white py-16">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="font-display text-3xl font-bold text-gray-900">Ready to start your Spanish journey?</h2>
            <p class="mt-4 text-lg text-gray-600">Reach out to discuss your goals and schedule your first lesson.</p>
            <div class="mt-8">
                <a asp-controller="Contact" asp-action="Index"
                   class="inline-flex items-center gap-2 px-8 py-3 bg-secondary-500 text-white text-base font-semibold rounded-xl hover:bg-secondary-600 shadow-lg shadow-secondary-500/30 transition-all hover:-translate-y-0.5">
                    Get in Touch
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                </a>
            </div>
        </div>
    </div>
</div>
