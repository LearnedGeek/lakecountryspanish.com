@{
    ViewData["Title"] = "Privacy Policy";
    ViewData["MetaDescription"] = "Lake Country Spanish privacy policy - learn how we protect your personal information and use cookies.";
}

<div class="bg-white">
    <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl font-bold text-primary-900 mb-8">@ViewData["Title"]</h1>

        <p class="text-gray-600 mb-8">
            <strong>Last Updated:</strong> January 2025
        </p>

        <div class="prose prose-lg max-w-none text-gray-700 space-y-8">
            <!-- Introduction -->
            <section>
                <h2 class="text-2xl font-semibold text-primary-800 mb-4">Introduction</h2>
                <p>
                    Lake Country Spanish ("we," "us," or "our") is committed to protecting your privacy.
                    This Privacy Policy explains how we collect, use, and safeguard your personal information
                    when you use our website and Spanish tutoring services.
                </p>
            </section>

            <!-- Information We Collect -->
            <section>
                <h2 class="text-2xl font-semibold text-primary-800 mb-4">Information We Collect</h2>

                <h3 class="text-xl font-medium text-primary-700 mb-2">Account Information</h3>
                <p>When you create an account, we collect:</p>
                <ul class="list-disc pl-6 space-y-1">
                    <li>Name and email address</li>
                    <li>Phone number (optional)</li>
                    <li>Password (stored securely using industry-standard encryption)</li>
                </ul>

                <h3 class="text-xl font-medium text-primary-700 mb-2 mt-4">Lesson & Payment Information</h3>
                <p>When you book lessons or make payments, we collect:</p>
                <ul class="list-disc pl-6 space-y-1">
                    <li>Class scheduling preferences and history</li>
                    <li>Payment information (processed securely through Stripe - we do not store your full card details)</li>
                    <li>Class feedback and notes</li>
                </ul>

                <h3 class="text-xl font-medium text-primary-700 mb-2 mt-4">Learning Progress</h3>
                <p>To provide personalized instruction, we track:</p>
                <ul class="list-disc pl-6 space-y-1">
                    <li>Your Spanish proficiency level and progress</li>
                    <li>Completed assignments and assessments</li>
                    <li>Tokens and rewards earned through our gamification system</li>
                </ul>
            </section>

            <!-- Cookies -->
            <section id="cookies">
                <h2 class="text-2xl font-semibold text-primary-800 mb-4">Cookies</h2>
                <p>
                    We use <strong>essential cookies only</strong> to provide core functionality:
                </p>
                <div class="bg-gray-50 rounded-lg p-4 mt-4">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b">
                                <th class="text-left py-2 font-medium">Cookie</th>
                                <th class="text-left py-2 font-medium">Purpose</th>
                                <th class="text-left py-2 font-medium">Duration</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="py-2">.AspNetCore.Identity.Application</td>
                                <td class="py-2">Keeps you logged in securely</td>
                                <td class="py-2">14 days</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p class="mt-4">
                    <strong>We do not use:</strong> tracking cookies, advertising cookies, or third-party analytics
                    like Google Analytics. Your browsing activity is not tracked or shared with advertisers.
                </p>
            </section>

            <!-- How We Use Information -->
            <section>
                <h2 class="text-2xl font-semibold text-primary-800 mb-4">How We Use Your Information</h2>
                <p>We use your information to:</p>
                <ul class="list-disc pl-6 space-y-1">
                    <li>Provide and improve our Spanish tutoring services</li>
                    <li>Schedule and manage your lessons</li>
                    <li>Process payments securely</li>
                    <li>Send important notifications (class reminders, schedule changes, payment confirmations)</li>
                    <li>Track your learning progress and customize instruction</li>
                    <li>Respond to your inquiries and support requests</li>
                </ul>
            </section>

            <!-- Data Sharing -->
            <section>
                <h2 class="text-2xl font-semibold text-primary-800 mb-4">Information Sharing</h2>
                <p>
                    We do <strong>not sell, rent, or share</strong> your personal information with third parties for
                    marketing purposes. We only share information with:
                </p>
                <ul class="list-disc pl-6 space-y-1">
                    <li><strong>Stripe:</strong> Our payment processor, to securely handle transactions</li>
                    <li><strong>Email service:</strong> To send you important notifications about your lessons</li>
                </ul>
            </section>

            <!-- Data Security -->
            <section>
                <h2 class="text-2xl font-semibold text-primary-800 mb-4">Data Security</h2>
                <p>We protect your information using:</p>
                <ul class="list-disc pl-6 space-y-1">
                    <li>HTTPS encryption for all data transmission</li>
                    <li>Secure password hashing</li>
                    <li>PCI-compliant payment processing through Stripe</li>
                    <li>Regular security updates and monitoring</li>
                </ul>
            </section>

            <!-- Your Rights -->
            <section>
                <h2 class="text-2xl font-semibold text-primary-800 mb-4">Your Rights</h2>
                <p>You have the right to:</p>
                <ul class="list-disc pl-6 space-y-1">
                    <li>Access your personal information</li>
                    <li>Correct inaccurate information</li>
                    <li>Request deletion of your account and data</li>
                    <li>Opt out of non-essential communications</li>
                </ul>
                <p class="mt-4">
                    To exercise these rights, please contact us at
                    <a href="mailto:karen@lakecountryspanish.com" class="text-secondary-600 hover:text-secondary-700">karen@lakecountryspanish.com</a>.
                </p>
            </section>

            <!-- Children's Privacy -->
            <section>
                <h2 class="text-2xl font-semibold text-primary-800 mb-4">Children's Privacy</h2>
                <p>
                    Our services are available to students of all ages. For students under 13, we require
                    parental consent and encourage parents to be involved in their child's learning journey.
                    Parents may contact us to review or delete their child's information.
                </p>
            </section>

            <!-- Changes -->
            <section>
                <h2 class="text-2xl font-semibold text-primary-800 mb-4">Changes to This Policy</h2>
                <p>
                    We may update this Privacy Policy from time to time. We will notify you of any significant
                    changes by posting the new policy on this page and updating the "Last Updated" date.
                </p>
            </section>

            <!-- Contact -->
            <section>
                <h2 class="text-2xl font-semibold text-primary-800 mb-4">Contact Us</h2>
                <p>
                    If you have any questions about this Privacy Policy, please contact us:
                </p>
                <div class="bg-primary-50 rounded-lg p-4 mt-4">
                    <p><strong>Lake Country Spanish</strong></p>
                    <p>Email: <a href="mailto:karen@lakecountryspanish.com" class="text-secondary-600 hover:text-secondary-700">karen@lakecountryspanish.com</a></p>
                    <p>Website: <a href="https://lakecountryspanish.com" class="text-secondary-600 hover:text-secondary-700">lakecountryspanish.com</a></p>
                </div>
            </section>
        </div>
    </div>
</div>
