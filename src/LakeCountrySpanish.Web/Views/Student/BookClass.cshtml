@model LakeCountrySpanish.Web.Models.ViewModels.BookClassViewModel
@{
    ViewData["Title"] = "Schedule a Class";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a asp-action="Dashboard" class="text-primary-600 hover:text-primary-700 flex items-center text-sm mb-4">
                <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
                Back to Dashboard
            </a>
            <h1 class="text-3xl font-bold text-gray-900">Schedule a Class</h1>
            <p class="mt-2 text-gray-600">Select an available time slot to schedule your Spanish lesson.</p>
        </div>

        <!-- Credits Available -->
        <div class="bg-green-50 border border-green-200 rounded-lg p-6 mb-8">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <div class="flex-shrink-0 p-3 bg-green-100 rounded-lg">
                        <svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-green-800">Available Credits</p>
                        <p class="text-2xl font-bold text-green-900">@Model.AvailablePackageClasses</p>
                    </div>
                </div>
                <a asp-action="PurchaseClasses" class="text-green-700 hover:text-green-800 text-sm font-medium">
                    Buy more credits
                </a>
            </div>
        </div>

        @if (!Model.AvailableSlots.Any())
        {
            <div class="bg-white rounded-lg shadow p-8 text-center">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                </svg>
                <p class="mt-2 text-gray-500">No time slots are currently available.</p>
                <p class="text-sm text-gray-400">Please check back later or contact Karen.</p>
            </div>
        }
        else
        {
            <div class="bg-white rounded-lg shadow">
                <div class="p-6 border-b border-gray-200">
                    <h2 class="text-lg font-semibold text-gray-900">Step 1: Choose a Time Slot</h2>
                </div>
                <div class="p-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="timeSlots">
                        @foreach (var slot in Model.AvailableSlots)
                        {
                            <button type="button"
                                    class="time-slot-btn p-4 border-2 border-gray-200 rounded-lg text-left hover:border-primary-500 hover:bg-primary-50 transition"
                                    data-slot-id="@slot.Id">
                                <p class="font-semibold text-gray-900">
                                    @if (slot.IsRecurring && slot.DayOfWeek.HasValue)
                                    {
                                        @slot.DayOfWeek.Value.ToString()@("s")
                                    }
                                    else if (slot.SpecificDate.HasValue)
                                    {
                                        @slot.SpecificDate.Value.ToString("MMM d, yyyy")
                                    }
                                </p>
                                <p class="text-sm text-gray-500">
                                    @(DateTime.Today.Add(slot.StartTime).ToString("h:mm tt")) - @(DateTime.Today.Add(slot.EndTime).ToString("h:mm tt"))
                                </p>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <div id="dateSelection" class="bg-white rounded-lg shadow mt-8 hidden">
                <div class="p-6 border-b border-gray-200">
                    <h2 class="text-lg font-semibold text-gray-900">Step 2: Choose a Date</h2>
                </div>
                <div class="p-6">
                    <div id="availableDates" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        <!-- Dates will be loaded via JavaScript -->
                    </div>
                    <div id="loadingDates" class="text-center py-8 hidden">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary-600 mx-auto"></div>
                        <p class="mt-2 text-gray-500">Loading available dates...</p>
                    </div>
                    <div id="noDates" class="text-center py-8 hidden">
                        <p class="text-gray-500">No available dates for this time slot in the next 60 days.</p>
                    </div>
                </div>
            </div>

            <form asp-action="BookClass" method="post" id="bookingForm" class="hidden mt-8">
                <input type="hidden" name="timeSlotId" id="selectedTimeSlotId" />
                <input type="hidden" name="classDateTime" id="selectedDateTime" />

                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-lg font-semibold text-gray-900 mb-4">Step 3: Confirm Booking</h2>

                    <div class="bg-gray-50 rounded-lg p-4 mb-6">
                        <p class="text-sm text-gray-500">Selected class:</p>
                        <p id="selectedClassDisplay" class="text-lg font-semibold text-gray-900"></p>
                    </div>

                    <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
                        <div class="flex items-center">
                            <svg class="h-5 w-5 text-green-600 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span class="text-green-700">1 credit will be used from your balance</span>
                        </div>
                    </div>

                    <button type="submit"
                            class="w-full flex justify-center rounded-md bg-primary-600 py-3 px-4 text-sm font-semibold text-white hover:bg-primary-700 transition">
                        <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                        </svg>
                        Confirm Booking
                    </button>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        let selectedSlotId = null;
        let selectedDateTime = null;

        document.querySelectorAll('.time-slot-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                // Reset selection
                document.querySelectorAll('.time-slot-btn').forEach(b => {
                    b.classList.remove('border-primary-500', 'bg-primary-50');
                    b.classList.add('border-gray-200');
                });

                // Select this slot
                this.classList.remove('border-gray-200');
                this.classList.add('border-primary-500', 'bg-primary-50');

                selectedSlotId = this.dataset.slotId;
                document.getElementById('selectedTimeSlotId').value = selectedSlotId;

                // Show date selection and load dates
                loadAvailableDates(selectedSlotId);
            });
        });

        function loadAvailableDates(slotId) {
            const dateSection = document.getElementById('dateSelection');
            const datesContainer = document.getElementById('availableDates');
            const loading = document.getElementById('loadingDates');
            const noDates = document.getElementById('noDates');
            const bookingForm = document.getElementById('bookingForm');

            dateSection.classList.remove('hidden');
            datesContainer.innerHTML = '';
            loading.classList.remove('hidden');
            noDates.classList.add('hidden');
            bookingForm.classList.add('hidden');

            fetch(`/Student/GetAvailableDates?timeSlotId=${slotId}`)
                .then(response => response.json())
                .then(dates => {
                    loading.classList.add('hidden');

                    if (dates.length === 0) {
                        noDates.classList.remove('hidden');
                        return;
                    }

                    dates.forEach(date => {
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'date-btn p-4 border-2 border-gray-200 rounded-lg text-left hover:border-primary-500 hover:bg-primary-50 transition';
                        btn.dataset.date = date.date;
                        btn.dataset.display = date.display;
                        btn.innerHTML = `
                            <p class="font-semibold text-gray-900">${date.display.split(' at ')[0]}</p>
                            <p class="text-sm text-gray-500">${date.time.replace(/^(\d{2}):(\d{2})$/, (m, h, min) => {
                                const hour = parseInt(h);
                                const ampm = hour >= 12 ? 'PM' : 'AM';
                                const hour12 = hour % 12 || 12;
                                return `${hour12}:${min} ${ampm}`;
                            })}</p>
                        `;

                        btn.addEventListener('click', function() {
                            document.querySelectorAll('.date-btn').forEach(b => {
                                b.classList.remove('border-primary-500', 'bg-primary-50');
                                b.classList.add('border-gray-200');
                            });

                            this.classList.remove('border-gray-200');
                            this.classList.add('border-primary-500', 'bg-primary-50');

                            selectedDateTime = this.dataset.date;
                            document.getElementById('selectedDateTime').value = selectedDateTime;
                            document.getElementById('selectedClassDisplay').textContent = this.dataset.display;

                            bookingForm.classList.remove('hidden');
                        });

                        datesContainer.appendChild(btn);
                    });
                })
                .catch(err => {
                    loading.classList.add('hidden');
                    noDates.classList.remove('hidden');
                    console.error('Error loading dates:', err);
                });
        }
    </script>
}
