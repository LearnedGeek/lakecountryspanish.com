@model LakeCountrySpanish.Web.Models.ViewModels.PurchaseClassesViewModel
@{
    ViewData["Title"] = "Purchase Classes";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a asp-action="Dashboard" class="text-primary-600 hover:text-primary-700 flex items-center text-sm mb-4">
                <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
                Back to Dashboard
            </a>
            <h1 class="text-3xl font-bold text-gray-900">Purchase Class Credits</h1>
            <p class="mt-2 text-gray-600">Buy class credits to schedule your Spanish lessons. The more you buy, the more you save!</p>
        </div>

        @if (TempData["InfoMessage"] != null)
        {
            <div class="bg-blue-50 border border-blue-200 text-blue-700 px-4 py-3 rounded-lg mb-6">
                @TempData["InfoMessage"]
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6">
                @TempData["SuccessMessage"]
            </div>
        }

        <!-- Current Credits -->
        @if (Model.AvailableCredits > 0)
        {
            <div class="bg-green-50 border border-green-200 rounded-lg p-6 mb-8">
                <div class="flex items-center">
                    <div class="flex-shrink-0 p-3 bg-green-100 rounded-lg">
                        <svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-green-800">You have credits available!</p>
                        <p class="text-2xl font-bold text-green-900">@Model.AvailableCredits class credits remaining</p>
                    </div>
                    <div class="ml-auto">
                        <a asp-action="BookClass" class="inline-flex items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-lg transition">
                            <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                            </svg>
                            Schedule a Class
                        </a>
                    </div>
                </div>
            </div>
        }

        <!-- How it Works -->
        <div class="bg-white rounded-lg shadow p-6 mb-8">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">How It Works</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="flex items-start">
                    <div class="flex-shrink-0 flex items-center justify-center h-10 w-10 rounded-full bg-primary-100 text-primary-600 font-bold">
                        1
                    </div>
                    <div class="ml-4">
                        <h3 class="text-sm font-medium text-gray-900">Purchase Credits</h3>
                        <p class="text-sm text-gray-500">Choose a package below and complete your payment.</p>
                    </div>
                </div>
                <div class="flex items-start">
                    <div class="flex-shrink-0 flex items-center justify-center h-10 w-10 rounded-full bg-primary-100 text-primary-600 font-bold">
                        2
                    </div>
                    <div class="ml-4">
                        <h3 class="text-sm font-medium text-gray-900">Schedule Classes</h3>
                        <p class="text-sm text-gray-500">Use your credits to book lessons at your convenience.</p>
                    </div>
                </div>
                <div class="flex items-start">
                    <div class="flex-shrink-0 flex items-center justify-center h-10 w-10 rounded-full bg-primary-100 text-primary-600 font-bold">
                        3
                    </div>
                    <div class="ml-4">
                        <h3 class="text-sm font-medium text-gray-900">Learn Spanish!</h3>
                        <p class="text-sm text-gray-500">Take classes at your own pace - no pressure!</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pricing Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            @foreach (var package in Model.Packages)
            {
                var savings = (Model.BaseClassPrice * package.ClassCount) - package.Price;
                var pricePerClass = package.Price / package.ClassCount;
                var discountPercent = savings > 0 ? Math.Round((savings / (Model.BaseClassPrice * package.ClassCount)) * 100) : 0;
                var isPopular = package.ClassCount == 10; // Mark 10-class as popular
                var isBestValue = package.ClassCount == 20; // Mark 20-class as best value

                <div class="relative bg-white rounded-lg shadow-lg overflow-hidden @(isPopular ? "ring-2 ring-primary-500" : "") @(isBestValue ? "ring-2 ring-green-500" : "")">
                    @if (isPopular)
                    {
                        <div class="absolute top-0 right-0 bg-primary-500 text-white text-xs font-bold px-3 py-1 rounded-bl-lg">
                            POPULAR
                        </div>
                    }
                    @if (isBestValue)
                    {
                        <div class="absolute top-0 right-0 bg-green-500 text-white text-xs font-bold px-3 py-1 rounded-bl-lg">
                            BEST VALUE
                        </div>
                    }

                    <div class="p-6">
                        <h3 class="text-xl font-bold text-gray-900 mb-2">@package.Name</h3>
                        <p class="text-sm text-gray-500 mb-4">@package.Description</p>

                        <div class="mb-4">
                            <span class="text-4xl font-bold text-gray-900">$@package.Price.ToString("0")</span>
                            @if (package.ClassCount > 1)
                            {
                                <span class="text-sm text-gray-500 ml-1">total</span>
                            }
                        </div>

                        <div class="space-y-2 mb-6">
                            <div class="flex items-center text-sm">
                                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                </svg>
                                <span class="text-gray-700">@package.ClassCount @(package.ClassCount == 1 ? "class" : "classes")</span>
                            </div>
                            <div class="flex items-center text-sm">
                                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                </svg>
                                <span class="text-gray-700">$@pricePerClass.ToString("0.00") per class</span>
                            </div>
                            @if (savings > 0)
                            {
                                <div class="flex items-center text-sm">
                                    <svg class="h-5 w-5 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                    </svg>
                                    <span class="text-green-600 font-semibold">Save $@savings.ToString("0") (@discountPercent% off!)</span>
                                </div>
                            }
                            <div class="flex items-center text-sm">
                                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                </svg>
                                <span class="text-gray-700">Schedule anytime</span>
                            </div>
                            <div class="flex items-center text-sm">
                                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                </svg>
                                <span class="text-gray-700">Never expires</span>
                            </div>
                        </div>

                        <a asp-controller="Payment" asp-action="BuyPackage" asp-route-id="@package.Id"
                           class="block w-full text-center py-3 px-4 rounded-lg font-semibold transition
                                  @(isPopular || isBestValue ? "bg-primary-600 hover:bg-primary-700 text-white" : "bg-gray-100 hover:bg-gray-200 text-gray-900")">
                            Buy Now
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- FAQ or Additional Info -->
        <div class="mt-12 bg-white rounded-lg shadow p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Frequently Asked Questions</h2>
            <div class="space-y-4">
                <div>
                    <h3 class="font-medium text-gray-900">Do my credits expire?</h3>
                    <p class="text-sm text-gray-500 mt-1">No! Your class credits never expire. Use them whenever you're ready.</p>
                </div>
                <div>
                    <h3 class="font-medium text-gray-900">Can I buy more credits later?</h3>
                    <p class="text-sm text-gray-500 mt-1">Yes! You can purchase additional credits at any time. They'll be added to your existing balance.</p>
                </div>
                <div>
                    <h3 class="font-medium text-gray-900">What if I need to cancel a class?</h3>
                    <p class="text-sm text-gray-500 mt-1">You can cancel classes up to 24 hours in advance and your credit will be restored automatically.</p>
                </div>
                <div>
                    <h3 class="font-medium text-gray-900">How do I schedule a class?</h3>
                    <p class="text-sm text-gray-500 mt-1">Once you have credits, simply click "Schedule a Class" and choose any available time slot that works for you.</p>
                </div>
            </div>
        </div>
    </div>
</div>
