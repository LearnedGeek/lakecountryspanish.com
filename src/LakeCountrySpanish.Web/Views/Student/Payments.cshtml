@model LakeCountrySpanish.Web.Models.ViewModels.PaymentHistoryViewModel
@{
    ViewData["Title"] = "Payment History";
}

<div class="bg-gradient-to-b from-emerald-50 via-white to-white min-h-screen">
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">

        <!-- Hero Header -->
        <div class="relative bg-gradient-to-r from-emerald-500 via-teal-500 to-cyan-500 rounded-2xl shadow-xl mb-8 overflow-hidden">
            <div class="absolute inset-0 opacity-10">
                <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                    <pattern id="payment-pattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
                        <circle cx="20" cy="20" r="2" fill="white"/>
                    </pattern>
                    <rect fill="url(#payment-pattern)" width="100%" height="100%"/>
                </svg>
            </div>
            <div class="relative p-6 lg:p-8">
                <div class="flex items-center justify-between">
                    <div>
                        <a asp-action="Dashboard" class="inline-flex items-center text-emerald-100 hover:text-white mb-2 transition">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                            </svg>
                            Dashboard
                        </a>
                        <h1 class="text-3xl font-bold text-white mb-2">Payment History</h1>
                        <p class="text-emerald-100">Your transactions and payment records</p>
                    </div>
                    <div class="hidden md:block text-8xl">💳</div>
                </div>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
            <!-- Total Paid Card -->
            <div class="bg-white rounded-2xl shadow-lg p-6 border-2 border-emerald-100 hover:border-emerald-300 transition group">
                <div class="flex items-center justify-between mb-4">
                    <div class="bg-emerald-100 rounded-full p-3 group-hover:scale-110 transition">
                        <span class="text-2xl">✅</span>
                    </div>
                    <span class="text-xs font-medium text-emerald-600 bg-emerald-50 px-2 py-1 rounded-full">All Time</span>
                </div>
                <p class="text-sm text-gray-500 mb-1">Total Paid</p>
                <p class="text-3xl font-bold text-emerald-600">$@Model.TotalPaid.ToString("0.00")</p>
                @if (Model.TotalPaid > 0)
                {
                    <p class="text-xs text-gray-400 mt-2 flex items-center">
                        <span class="text-emerald-500 mr-1">🎉</span>
                        Thank you for your investment in learning!
                    </p>
                }
            </div>

            <!-- Outstanding Balance Card -->
            <div class="bg-white rounded-2xl shadow-lg p-6 border-2 @(Model.OutstandingBalance > 0 ? "border-amber-100 hover:border-amber-300" : "border-gray-100 hover:border-gray-300") transition group">
                <div class="flex items-center justify-between mb-4">
                    <div class="@(Model.OutstandingBalance > 0 ? "bg-amber-100" : "bg-gray-100") rounded-full p-3 group-hover:scale-110 transition">
                        <span class="text-2xl">@(Model.OutstandingBalance > 0 ? "⏳" : "🎯")</span>
                    </div>
                    @if (Model.OutstandingBalance > 0)
                    {
                        <span class="text-xs font-medium text-amber-600 bg-amber-50 px-2 py-1 rounded-full animate-pulse">Due</span>
                    }
                    else
                    {
                        <span class="text-xs font-medium text-gray-600 bg-gray-50 px-2 py-1 rounded-full">Paid</span>
                    }
                </div>
                <p class="text-sm text-gray-500 mb-1">Outstanding Balance</p>
                <p class="text-3xl font-bold @(Model.OutstandingBalance > 0 ? "text-amber-600" : "text-gray-900")">$@Model.OutstandingBalance.ToString("0.00")</p>
                @if (Model.OutstandingBalance > 0)
                {
                    <a asp-controller="Payment" asp-action="Checkout"
                       class="mt-4 inline-flex items-center px-4 py-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white rounded-lg font-medium text-sm transition shadow-md hover:shadow-lg">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                        </svg>
                        Pay Now
                    </a>
                }
                else
                {
                    <p class="text-xs text-gray-400 mt-2 flex items-center">
                        <span class="text-emerald-500 mr-1">✨</span>
                        All caught up!
                    </p>
                }
            </div>
        </div>

        <!-- Payment History -->
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
            <div class="p-6 border-b border-gray-100 bg-gradient-to-r from-gray-50 to-white">
                <div class="flex items-center">
                    <span class="text-2xl mr-3">📋</span>
                    <h2 class="text-lg font-semibold text-gray-900">Transaction History</h2>
                </div>
            </div>

            @if (Model.Payments.Any())
            {
                <div class="divide-y divide-gray-100">
                    @foreach (var payment in Model.Payments)
                    {
                        var statusInfo = payment.Status switch
                        {
                            LakeCountrySpanish.Web.Models.Entities.PaymentStatusType.Completed => (emoji: "✅", bgColor: "bg-emerald-50", textColor: "text-emerald-700", borderColor: "border-emerald-200"),
                            LakeCountrySpanish.Web.Models.Entities.PaymentStatusType.Pending => (emoji: "⏳", bgColor: "bg-amber-50", textColor: "text-amber-700", borderColor: "border-amber-200"),
                            LakeCountrySpanish.Web.Models.Entities.PaymentStatusType.Failed => (emoji: "❌", bgColor: "bg-red-50", textColor: "text-red-700", borderColor: "border-red-200"),
                            _ => (emoji: "📄", bgColor: "bg-gray-50", textColor: "text-gray-700", borderColor: "border-gray-200")
                        };

                        <div class="p-5 hover:bg-gradient-to-r hover:from-emerald-50 hover:to-teal-50 transition group">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0 text-2xl mr-4 transform group-hover:scale-110 transition">
                                        @statusInfo.emoji
                                    </div>
                                    <div>
                                        <p class="font-semibold text-gray-900 group-hover:text-emerald-700 transition">@payment.Description</p>
                                        <p class="text-sm text-gray-500 flex items-center mt-1">
                                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                            </svg>
                                            @payment.CreatedAt.ToString("MMMM d, yyyy 'at' h:mm tt")
                                        </p>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <p class="text-xl font-bold text-gray-900">$@payment.Amount.ToString("0.00")</p>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @statusInfo.bgColor @statusInfo.textColor border @statusInfo.borderColor mt-1">
                                        @payment.Status.ToString()
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="p-12 text-center">
                    <div class="text-6xl mb-4">💰</div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">No payment history yet</h3>
                    <p class="text-gray-500 max-w-sm mx-auto">
                        Your payment records will appear here once you make a transaction.
                    </p>
                    <a asp-action="Dashboard" class="inline-flex items-center mt-6 text-emerald-600 hover:text-emerald-700 font-medium">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                        </svg>
                        Back to Dashboard
                    </a>
                </div>
            }
        </div>

        <!-- Secure Payment Info -->
        @if (Model.Payments.Any())
        {
            <div class="mt-6 bg-gradient-to-r from-emerald-50 to-teal-50 rounded-xl p-5 border border-emerald-100">
                <div class="flex items-start">
                    <span class="text-2xl mr-3">🔒</span>
                    <div>
                        <h4 class="font-semibold text-emerald-900">Secure Payments</h4>
                        <p class="text-sm text-emerald-800 mt-1">
                            All payments are processed securely through Stripe. Your payment information is never stored on our servers.
                        </p>
                    </div>
                </div>
            </div>
        }

    </div>
</div>
