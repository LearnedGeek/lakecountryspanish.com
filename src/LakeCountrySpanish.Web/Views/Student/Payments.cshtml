@model LakeCountrySpanish.Web.Models.ViewModels.PaymentHistoryViewModel
@{
    ViewData["Title"] = "Payment History";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
        @await Component.InvokeAsync("PageHeader", new {
            title = "Payment History",
            backUrl = Url.Action("Dashboard"),
            backText = "Back to Dashboard"
        })

        <!-- Summary Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
            @await Component.InvokeAsync("StatCard", new {
                value = "$" + Model.TotalPaid.ToString("0.00"),
                label = "Total Paid",
                color = "success",
                icon = "currency"
            })
            <div class="bg-white rounded-lg shadow p-6">
                <p class="text-sm text-gray-500">Outstanding Balance</p>
                <p class="text-3xl font-bold text-@(Model.OutstandingBalance > 0 ? "yellow-600" : "gray-900")">$@Model.OutstandingBalance.ToString("0.00")</p>
                @if (Model.OutstandingBalance > 0)
                {
                    <a asp-controller="Payment" asp-action="Checkout" class="mt-4 inline-block text-primary-600 hover:text-primary-700 text-sm font-medium">
                        Pay Now
                    </a>
                }
            </div>
        </div>

        <!-- Payment History -->
        <div class="bg-white rounded-lg shadow">
            <div class="p-6 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-900">Transaction History</h2>
            </div>
            <div class="divide-y divide-gray-200">
                @if (Model.Payments.Any())
                {
                    @foreach (var payment in Model.Payments)
                    {
                        var badgeColor = payment.Status switch
                        {
                            LakeCountrySpanish.Web.Models.Entities.PaymentStatusType.Completed => "green",
                            LakeCountrySpanish.Web.Models.Entities.PaymentStatusType.Pending => "yellow",
                            LakeCountrySpanish.Web.Models.Entities.PaymentStatusType.Failed => "red",
                            _ => "gray"
                        };
                        <div class="p-6 flex items-center justify-between">
                            <div>
                                <p class="font-medium text-gray-900">@payment.Description</p>
                                <p class="text-sm text-gray-500">@payment.CreatedAt.ToString("MMMM d, yyyy 'at' h:mm tt")</p>
                            </div>
                            <div class="text-right">
                                <p class="font-semibold text-gray-900">$@payment.Amount.ToString("0.00")</p>
                                @await Component.InvokeAsync("StatusBadge", new { text = payment.Status.ToString(), color = badgeColor })
                            </div>
                        </div>
                    }
                }
                else
                {
                    @await Component.InvokeAsync("EmptyState", new {
                        icon = "currency",
                        title = "No payment history yet"
                    })
                }
            </div>
        </div>
    </div>
</div>
