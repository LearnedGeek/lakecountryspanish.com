@model LakeCountrySpanish.Web.Models.ViewModels.StudentDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    var nextClassCountdown = Model.NextClass != null ? (Model.NextClass.ClassDateTime - DateTime.Now) : TimeSpan.Zero;
}

<div class="bg-gradient-to-b from-indigo-50 via-white to-white min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">

        <!-- Hero Section with Mascot and Greeting -->
        <div class="relative bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-500 rounded-2xl shadow-xl mb-8 overflow-hidden">
            <!-- Background Pattern -->
            <div class="absolute inset-0 opacity-10">
                <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                    <pattern id="hero-pattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
                        <circle cx="20" cy="20" r="2" fill="white"/>
                    </pattern>
                    <rect fill="url(#hero-pattern)" width="100%" height="100%"/>
                </svg>
            </div>

            <div class="relative flex items-center justify-between p-6 lg:p-8">
                <!-- Greeting and Quick Stats -->
                <div class="flex-1">
                    <h1 class="text-2xl lg:text-3xl font-bold text-white mb-2">@Model.GetGreeting()</h1>
                    <p class="text-indigo-100 text-lg mb-4">Keep learning and earning!</p>

                    <!-- Quick Action Buttons -->
                    <div class="flex flex-wrap gap-3 mt-4">
                        <a asp-action="MyClasses" class="inline-flex items-center px-4 py-2 bg-white text-indigo-600 rounded-lg font-semibold shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            Schedule Classes
                        </a>
                        @if (Model.InProgressAssignments.Any())
                        {
                            <a asp-controller="Assignment" asp-action="Take" asp-route-id="@Model.InProgressAssignments.First().StudentAssignmentId"
                               class="inline-flex items-center px-4 py-2 bg-yellow-400 text-yellow-900 rounded-lg font-semibold shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all">
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                Continue Learning
                            </a>
                        }
                    </div>
                </div>

                <!-- Mascot (Llama) -->
                <div class="hidden md:flex items-center justify-center ml-6">
                    <div class="relative" id="mascot-container">
                        @{
                            var mascotSize = "w-32 h-32 lg:w-40 lg:h-40";
                        }
                        <div class="@mascotSize relative animate-bounce-slow" style="animation: gentle-bounce 3s ease-in-out infinite;">
                            @switch (Model.MascotMood)
                            {
                                case "celebrating":
                                    <!-- Celebrating Llama with confetti -->
                                    <div class="text-8xl lg:text-9xl filter drop-shadow-lg">🦙</div>
                                    <div class="absolute -top-2 -right-2 text-3xl animate-spin-slow">🎉</div>
                                    <div class="absolute -top-4 left-0 text-2xl animate-bounce">⭐</div>
                                    break;
                                case "excited":
                                    <!-- Excited Llama -->
                                    <div class="text-8xl lg:text-9xl filter drop-shadow-lg transform hover:scale-110 transition">🦙</div>
                                    <div class="absolute -top-2 right-0 text-3xl animate-pulse">🔥</div>
                                    break;
                                case "happy":
                                    <!-- Happy Llama -->
                                    <div class="text-8xl lg:text-9xl filter drop-shadow-lg">🦙</div>
                                    <div class="absolute -top-1 right-2 text-2xl">✨</div>
                                    break;
                                case "missing-you":
                                    <!-- Sad/Missing Llama -->
                                    <div class="text-8xl lg:text-9xl filter drop-shadow-lg opacity-90">🦙</div>
                                    <div class="absolute top-8 right-0 text-xl">💭</div>
                                    break;
                                case "ready":
                                    <!-- Ready for class Llama -->
                                    <div class="text-8xl lg:text-9xl filter drop-shadow-lg animate-pulse">🦙</div>
                                    <div class="absolute -top-2 right-0 text-2xl">📚</div>
                                    break;
                                default:
                                    <!-- Friendly Llama -->
                                    <div class="text-8xl lg:text-9xl filter drop-shadow-lg">🦙</div>
                                    <div class="absolute top-0 right-0 text-xl">👋</div>
                                    break;
                            }
                        </div>
                        <!-- Speech bubble for special messages -->
                        @if (Model.NewBadges.Any())
                        {
                            <div class="absolute -bottom-2 left-1/2 transform -translate-x-1/2 bg-white rounded-lg px-3 py-1 shadow-lg text-sm font-medium text-indigo-600 whitespace-nowrap animate-bounce">
                                New badge! 🏆
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- New Badge Celebration Modal -->
        @if (Model.NewBadges.Any())
        {
            <div id="badgeCelebration" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
                <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md mx-4 text-center transform animate-pop-in">
                    <div class="text-6xl mb-4 animate-bounce">🏆</div>
                    <h2 class="text-2xl font-bold text-gray-900 mb-2">Congratulations!</h2>
                    <p class="text-gray-600 mb-4">You earned a new badge!</p>

                    @foreach (var badge in Model.NewBadges.Take(1))
                    {
                        <div class="bg-gradient-to-r from-yellow-100 to-yellow-50 rounded-xl p-4 mb-4">
                            <div class="text-5xl mb-2">@(badge.Emoji ?? "🌟")</div>
                            <h3 class="text-xl font-bold text-gray-900">@badge.Name</h3>
                            <p class="text-gray-600 text-sm">@badge.Description</p>
                        </div>
                    }

                    <button onclick="dismissBadgeCelebration()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-lg transition transform hover:scale-105">
                        Awesome!
                    </button>
                </div>
            </div>
        }

        <!-- Gamification Stats Row -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <!-- Streak Card -->
            <div class="bg-white rounded-xl shadow-md p-4 border-l-4 @(Model.CurrentStreak >= 7 ? "border-orange-500" : Model.CurrentStreak > 0 ? "border-yellow-500" : "border-gray-300") transform hover:scale-105 transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-500 uppercase tracking-wide">Streak</p>
                        <p class="text-3xl font-bold @(Model.CurrentStreak >= 7 ? "text-orange-500" : Model.CurrentStreak > 0 ? "text-yellow-500" : "text-gray-400")">
                            @Model.CurrentStreak
                        </p>
                        <p class="text-xs text-gray-400">days</p>
                    </div>
                    <div class="text-3xl">
                        @if (Model.CurrentStreak >= 7)
                        {
                            <span class="animate-pulse">🔥</span>
                        }
                        else if (Model.CurrentStreak > 0)
                        {
                            <span>⚡</span>
                        }
                        else
                        {
                            <span class="opacity-50">💤</span>
                        }
                    </div>
                </div>
                @if (Model.CurrentStreak > 0 && !Model.ActivityToday)
                {
                    <p class="text-xs text-orange-600 mt-2 animate-pulse">Keep it going today!</p>
                }
            </div>

            <!-- Tokens Card -->
            <div class="bg-white rounded-xl shadow-md p-4 border-l-4 border-yellow-400 transform hover:scale-105 transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-500 uppercase tracking-wide">Tokens</p>
                        <p class="text-3xl font-bold text-yellow-600">@Model.TotalTokens</p>
                        <p class="text-xs text-gray-400">earned</p>
                    </div>
                    <div class="text-3xl">🪙</div>
                </div>
                <a asp-action="TokenStore" class="text-xs text-indigo-600 hover:underline mt-2 inline-block">Visit Store →</a>
            </div>

            <!-- Tickets Card (Free Class Rewards) -->
            <div class="bg-white rounded-xl shadow-md p-4 border-l-4 @(Model.AvailableTickets > 0 ? "border-green-500" : "border-gray-300") transform hover:scale-105 transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-500 uppercase tracking-wide">Free Classes</p>
                        <p class="text-3xl font-bold @(Model.AvailableTickets > 0 ? "text-green-600" : "text-gray-400")">@Model.AvailableTickets</p>
                        <p class="text-xs text-gray-400">rewards</p>
                    </div>
                    <div class="text-3xl">🎁</div>
                </div>
                @if (Model.AvailableTickets > 0)
                {
                    <p class="text-xs text-green-600 font-medium mt-2">You have @Model.AvailableTickets free class@(Model.AvailableTickets > 1 ? "es" : "")!</p>
                }
                else
                {
                    <p class="text-xs text-gray-400 mt-2">Earn tokens to unlock</p>
                }
            </div>

            <!-- Badges Card -->
            <div class="bg-white rounded-xl shadow-md p-4 border-l-4 border-purple-500 transform hover:scale-105 transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-500 uppercase tracking-wide">Badges</p>
                        <p class="text-3xl font-bold text-purple-600">@Model.TotalBadgesEarned</p>
                        <p class="text-xs text-gray-400">earned</p>
                    </div>
                    <div class="text-3xl">🏆</div>
                </div>
                <a asp-action="Progress" class="text-xs text-indigo-600 hover:underline mt-2 inline-block">View all →</a>
            </div>
        </div>

        <!-- Points Progress Bar -->
        <div class="bg-white rounded-xl shadow-md p-4 mb-6">
            <div class="flex items-center justify-between mb-2">
                <div class="flex items-center">
                    <span class="text-2xl mr-2">📊</span>
                    <div>
                        <p class="font-semibold text-gray-900">Points to Next Token</p>
                        <p class="text-sm text-gray-500">@Model.PointProgressPercent / 100 points</p>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-sm text-gray-500">@Model.PointsToNextToken more to go!</p>
                </div>
            </div>
            <div class="relative w-full bg-gray-200 rounded-full h-4 overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 rounded-full transition-all duration-1000 ease-out"
                     style="width: @Model.PointProgressPercent%"></div>
                <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white to-transparent opacity-30 animate-shimmer"></div>
            </div>
            <div class="flex justify-between mt-1 text-xs text-gray-400">
                <span>0</span>
                <span>25</span>
                <span>50</span>
                <span>75</span>
                <span>100 🪙</span>
            </div>
        </div>

        <!-- Badge Showcase -->
        @if (Model.RecentBadges.Any())
        {
            <div class="bg-white rounded-xl shadow-md p-4 mb-6">
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center">
                        <span class="text-2xl mr-2">🏅</span>
                        <h2 class="font-semibold text-gray-900">Recent Badges</h2>
                    </div>
                    <a asp-action="Progress" class="text-sm text-indigo-600 hover:underline">View all badges →</a>
                </div>
                <div class="flex flex-wrap gap-3">
                    @foreach (var badge in Model.RecentBadges)
                    {
                        <div class="flex items-center bg-gradient-to-r from-yellow-50 to-orange-50 rounded-lg px-3 py-2 @(badge.IsNew ? "ring-2 ring-yellow-400 animate-pulse" : "")">
                            <span class="text-2xl mr-2">@(badge.Emoji ?? "🌟")</span>
                            <div>
                                <p class="font-medium text-gray-900 text-sm">@badge.Name</p>
                                <p class="text-xs text-gray-500">@badge.EarnedAt.ToString("MMM d")</p>
                            </div>
                            @if (badge.IsNew)
                            {
                                <span class="ml-2 bg-yellow-400 text-yellow-900 text-xs font-bold px-1.5 py-0.5 rounded">NEW</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Next Class Countdown -->
        @if (Model.NextClass != null)
        {
            var isWithin24Hours = nextClassCountdown.TotalHours < 24;
            var isWithin1Hour = nextClassCountdown.TotalHours < 1;
            var classroomUrl = Model.NextClass.ClassroomUrlOverride ?? Model.DefaultClassroomUrl;

            <div class="bg-gradient-to-r @(isWithin1Hour ? "from-green-500 to-emerald-600" : isWithin24Hours ? "from-blue-500 to-indigo-600" : "from-gray-700 to-gray-800") rounded-xl shadow-lg p-6 mb-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm opacity-80 uppercase tracking-wide">Next Class</p>
                        <p class="text-xl font-bold">@Model.NextClass.ClassDateTime.ToString("dddd, MMMM d")</p>
                        <p class="text-lg">@Model.NextClass.ClassDateTime.ToString("h:mm tt")</p>
                    </div>
                    <div class="text-center">
                        @if (isWithin1Hour)
                        {
                            <p class="text-4xl font-bold animate-pulse">Starting Soon!</p>
                            @if (!string.IsNullOrEmpty(classroomUrl))
                            {
                                <a href="@classroomUrl" target="_blank" class="inline-flex items-center mt-2 bg-white text-green-600 font-semibold px-4 py-2 rounded-lg hover:bg-green-50 transition">
                                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                    </svg>
                                    Join Now
                                </a>
                            }
                        }
                        else if (nextClassCountdown.TotalHours < 24)
                        {
                            <div id="countdown" class="font-mono">
                                <span class="text-4xl font-bold" id="countdown-hours">@((int)nextClassCountdown.TotalHours)</span>
                                <span class="text-lg">h</span>
                                <span class="text-4xl font-bold" id="countdown-minutes">@nextClassCountdown.Minutes</span>
                                <span class="text-lg">m</span>
                            </div>
                            <p class="text-sm opacity-80 mt-1">until class</p>
                        }
                        else
                        {
                            <div class="text-4xl font-bold">@((int)nextClassCountdown.TotalDays) days</div>
                            <p class="text-sm opacity-80">until next class</p>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Continue Learning / In-Progress Assignments -->
        @if (Model.InProgressAssignments.Any())
        {
            <div class="bg-gradient-to-r from-yellow-50 to-orange-50 border border-yellow-200 rounded-xl p-4 mb-6">
                <div class="flex items-center mb-3">
                    <span class="text-2xl mr-2">📝</span>
                    <h2 class="font-semibold text-gray-900">Continue Where You Left Off</h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    @foreach (var assignment in Model.InProgressAssignments)
                    {
                        <a asp-controller="Assignment" asp-action="Take" asp-route-id="@assignment.StudentAssignmentId"
                           class="flex items-center bg-white rounded-lg p-3 shadow hover:shadow-md transition group @(assignment.IsOverdue ? "ring-2 ring-red-300" : "")">
                            <div class="flex-1">
                                <p class="font-medium text-gray-900 group-hover:text-indigo-600 transition">@assignment.Title</p>
                                <div class="flex items-center gap-2 mt-1">
                                    <span class="text-xs bg-gray-100 px-2 py-0.5 rounded">@assignment.CefrLevel</span>
                                    <span class="text-xs text-gray-500">@assignment.TotalPoints pts</span>
                                    @if (assignment.IsOverdue)
                                    {
                                        <span class="text-xs bg-red-100 text-red-700 px-2 py-0.5 rounded">Overdue</span>
                                    }
                                </div>
                            </div>
                            <svg class="w-5 h-5 text-gray-400 group-hover:text-indigo-600 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </a>
                    }
                </div>
            </div>
        }

        <!-- CEFR Level & Placement Test -->
        @if (string.IsNullOrEmpty(Model.CefrLevel))
        {
            <div class="bg-gradient-to-r from-indigo-50 to-purple-50 border border-indigo-200 rounded-xl p-6 mb-6">
                <div class="flex items-center justify-between">
                    <div class="flex items-center">
                        <div class="text-4xl mr-4">🎓</div>
                        <div>
                            <h3 class="font-bold text-gray-900">Discover Your Spanish Level!</h3>
                            <p class="text-gray-600">Take a 10-15 minute placement test to personalize your learning journey.</p>
                        </div>
                    </div>
                    <a asp-controller="PlacementTest" asp-action="Index" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-lg transition transform hover:scale-105 whitespace-nowrap">
                        Take Test
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- CEFR Progress Journey -->
            <div class="bg-white rounded-xl shadow-md p-4 mb-6">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center">
                        <span class="text-2xl mr-2">🗺️</span>
                        <h2 class="font-semibold text-gray-900">Your Learning Journey</h2>
                    </div>
                    <span class="bg-indigo-100 text-indigo-700 font-bold px-3 py-1 rounded-lg">Level @Model.CefrLevel</span>
                </div>
                <div class="flex items-center justify-between">
                    @{
                        var levels = new[] { "A1", "A2", "B1", "B2", "C1", "C2" };
                        var currentIndex = Array.IndexOf(levels, Model.CefrLevel);
                    }
                    @foreach (var level in levels)
                    {
                        var levelIndex = Array.IndexOf(levels, level);
                        var isCompleted = levelIndex < currentIndex;
                        var isCurrent = level == Model.CefrLevel;
                        <div class="flex-1 flex flex-col items-center relative">
                            @if (levelIndex > 0)
                            {
                                <div class="absolute left-0 top-4 w-1/2 h-1 @(isCompleted || isCurrent ? "bg-indigo-500" : "bg-gray-200")"></div>
                            }
                            @if (levelIndex < levels.Length - 1)
                            {
                                <div class="absolute right-0 top-4 w-1/2 h-1 @(isCompleted ? "bg-indigo-500" : "bg-gray-200")"></div>
                            }
                            <div class="relative z-10 w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold
                                @(isCompleted ? "bg-indigo-500 text-white" : isCurrent ? "bg-indigo-600 text-white ring-4 ring-indigo-200" : "bg-gray-200 text-gray-500")">
                                @if (isCompleted)
                                {
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                    </svg>
                                }
                                else
                                {
                                    @level[1]
                                }
                            </div>
                            <span class="mt-1 text-xs @(isCurrent ? "font-bold text-indigo-600" : "text-gray-500")">@level</span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Activity Stats -->
        <div class="bg-white rounded-xl shadow-md p-4 mb-6">
            <div class="flex items-center mb-3">
                <span class="text-2xl mr-2">📈</span>
                <h2 class="font-semibold text-gray-900">Your Activity</h2>
            </div>
            <div class="grid grid-cols-3 gap-4 text-center">
                <div class="bg-gray-50 rounded-lg p-3">
                    <p class="text-2xl font-bold text-indigo-600">@Model.ClassesThisMonth</p>
                    <p class="text-xs text-gray-500">Classes this month</p>
                </div>
                <div class="bg-gray-50 rounded-lg p-3">
                    <p class="text-2xl font-bold text-green-600">@Model.AssignmentsCompletedThisWeek</p>
                    <p class="text-xs text-gray-500">Assignments this week</p>
                </div>
                <div class="bg-gray-50 rounded-lg p-3">
                    <p class="text-2xl font-bold text-purple-600">@Model.TotalClassesCompleted</p>
                    <p class="text-xs text-gray-500">Total classes completed</p>
                </div>
            </div>
        </div>

        <!-- Quick Navigation -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <a asp-controller="Student" asp-action="MyClasses" class="flex items-center bg-white rounded-xl shadow-md p-4 hover:shadow-lg transition group ring-2 ring-indigo-200">
                <div class="flex-shrink-0 p-3 bg-indigo-100 rounded-lg group-hover:bg-indigo-200 transition">
                    <svg class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                    </svg>
                </div>
                <div class="ml-4">
                    <p class="font-medium text-gray-900">My Classes</p>
                    <p class="text-sm text-gray-500">Schedule & Manage</p>
                </div>
            </a>
            <a asp-controller="Assignment" asp-action="Index" class="flex items-center bg-white rounded-xl shadow-md p-4 hover:shadow-lg transition group">
                <div class="flex-shrink-0 p-3 bg-green-100 rounded-lg group-hover:bg-green-200 transition">
                    <svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
                    </svg>
                </div>
                <div class="ml-4">
                    <p class="font-medium text-gray-900">Assignments</p>
                    <p class="text-sm text-gray-500">Practice & Homework</p>
                </div>
            </a>
            <a asp-controller="Student" asp-action="Progress" class="flex items-center bg-white rounded-xl shadow-md p-4 hover:shadow-lg transition group">
                <div class="flex-shrink-0 p-3 bg-purple-100 rounded-lg group-hover:bg-purple-200 transition">
                    <svg class="h-6 w-6 text-purple-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 002.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 012.916.52 6.003 6.003 0 01-5.395 4.972m0 0a6.726 6.726 0 01-2.749 1.35m0 0a6.772 6.772 0 01-3.044 0" />
                    </svg>
                </div>
                <div class="ml-4">
                    <p class="font-medium text-gray-900">My Progress</p>
                    <p class="text-sm text-gray-500">Points & Badges</p>
                </div>
            </a>
            <a asp-controller="Student" asp-action="TokenStore" class="flex items-center bg-white rounded-xl shadow-md p-4 hover:shadow-lg transition group">
                <div class="flex-shrink-0 p-3 bg-yellow-100 rounded-lg group-hover:bg-yellow-200 transition">
                    <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349m-16.5 11.65V9.35m0 0a3.001 3.001 0 003.75-.615A2.993 2.993 0 009.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 002.25 1.016c.896 0 1.7-.393 2.25-1.016a3.001 3.001 0 003.75.614m-16.5 0a3.004 3.004 0 01-.621-4.72L4.318 3.44A1.5 1.5 0 015.378 3h13.243a1.5 1.5 0 011.06.44l1.19 1.189a3 3 0 01-.621 4.72m-13.5 8.65h3.75a.75.75 0 00.75-.75V13.5a.75.75 0 00-.75-.75H6.75a.75.75 0 00-.75.75v3.75c0 .415.336.75.75.75z" />
                    </svg>
                </div>
                <div class="ml-4">
                    <p class="font-medium text-gray-900">Rewards</p>
                    <p class="text-sm text-gray-500">Earn Free Classes</p>
                </div>
            </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Upcoming Classes -->
            <div class="bg-white rounded-xl shadow-md overflow-hidden">
                <div class="p-4 border-b border-gray-200 flex items-center justify-between">
                    <div class="flex items-center">
                        <span class="text-xl mr-2">📅</span>
                        <h2 class="font-semibold text-gray-900">Upcoming Classes</h2>
                    </div>
                    <a asp-action="MyClasses" class="text-sm text-indigo-600 hover:underline">+ Schedule more</a>
                </div>
                <div class="p-4">
                    @if (Model.UpcomingClasses.Any())
                    {
                        <div class="space-y-3">
                            @foreach (var cls in Model.UpcomingClasses.Take(5))
                            {
                                var hoursUntil = (cls.ClassDateTime - DateTime.Now).TotalHours;
                                var isWithin24Hours = hoursUntil < 24 && hoursUntil > 1;
                                var isWithin1Hour = hoursUntil <= 1;
                                var classroomUrl = cls.ClassroomUrlOverride ?? Model.DefaultClassroomUrl;
                                <div class="p-3 bg-gray-50 rounded-lg @(isWithin1Hour ? "ring-2 ring-green-400 bg-green-50" : isWithin24Hours ? "ring-2 ring-blue-300 bg-blue-50" : "")">
                                    <div class="flex items-center justify-between">
                                        <div>
                                            <p class="font-medium text-gray-900">@cls.ClassDateTime.ToString("dddd, MMMM d")</p>
                                            <p class="text-sm text-gray-500">@cls.ClassDateTime.ToString("h:mm tt")</p>
                                        </div>
                                        @if (isWithin1Hour && !string.IsNullOrEmpty(classroomUrl))
                                        {
                                            <a href="@classroomUrl" target="_blank" class="bg-green-500 hover:bg-green-600 text-white text-sm font-medium px-3 py-1.5 rounded-lg transition">
                                                Join Now
                                            </a>
                                        }
                                        else if (!isWithin1Hour)
                                        {
                                            <button type="button"
                                                    onclick="showCancelModal(@cls.Id, '@cls.ClassDateTime.ToString("dddd, MMMM d \\a\\t h:mm tt")', @(isWithin24Hours ? "true" : "false"))"
                                                    class="text-red-600 hover:text-red-800 text-sm">
                                                Cancel
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-8">
                            <div class="text-4xl mb-3">📚</div>
                            <p class="text-gray-600 mb-3">No upcoming classes</p>
                            <a asp-action="MyClasses" class="inline-flex items-center text-indigo-600 hover:underline font-medium">
                                Schedule your classes →
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Leave Feedback / Recent Documents -->
            <div class="space-y-6">
                @if (Model.ClassesNeedingFeedback.Any())
                {
                    <div class="bg-gradient-to-r from-yellow-50 to-orange-50 rounded-xl shadow-md overflow-hidden">
                        <div class="p-4 border-b border-yellow-200 flex items-center">
                            <span class="text-xl mr-2">⭐</span>
                            <h2 class="font-semibold text-gray-900">Leave Feedback</h2>
                        </div>
                        <div class="p-4 space-y-2">
                            @foreach (var cls in Model.ClassesNeedingFeedback.Take(3))
                            {
                                <div class="flex items-center justify-between p-3 bg-white rounded-lg">
                                    <div>
                                        <p class="font-medium text-gray-900">@cls.ClassDateTime.ToString("MMM d")</p>
                                        <p class="text-sm text-gray-500">@cls.ClassDateTime.ToString("h:mm tt")</p>
                                    </div>
                                    <button onclick="showFeedbackModal(@cls.ClassId, '@cls.ClassDateTime.ToString("MMMM d, yyyy")')"
                                            class="bg-yellow-500 hover:bg-yellow-600 text-white text-sm font-medium px-3 py-1.5 rounded-lg transition">
                                        Rate
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Show Appreciation -->
                <div class="bg-gradient-to-r from-pink-50 to-purple-50 rounded-xl shadow-md p-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <span class="text-2xl mr-2">💝</span>
                            <div>
                                <p class="font-semibold text-gray-900">Show Appreciation</p>
                                <p class="text-sm text-gray-600">Thank Karen for a great lesson</p>
                            </div>
                        </div>
                        <button onclick="showTipModal()" class="bg-pink-500 hover:bg-pink-600 text-white font-medium px-4 py-2 rounded-lg transition">
                            Send Tip
                        </button>
                    </div>
                </div>

                <!-- Recent Documents -->
                @if (Model.Documents.Any())
                {
                    <div class="bg-white rounded-xl shadow-md overflow-hidden">
                        <div class="p-4 border-b border-gray-200 flex items-center justify-between">
                            <div class="flex items-center">
                                <span class="text-xl mr-2">📄</span>
                                <h2 class="font-semibold text-gray-900">Recent Documents</h2>
                            </div>
                            <a asp-action="Documents" class="text-sm text-indigo-600 hover:underline">View all</a>
                        </div>
                        <div class="p-4 space-y-2">
                            @foreach (var doc in Model.Documents.Take(3))
                            {
                                <a asp-action="DownloadDocument" asp-route-id="@doc.Id"
                                   class="flex items-center p-2 rounded-lg hover:bg-gray-50 transition">
                                    <svg class="h-6 w-6 text-gray-400 mr-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                                    </svg>
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">@doc.Title</p>
                                        <p class="text-xs text-gray-500">@doc.UploadedAt.ToString("MMM d")</p>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Balance Due Notice -->
        @if (Model.Balance > 0)
        {
            <div class="mt-6 bg-yellow-50 border border-yellow-200 rounded-xl p-4 flex items-center justify-between">
                <div class="flex items-center">
                    <span class="text-2xl mr-3">💰</span>
                    <div>
                        <p class="font-semibold text-gray-900">Balance Due: $@Model.Balance.ToString("0.00")</p>
                        <p class="text-sm text-gray-600">Please settle your balance when convenient</p>
                    </div>
                </div>
                <a asp-action="Payments" class="bg-yellow-500 hover:bg-yellow-600 text-white font-medium px-4 py-2 rounded-lg transition">
                    View Payments
                </a>
            </div>
        }
    </div>
</div>

<!-- Feedback Modal -->
<div id="feedbackModal" class="fixed inset-0 bg-gray-500 bg-opacity-75 hidden flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl p-6 max-w-lg w-full mx-4 max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900">Leave Feedback</h3>
            <button type="button" onclick="hideFeedbackModal()" class="text-gray-400 hover:text-gray-600">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <p class="text-gray-600 mb-4">Class on <span id="feedbackClassDate" class="font-medium"></span></p>

        <form asp-action="SubmitFeedback" method="post" id="feedbackForm">
            <input type="hidden" name="ScheduledClassId" id="feedbackClassId" />

            <!-- Star Rating -->
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-2">How was your class? <span class="text-red-500">*</span></label>
                <div class="flex space-x-2" id="starRating">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <button type="button" onclick="setRating(@i)" class="star-btn text-gray-300 hover:text-yellow-400 transition" data-rating="@i">
                            <svg class="h-10 w-10" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                            </svg>
                        </button>
                    }
                </div>
                <input type="hidden" name="Rating" id="ratingInput" value="0" />
            </div>

            <!-- Private Comment -->
            <div class="mb-6">
                <label for="privateComment" class="block text-sm font-medium text-gray-700 mb-2">
                    Private feedback for Karen
                    <span class="text-gray-400 font-normal">(only Karen will see this)</span>
                </label>
                <textarea name="PrivateComment" id="privateComment" rows="3" maxlength="2000"
                          class="w-full rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
                          placeholder="Any comments about the class, suggestions, or things you'd like to work on..."></textarea>
            </div>

            <!-- Public Testimonial -->
            <div class="mb-4">
                <label for="publicTestimonial" class="block text-sm font-medium text-gray-700 mb-2">
                    Share a testimonial
                    <span class="text-gray-400 font-normal">(may be displayed publicly)</span>
                </label>
                <textarea name="PublicTestimonial" id="publicTestimonial" rows="2" maxlength="500"
                          class="w-full rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
                          placeholder="e.g., 'Karen is an amazing teacher! I've learned so much...'"></textarea>
            </div>

            <!-- Consent Checkbox -->
            <div class="mb-6">
                <label class="flex items-start">
                    <input type="checkbox" name="AllowPublicDisplay" value="true" id="allowPublicDisplay"
                           class="mt-1 rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
                    <span class="ml-2 text-sm text-gray-600">
                        I allow my first name and testimonial to be displayed publicly on the website.
                    </span>
                </label>
            </div>

            <!-- Optional Tip -->
            <div class="border-t border-gray-200 pt-6 mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-3">
                    Add a tip? <span class="text-gray-400 font-normal">(optional)</span>
                </label>
                <div class="flex flex-wrap gap-2 mb-3">
                    <button type="button" onclick="setTipAmount(5)" class="tip-btn px-4 py-2 rounded-lg border border-gray-300 hover:border-pink-500 hover:bg-pink-50 transition">$5</button>
                    <button type="button" onclick="setTipAmount(10)" class="tip-btn px-4 py-2 rounded-lg border border-gray-300 hover:border-pink-500 hover:bg-pink-50 transition">$10</button>
                    <button type="button" onclick="setTipAmount(20)" class="tip-btn px-4 py-2 rounded-lg border border-gray-300 hover:border-pink-500 hover:bg-pink-50 transition">$20</button>
                    <button type="button" onclick="showCustomTip()" class="tip-btn px-4 py-2 rounded-lg border border-gray-300 hover:border-pink-500 hover:bg-pink-50 transition">Custom</button>
                </div>
                <div id="customTipInput" class="hidden mb-3">
                    <div class="flex items-center">
                        <span class="text-gray-500 mr-2">$</span>
                        <input type="number" id="customTipValue" min="1" max="1000" step="1"
                               class="w-24 rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
                               placeholder="Amount" onchange="setCustomTip()" />
                    </div>
                </div>
                <input type="hidden" name="TipAmount" id="tipAmountInput" />
                <p id="tipConfirmation" class="text-sm text-pink-600 font-medium hidden"></p>
            </div>

            <!-- Tip Message -->
            <div id="tipMessageSection" class="mb-6 hidden">
                <label for="tipMessage" class="block text-sm font-medium text-gray-700 mb-2">
                    Add a message with your tip <span class="text-gray-400 font-normal">(optional)</span>
                </label>
                <input type="text" name="TipMessage" id="tipMessage" maxlength="200"
                       class="w-full rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
                       placeholder="Thanks for the great lesson!" />
            </div>

            <div class="flex justify-end space-x-3">
                <button type="button" onclick="hideFeedbackModal()" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">Cancel</button>
                <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg transition">Submit Feedback</button>
            </div>
        </form>
    </div>
</div>

<!-- Tip Modal -->
<div id="tipModal" class="fixed inset-0 bg-gray-500 bg-opacity-75 hidden flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full mx-4">
        <div class="flex items-center justify-between mb-4">
            <div class="flex items-center">
                <span class="text-2xl mr-2">💝</span>
                <h3 class="text-lg font-semibold text-gray-900">Send a Tip</h3>
            </div>
            <button type="button" onclick="hideTipModal()" class="text-gray-400 hover:text-gray-600">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <p class="text-gray-600 mb-4">Show your appreciation to Karen!</p>

        <form asp-action="SendTip" method="post" id="tipForm">
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-3">Select an amount</label>
                <div class="flex flex-wrap gap-2 mb-3">
                    <button type="button" onclick="setStandaloneTip(5)" class="standalone-tip-btn px-4 py-2 rounded-lg border border-gray-300 hover:border-pink-500 hover:bg-pink-50 transition">$5</button>
                    <button type="button" onclick="setStandaloneTip(10)" class="standalone-tip-btn px-4 py-2 rounded-lg border border-gray-300 hover:border-pink-500 hover:bg-pink-50 transition">$10</button>
                    <button type="button" onclick="setStandaloneTip(20)" class="standalone-tip-btn px-4 py-2 rounded-lg border border-gray-300 hover:border-pink-500 hover:bg-pink-50 transition">$20</button>
                    <button type="button" onclick="showStandaloneCustomTip()" class="standalone-tip-btn px-4 py-2 rounded-lg border border-gray-300 hover:border-pink-500 hover:bg-pink-50 transition">Custom</button>
                </div>
                <div id="standaloneCustomTipInput" class="hidden mb-3">
                    <div class="flex items-center">
                        <span class="text-gray-500 mr-2">$</span>
                        <input type="number" id="standaloneCustomTipValue" min="1" max="1000" step="1"
                               class="w-24 rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
                               placeholder="Amount" onchange="setStandaloneCustomTip()" />
                    </div>
                </div>
                <input type="hidden" name="Amount" id="standaloneTipAmountInput" />
            </div>

            <div class="mb-6">
                <label for="standaloneTipMessage" class="block text-sm font-medium text-gray-700 mb-2">
                    Add a message <span class="text-gray-400 font-normal">(optional)</span>
                </label>
                <input type="text" name="Message" id="standaloneTipMessage" maxlength="200"
                       class="w-full rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
                       placeholder="Thanks for being an amazing teacher!" />
            </div>

            <div class="flex justify-end space-x-3">
                <button type="button" onclick="hideTipModal()" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">Cancel</button>
                <button type="submit" id="submitTipBtn" disabled
                        class="bg-pink-500 hover:bg-pink-600 disabled:bg-gray-300 disabled:cursor-not-allowed text-white font-medium py-2 px-4 rounded-lg transition">
                    Send Tip
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Cancel Modal -->
<div id="cancelModal" class="fixed inset-0 bg-gray-500 bg-opacity-75 hidden flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full mx-4">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Cancel Class</h3>
        <p class="text-gray-600 mb-4">
            <span id="cancelClassDisplay" class="font-medium"></span>
        </p>

        <div id="standardCancelMessage" class="hidden mb-4 bg-green-50 border border-green-200 rounded-lg p-3">
            <p class="text-green-800 text-sm">Your ticket will be restored since you're cancelling more than 24 hours in advance.</p>
        </div>

        <div id="forfeitWarning" class="hidden mb-4 bg-yellow-50 border border-yellow-200 rounded-lg p-3">
            <p class="text-yellow-800 text-sm"><strong>Late Cancellation:</strong> Because this class is within 24 hours, your ticket will be forfeited.</p>
        </div>

        <form asp-action="CancelClass" method="post" id="cancelForm">
            <input type="hidden" name="id" id="cancelClassId" />
            <input type="hidden" name="acceptForfeit" id="acceptForfeit" value="false" />

            <div class="flex justify-end space-x-3">
                <button type="button" onclick="hideCancelModal()" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">Keep Class</button>
                <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition">Cancel Class</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <style>
        @@keyframes gentle-bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        @@keyframes pop-in {
            0% { transform: scale(0.8); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        @@keyframes shimmer {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        .animate-bounce-slow {
            animation: gentle-bounce 3s ease-in-out infinite;
        }

        .animate-spin-slow {
            animation: spin 3s linear infinite;
        }

        .animate-pop-in {
            animation: pop-in 0.3s ease-out;
        }

        .animate-shimmer {
            animation: shimmer 2s ease-in-out infinite;
        }
    </style>

    <script>
        // Badge celebration dismissal
        function dismissBadgeCelebration() {
            document.getElementById('badgeCelebration')?.classList.add('hidden');
            // Mark badges as viewed via AJAX
            fetch('@Url.Action("MarkBadgesViewed", "Student")', { method: 'POST' });
        }

        // Cancel Modal
        function showCancelModal(classId, displayText, willForfeit) {
            document.getElementById('cancelClassId').value = classId;
            document.getElementById('cancelClassDisplay').textContent = displayText;
            document.getElementById('acceptForfeit').value = willForfeit;

            if (willForfeit) {
                document.getElementById('forfeitWarning').classList.remove('hidden');
                document.getElementById('standardCancelMessage').classList.add('hidden');
            } else {
                document.getElementById('forfeitWarning').classList.add('hidden');
                document.getElementById('standardCancelMessage').classList.remove('hidden');
            }

            document.getElementById('cancelModal').classList.remove('hidden');
        }

        function hideCancelModal() {
            document.getElementById('cancelModal').classList.add('hidden');
        }

        // Feedback Modal
        let currentRating = 0;
        let currentTipAmount = null;

        function showFeedbackModal(classId, classDate) {
            document.getElementById('feedbackClassId').value = classId;
            document.getElementById('feedbackClassDate').textContent = classDate;
            resetFeedbackForm();
            document.getElementById('feedbackModal').classList.remove('hidden');
        }

        function hideFeedbackModal() {
            document.getElementById('feedbackModal').classList.add('hidden');
            resetFeedbackForm();
        }

        function resetFeedbackForm() {
            currentRating = 0;
            currentTipAmount = null;
            document.getElementById('ratingInput').value = 0;
            document.getElementById('tipAmountInput').value = '';
            document.getElementById('privateComment').value = '';
            document.getElementById('publicTestimonial').value = '';
            document.getElementById('allowPublicDisplay').checked = false;
            document.getElementById('tipMessage').value = '';
            document.getElementById('customTipValue').value = '';
            document.getElementById('customTipInput').classList.add('hidden');
            document.getElementById('tipMessageSection').classList.add('hidden');
            document.getElementById('tipConfirmation').classList.add('hidden');
            updateStars();
            clearTipSelection();
        }

        function setRating(rating) {
            currentRating = rating;
            document.getElementById('ratingInput').value = rating;
            updateStars();
        }

        function updateStars() {
            const stars = document.querySelectorAll('#starRating .star-btn');
            stars.forEach((star, index) => {
                if (index < currentRating) {
                    star.classList.remove('text-gray-300');
                    star.classList.add('text-yellow-400');
                } else {
                    star.classList.add('text-gray-300');
                    star.classList.remove('text-yellow-400');
                }
            });
        }

        function setTipAmount(amount) {
            currentTipAmount = amount;
            document.getElementById('tipAmountInput').value = amount;
            document.getElementById('customTipInput').classList.add('hidden');
            document.getElementById('tipConfirmation').textContent = 'Tip: $' + amount;
            document.getElementById('tipConfirmation').classList.remove('hidden');
            document.getElementById('tipMessageSection').classList.remove('hidden');
            highlightTipButton(amount);
        }

        function showCustomTip() {
            document.getElementById('customTipInput').classList.remove('hidden');
            document.getElementById('customTipValue').focus();
            clearTipSelection();
        }

        function setCustomTip() {
            const value = parseFloat(document.getElementById('customTipValue').value);
            if (value && value >= 1 && value <= 1000) {
                currentTipAmount = value;
                document.getElementById('tipAmountInput').value = value;
                document.getElementById('tipConfirmation').textContent = 'Tip: $' + value;
                document.getElementById('tipConfirmation').classList.remove('hidden');
                document.getElementById('tipMessageSection').classList.remove('hidden');
            } else {
                currentTipAmount = null;
                document.getElementById('tipAmountInput').value = '';
                document.getElementById('tipConfirmation').classList.add('hidden');
                document.getElementById('tipMessageSection').classList.add('hidden');
            }
        }

        function highlightTipButton(amount) {
            const buttons = document.querySelectorAll('.tip-btn');
            buttons.forEach(btn => {
                btn.classList.remove('border-pink-500', 'bg-pink-50');
                if (btn.textContent === '$' + amount) {
                    btn.classList.add('border-pink-500', 'bg-pink-50');
                }
            });
        }

        function clearTipSelection() {
            const buttons = document.querySelectorAll('.tip-btn');
            buttons.forEach(btn => {
                btn.classList.remove('border-pink-500', 'bg-pink-50');
            });
        }

        // Standalone Tip Modal
        let standaloneTipAmount = null;

        function showTipModal() {
            resetTipForm();
            document.getElementById('tipModal').classList.remove('hidden');
        }

        function hideTipModal() {
            document.getElementById('tipModal').classList.add('hidden');
            resetTipForm();
        }

        function resetTipForm() {
            standaloneTipAmount = null;
            document.getElementById('standaloneTipAmountInput').value = '';
            document.getElementById('standaloneTipMessage').value = '';
            document.getElementById('standaloneCustomTipValue').value = '';
            document.getElementById('standaloneCustomTipInput').classList.add('hidden');
            document.getElementById('submitTipBtn').disabled = true;
            clearStandaloneTipSelection();
        }

        function setStandaloneTip(amount) {
            standaloneTipAmount = amount;
            document.getElementById('standaloneTipAmountInput').value = amount;
            document.getElementById('standaloneCustomTipInput').classList.add('hidden');
            document.getElementById('submitTipBtn').disabled = false;
            highlightStandaloneTipButton(amount);
        }

        function showStandaloneCustomTip() {
            document.getElementById('standaloneCustomTipInput').classList.remove('hidden');
            document.getElementById('standaloneCustomTipValue').focus();
            clearStandaloneTipSelection();
            document.getElementById('submitTipBtn').disabled = true;
        }

        function setStandaloneCustomTip() {
            const value = parseFloat(document.getElementById('standaloneCustomTipValue').value);
            if (value && value >= 1 && value <= 1000) {
                standaloneTipAmount = value;
                document.getElementById('standaloneTipAmountInput').value = value;
                document.getElementById('submitTipBtn').disabled = false;
            } else {
                standaloneTipAmount = null;
                document.getElementById('standaloneTipAmountInput').value = '';
                document.getElementById('submitTipBtn').disabled = true;
            }
        }

        function highlightStandaloneTipButton(amount) {
            const buttons = document.querySelectorAll('.standalone-tip-btn');
            buttons.forEach(btn => {
                btn.classList.remove('border-pink-500', 'bg-pink-50');
                if (btn.textContent === '$' + amount) {
                    btn.classList.add('border-pink-500', 'bg-pink-50');
                }
            });
        }

        function clearStandaloneTipSelection() {
            const buttons = document.querySelectorAll('.standalone-tip-btn');
            buttons.forEach(btn => {
                btn.classList.remove('border-pink-500', 'bg-pink-50');
            });
        }

        // Global Event Handlers
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                hideCancelModal();
                hideFeedbackModal();
                hideTipModal();
                dismissBadgeCelebration();
            }
        });

        document.getElementById('cancelModal')?.addEventListener('click', function(e) {
            if (e.target === this) hideCancelModal();
        });

        document.getElementById('feedbackModal')?.addEventListener('click', function(e) {
            if (e.target === this) hideFeedbackModal();
        });

        document.getElementById('tipModal')?.addEventListener('click', function(e) {
            if (e.target === this) hideTipModal();
        });

        document.getElementById('badgeCelebration')?.addEventListener('click', function(e) {
            if (e.target === this) dismissBadgeCelebration();
        });

        // Validate feedback form before submit
        document.getElementById('feedbackForm')?.addEventListener('submit', function(e) {
            const rating = parseInt(document.getElementById('ratingInput').value);
            if (rating < 1 || rating > 5) {
                e.preventDefault();
                alert('Please select a rating before submitting.');
            }
        });

        // Countdown timer for next class
        @if (Model.NextClass != null && nextClassCountdown.TotalHours < 24)
        {
            <text>
            let countdownTarget = new Date('@Model.NextClass.ClassDateTime.ToString("yyyy-MM-ddTHH:mm:ss")');
            setInterval(function() {
                let now = new Date();
                let diff = countdownTarget - now;
                if (diff > 0) {
                    let hours = Math.floor(diff / (1000 * 60 * 60));
                    let minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                    document.getElementById('countdown-hours')?.textContent = hours;
                    document.getElementById('countdown-minutes')?.textContent = minutes;
                }
            }, 60000);
            </text>
        }
    </script>
}
