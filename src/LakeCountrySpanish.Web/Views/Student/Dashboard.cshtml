@model LakeCountrySpanish.Web.Models.ViewModels.StudentDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Welcome back, @Model.StudentName!</h1>
            <p class="mt-2 text-gray-600">Manage your Spanish lessons and track your progress.</p>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 mb-8">
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center">
                    <div class="flex-shrink-0 p-3 bg-blue-100 rounded-lg">
                        <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-500">Upcoming Classes</p>
                        <p class="text-2xl font-semibold text-gray-900">@Model.UpcomingClasses.Count()</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center">
                    <div class="flex-shrink-0 p-3 bg-green-100 rounded-lg">
                        <svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-500">Package Credits</p>
                        <p class="text-2xl font-semibold text-gray-900">@Model.AvailablePackageClasses</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center">
                    <div class="flex-shrink-0 p-3 bg-yellow-100 rounded-lg">
                        <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-500">Balance Due</p>
                        <p class="text-2xl font-semibold text-gray-900">$@Model.Balance.ToString("0.00")</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center">
                    <div class="flex-shrink-0 p-3 bg-purple-100 rounded-lg">
                        <svg class="h-6 w-6 text-purple-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-500">Documents</p>
                        <p class="text-2xl font-semibold text-gray-900">@Model.Documents.Count()</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-4 mb-8">
            @if (Model.AvailablePackageClasses > 0)
            {
                <a asp-action="BookClass" class="flex items-center justify-center bg-primary-600 hover:bg-primary-700 text-white rounded-lg p-4 transition">
                    <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                    </svg>
                    Schedule a Class
                </a>
            }
            <a asp-action="PurchaseClasses" class="flex items-center justify-center @(Model.AvailablePackageClasses == 0 ? "bg-primary-600 hover:bg-primary-700 text-white" : "bg-white hover:bg-gray-50 text-gray-700 border border-gray-300") rounded-lg p-4 transition">
                <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Buy Classes
            </a>
            <a asp-action="Payments" class="flex items-center justify-center bg-white hover:bg-gray-50 text-gray-700 border border-gray-300 rounded-lg p-4 transition">
                <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
                </svg>
                Payment History
            </a>
            <a asp-action="Documents" class="flex items-center justify-center bg-white hover:bg-gray-50 text-gray-700 border border-gray-300 rounded-lg p-4 transition">
                <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
                My Documents
            </a>
        </div>

        <!-- Prompt to buy credits if none available -->
        @if (Model.AvailablePackageClasses == 0)
        {
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6 mb-8">
                <div class="flex items-start">
                    <div class="flex-shrink-0">
                        <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                        </svg>
                    </div>
                    <div class="ml-3">
                        <h3 class="text-sm font-medium text-yellow-800">No class credits available</h3>
                        <p class="mt-1 text-sm text-yellow-700">
                            Purchase class credits to schedule your next Spanish lesson. Buy in bulk and save!
                        </p>
                        <div class="mt-4">
                            <a asp-action="PurchaseClasses" class="inline-flex items-center px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white text-sm font-medium rounded-lg transition">
                                <svg class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                                </svg>
                                Purchase Class Credits
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Leave Feedback Section -->
        @if (Model.ClassesNeedingFeedback.Any())
        {
            <div class="bg-white rounded-lg shadow mb-8">
                <div class="p-6 border-b border-gray-200">
                    <div class="flex items-center">
                        <svg class="h-6 w-6 text-yellow-500 mr-2" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                        </svg>
                        <h2 class="text-lg font-semibold text-gray-900">Leave Feedback</h2>
                    </div>
                    <p class="text-sm text-gray-600 mt-1">Share your experience from recent classes</p>
                </div>
                <div class="p-6">
                    <div class="space-y-3">
                        @foreach (var cls in Model.ClassesNeedingFeedback)
                        {
                            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                                <div>
                                    <p class="font-medium text-gray-900">@cls.ClassDateTime.ToString("dddd, MMMM d")</p>
                                    <p class="text-sm text-gray-500">@cls.ClassDateTime.ToString("h:mm tt")</p>
                                    @if (!string.IsNullOrEmpty(cls.TeacherNotes))
                                    {
                                        <p class="text-xs text-gray-400 mt-1 truncate max-w-xs">Notes: @cls.TeacherNotes</p>
                                    }
                                </div>
                                <button type="button" onclick="showFeedbackModal(@cls.ClassId, '@cls.ClassDateTime.ToString("MMMM d, yyyy")')"
                                        class="inline-flex items-center bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition">
                                    <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                                    </svg>
                                    Leave Feedback
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Show Appreciation Card -->
        <div class="bg-gradient-to-r from-pink-50 to-purple-50 rounded-lg shadow p-6 mb-8">
            <div class="flex items-start justify-between">
                <div>
                    <div class="flex items-center">
                        <svg class="h-6 w-6 text-pink-500 mr-2" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                        </svg>
                        <h3 class="text-lg font-semibold text-gray-900">Show Appreciation</h3>
                    </div>
                    <p class="text-sm text-gray-600 mt-1">Want to thank Karen for a great lesson?</p>
                </div>
                <button type="button" onclick="showTipModal()"
                        class="inline-flex items-center bg-pink-500 hover:bg-pink-600 text-white text-sm font-medium px-4 py-2 rounded-lg transition">
                    <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                    </svg>
                    Send a Tip
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Upcoming Classes -->
            <div class="bg-white rounded-lg shadow">
                <div class="p-6 border-b border-gray-200">
                    <h2 class="text-lg font-semibold text-gray-900">Upcoming Classes</h2>
                </div>
                <div class="p-6">
                    @if (Model.UpcomingClasses.Any())
                    {
                        <div class="space-y-4">
                            @foreach (var cls in Model.UpcomingClasses.Take(5))
                            {
                                var hoursUntil = (cls.ClassDateTime - DateTime.Now).TotalHours;
                                var isWithin24Hours = hoursUntil < 24 && hoursUntil > 1;
                                var isWithin1Hour = hoursUntil <= 1;
                                var classroomUrl = cls.ClassroomUrlOverride ?? Model.DefaultClassroomUrl;
                                <div class="p-4 bg-gray-50 rounded-lg">
                                    <div class="flex items-center justify-between">
                                        <div>
                                            <p class="font-medium text-gray-900">@cls.ClassDateTime.ToString("dddd, MMMM d")</p>
                                            <p class="text-sm text-gray-500">@cls.ClassDateTime.ToString("h:mm tt") - @cls.ClassDateTime.AddHours(1).ToString("h:mm tt")</p>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium @(cls.PaymentStatus == LakeCountrySpanish.Web.Models.Entities.PaymentStatus.Paid || cls.PaymentStatus == LakeCountrySpanish.Web.Models.Entities.PaymentStatus.PartOfPackage ? "bg-green-100 text-green-800" : "bg-yellow-100 text-yellow-800")">
                                                @cls.PaymentStatus
                                            </span>
                                            @if (isWithin24Hours)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800 ml-1">
                                                    Less than 24 hours
                                                </span>
                                            }
                                        </div>
                                        @if (!isWithin1Hour)
                                        {
                                            <button type="button"
                                                    onclick="showCancelModal(@cls.Id, '@cls.ClassDateTime.ToString("dddd, MMMM d \\a\\t h:mm tt")', @(isWithin24Hours ? "true" : "false"))"
                                                    class="text-red-600 hover:text-red-800 text-sm font-medium">
                                                Cancel
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-gray-400 text-sm">Too late to cancel</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(classroomUrl))
                                    {
                                        <div class="mt-3 pt-3 border-t border-gray-200">
                                            <a href="@classroomUrl" target="_blank" rel="noopener noreferrer"
                                               class="inline-flex items-center text-sm font-medium text-primary-600 hover:text-primary-700">
                                                <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
                                                </svg>
                                                Join Classroom
                                                <svg class="h-3 w-3 ml-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
                                                </svg>
                                            </a>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-8">
                            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                            </svg>
                            <p class="mt-2 text-gray-500">No upcoming classes</p>
                            @if (Model.AvailablePackageClasses > 0)
                            {
                                <a asp-action="BookClass" class="mt-4 inline-flex items-center text-primary-600 hover:text-primary-700 font-medium">
                                    Schedule your next class
                                    <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                                    </svg>
                                </a>
                            }
                            else
                            {
                                <a asp-action="PurchaseClasses" class="mt-4 inline-flex items-center text-primary-600 hover:text-primary-700 font-medium">
                                    Purchase credits to book
                                    <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                                    </svg>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Recent Documents -->
            <div class="bg-white rounded-lg shadow">
                <div class="p-6 border-b border-gray-200">
                    <h2 class="text-lg font-semibold text-gray-900">Recent Documents</h2>
                </div>
                <div class="p-6">
                    @if (Model.Documents.Any())
                    {
                        <div class="space-y-3">
                            @foreach (var doc in Model.Documents.Take(5))
                            {
                                <a asp-action="DownloadDocument" asp-route-id="@doc.Id"
                                   class="flex items-center p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition">
                                    <svg class="h-8 w-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                                    </svg>
                                    <div class="ml-3">
                                        <p class="text-sm font-medium text-gray-900">@doc.Title</p>
                                        <p class="text-xs text-gray-500">Uploaded @doc.UploadedAt.ToString("MMM d, yyyy")</p>
                                    </div>
                                </a>
                            }
                        </div>
                        @if (Model.Documents.Count() > 5)
                        {
                            <div class="mt-4 text-center">
                                <a asp-action="Documents" class="text-primary-600 hover:text-primary-700 text-sm font-medium">
                                    View all documents
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-8">
                            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                            </svg>
                            <p class="mt-2 text-gray-500">No documents available yet</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Feedback Modal -->
<div id="feedbackModal" class="fixed inset-0 bg-gray-500 bg-opacity-75 hidden flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl p-6 max-w-lg w-full mx-4 max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900">Leave Feedback</h3>
            <button type="button" onclick="hideFeedbackModal()" class="text-gray-400 hover:text-gray-600">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <p class="text-gray-600 mb-4">Class on <span id="feedbackClassDate" class="font-medium"></span></p>

        <form asp-action="SubmitFeedback" method="post" id="feedbackForm">
            <input type="hidden" name="ScheduledClassId" id="feedbackClassId" />

            <!-- Star Rating -->
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-2">How was your class? <span class="text-red-500">*</span></label>
                <div class="flex space-x-2" id="starRating">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <button type="button" onclick="setRating(@i)" class="star-btn text-gray-300 hover:text-yellow-400 transition" data-rating="@i">
                            <svg class="h-10 w-10" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                            </svg>
                        </button>
                    }
                </div>
                <input type="hidden" name="Rating" id="ratingInput" value="0" />
            </div>

            <!-- Private Comment -->
            <div class="mb-6">
                <label for="privateComment" class="block text-sm font-medium text-gray-700 mb-2">
                    Private feedback for Karen
                    <span class="text-gray-400 font-normal">(only Karen will see this)</span>
                </label>
                <textarea name="PrivateComment" id="privateComment" rows="3" maxlength="2000"
                          class="w-full rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
                          placeholder="Any comments about the class, suggestions, or things you'd like to work on..."></textarea>
            </div>

            <!-- Public Testimonial -->
            <div class="mb-4">
                <label for="publicTestimonial" class="block text-sm font-medium text-gray-700 mb-2">
                    Share a testimonial
                    <span class="text-gray-400 font-normal">(may be displayed publicly)</span>
                </label>
                <textarea name="PublicTestimonial" id="publicTestimonial" rows="2" maxlength="500"
                          class="w-full rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
                          placeholder="e.g., 'Karen is an amazing teacher! I've learned so much...'"></textarea>
            </div>

            <!-- Consent Checkbox -->
            <div class="mb-6">
                <label class="flex items-start">
                    <input type="checkbox" name="AllowPublicDisplay" value="true" id="allowPublicDisplay"
                           class="mt-1 rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
                    <span class="ml-2 text-sm text-gray-600">
                        I allow my first name and testimonial to be displayed publicly on the website.
                    </span>
                </label>
            </div>

            <!-- Optional Tip -->
            <div class="border-t border-gray-200 pt-6 mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-3">
                    Add a tip? <span class="text-gray-400 font-normal">(optional)</span>
                </label>
                <div class="flex flex-wrap gap-2 mb-3">
                    <button type="button" onclick="setTipAmount(5)" class="tip-btn px-4 py-2 rounded-lg border border-gray-300 hover:border-pink-500 hover:bg-pink-50 transition">$5</button>
                    <button type="button" onclick="setTipAmount(10)" class="tip-btn px-4 py-2 rounded-lg border border-gray-300 hover:border-pink-500 hover:bg-pink-50 transition">$10</button>
                    <button type="button" onclick="setTipAmount(20)" class="tip-btn px-4 py-2 rounded-lg border border-gray-300 hover:border-pink-500 hover:bg-pink-50 transition">$20</button>
                    <button type="button" onclick="showCustomTip()" class="tip-btn px-4 py-2 rounded-lg border border-gray-300 hover:border-pink-500 hover:bg-pink-50 transition">Custom</button>
                </div>
                <div id="customTipInput" class="hidden mb-3">
                    <div class="flex items-center">
                        <span class="text-gray-500 mr-2">$</span>
                        <input type="number" id="customTipValue" min="1" max="1000" step="1"
                               class="w-24 rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
                               placeholder="Amount" onchange="setCustomTip()" />
                    </div>
                </div>
                <input type="hidden" name="TipAmount" id="tipAmountInput" />
                <p id="tipConfirmation" class="text-sm text-pink-600 font-medium hidden"></p>
            </div>

            <!-- Tip Message (shown when tip is selected) -->
            <div id="tipMessageSection" class="mb-6 hidden">
                <label for="tipMessage" class="block text-sm font-medium text-gray-700 mb-2">
                    Add a message with your tip <span class="text-gray-400 font-normal">(optional)</span>
                </label>
                <input type="text" name="TipMessage" id="tipMessage" maxlength="200"
                       class="w-full rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
                       placeholder="Thanks for the great lesson!" />
            </div>

            <div class="flex justify-end space-x-3">
                <button type="button" onclick="hideFeedbackModal()"
                        class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium py-2 px-4 rounded-lg transition">
                    Cancel
                </button>
                <button type="submit" id="submitFeedbackBtn"
                        class="bg-primary-600 hover:bg-primary-700 text-white font-medium py-2 px-4 rounded-lg transition">
                    Submit Feedback
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Tip Modal (standalone) -->
<div id="tipModal" class="fixed inset-0 bg-gray-500 bg-opacity-75 hidden flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full mx-4">
        <div class="flex items-center justify-between mb-4">
            <div class="flex items-center">
                <svg class="h-6 w-6 text-pink-500 mr-2" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
                <h3 class="text-lg font-semibold text-gray-900">Send a Tip</h3>
            </div>
            <button type="button" onclick="hideTipModal()" class="text-gray-400 hover:text-gray-600">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <p class="text-gray-600 mb-4">Show your appreciation to Karen!</p>

        <form asp-action="SendTip" method="post" id="tipForm">
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-3">Select an amount</label>
                <div class="flex flex-wrap gap-2 mb-3">
                    <button type="button" onclick="setStandaloneTip(5)" class="standalone-tip-btn px-4 py-2 rounded-lg border border-gray-300 hover:border-pink-500 hover:bg-pink-50 transition">$5</button>
                    <button type="button" onclick="setStandaloneTip(10)" class="standalone-tip-btn px-4 py-2 rounded-lg border border-gray-300 hover:border-pink-500 hover:bg-pink-50 transition">$10</button>
                    <button type="button" onclick="setStandaloneTip(20)" class="standalone-tip-btn px-4 py-2 rounded-lg border border-gray-300 hover:border-pink-500 hover:bg-pink-50 transition">$20</button>
                    <button type="button" onclick="showStandaloneCustomTip()" class="standalone-tip-btn px-4 py-2 rounded-lg border border-gray-300 hover:border-pink-500 hover:bg-pink-50 transition">Custom</button>
                </div>
                <div id="standaloneCustomTipInput" class="hidden mb-3">
                    <div class="flex items-center">
                        <span class="text-gray-500 mr-2">$</span>
                        <input type="number" id="standaloneCustomTipValue" min="1" max="1000" step="1"
                               class="w-24 rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
                               placeholder="Amount" onchange="setStandaloneCustomTip()" />
                    </div>
                </div>
                <input type="hidden" name="Amount" id="standaloneTipAmountInput" />
            </div>

            <div class="mb-6">
                <label for="standaloneTipMessage" class="block text-sm font-medium text-gray-700 mb-2">
                    Add a message <span class="text-gray-400 font-normal">(optional)</span>
                </label>
                <input type="text" name="Message" id="standaloneTipMessage" maxlength="200"
                       class="w-full rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
                       placeholder="Thanks for being an amazing teacher!" />
            </div>

            <div class="flex justify-end space-x-3">
                <button type="button" onclick="hideTipModal()"
                        class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium py-2 px-4 rounded-lg transition">
                    Cancel
                </button>
                <button type="submit" id="submitTipBtn" disabled
                        class="bg-pink-500 hover:bg-pink-600 disabled:bg-gray-300 disabled:cursor-not-allowed text-white font-medium py-2 px-4 rounded-lg transition">
                    Send Tip
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Cancel Class Modal -->
<div id="cancelModal" class="fixed inset-0 bg-gray-500 bg-opacity-75 hidden flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full mx-4">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Cancel Class</h3>
        <p class="text-gray-600 mb-4">
            <span id="cancelClassDisplay" class="font-medium"></span>
        </p>

        <!-- Standard cancellation message -->
        <div id="standardCancelMessage" class="bg-green-50 border border-green-200 rounded-lg p-4 mb-4 hidden">
            <div class="flex items-start">
                <svg class="h-5 w-5 text-green-600 mt-0.5 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                    <p class="text-sm text-green-800 font-medium">Your credit will be restored</p>
                    <p class="text-sm text-green-700 mt-1">Since you're cancelling more than 24 hours in advance, your class credit will be returned to your account.</p>
                </div>
            </div>
        </div>

        <!-- Late cancellation forfeit warning -->
        <div id="forfeitWarning" class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-4 hidden">
            <div class="flex items-start">
                <svg class="h-5 w-5 text-amber-600 mt-0.5 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                </svg>
                <div>
                    <p class="text-sm text-amber-800 font-medium">Late Cancellation - Credit Will Be Forfeited</p>
                    <p class="text-sm text-amber-700 mt-1">Because this class is within 24 hours, cancelling will forfeit your class credit. The credit will not be restored to your account.</p>
                </div>
            </div>
        </div>

        <form asp-action="CancelClass" method="post" id="cancelForm">
            <input type="hidden" name="id" id="cancelClassId" />
            <input type="hidden" name="acceptForfeit" id="acceptForfeit" value="false" />

            <div class="flex justify-end space-x-3">
                <button type="button" onclick="hideCancelModal()"
                        class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium py-2 px-4 rounded-lg transition">
                    Keep Class
                </button>
                <button type="submit" id="cancelButton"
                        class="bg-red-600 hover:bg-red-700 text-white font-medium py-2 px-4 rounded-lg transition">
                    Cancel Class
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // ===== Cancel Modal =====
        function showCancelModal(classId, displayText, willForfeit) {
            document.getElementById('cancelClassId').value = classId;
            document.getElementById('cancelClassDisplay').textContent = displayText;
            document.getElementById('acceptForfeit').value = willForfeit;

            if (willForfeit) {
                document.getElementById('forfeitWarning').classList.remove('hidden');
                document.getElementById('standardCancelMessage').classList.add('hidden');
                document.getElementById('cancelButton').textContent = 'Cancel & Forfeit Credit';
            } else {
                document.getElementById('forfeitWarning').classList.add('hidden');
                document.getElementById('standardCancelMessage').classList.remove('hidden');
                document.getElementById('cancelButton').textContent = 'Cancel Class';
            }

            document.getElementById('cancelModal').classList.remove('hidden');
        }

        function hideCancelModal() {
            document.getElementById('cancelModal').classList.add('hidden');
        }

        // ===== Feedback Modal =====
        let currentRating = 0;
        let currentTipAmount = null;

        function showFeedbackModal(classId, classDate) {
            document.getElementById('feedbackClassId').value = classId;
            document.getElementById('feedbackClassDate').textContent = classDate;
            resetFeedbackForm();
            document.getElementById('feedbackModal').classList.remove('hidden');
        }

        function hideFeedbackModal() {
            document.getElementById('feedbackModal').classList.add('hidden');
            resetFeedbackForm();
        }

        function resetFeedbackForm() {
            currentRating = 0;
            currentTipAmount = null;
            document.getElementById('ratingInput').value = 0;
            document.getElementById('tipAmountInput').value = '';
            document.getElementById('privateComment').value = '';
            document.getElementById('publicTestimonial').value = '';
            document.getElementById('allowPublicDisplay').checked = false;
            document.getElementById('tipMessage').value = '';
            document.getElementById('customTipValue').value = '';
            document.getElementById('customTipInput').classList.add('hidden');
            document.getElementById('tipMessageSection').classList.add('hidden');
            document.getElementById('tipConfirmation').classList.add('hidden');
            updateStars();
            clearTipSelection();
        }

        function setRating(rating) {
            currentRating = rating;
            document.getElementById('ratingInput').value = rating;
            updateStars();
        }

        function updateStars() {
            const stars = document.querySelectorAll('#starRating .star-btn');
            stars.forEach((star, index) => {
                if (index < currentRating) {
                    star.classList.remove('text-gray-300');
                    star.classList.add('text-yellow-400');
                } else {
                    star.classList.add('text-gray-300');
                    star.classList.remove('text-yellow-400');
                }
            });
        }

        function setTipAmount(amount) {
            currentTipAmount = amount;
            document.getElementById('tipAmountInput').value = amount;
            document.getElementById('customTipInput').classList.add('hidden');
            document.getElementById('tipConfirmation').textContent = 'Tip: $' + amount;
            document.getElementById('tipConfirmation').classList.remove('hidden');
            document.getElementById('tipMessageSection').classList.remove('hidden');
            highlightTipButton(amount);
        }

        function showCustomTip() {
            document.getElementById('customTipInput').classList.remove('hidden');
            document.getElementById('customTipValue').focus();
            clearTipSelection();
        }

        function setCustomTip() {
            const value = parseFloat(document.getElementById('customTipValue').value);
            if (value && value >= 1 && value <= 1000) {
                currentTipAmount = value;
                document.getElementById('tipAmountInput').value = value;
                document.getElementById('tipConfirmation').textContent = 'Tip: $' + value;
                document.getElementById('tipConfirmation').classList.remove('hidden');
                document.getElementById('tipMessageSection').classList.remove('hidden');
            } else {
                currentTipAmount = null;
                document.getElementById('tipAmountInput').value = '';
                document.getElementById('tipConfirmation').classList.add('hidden');
                document.getElementById('tipMessageSection').classList.add('hidden');
            }
        }

        function highlightTipButton(amount) {
            const buttons = document.querySelectorAll('.tip-btn');
            buttons.forEach(btn => {
                btn.classList.remove('border-pink-500', 'bg-pink-50');
                if (btn.textContent === '$' + amount) {
                    btn.classList.add('border-pink-500', 'bg-pink-50');
                }
            });
        }

        function clearTipSelection() {
            const buttons = document.querySelectorAll('.tip-btn');
            buttons.forEach(btn => {
                btn.classList.remove('border-pink-500', 'bg-pink-50');
            });
        }

        // ===== Standalone Tip Modal =====
        let standaloneTipAmount = null;

        function showTipModal() {
            resetTipForm();
            document.getElementById('tipModal').classList.remove('hidden');
        }

        function hideTipModal() {
            document.getElementById('tipModal').classList.add('hidden');
            resetTipForm();
        }

        function resetTipForm() {
            standaloneTipAmount = null;
            document.getElementById('standaloneTipAmountInput').value = '';
            document.getElementById('standaloneTipMessage').value = '';
            document.getElementById('standaloneCustomTipValue').value = '';
            document.getElementById('standaloneCustomTipInput').classList.add('hidden');
            document.getElementById('submitTipBtn').disabled = true;
            clearStandaloneTipSelection();
        }

        function setStandaloneTip(amount) {
            standaloneTipAmount = amount;
            document.getElementById('standaloneTipAmountInput').value = amount;
            document.getElementById('standaloneCustomTipInput').classList.add('hidden');
            document.getElementById('submitTipBtn').disabled = false;
            highlightStandaloneTipButton(amount);
        }

        function showStandaloneCustomTip() {
            document.getElementById('standaloneCustomTipInput').classList.remove('hidden');
            document.getElementById('standaloneCustomTipValue').focus();
            clearStandaloneTipSelection();
            document.getElementById('submitTipBtn').disabled = true;
        }

        function setStandaloneCustomTip() {
            const value = parseFloat(document.getElementById('standaloneCustomTipValue').value);
            if (value && value >= 1 && value <= 1000) {
                standaloneTipAmount = value;
                document.getElementById('standaloneTipAmountInput').value = value;
                document.getElementById('submitTipBtn').disabled = false;
            } else {
                standaloneTipAmount = null;
                document.getElementById('standaloneTipAmountInput').value = '';
                document.getElementById('submitTipBtn').disabled = true;
            }
        }

        function highlightStandaloneTipButton(amount) {
            const buttons = document.querySelectorAll('.standalone-tip-btn');
            buttons.forEach(btn => {
                btn.classList.remove('border-pink-500', 'bg-pink-50');
                if (btn.textContent === '$' + amount) {
                    btn.classList.add('border-pink-500', 'bg-pink-50');
                }
            });
        }

        function clearStandaloneTipSelection() {
            const buttons = document.querySelectorAll('.standalone-tip-btn');
            buttons.forEach(btn => {
                btn.classList.remove('border-pink-500', 'bg-pink-50');
            });
        }

        // ===== Global Event Handlers =====
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                hideCancelModal();
                hideFeedbackModal();
                hideTipModal();
            }
        });

        document.getElementById('cancelModal').addEventListener('click', function(e) {
            if (e.target === this) hideCancelModal();
        });

        document.getElementById('feedbackModal').addEventListener('click', function(e) {
            if (e.target === this) hideFeedbackModal();
        });

        document.getElementById('tipModal').addEventListener('click', function(e) {
            if (e.target === this) hideTipModal();
        });

        // Validate feedback form before submit
        document.getElementById('feedbackForm').addEventListener('submit', function(e) {
            const rating = parseInt(document.getElementById('ratingInput').value);
            if (rating < 1 || rating > 5) {
                e.preventDefault();
                alert('Please select a rating before submitting.');
            }
        });
    </script>
}
