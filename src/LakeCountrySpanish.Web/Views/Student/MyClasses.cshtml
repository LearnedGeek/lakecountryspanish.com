@model LakeCountrySpanish.Web.Models.ViewModels.MyClassesViewModel
@{
    ViewData["Title"] = "My Classes";
    var currentWeekStart = Model.WeeklyCalendar.WeekStart;
    var previousWeekStart = currentWeekStart.AddDays(-7);
    var nextWeekStart = currentWeekStart.AddDays(7);
}

<div class="bg-gradient-to-b from-indigo-50 via-white to-white min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

        <!-- Hero Header -->
        <div class="relative bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-500 rounded-2xl shadow-xl mb-8 overflow-hidden">
            <div class="absolute inset-0 opacity-10">
                <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                    <pattern id="schedule-pattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
                        <circle cx="20" cy="20" r="2" fill="white"/>
                    </pattern>
                    <rect fill="url(#schedule-pattern)" width="100%" height="100%"/>
                </svg>
            </div>
            <div class="relative p-6 lg:p-8">
                <div class="flex items-center justify-between">
                    <div>
                        <a asp-action="Dashboard" class="inline-flex items-center text-indigo-200 hover:text-white mb-2 transition">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                            </svg>
                            Dashboard
                        </a>
                        <h1 class="text-3xl font-bold text-white mb-2">My Classes</h1>
                        <p class="text-indigo-100">Schedule and manage your Spanish lessons</p>
                    </div>
                    <div class="hidden md:block text-8xl">📅</div>
                </div>
            </div>
        </div>

        <!-- Status Cards Row -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
            @if (Model.HasActiveSubscription && Model.CurrentSubscription != null)
            {
                <!-- Subscription Status -->
                <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-purple-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs text-gray-500 uppercase tracking-wide">Subscription</p>
                            <p class="text-xl font-bold text-purple-600">@Model.CurrentSubscription.Tier?.Name</p>
                            <p class="text-sm text-gray-500">@Model.SubscriptionClassesRemaining classes remaining</p>
                        </div>
                        <span class="text-3xl">✨</span>
                    </div>
                </div>
            }
            else
            {
                <!-- Pay Per Class Info -->
                <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-blue-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs text-gray-500 uppercase tracking-wide">Per Class</p>
                            <p class="text-xl font-bold text-blue-600">$@Model.CheckoutSummary.PerClassPrice.ToString("0.00")</p>
                            <p class="text-sm text-gray-500">Select classes to schedule</p>
                        </div>
                        <span class="text-3xl">💳</span>
                    </div>
                </div>
            }

            <!-- Upcoming Classes -->
            <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-green-500">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-500 uppercase tracking-wide">Upcoming</p>
                        <p class="text-xl font-bold text-green-600">@Model.UpcomingClasses.Count()</p>
                        <p class="text-sm text-gray-500">classes scheduled</p>
                    </div>
                    <span class="text-3xl">📚</span>
                </div>
            </div>

            <!-- Free Class Rewards -->
            <div class="bg-white rounded-xl shadow-md p-5 border-l-4 @(Model.AvailableTickets > 0 ? "border-yellow-500" : "border-gray-300")">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-500 uppercase tracking-wide">Free Classes</p>
                        <p class="text-xl font-bold @(Model.AvailableTickets > 0 ? "text-yellow-600" : "text-gray-400")">@Model.AvailableTickets</p>
                        <p class="text-sm text-gray-500">rewards available</p>
                    </div>
                    <span class="text-3xl">🎁</span>
                </div>
                @if (Model.AvailableTickets > 0)
                {
                    <p class="text-xs text-green-600 font-medium mt-2">Apply at checkout for free classes!</p>
                }
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Calendar Section (2/3 width on large screens) -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-xl shadow-md overflow-hidden">
                    <!-- Week Navigation -->
                    <div class="p-4 border-b border-gray-200 flex items-center justify-between bg-gradient-to-r from-gray-50 to-white">
                        <a asp-action="MyClasses" asp-route-weekStart="@previousWeekStart.ToString("yyyy-MM-dd")"
                           class="flex items-center text-indigo-600 hover:text-indigo-800 font-medium transition">
                            <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                            </svg>
                            Previous
                        </a>
                        <div class="text-center">
                            <h2 class="text-lg font-semibold text-gray-900">
                                @Model.WeeklyCalendar.WeekStart.ToString("MMMM d") - @Model.WeeklyCalendar.WeekEnd.ToString("MMMM d, yyyy")
                            </h2>
                        </div>
                        <a asp-action="MyClasses" asp-route-weekStart="@nextWeekStart.ToString("yyyy-MM-dd")"
                           class="flex items-center text-indigo-600 hover:text-indigo-800 font-medium transition">
                            Next
                            <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </a>
                    </div>

                    <!-- Calendar Grid -->
                    <div class="p-4 overflow-x-auto">
                        <table class="w-full min-w-[600px]">
                            <thead>
                                <tr>
                                    <th class="py-2 px-2 text-left text-xs font-medium text-gray-500 uppercase">Time</th>
                                    @foreach (var day in Model.WeeklyCalendar.Days)
                                    {
                                        var isToday = day.Date.Date == DateTime.Today;
                                        <th class="py-2 px-2 text-center text-xs font-medium @(isToday ? "text-indigo-600" : "text-gray-500") uppercase">
                                            <div class="@(isToday ? "bg-indigo-100 rounded-lg px-2 py-1" : "")">
                                                @day.Date.ToString("ddd")
                                                <br/>
                                                @day.Date.Day
                                            </div>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var timeSlot in Model.WeeklyCalendar.AllTimeSlots)
                                {
                                    <tr class="border-t border-gray-100">
                                        <td class="py-3 px-2 text-sm text-gray-600 font-medium whitespace-nowrap">
                                            @timeSlot.StartTime.ToString(@"h\:mm") - @timeSlot.EndTime.ToString(@"h\:mm")
                                        </td>
                                        @foreach (var day in Model.WeeklyCalendar.Days)
                                        {
                                            var slot = day.TimeSlots.FirstOrDefault(s => s.TimeSlotId == timeSlot.Id);
                                            <td class="py-2 px-1">
                                                @if (day.IsBlocked)
                                                {
                                                    <div class="h-12 bg-gray-100 rounded-lg flex items-center justify-center" title="@day.BlockedReason">
                                                        <span class="text-xs text-gray-400">Unavailable</span>
                                                    </div>
                                                }
                                                else if (slot == null || !slot.SlotExistsForDay)
                                                {
                                                    <div class="h-12 bg-gray-50 rounded-lg"></div>
                                                }
                                                else if (slot.IsPastBookingCutoff)
                                                {
                                                    <div class="h-12 bg-gray-100 rounded-lg flex items-center justify-center">
                                                        <span class="text-xs text-gray-400">Past</span>
                                                    </div>
                                                }
                                                else if (!slot.IsAvailable)
                                                {
                                                    <div class="h-12 bg-red-50 border border-red-200 rounded-lg flex items-center justify-center">
                                                        <span class="text-xs text-red-500 font-medium">Booked</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            onclick="selectSlot(@timeSlot.Id, '@day.Date.ToString("yyyy-MM-dd")', '@timeSlot.StartTime.ToString(@"h\:mm tt")')"
                                                            class="w-full h-12 bg-green-50 hover:bg-green-100 border-2 border-dashed border-green-300 hover:border-green-500 rounded-lg flex items-center justify-center transition group">
                                                        <svg class="w-5 h-5 text-green-500 group-hover:scale-110 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                                                        </svg>
                                                    </button>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Legend -->
                    <div class="p-4 bg-gray-50 border-t border-gray-200">
                        <div class="flex flex-wrap gap-4 text-xs">
                            <div class="flex items-center">
                                <div class="w-4 h-4 bg-green-50 border-2 border-dashed border-green-300 rounded mr-2"></div>
                                <span class="text-gray-600">Available</span>
                            </div>
                            <div class="flex items-center">
                                <div class="w-4 h-4 bg-red-50 border border-red-200 rounded mr-2"></div>
                                <span class="text-gray-600">Booked</span>
                            </div>
                            <div class="flex items-center">
                                <div class="w-4 h-4 bg-gray-100 rounded mr-2"></div>
                                <span class="text-gray-600">Unavailable</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar (1/3 width on large screens) -->
            <div class="space-y-6">
                <!-- Upcoming Classes List -->
                <div class="bg-white rounded-xl shadow-md overflow-hidden">
                    <div class="p-4 border-b border-gray-200 bg-gradient-to-r from-green-50 to-white">
                        <div class="flex items-center">
                            <span class="text-xl mr-2">📚</span>
                            <h3 class="font-semibold text-gray-900">Upcoming Classes</h3>
                        </div>
                    </div>
                    <div class="p-4">
                        @if (Model.UpcomingClasses.Any())
                        {
                            <div class="space-y-3 max-h-64 overflow-y-auto">
                                @foreach (var cls in Model.UpcomingClasses.Take(5))
                                {
                                    var hoursUntil = (cls.ClassDateTime - DateTime.Now).TotalHours;
                                    var isWithin24Hours = hoursUntil < 24 && hoursUntil > 0;
                                    <div class="p-3 bg-gray-50 rounded-lg @(isWithin24Hours ? "ring-2 ring-blue-200" : "")">
                                        <div class="flex items-center justify-between">
                                            <div>
                                                <p class="font-medium text-gray-900 text-sm">@cls.ClassDateTime.ToString("ddd, MMM d")</p>
                                                <p class="text-xs text-gray-500">@cls.ClassDateTime.ToString("h:mm tt")</p>
                                            </div>
                                            @if (hoursUntil > 1)
                                            {
                                                <button type="button" class="text-xs text-red-600 hover:text-red-800">Cancel</button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (Model.UpcomingClasses.Count() > 5)
                            {
                                <p class="text-xs text-gray-500 mt-3 text-center">+ @(Model.UpcomingClasses.Count() - 5) more classes</p>
                            }
                        }
                        else
                        {
                            <div class="text-center py-6">
                                <div class="text-4xl mb-2">📭</div>
                                <p class="text-gray-500 text-sm">No upcoming classes</p>
                                <p class="text-gray-400 text-xs mt-1">Select a time slot to schedule</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Free Class Rewards Info -->
                @if (Model.AvailableTickets > 0)
                {
                    <div class="bg-gradient-to-r from-yellow-50 to-orange-50 rounded-xl shadow-md p-5 border border-yellow-200">
                        <div class="flex items-start">
                            <span class="text-3xl mr-3">🎁</span>
                            <div>
                                <h4 class="font-semibold text-yellow-900">Free Class Rewards</h4>
                                <p class="text-sm text-yellow-800 mt-1">
                                    You have <strong>@Model.AvailableTickets</strong> free class reward@(Model.AvailableTickets > 1 ? "s" : "")!
                                </p>
                                <p class="text-xs text-yellow-700 mt-2">
                                    When you schedule classes, you can apply these rewards at checkout to reduce your total.
                                </p>
                            </div>
                        </div>
                    </div>
                }

                <!-- How It Works -->
                <div class="bg-white rounded-xl shadow-md p-5">
                    <h4 class="font-semibold text-gray-900 mb-3 flex items-center">
                        <span class="mr-2">💡</span>
                        How It Works
                    </h4>
                    <ol class="space-y-2 text-sm text-gray-600">
                        <li class="flex items-start">
                            <span class="bg-indigo-100 text-indigo-600 rounded-full w-5 h-5 flex items-center justify-center text-xs font-bold mr-2 flex-shrink-0">1</span>
                            Select available time slots on the calendar
                        </li>
                        <li class="flex items-start">
                            <span class="bg-indigo-100 text-indigo-600 rounded-full w-5 h-5 flex items-center justify-center text-xs font-bold mr-2 flex-shrink-0">2</span>
                            Review your selected classes
                        </li>
                        <li class="flex items-start">
                            <span class="bg-indigo-100 text-indigo-600 rounded-full w-5 h-5 flex items-center justify-center text-xs font-bold mr-2 flex-shrink-0">3</span>
                            Apply free class rewards (if available)
                        </li>
                        <li class="flex items-start">
                            <span class="bg-indigo-100 text-indigo-600 rounded-full w-5 h-5 flex items-center justify-center text-xs font-bold mr-2 flex-shrink-0">4</span>
                            Complete checkout to confirm
                        </li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Booking Modal (placeholder for now) -->
<div id="bookingModal" class="fixed inset-0 bg-gray-500 bg-opacity-75 hidden flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full mx-4">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900">Schedule Class</h3>
            <button type="button" onclick="hideBookingModal()" class="text-gray-400 hover:text-gray-600">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="mb-4">
            <p class="text-gray-600">You're about to schedule a class for:</p>
            <p class="text-lg font-semibold text-gray-900 mt-2" id="selectedSlotDisplay"></p>
        </div>

        <div class="bg-gray-50 rounded-lg p-4 mb-4">
            <div class="flex justify-between items-center">
                <span class="text-gray-600">Class fee:</span>
                <span class="font-semibold">$@Model.CheckoutSummary.PerClassPrice.ToString("0.00")</span>
            </div>
            @if (Model.AvailableTickets > 0)
            {
                <div class="flex justify-between items-center mt-2 text-green-600">
                    <span>Free class reward:</span>
                    <span class="font-semibold">-$@Model.CheckoutSummary.PerClassPrice.ToString("0.00")</span>
                </div>
                <div class="border-t border-gray-200 mt-2 pt-2 flex justify-between items-center">
                    <span class="font-semibold text-gray-900">Total:</span>
                    <span class="font-bold text-green-600">FREE</span>
                </div>
            }
        </div>

        <p class="text-sm text-gray-500 mb-4">
            <strong>Note:</strong> This feature is coming soon. For now, please contact Karen to schedule your class.
        </p>

        <div class="flex justify-end space-x-3">
            <button type="button" onclick="hideBookingModal()" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">
                Cancel
            </button>
            <a asp-controller="Contact" asp-action="Index" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg transition">
                Contact Karen
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectSlot(timeSlotId, date, timeDisplay) {
            const dateObj = new Date(date);
            const options = { weekday: 'long', month: 'long', day: 'numeric' };
            const formattedDate = dateObj.toLocaleDateString('en-US', options);
            document.getElementById('selectedSlotDisplay').textContent = formattedDate + ' at ' + timeDisplay;
            document.getElementById('bookingModal').classList.remove('hidden');
        }

        function hideBookingModal() {
            document.getElementById('bookingModal').classList.add('hidden');
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                hideBookingModal();
            }
        });

        document.getElementById('bookingModal')?.addEventListener('click', function(e) {
            if (e.target === this) hideBookingModal();
        });
    </script>
}
