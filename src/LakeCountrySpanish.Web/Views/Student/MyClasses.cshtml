@model LakeCountrySpanish.Web.Models.ViewModels.MyClassesViewModel
@using LakeCountrySpanish.Web.Models.Entities
@{
    ViewData["Title"] = "My Classes";
    var currentWeekStart = Model.WeeklyCalendar.WeekStart;
    var previousWeekStart = currentWeekStart.AddDays(-7);
    var nextWeekStart = currentWeekStart.AddDays(7);
    var activeTab = Model.ActiveTab ?? "lessons";
}

<div class="bg-gradient-to-b from-indigo-50 via-white to-white min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

        <!-- Hero Header -->
        <div class="relative bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-500 rounded-2xl shadow-xl mb-8 overflow-hidden">
            <div class="absolute inset-0 opacity-10">
                <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                    <pattern id="schedule-pattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
                        <circle cx="20" cy="20" r="2" fill="white"/>
                    </pattern>
                    <rect fill="url(#schedule-pattern)" width="100%" height="100%"/>
                </svg>
            </div>
            <div class="relative p-6 lg:p-8">
                <div class="flex items-center justify-between">
                    <div>
                        <a asp-action="Dashboard" class="inline-flex items-center text-indigo-200 hover:text-white mb-2 transition">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                            </svg>
                            Dashboard
                        </a>
                        <h1 class="text-3xl font-bold text-white mb-2">My Classes</h1>
                        <p class="text-indigo-100">Schedule and manage your Spanish lessons</p>
                    </div>
                    <div class="hidden md:block text-8xl">📅</div>
                </div>
            </div>
        </div>

        <!-- Status Cards Row -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
            @if (Model.HasActiveSubscription && Model.CurrentSubscription != null)
            {
                <!-- Subscription Status -->
                <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-purple-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs text-gray-500 uppercase tracking-wide">Subscription</p>
                            <p class="text-xl font-bold text-purple-600">@Model.CurrentSubscription.Tier?.Name</p>
                            <p class="text-sm text-gray-500">@Model.SubscriptionClassesRemaining classes remaining</p>
                        </div>
                        <span class="text-3xl">✨</span>
                    </div>
                </div>
            }
            else
            {
                <!-- Pay Per Class Info -->
                <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-blue-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs text-gray-500 uppercase tracking-wide">Per Class</p>
                            <p class="text-xl font-bold text-blue-600">$@Model.CheckoutSummary.PerClassPrice.ToString("0.00")</p>
                            <p class="text-sm text-gray-500">Select classes to schedule</p>
                        </div>
                        <span class="text-3xl">💳</span>
                    </div>
                </div>
            }

            <!-- Upcoming Classes -->
            <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-green-500">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-500 uppercase tracking-wide">Upcoming</p>
                        <p class="text-xl font-bold text-green-600">@Model.UpcomingClasses.Count()</p>
                        <p class="text-sm text-gray-500">classes scheduled</p>
                    </div>
                    <span class="text-3xl">📚</span>
                </div>
            </div>

            <!-- Free Class Rewards -->
            <div class="bg-white rounded-xl shadow-md p-5 border-l-4 @(Model.AvailableTickets > 0 ? "border-yellow-500" : "border-gray-300")">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-500 uppercase tracking-wide">Free Classes</p>
                        <p class="text-xl font-bold @(Model.AvailableTickets > 0 ? "text-yellow-600" : "text-gray-400")">@Model.AvailableTickets</p>
                        <p class="text-sm text-gray-500">rewards available</p>
                    </div>
                    <span class="text-3xl">🎁</span>
                </div>
                @if (Model.AvailableTickets > 0)
                {
                    <p class="text-xs text-green-600 font-medium mt-2">Apply at checkout for free classes!</p>
                }
            </div>
        </div>

        <!-- Tab Navigation -->
        <div class="bg-white rounded-xl shadow-md mb-6">
            <div class="border-b border-gray-200">
                <nav class="flex -mb-px" aria-label="Tabs">
                    <button type="button" id="lessons-tab"
                            onclick="switchTab('lessons')"
                            class="tab-button @(activeTab == "lessons" ? "border-indigo-500 text-indigo-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") whitespace-nowrap py-4 px-6 border-b-2 font-medium text-sm flex items-center">
                        <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                        </svg>
                        Lessons
                    </button>
                    <button type="button" id="calendar-tab"
                            onclick="switchTab('calendar')"
                            class="tab-button @(activeTab == "calendar" ? "border-indigo-500 text-indigo-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") whitespace-nowrap py-4 px-6 border-b-2 font-medium text-sm flex items-center">
                        <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        Calendar
                    </button>
                </nav>
            </div>
        </div>

        <!-- Lessons Tab Content -->
        <div id="lessons-content" class="@(activeTab == "lessons" ? "" : "hidden")">
            <div class="bg-white rounded-xl shadow-md p-6">
                @await Component.InvokeAsync("LessonsList", new {
                    upcomingClasses = Model.UpcomingClasses,
                    reservedClasses = Model.ReservedClasses,
                    subscription = Model.CurrentSubscription
                })
            </div>
        </div>

        <!-- Calendar Tab Content -->
        <div id="calendar-content" class="@(activeTab == "calendar" ? "" : "hidden")">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Calendar Section (2/3 width on large screens) -->
                <div class="lg:col-span-2">
                    <div class="bg-white rounded-xl shadow-md overflow-hidden">
                        <!-- Week Navigation -->
                        <div class="p-4 border-b border-gray-200 flex items-center justify-between bg-gradient-to-r from-gray-50 to-white">
                        <a asp-action="MyClasses" asp-route-weekStart="@previousWeekStart.ToString("yyyy-MM-dd")" asp-route-tab="calendar"
                           class="flex items-center text-indigo-600 hover:text-indigo-800 font-medium transition">
                            <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                            </svg>
                            Previous
                        </a>
                        <div class="text-center">
                            <h2 class="text-lg font-semibold text-gray-900">
                                @Model.WeeklyCalendar.WeekStart.ToString("MMMM d") - @Model.WeeklyCalendar.WeekEnd.ToString("MMMM d, yyyy")
                            </h2>
                        </div>
                        <a asp-action="MyClasses" asp-route-weekStart="@nextWeekStart.ToString("yyyy-MM-dd")" asp-route-tab="calendar"
                           class="flex items-center text-indigo-600 hover:text-indigo-800 font-medium transition">
                            Next
                            <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </a>
                    </div>

                    <!-- Calendar Grid -->
                    <div class="p-4 overflow-x-auto">
                        <table class="w-full min-w-[600px]">
                            <thead>
                                <tr>
                                    <th class="py-2 px-2 text-left text-xs font-medium text-gray-500 uppercase">Time</th>
                                    @foreach (var day in Model.WeeklyCalendar.Days)
                                    {
                                        var isToday = day.Date.Date == DateTime.Today;
                                        <th class="py-2 px-2 text-center text-xs font-medium @(isToday ? "text-indigo-600" : "text-gray-500") uppercase">
                                            <div class="@(isToday ? "bg-indigo-100 rounded-lg px-2 py-1" : "")">
                                                @day.Date.ToString("ddd")
                                                <br/>
                                                @day.Date.Day
                                            </div>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var timeSlot in Model.WeeklyCalendar.AllTimeSlots)
                                {
                                    <tr class="border-t border-gray-100">
                                        <td class="py-3 px-2 text-sm text-gray-600 font-medium whitespace-nowrap">
                                            @(DateTime.Today.Add(timeSlot.StartTime).ToString("h:mm tt")) - @(DateTime.Today.Add(timeSlot.EndTime).ToString("h:mm tt"))
                                        </td>
                                        @foreach (var day in Model.WeeklyCalendar.Days)
                                        {
                                            var slot = day.TimeSlots.FirstOrDefault(s => s.TimeSlotId == timeSlot.Id);
                                            <td class="py-2 px-1">
                                                @if (day.IsBlocked)
                                                {
                                                    <div class="h-12 bg-gray-100 rounded-lg flex items-center justify-center" title="@day.BlockedReason">
                                                        <span class="text-xs text-gray-400">Unavailable</span>
                                                    </div>
                                                }
                                                else if (slot == null || !slot.SlotExistsForDay)
                                                {
                                                    <div class="h-12 bg-gray-50 rounded-lg"></div>
                                                }
                                                else if (slot.IsPastBookingCutoff)
                                                {
                                                    <div class="h-12 bg-gray-100 rounded-lg flex items-center justify-center">
                                                        <span class="text-xs text-gray-400">Past</span>
                                                    </div>
                                                }
                                                else if (!slot.IsAvailable)
                                                {
                                                    <div class="h-12 bg-red-50 border border-red-200 rounded-lg flex items-center justify-center">
                                                        <span class="text-xs text-red-500 font-medium">Booked</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    var classDateTime = day.Date.Add(timeSlot.StartTime);
                                                    <button type="button"
                                                            onclick="selectSlot(@timeSlot.Id, '@classDateTime.ToString("yyyy-MM-ddTHH:mm:ss")', '@(DateTime.Today.Add(timeSlot.StartTime).ToString("h:mm tt"))')"
                                                            class="w-full h-12 bg-green-50 hover:bg-green-100 border-2 border-dashed border-green-300 hover:border-green-500 rounded-lg flex items-center justify-center transition group">
                                                        <svg class="w-5 h-5 text-green-500 group-hover:scale-110 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                                                        </svg>
                                                    </button>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Legend -->
                    <div class="p-4 bg-gray-50 border-t border-gray-200">
                        <div class="flex flex-wrap gap-4 text-xs">
                            <div class="flex items-center">
                                <div class="w-4 h-4 bg-green-50 border-2 border-dashed border-green-300 rounded mr-2"></div>
                                <span class="text-gray-600">Available</span>
                            </div>
                            <div class="flex items-center">
                                <div class="w-4 h-4 bg-red-50 border border-red-200 rounded mr-2"></div>
                                <span class="text-gray-600">Booked</span>
                            </div>
                            <div class="flex items-center">
                                <div class="w-4 h-4 bg-gray-100 rounded mr-2"></div>
                                <span class="text-gray-600">Unavailable</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar (1/3 width on large screens) -->
            <div class="space-y-6">
                @if (!Model.HasActiveSubscription)
                {
                    <!-- Checkout Cart (Non-subscribers) -->
                    <div id="checkoutCart" class="bg-white rounded-xl shadow-md overflow-hidden">
                        <div class="p-4 border-b border-gray-200 bg-gradient-to-r from-indigo-50 to-white">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center">
                                    <span class="text-xl mr-2">🛒</span>
                                    <h3 class="font-semibold text-gray-900">Your Cart</h3>
                                </div>
                                <span id="cartCount" class="bg-indigo-100 text-indigo-800 text-xs font-bold px-2 py-1 rounded-full">
                                    @Model.PendingCheckoutClasses.Count()
                                </span>
                            </div>
                        </div>
                        <div class="p-4">
                            <div id="cartItems" class="space-y-2 max-h-40 overflow-y-auto mb-4">
                                @if (Model.PendingCheckoutClasses.Any())
                                {
                                    @foreach (var cls in Model.PendingCheckoutClasses)
                                    {
                                        <div class="flex items-center justify-between p-2 bg-gray-50 rounded-lg cart-item" data-class-id="@cls.Id">
                                            <div>
                                                <p class="text-sm font-medium text-gray-900">@cls.ClassDateTime.ToString("ddd, MMM d")</p>
                                                <p class="text-xs text-gray-500">@cls.ClassDateTime.ToString("h:mm tt")</p>
                                            </div>
                                            <button type="button" onclick="removeFromCart(@cls.Id)" class="text-red-500 hover:text-red-700">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                                </svg>
                                            </button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div id="emptyCartMessage" class="text-center py-4">
                                        <p class="text-gray-500 text-sm">No classes selected</p>
                                        <p class="text-gray-400 text-xs mt-1">Click a green slot to add</p>
                                    </div>
                                }
                            </div>

                            <!-- Pricing Summary -->
                            <div id="pricingSummary" class="border-t border-gray-200 pt-4 @(Model.PendingCheckoutClasses.Any() ? "" : "hidden")">
                                <div class="flex justify-between text-sm mb-2">
                                    <span class="text-gray-600"><span id="classCountText">@Model.CheckoutSummary.ClassCount</span> class(es)</span>
                                    <span class="text-gray-900">$<span id="subtotalText">@Model.CheckoutSummary.Subtotal.ToString("0.00")</span></span>
                                </div>

                                @if (Model.AvailableTickets > 0)
                                {
                                    <div class="mb-3">
                                        <label class="flex items-center text-sm">
                                            <input type="checkbox" id="applyTickets" class="rounded border-gray-300 text-indigo-600 mr-2" onchange="updateCheckoutSummary()">
                                            <span class="text-gray-700">Apply free class rewards (<span id="availableTicketsText">@Model.AvailableTickets</span> available)</span>
                                        </label>
                                        <div id="ticketDiscount" class="flex justify-between text-sm text-green-600 mt-1 hidden">
                                            <span>Discount</span>
                                            <span>-$<span id="discountText">0.00</span></span>
                                        </div>
                                    </div>
                                }

                                <div class="flex justify-between font-semibold text-lg border-t border-gray-200 pt-2">
                                    <span>Total</span>
                                    <span id="totalDue" class="text-indigo-600">$@Model.CheckoutSummary.TotalDue.ToString("0.00")</span>
                                </div>

                                <form asp-action="Checkout" method="post" class="mt-4">
                                    <input type="hidden" name="ticketsToApply" id="ticketsToApplyInput" value="0">
                                    <button type="submit" id="checkoutBtn" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-4 rounded-lg transition disabled:bg-gray-400 disabled:cursor-not-allowed" @(Model.PendingCheckoutClasses.Any() ? "" : "disabled")>
                                        Checkout
                                    </button>
                                </form>

                                <button type="button" onclick="clearCart()" class="w-full text-gray-500 hover:text-gray-700 text-sm mt-2">
                                    Clear cart
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <!-- Upcoming Classes List -->
                <div class="bg-white rounded-xl shadow-md overflow-hidden">
                    <div class="p-4 border-b border-gray-200 bg-gradient-to-r from-green-50 to-white">
                        <div class="flex items-center">
                            <span class="text-xl mr-2">📚</span>
                            <h3 class="font-semibold text-gray-900">Upcoming Classes</h3>
                        </div>
                    </div>
                    <div class="p-4">
                        @if (Model.UpcomingClasses.Any())
                        {
                            <div class="space-y-3 max-h-64 overflow-y-auto">
                                @foreach (var cls in Model.UpcomingClasses.Take(5))
                                {
                                    var hoursUntil = (cls.ClassDateTime - DateTime.Now).TotalHours;
                                    var isWithin24Hours = hoursUntil < 24 && hoursUntil > 0;
                                    <div class="p-3 bg-gray-50 rounded-lg @(isWithin24Hours ? "ring-2 ring-blue-200" : "")">
                                        <div class="flex items-center justify-between">
                                            <div>
                                                <p class="font-medium text-gray-900 text-sm">@cls.ClassDateTime.ToString("ddd, MMM d")</p>
                                                <p class="text-xs text-gray-500">@cls.ClassDateTime.ToString("h:mm tt")</p>
                                            </div>
                                            @if (hoursUntil > 1)
                                            {
                                                <button type="button" onclick="cancelUpcomingClass(@cls.Id, false)" class="text-xs text-red-600 hover:text-red-800">Cancel</button>
                                            }
                                            else if (hoursUntil > 0)
                                            {
                                                <button type="button" onclick="cancelUpcomingClass(@cls.Id, true)" class="text-xs text-orange-600 hover:text-orange-800" title="Within 24 hours - ticket may be forfeited">Cancel*</button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (Model.UpcomingClasses.Count() > 5)
                            {
                                <p class="text-xs text-gray-500 mt-3 text-center">+ @(Model.UpcomingClasses.Count() - 5) more classes</p>
                            }
                        }
                        else
                        {
                            <div class="text-center py-6">
                                <div class="text-4xl mb-2">📭</div>
                                <p class="text-gray-500 text-sm">No upcoming classes</p>
                                <p class="text-gray-400 text-xs mt-1">Select a time slot to schedule</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Free Class Rewards Info (Subscribers) -->
                @if (Model.AvailableTickets > 0 && Model.HasActiveSubscription)
                {
                    <div class="bg-gradient-to-r from-yellow-50 to-orange-50 rounded-xl shadow-md p-5 border border-yellow-200">
                        <div class="flex items-start">
                            <span class="text-3xl mr-3">🎁</span>
                            <div class="flex-1">
                                <h4 class="font-semibold text-yellow-900">Free Class Rewards</h4>
                                <p class="text-sm text-yellow-800 mt-1">
                                    You have <strong id="ticketCountDisplay">@Model.AvailableTickets</strong> free class reward@(Model.AvailableTickets > 1 ? "s" : "")!
                                </p>
                                <p class="text-xs text-yellow-700 mt-2">
                                    Use rewards to schedule extra classes beyond your monthly allocation.
                                </p>
                                <button type="button"
                                        id="useTicketModeBtn"
                                        onclick="toggleTicketMode()"
                                        class="mt-3 px-4 py-2 bg-yellow-500 hover:bg-yellow-600 text-white text-sm font-medium rounded-lg transition">
                                    Use Reward for Extra Class
                                </button>
                                <p id="ticketModeHint" class="hidden text-xs text-yellow-800 font-medium mt-2">
                                    Click a green slot to use your reward
                                </p>
                            </div>
                        </div>
                    </div>
                }

                <!-- How It Works (Non-subscriber) -->
                @if (!Model.HasActiveSubscription)
                {
                    <div class="bg-white rounded-xl shadow-md p-5">
                        <h4 class="font-semibold text-gray-900 mb-3 flex items-center">
                            <span class="mr-2">💡</span>
                            How It Works
                        </h4>
                        <ol class="space-y-2 text-sm text-gray-600">
                            <li class="flex items-start">
                                <span class="bg-indigo-100 text-indigo-600 rounded-full w-5 h-5 flex items-center justify-center text-xs font-bold mr-2 flex-shrink-0">1</span>
                                Click green slots to add classes to your cart
                            </li>
                            <li class="flex items-start">
                                <span class="bg-indigo-100 text-indigo-600 rounded-full w-5 h-5 flex items-center justify-center text-xs font-bold mr-2 flex-shrink-0">2</span>
                                Apply free class rewards if you have them
                            </li>
                            <li class="flex items-start">
                                <span class="bg-indigo-100 text-indigo-600 rounded-full w-5 h-5 flex items-center justify-center text-xs font-bold mr-2 flex-shrink-0">3</span>
                                Checkout to confirm your classes
                            </li>
                        </ol>
                    </div>
                }
            </div>
        </div>
        </div> <!-- End calendar-content -->
    </div>
</div>

<!-- Booking Modal (placeholder for now) -->
<div id="bookingModal" class="fixed inset-0 bg-gray-500 bg-opacity-75 hidden flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full mx-4">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900">Schedule Class</h3>
            <button type="button" onclick="hideBookingModal()" class="text-gray-400 hover:text-gray-600">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="mb-4">
            <p class="text-gray-600">You're about to schedule a class for:</p>
            <p class="text-lg font-semibold text-gray-900 mt-2" id="selectedSlotDisplay"></p>
        </div>

        <div class="bg-gray-50 rounded-lg p-4 mb-4">
            <div class="flex justify-between items-center">
                <span class="text-gray-600">Class fee:</span>
                <span class="font-semibold">$@Model.CheckoutSummary.PerClassPrice.ToString("0.00")</span>
            </div>
            @if (Model.AvailableTickets > 0)
            {
                <div class="flex justify-between items-center mt-2 text-green-600">
                    <span>Free class reward:</span>
                    <span class="font-semibold">-$@Model.CheckoutSummary.PerClassPrice.ToString("0.00")</span>
                </div>
                <div class="border-t border-gray-200 mt-2 pt-2 flex justify-between items-center">
                    <span class="font-semibold text-gray-900">Total:</span>
                    <span class="font-bold text-green-600">FREE</span>
                </div>
            }
        </div>

        <p class="text-sm text-gray-500 mb-4">
            <strong>Note:</strong> This feature is coming soon. For now, please contact Karen to schedule your class.
        </p>

        <div class="flex justify-end space-x-3">
            <button type="button" onclick="hideBookingModal()" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">
                Cancel
            </button>
            <a asp-controller="Contact" asp-action="Index" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg transition">
                Contact Karen
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const isSubscriber = @Model.HasActiveSubscription.ToString().ToLower();
        const perClassPrice = @Model.CheckoutSummary.PerClassPrice;
        let availableTickets = @Model.AvailableTickets;

        // Track if subscriber is in "use ticket" mode
        let ticketMode = false;

        // Toggle ticket mode for subscribers
        function toggleTicketMode() {
            ticketMode = !ticketMode;
            const btn = document.getElementById('useTicketModeBtn');
            const hint = document.getElementById('ticketModeHint');

            if (ticketMode) {
                btn.textContent = 'Cancel';
                btn.classList.remove('bg-yellow-500', 'hover:bg-yellow-600');
                btn.classList.add('bg-gray-500', 'hover:bg-gray-600');
                hint?.classList.remove('hidden');
            } else {
                btn.textContent = 'Use Reward for Extra Class';
                btn.classList.remove('bg-gray-500', 'hover:bg-gray-600');
                btn.classList.add('bg-yellow-500', 'hover:bg-yellow-600');
                hint?.classList.add('hidden');
            }
        }

        // Tab switching functionality
        function switchTab(tabName) {
            // Hide all content
            document.getElementById('lessons-content').classList.add('hidden');
            document.getElementById('calendar-content').classList.add('hidden');

            // Reset all tab buttons
            document.querySelectorAll('.tab-button').forEach(btn => {
                btn.classList.remove('border-indigo-500', 'text-indigo-600');
                btn.classList.add('border-transparent', 'text-gray-500');
            });

            // Show selected content
            document.getElementById(tabName + '-content').classList.remove('hidden');

            // Highlight selected tab
            const selectedTab = document.getElementById(tabName + '-tab');
            selectedTab.classList.remove('border-transparent', 'text-gray-500');
            selectedTab.classList.add('border-indigo-500', 'text-indigo-600');

            // Update URL without reload (for bookmarking/back button)
            const url = new URL(window.location);
            url.searchParams.set('tab', tabName);
            window.history.replaceState({}, '', url);
        }

        // Handle clicking on an available slot
        function selectSlot(timeSlotId, date, timeDisplay) {
            if (isSubscriber && ticketMode) {
                // Subscriber in ticket mode: use a ticket for extra class
                selectSlotWithTicket(timeSlotId, date, timeDisplay);
                toggleTicketMode(); // Turn off ticket mode after use
            } else if (isSubscriber) {
                // Subscribers: schedule immediately with subscription
                addToCart(timeSlotId, date, timeDisplay, false);
            } else {
                // Non-subscribers: add to cart
                addToCart(timeSlotId, date, timeDisplay, false);
            }
        }

        // For subscribers who want to use a ticket for an extra class
        function selectSlotWithTicket(timeSlotId, date, timeDisplay) {
            if (availableTickets > 0) {
                addToCart(timeSlotId, date, timeDisplay, true);
            } else {
                showToast('No free class rewards available', 'error');
            }
        }

        async function addToCart(timeSlotId, date, timeDisplay, useTicket = false) {
            try {
                let body = `timeSlotId=${timeSlotId}&classDateTime=${date}`;
                if (useTicket) {
                    body += '&useTicket=true';
                }

                const response = await fetch('/Student/AddToCart', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: body
                });

                const result = await response.json();

                if (result.success) {
                    if (result.confirmed) {
                        // Subscriber flow: class was confirmed immediately
                        if (result.usedTicket) {
                            showToast('Class scheduled with free reward!', 'success');
                            availableTickets = result.ticketsRemaining;
                        } else {
                            showToast('Class scheduled successfully!', 'success');
                        }
                        // Reload page to update calendar and classes list
                        location.reload();
                    } else {
                        // Non-subscriber: added to cart
                        showToast('Added to cart', 'success');
                        addCartItem(result.classId, result.classDateTime);
                        updateCartUI(result.summary);
                    }
                } else {
                    showToast(result.error || 'Failed to add class', 'error');
                }
            } catch (error) {
                console.error('Error adding to cart:', error);
                showToast('Failed to add class. Please try again.', 'error');
            }
        }

        async function removeFromCart(classId) {
            try {
                const response = await fetch('/Student/RemoveFromCart', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `classId=${classId}`
                });

                const result = await response.json();

                if (result.success) {
                    // Remove item from cart UI
                    const item = document.querySelector(`.cart-item[data-class-id="${classId}"]`);
                    if (item) item.remove();

                    updateCartUI(result.summary);
                    showToast('Removed from cart', 'info');
                } else {
                    showToast(result.error || 'Failed to remove class', 'error');
                }
            } catch (error) {
                console.error('Error removing from cart:', error);
                showToast('Failed to remove class. Please try again.', 'error');
            }
        }

        async function clearCart() {
            if (!confirm('Remove all classes from your cart?')) return;

            try {
                const response = await fetch('/Student/ClearCart', {
                    method: 'POST'
                });

                const result = await response.json();

                if (result.success) {
                    // Clear all cart items
                    const cartItems = document.getElementById('cartItems');
                    cartItems.innerHTML = `
                        <div id="emptyCartMessage" class="text-center py-4">
                            <p class="text-gray-500 text-sm">No classes selected</p>
                            <p class="text-gray-400 text-xs mt-1">Click a green slot to add</p>
                        </div>
                    `;
                    updateCartUI({ classCount: 0, subtotal: 0, totalDue: 0 });
                    showToast('Cart cleared', 'info');
                }
            } catch (error) {
                console.error('Error clearing cart:', error);
            }
        }

        async function cancelUpcomingClass(classId, willForfeit) {
            const message = willForfeit
                ? 'This class is within 24 hours. Cancelling may forfeit your credit. Continue?'
                : 'Are you sure you want to cancel this class?';

            if (!confirm(message)) {
                return;
            }

            try {
                const response = await fetch(`/Student/CancelClass?id=${classId}&acceptForfeit=${willForfeit}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    }
                });

                if (response.ok) {
                    showToast('Class cancelled successfully', 'success');
                    location.reload();
                } else {
                    showToast('Failed to cancel class', 'error');
                }
            } catch (error) {
                console.error('Error cancelling class:', error);
                showToast('Failed to cancel class', 'error');
            }
        }

        async function updateCheckoutSummary() {
            const applyTicketsCheckbox = document.getElementById('applyTickets');
            const ticketsToApply = applyTicketsCheckbox?.checked ? availableTickets : 0;

            document.getElementById('ticketsToApplyInput').value = ticketsToApply;

            try {
                const response = await fetch(`/Student/GetCheckoutSummary?ticketsToApply=${ticketsToApply}`);
                const summary = await response.json();

                document.getElementById('classCountText').textContent = summary.classCount;
                document.getElementById('subtotalText').textContent = summary.subtotal.toFixed(2);
                document.getElementById('totalDue').textContent = '$' + summary.totalDue.toFixed(2);

                // Show/hide ticket discount
                const ticketDiscountEl = document.getElementById('ticketDiscount');
                if (ticketDiscountEl) {
                    if (summary.ticketsApplied > 0) {
                        ticketDiscountEl.classList.remove('hidden');
                        document.getElementById('discountText').textContent = summary.ticketDiscount.toFixed(2);
                    } else {
                        ticketDiscountEl.classList.add('hidden');
                    }
                }

                // Update button text if free
                const checkoutBtn = document.getElementById('checkoutBtn');
                if (summary.totalDue === 0 && summary.classCount > 0) {
                    checkoutBtn.textContent = 'Schedule Free Classes';
                } else {
                    checkoutBtn.textContent = 'Checkout';
                }
            } catch (error) {
                console.error('Error updating summary:', error);
            }
        }

        function addCartItem(classId, dateTimeStr) {
            const cartItems = document.getElementById('cartItems');

            // Remove empty message if present
            const emptyMsg = document.getElementById('emptyCartMessage');
            if (emptyMsg) emptyMsg.remove();

            // Parse the date string and format consistently
            const dateObj = new Date(dateTimeStr);
            const dateFormatted = dateObj.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
            const timeFormatted = dateObj.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });

            // Add new item
            const item = document.createElement('div');
            item.className = 'flex items-center justify-between p-2 bg-gray-50 rounded-lg cart-item';
            item.setAttribute('data-class-id', classId);
            item.innerHTML = `
                <div>
                    <p class="text-sm font-medium text-gray-900">${dateFormatted}</p>
                    <p class="text-xs text-gray-500">${timeFormatted}</p>
                </div>
                <button type="button" onclick="removeFromCart(${classId})" class="text-red-500 hover:text-red-700">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            `;
            cartItems.appendChild(item);
        }

        function updateCartUI(summary) {
            const cartCount = document.getElementById('cartCount');
            const pricingSummary = document.getElementById('pricingSummary');
            const checkoutBtn = document.getElementById('checkoutBtn');

            if (cartCount) cartCount.textContent = summary.classCount;

            if (summary.classCount > 0) {
                pricingSummary?.classList.remove('hidden');
                checkoutBtn?.removeAttribute('disabled');
            } else {
                pricingSummary?.classList.add('hidden');
                checkoutBtn?.setAttribute('disabled', 'disabled');

                // Show empty message
                const cartItems = document.getElementById('cartItems');
                if (!document.getElementById('emptyCartMessage')) {
                    cartItems.innerHTML = `
                        <div id="emptyCartMessage" class="text-center py-4">
                            <p class="text-gray-500 text-sm">No classes selected</p>
                            <p class="text-gray-400 text-xs mt-1">Click a green slot to add</p>
                        </div>
                    `;
                }
            }

            document.getElementById('classCountText').textContent = summary.classCount;
            document.getElementById('subtotalText').textContent = summary.subtotal.toFixed(2);
            document.getElementById('totalDue').textContent = '$' + summary.totalDue.toFixed(2);
        }

        function showToast(message, type = 'info') {
            // Create toast element
            const toast = document.createElement('div');
            toast.className = `fixed bottom-4 right-4 px-6 py-3 rounded-lg shadow-lg z-50 transform transition-all duration-300 translate-y-full opacity-0 ${
                type === 'success' ? 'bg-green-600 text-white' :
                type === 'error' ? 'bg-red-600 text-white' :
                'bg-gray-800 text-white'
            }`;
            toast.textContent = message;
            document.body.appendChild(toast);

            // Animate in
            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-full', 'opacity-0');
            });

            // Remove after 3 seconds
            setTimeout(() => {
                toast.classList.add('translate-y-full', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                hideBookingModal();
            }
        });

        // Old modal function (kept for backwards compatibility)
        function hideBookingModal() {
            document.getElementById('bookingModal')?.classList.add('hidden');
        }

        document.getElementById('bookingModal')?.addEventListener('click', function(e) {
            if (e.target === this) hideBookingModal();
        });
    </script>
}
