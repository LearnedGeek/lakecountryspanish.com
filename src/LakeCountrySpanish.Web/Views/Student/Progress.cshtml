@model LakeCountrySpanish.Web.Models.ViewModels.StudentProgressViewModel
@{
    ViewData["Title"] = "My Progress";
}

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    @await Component.InvokeAsync("PageHeader", new {
        title = "My Progress",
        backUrl = Url.Action("Dashboard"),
        backText = "Back to Dashboard"
    })

    <!-- Summary Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-indigo-600 rounded-lg shadow p-4 text-center text-white">
            <p class="text-3xl font-bold">@Model.Progress.TotalPoints.ToString("N0")</p>
            <p class="text-sm opacity-90">Total Points</p>
        </div>
        <div class="bg-green-600 rounded-lg shadow p-4 text-center text-white">
            <p class="text-3xl font-bold">@Model.Progress.CurrentStreak</p>
            <p class="text-sm opacity-90">Day Streak</p>
            @if (Model.Progress.WasActiveToday)
            {
                <p class="text-xs opacity-75 mt-1">Active today!</p>
            }
            else if (Model.Progress.CurrentStreak > 0)
            {
                <p class="text-xs text-yellow-300 mt-1">Keep your streak!</p>
            }
        </div>
        <div class="bg-yellow-500 rounded-lg shadow p-4 text-center text-white">
            <p class="text-3xl font-bold">@Model.Progress.TotalBadgesEarned</p>
            <p class="text-sm opacity-90">Badges Earned</p>
            @if (Model.Progress.UnviewedBadgeCount > 0)
            {
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800 mt-1">
                    @Model.Progress.UnviewedBadgeCount new!
                </span>
            }
        </div>
        <div class="bg-cyan-600 rounded-lg shadow p-4 text-center text-white">
            <p class="text-3xl font-bold">@Model.Progress.TokensEarnedFromPoints</p>
            <p class="text-sm opacity-90">Tokens Earned</p>
            <p class="text-xs opacity-75 mt-1">From points</p>
        </div>
    </div>

    <!-- Points Progress to Next Token -->
    <div class="bg-white rounded-lg shadow mb-6">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Progress to Next Token</h2>
        </div>
        <div class="p-6">
            <div class="flex justify-between text-sm text-gray-600 mb-2">
                <span>@Model.Progress.PointsTowardsNextToken / 100 points</span>
                <span>@(100 - Model.Progress.PointsTowardsNextToken) more to earn a token</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-6">
                <div class="bg-green-600 h-6 rounded-full flex items-center justify-center text-white text-sm font-medium transition-all"
                     style="width: @Model.Progress.PointsTowardsNextToken%">
                    @if (Model.Progress.PointsTowardsNextToken >= 10)
                    {
                        <span>@Model.Progress.PointsTowardsNextToken%</span>
                    }
                </div>
            </div>
            @if (Model.Progress.PointsMultiplier > 1)
            {
                @await Component.InvokeAsync("Alert", new {
                    type = "success",
                    message = "Subscriber Bonus! You're earning " + Model.Progress.PointsMultiplier.ToString("0.0") + "x points on all activities."
                })
            }
        </div>
    </div>

    <!-- Streak Info -->
    <div class="bg-white rounded-lg shadow mb-6">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Streak Information</h2>
        </div>
        <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <p class="text-gray-700 mb-2"><span class="font-medium">Current Streak:</span> @Model.Progress.CurrentStreak days</p>
                    <p class="text-gray-700"><span class="font-medium">Longest Streak:</span> @Model.Progress.LongestStreak days</p>
                </div>
                <div>
                    @if (Model.Progress.WasActiveToday)
                    {
                        @await Component.InvokeAsync("Alert", new { type = "success", message = "You've been active today! Keep it up!" })
                    }
                    else if (Model.Progress.CurrentStreak > 0)
                    {
                        @await Component.InvokeAsync("Alert", new { type = "warning", message = "Don't break your streak! Complete an activity today." })
                    }
                    else
                    {
                        @await Component.InvokeAsync("Alert", new { type = "info", message = "Start your streak by completing an activity!" })
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Badges Section -->
    <div class="bg-white rounded-lg shadow mb-6">
        <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
            <h2 class="text-lg font-semibold text-gray-900">Badges</h2>
            @if (Model.Progress.UnviewedBadgeCount > 0)
            {
                <form method="post" asp-action="MarkBadgesViewed" class="inline">
                    @Html.AntiForgeryToken()
                    @await Component.InvokeAsync("Button", new {
                        text = "Mark all as viewed",
                        type = "secondary",
                        size = "sm"
                    })
                </form>
            }
        </div>
        <div class="p-6">
            @if (!Model.AllBadges.Any())
            {
                <p class="text-gray-500">No badges available yet. Keep learning to unlock badges!</p>
            }
            else
            {
                @foreach (var category in Model.AllBadges.Select(b => b.Category).Distinct())
                {
                    var categoryBadges = Model.AllBadges.Where(b => b.Category == category).ToList();
                    <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider mt-4 mb-3 first:mt-0">@categoryBadges.First().CategoryDisplayName</h3>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        @foreach (var badge in categoryBadges)
                        {
                            <div class="relative bg-white border @(badge.IsEarned ? "border-gray-200" : "border-gray-100 bg-gray-50 opacity-75") rounded-lg p-4 text-center">
                                @if (badge.IsNew)
                                {
                                    <span class="absolute -top-2 -right-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-500 text-white">
                                        NEW
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(badge.IconUrl))
                                {
                                    <img src="@badge.IconUrl" alt="@badge.Name" class="mx-auto mb-2 w-16 h-16 @(badge.IsEarned ? "" : "grayscale")">
                                }
                                else
                                {
                                    <div class="text-5xl mb-2">
                                        @(badge.IsEarned ? "🏆" : "🔒")
                                    </div>
                                }
                                <h4 class="font-medium text-gray-900 text-sm">@badge.Name</h4>
                                <p class="text-xs text-gray-500 mt-1">@badge.Description</p>
                                @if (badge.IsEarned)
                                {
                                    @await Component.InvokeAsync("StatusBadge", new { text = "Earned " + badge.EarnedAt?.ToString("MMM d, yyyy"), color = "green" })
                                }
                                else if (badge.ProgressPercentage.HasValue)
                                {
                                    <div class="w-full bg-gray-200 rounded-full h-1.5 mt-2">
                                        <div class="bg-indigo-600 h-1.5 rounded-full" style="width: @badge.ProgressPercentage%"></div>
                                    </div>
                                    <p class="text-xs text-gray-400 mt-1">@badge.CurrentProgress / @badge.RequirementValue</p>
                                }
                                else
                                {
                                    <p class="text-xs text-gray-400 mt-2">@badge.RequirementDescription</p>
                                }
                                @if (badge.BonusPoints > 0)
                                {
                                    <p class="text-xs text-green-600 mt-1">+@badge.BonusPoints bonus points</p>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>

    <!-- Recent Points Activity -->
    <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Recent Points Activity</h2>
        </div>
        @if (!Model.RecentPointHistory.Any())
        {
            @await Component.InvokeAsync("EmptyState", new {
                icon = "chart",
                title = "No point activity yet",
                message = "Complete activities to earn points!"
            })
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Activity</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Details</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Points</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var point in Model.RecentPointHistory)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@point.CreatedAt.ToString("MMM d, yyyy h:mm tt")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@point.SourceDisplayName</td>
                                <td class="px-6 py-4 text-sm text-gray-500">
                                    @(point.Details ?? point.BadgeName ?? "-")
                                    @if (point.HasMultiplier)
                                    {
                                        @await Component.InvokeAsync("StatusBadge", new { text = point.Multiplier.ToString("0.0") + "x", color = "cyan" })
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-right @(point.FinalPoints >= 0 ? "text-green-600" : "text-red-600")">
                                    @point.PointsDisplay
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
