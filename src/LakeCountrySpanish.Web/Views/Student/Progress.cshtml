@model LakeCountrySpanish.Web.Models.ViewModels.StudentProgressViewModel
@{
    ViewData["Title"] = "My Progress";
}

<div class="bg-gradient-to-b from-indigo-50 via-white to-white min-h-screen">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">

        <!-- Hero Header -->
        <div class="relative bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-500 rounded-2xl shadow-xl mb-8 overflow-hidden">
            <div class="absolute inset-0 opacity-10">
                <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                    <pattern id="progress-pattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
                        <circle cx="20" cy="20" r="2" fill="white"/>
                    </pattern>
                    <rect fill="url(#progress-pattern)" width="100%" height="100%"/>
                </svg>
            </div>
            <div class="relative p-6 lg:p-8">
                <div class="flex items-center justify-between">
                    <div>
                        <a asp-action="Dashboard" class="inline-flex items-center text-indigo-200 hover:text-white mb-2 transition">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                            </svg>
                            Dashboard
                        </a>
                        <h1 class="text-3xl font-bold text-white mb-2">My Progress</h1>
                        <p class="text-indigo-100">Track your learning journey and achievements</p>
                    </div>
                    <div class="hidden md:block text-8xl">🏆</div>
                </div>
            </div>
        </div>

        <!-- Summary Cards - More Exciting -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            <!-- Total Points -->
            <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-indigo-500 transform hover:scale-105 transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-500 uppercase tracking-wide">Total Points</p>
                        <p class="text-3xl font-bold text-indigo-600">@Model.Progress.TotalPoints.ToString("N0")</p>
                    </div>
                    <div class="text-3xl">📊</div>
                </div>
                @if (Model.Progress.PointsMultiplier > 1)
                {
                    <p class="text-xs text-green-600 mt-2">@Model.Progress.PointsMultiplier.ToString("0.0")x multiplier active!</p>
                }
            </div>

            <!-- Streak -->
            <div class="bg-white rounded-xl shadow-md p-5 border-l-4 @(Model.Progress.CurrentStreak >= 7 ? "border-orange-500" : Model.Progress.CurrentStreak > 0 ? "border-yellow-500" : "border-gray-300") transform hover:scale-105 transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-500 uppercase tracking-wide">Day Streak</p>
                        <p class="text-3xl font-bold @(Model.Progress.CurrentStreak >= 7 ? "text-orange-500" : Model.Progress.CurrentStreak > 0 ? "text-yellow-500" : "text-gray-400")">
                            @Model.Progress.CurrentStreak
                        </p>
                    </div>
                    <div class="text-3xl">
                        @if (Model.Progress.CurrentStreak >= 7)
                        {
                            <span class="animate-pulse">🔥</span>
                        }
                        else if (Model.Progress.CurrentStreak > 0)
                        {
                            <span>⚡</span>
                        }
                        else
                        {
                            <span class="opacity-50">💤</span>
                        }
                    </div>
                </div>
                @if (Model.Progress.WasActiveToday)
                {
                    <p class="text-xs text-green-600 mt-2">Active today!</p>
                }
                else if (Model.Progress.CurrentStreak > 0)
                {
                    <p class="text-xs text-orange-600 mt-2 animate-pulse">Keep your streak!</p>
                }
            </div>

            <!-- Badges -->
            <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-purple-500 transform hover:scale-105 transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-500 uppercase tracking-wide">Badges</p>
                        <p class="text-3xl font-bold text-purple-600">@Model.Progress.TotalBadgesEarned</p>
                    </div>
                    <div class="text-3xl">🏅</div>
                </div>
                @if (Model.Progress.UnviewedBadgeCount > 0)
                {
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800 mt-2 animate-pulse">
                        @Model.Progress.UnviewedBadgeCount new!
                    </span>
                }
            </div>

            <!-- Tokens -->
            <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-yellow-400 transform hover:scale-105 transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-500 uppercase tracking-wide">Tokens</p>
                        <p class="text-3xl font-bold text-yellow-600">@Model.Progress.TokensEarnedFromPoints</p>
                    </div>
                    <div class="text-3xl">🪙</div>
                </div>
                <a asp-action="TokenStore" class="text-xs text-indigo-600 hover:underline mt-2 inline-block">Spend tokens →</a>
            </div>
        </div>

        <!-- Points Progress to Next Token - Enhanced -->
        <div class="bg-white rounded-xl shadow-md p-6 mb-8">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center">
                    <span class="text-3xl mr-3">🎯</span>
                    <div>
                        <h2 class="text-lg font-semibold text-gray-900">Progress to Next Token</h2>
                        <p class="text-sm text-gray-500">@Model.Progress.PointsTowardsNextToken / 100 points</p>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-sm text-gray-500">@(100 - Model.Progress.PointsTowardsNextToken) more to go!</p>
                </div>
            </div>
            <div class="relative w-full bg-gray-200 rounded-full h-6 overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 rounded-full transition-all duration-1000 ease-out flex items-center justify-center"
                     style="width: @Model.Progress.PointsTowardsNextToken%">
                    @if (Model.Progress.PointsTowardsNextToken >= 15)
                    {
                        <span class="text-white text-sm font-semibold">@Model.Progress.PointsTowardsNextToken%</span>
                    }
                </div>
                <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white to-transparent opacity-30" style="animation: shimmer 2s ease-in-out infinite;"></div>
            </div>
            <div class="flex justify-between mt-2 text-xs text-gray-400">
                <span>0</span>
                <span>25</span>
                <span>50</span>
                <span>75</span>
                <span>100 🪙</span>
            </div>
            @if (Model.Progress.PointsMultiplier > 1)
            {
                <div class="mt-4 bg-green-50 border border-green-200 rounded-lg p-3 flex items-center">
                    <span class="text-xl mr-2">⭐</span>
                    <p class="text-sm text-green-800"><strong>Subscriber Bonus!</strong> You're earning @Model.Progress.PointsMultiplier.ToString("0.0")x points on all activities.</p>
                </div>
            }
        </div>

        <!-- Streak Section - More Visual -->
        <div class="bg-gradient-to-r from-yellow-50 to-orange-50 rounded-xl shadow-md p-6 mb-8">
            <div class="flex items-center mb-4">
                <span class="text-3xl mr-3">🔥</span>
                <h2 class="text-lg font-semibold text-gray-900">Streak Status</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-white rounded-lg p-4 text-center">
                    <p class="text-4xl font-bold @(Model.Progress.CurrentStreak >= 7 ? "text-orange-500" : Model.Progress.CurrentStreak > 0 ? "text-yellow-500" : "text-gray-400")">
                        @Model.Progress.CurrentStreak
                    </p>
                    <p class="text-sm text-gray-500">Current Streak</p>
                </div>
                <div class="bg-white rounded-lg p-4 text-center">
                    <p class="text-4xl font-bold text-indigo-600">@Model.Progress.LongestStreak</p>
                    <p class="text-sm text-gray-500">Longest Streak</p>
                </div>
                <div class="bg-white rounded-lg p-4 text-center flex flex-col items-center justify-center">
                    @if (Model.Progress.WasActiveToday)
                    {
                        <div class="text-3xl mb-1">✅</div>
                        <p class="text-sm text-green-600 font-medium">Active today!</p>
                    }
                    else if (Model.Progress.CurrentStreak > 0)
                    {
                        <div class="text-3xl mb-1 animate-bounce">⚠️</div>
                        <p class="text-sm text-orange-600 font-medium">Complete an activity!</p>
                    }
                    else
                    {
                        <div class="text-3xl mb-1">🚀</div>
                        <p class="text-sm text-indigo-600 font-medium">Start your streak!</p>
                    }
                </div>
            </div>
        </div>

        <!-- Badges Section - Trophy Case -->
        <div class="bg-white rounded-xl shadow-md overflow-hidden mb-8">
            <div class="px-6 py-4 border-b border-gray-200 bg-gradient-to-r from-purple-50 to-pink-50 flex justify-between items-center">
                <div class="flex items-center">
                    <span class="text-2xl mr-2">🏆</span>
                    <h2 class="text-lg font-semibold text-gray-900">Trophy Case</h2>
                </div>
                @if (Model.Progress.UnviewedBadgeCount > 0)
                {
                    <form method="post" asp-action="MarkBadgesViewed">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="text-sm text-indigo-600 hover:text-indigo-800 font-medium">
                            Mark all as viewed
                        </button>
                    </form>
                }
            </div>
            <div class="p-6">
                @if (!Model.AllBadges.Any())
                {
                    <div class="text-center py-8">
                        <div class="text-5xl mb-3">🎯</div>
                        <p class="text-gray-600 font-medium">Your trophy case is waiting!</p>
                        <p class="text-gray-500 text-sm mt-1">Keep learning to unlock badges and fill it up.</p>
                    </div>
                }
                else
                {
                    @foreach (var category in Model.AllBadges.Select(b => b.Category).Distinct())
                    {
                        var categoryBadges = Model.AllBadges.Where(b => b.Category == category).ToList();
                        var categoryEmoji = category switch {
                            LakeCountrySpanish.Web.Models.Entities.BadgeCategory.Consistency => "🔥",
                            LakeCountrySpanish.Web.Models.Entities.BadgeCategory.Milestone => "📊",
                            LakeCountrySpanish.Web.Models.Entities.BadgeCategory.TopicMastery => "📚",
                            LakeCountrySpanish.Web.Models.Entities.BadgeCategory.Challenge => "🎯",
                            LakeCountrySpanish.Web.Models.Entities.BadgeCategory.LevelProgress => "🎓",
                            LakeCountrySpanish.Web.Models.Entities.BadgeCategory.Special => "⭐",
                            _ => "🏅"
                        };
                        <div class="mb-6 last:mb-0">
                            <h3 class="flex items-center text-sm font-medium text-gray-500 uppercase tracking-wider mb-3">
                                <span class="mr-2">@categoryEmoji</span>
                                @categoryBadges.First().CategoryDisplayName
                            </h3>
                            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                                @foreach (var badge in categoryBadges)
                                {
                                    <div class="relative group">
                                        <div class="bg-gradient-to-b @(badge.IsEarned ? "from-yellow-50 to-orange-50 border-yellow-200" : "from-gray-50 to-gray-100 border-gray-200 opacity-60") border-2 rounded-xl p-4 text-center transform group-hover:scale-105 transition-all">
                                            @if (badge.IsNew)
                                            {
                                                <span class="absolute -top-2 -right-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-500 text-white animate-bounce">
                                                    NEW
                                                </span>
                                            }
                                            <div class="text-4xl mb-2">
                                                @if (badge.IsEarned)
                                                {
                                                    @(string.IsNullOrEmpty(badge.IconUrl) ? "🏆" : badge.IconUrl)
                                                }
                                                else
                                                {
                                                    <span class="opacity-50">🔒</span>
                                                }
                                            </div>
                                            <h4 class="font-medium text-gray-900 text-sm">@badge.Name</h4>
                                            <p class="text-xs text-gray-500 mt-1 line-clamp-2">@badge.Description</p>

                                            @if (badge.IsEarned)
                                            {
                                                <p class="text-xs text-green-600 mt-2 font-medium">
                                                    ✓ Earned @badge.EarnedAt?.ToString("MMM d")
                                                </p>
                                            }
                                            else if (badge.ProgressPercentage.HasValue)
                                            {
                                                <div class="mt-2">
                                                    <div class="w-full bg-gray-200 rounded-full h-1.5">
                                                        <div class="bg-indigo-500 h-1.5 rounded-full transition-all" style="width: @badge.ProgressPercentage%"></div>
                                                    </div>
                                                    <p class="text-xs text-gray-400 mt-1">@badge.CurrentProgress / @badge.RequirementValue</p>
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="text-xs text-gray-400 mt-2">@badge.RequirementDescription</p>
                                            }

                                            @if (badge.BonusPoints > 0)
                                            {
                                                <p class="text-xs text-green-600 mt-1">+@badge.BonusPoints pts</p>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Recent Points Activity -->
        <div class="bg-white rounded-xl shadow-md overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200 flex items-center">
                <span class="text-xl mr-2">📈</span>
                <h2 class="text-lg font-semibold text-gray-900">Recent Activity</h2>
            </div>
            @if (!Model.RecentPointHistory.Any())
            {
                <div class="p-8 text-center">
                    <div class="text-5xl mb-3">🎮</div>
                    <p class="text-gray-600 font-medium">No activity yet</p>
                    <p class="text-gray-500 text-sm mt-1">Complete activities to start earning points!</p>
                    <a asp-controller="Assignment" asp-action="Index" class="inline-flex items-center mt-4 text-indigo-600 hover:text-indigo-800 font-medium">
                        Browse assignments →
                    </a>
                </div>
            }
            else
            {
                <div class="divide-y divide-gray-100">
                    @foreach (var point in Model.RecentPointHistory)
                    {
                        var iconEmoji = point.Source switch {
                            LakeCountrySpanish.Web.Models.Entities.PointSource.ClassCompletion => "📚",
                            LakeCountrySpanish.Web.Models.Entities.PointSource.Exercise => "✅",
                            LakeCountrySpanish.Web.Models.Entities.PointSource.BadgeEarned => "🏆",
                            LakeCountrySpanish.Web.Models.Entities.PointSource.StreakBonus => "🔥",
                            LakeCountrySpanish.Web.Models.Entities.PointSource.AdminGrant => "⚙️",
                            LakeCountrySpanish.Web.Models.Entities.PointSource.PerfectScore => "💯",
                            LakeCountrySpanish.Web.Models.Entities.PointSource.FirstAttemptBonus => "🎯",
                            LakeCountrySpanish.Web.Models.Entities.PointSource.Adjustment => "🔧",
                            _ => "⭐"
                        };
                        <div class="px-6 py-4 flex items-center hover:bg-gray-50 transition">
                            <div class="text-2xl mr-4">@iconEmoji</div>
                            <div class="flex-1">
                                <p class="font-medium text-gray-900">@point.SourceDisplayName</p>
                                <p class="text-sm text-gray-500">
                                    @(point.Details ?? point.BadgeName ?? "-")
                                    @if (point.HasMultiplier)
                                    {
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-cyan-100 text-cyan-700 ml-1">
                                            @point.Multiplier.ToString("0.0")x
                                        </span>
                                    }
                                </p>
                                <p class="text-xs text-gray-400">@point.CreatedAt.ToString("MMM d 'at' h:mm tt")</p>
                            </div>
                            <div class="text-right">
                                <p class="text-lg font-bold @(point.FinalPoints >= 0 ? "text-green-600" : "text-red-600")">
                                    @point.PointsDisplay
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>

<style>
    @@keyframes shimmer {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
    }
</style>
