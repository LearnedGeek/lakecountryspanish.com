@model LakeCountrySpanish.Web.Models.ViewModels.StudentDocumentsViewModel
@{
    ViewData["Title"] = "My Documents";
}

<div class="bg-gradient-to-b from-cyan-50 via-white to-white min-h-screen">
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">

        <!-- Hero Header -->
        <div class="relative bg-gradient-to-r from-cyan-500 via-blue-500 to-indigo-500 rounded-2xl shadow-xl mb-8 overflow-hidden">
            <div class="absolute inset-0 opacity-10">
                <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                    <pattern id="docs-pattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
                        <circle cx="20" cy="20" r="2" fill="white"/>
                    </pattern>
                    <rect fill="url(#docs-pattern)" width="100%" height="100%"/>
                </svg>
            </div>
            <div class="relative p-6 lg:p-8">
                <div class="flex items-center justify-between">
                    <div>
                        <a asp-action="Dashboard" class="inline-flex items-center text-cyan-100 hover:text-white mb-2 transition">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                            </svg>
                            Dashboard
                        </a>
                        <h1 class="text-3xl font-bold text-white mb-2">My Documents</h1>
                        <p class="text-cyan-100">Learning materials and resources from Karen</p>
                    </div>
                    <div class="hidden md:block text-8xl">📁</div>
                </div>
            </div>
        </div>

        <!-- Documents List -->
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
            @if (Model.Documents.Any())
            {
                <div class="divide-y divide-gray-100">
                    @foreach (var doc in Model.Documents)
                    {
                        var fileIcon = doc.FileName.ToLower() switch
                        {
                            var x when x.EndsWith(".pdf") => "📕",
                            var x when x.EndsWith(".doc") || x.EndsWith(".docx") => "📘",
                            var x when x.EndsWith(".xls") || x.EndsWith(".xlsx") => "📗",
                            var x when x.EndsWith(".ppt") || x.EndsWith(".pptx") => "📙",
                            var x when x.EndsWith(".mp3") || x.EndsWith(".wav") => "🎵",
                            var x when x.EndsWith(".mp4") || x.EndsWith(".mov") => "🎬",
                            var x when x.EndsWith(".jpg") || x.EndsWith(".png") || x.EndsWith(".gif") => "🖼️",
                            var x when x.EndsWith(".zip") || x.EndsWith(".rar") => "📦",
                            _ => "📄"
                        };
                        <a asp-action="DownloadDocument" asp-route-id="@doc.Id"
                           class="flex items-center p-5 hover:bg-gradient-to-r hover:from-cyan-50 hover:to-blue-50 transition group">
                            <div class="flex-shrink-0 text-4xl mr-4 transform group-hover:scale-110 transition">
                                @fileIcon
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-lg font-semibold text-gray-900 group-hover:text-cyan-600 transition truncate">@doc.Title</p>
                                <p class="text-sm text-gray-500 truncate">@doc.FileName</p>
                                <p class="text-xs text-gray-400 mt-1 flex items-center">
                                    <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                    @doc.UploadedAt.ToString("MMMM d, yyyy")
                                </p>
                            </div>
                            <div class="flex-shrink-0 ml-4">
                                <div class="bg-cyan-100 group-hover:bg-cyan-200 rounded-full p-3 transition">
                                    <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                                    </svg>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="p-12 text-center">
                    <div class="text-6xl mb-4">📚</div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">No documents yet</h3>
                    <p class="text-gray-500 max-w-sm mx-auto">
                        Karen will share learning materials and resources with you here. Check back after your next class!
                    </p>
                    <a asp-action="Dashboard" class="inline-flex items-center mt-6 text-cyan-600 hover:text-cyan-700 font-medium">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                        </svg>
                        Back to Dashboard
                    </a>
                </div>
            }
        </div>

        <!-- Info Box -->
        @if (Model.Documents.Any())
        {
            <div class="mt-6 bg-gradient-to-r from-cyan-50 to-blue-50 rounded-xl p-5 border border-cyan-100">
                <div class="flex items-start">
                    <span class="text-2xl mr-3">💡</span>
                    <div>
                        <h4 class="font-semibold text-cyan-900">Tip</h4>
                        <p class="text-sm text-cyan-800 mt-1">
                            Click on any document to download it. These materials are personalized for your learning journey!
                        </p>
                    </div>
                </div>
            </div>
        }

    </div>
</div>
