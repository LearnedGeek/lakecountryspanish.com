@model LakeCountrySpanish.Web.Models.ViewModels.StudentDocumentsViewModel
@{
    ViewData["Title"] = "My Documents";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
        @await Component.InvokeAsync("PageHeader", new {
            title = "My Documents",
            subtitle = "Learning materials and resources from Karen.",
            backUrl = Url.Action("Dashboard"),
            backText = "Back to Dashboard"
        })

        <div class="bg-white rounded-lg shadow">
            @if (Model.Documents.Any())
            {
                <div class="divide-y divide-gray-200">
                    @foreach (var doc in Model.Documents)
                    {
                        <a asp-action="DownloadDocument" asp-route-id="@doc.Id"
                           class="flex items-center p-6 hover:bg-gray-50 transition">
                            <div class="flex-shrink-0">
                                <svg class="h-10 w-10 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                                </svg>
                            </div>
                            <div class="ml-4 flex-1">
                                <p class="text-lg font-medium text-gray-900">@doc.Title</p>
                                <p class="text-sm text-gray-500">@doc.FileName</p>
                                <p class="text-xs text-gray-400 mt-1">Uploaded @doc.UploadedAt.ToString("MMMM d, yyyy")</p>
                            </div>
                            <div class="flex-shrink-0">
                                <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                                </svg>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                @await Component.InvokeAsync("EmptyState", new {
                    icon = "document",
                    title = "No documents available yet",
                    message = "Karen will share learning materials with you here."
                })
            }
        </div>
    </div>
</div>
