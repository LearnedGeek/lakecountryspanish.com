@model LakeCountrySpanish.Web.Models.ViewModels.TokenStoreViewModel
@{
    ViewData["Title"] = "Token Store";
}

<div class="bg-gradient-to-b from-yellow-50 via-white to-white min-h-screen">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-8">

        <!-- Hero Header -->
        <div class="relative bg-gradient-to-r from-yellow-400 via-orange-500 to-pink-500 rounded-2xl shadow-xl mb-8 overflow-hidden">
            <div class="absolute inset-0 opacity-10">
                <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                    <pattern id="store-pattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
                        <circle cx="20" cy="20" r="2" fill="white"/>
                    </pattern>
                    <rect fill="url(#store-pattern)" width="100%" height="100%"/>
                </svg>
            </div>
            <div class="relative p-6 lg:p-8">
                <div class="flex items-center justify-between">
                    <div>
                        <a asp-action="Dashboard" class="inline-flex items-center text-yellow-100 hover:text-white mb-2 transition">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                            </svg>
                            Dashboard
                        </a>
                        <h1 class="text-3xl font-bold text-white mb-2">Token Store</h1>
                        <p class="text-yellow-100">Exchange your earned tokens for free class rewards!</p>
                    </div>
                    <div class="hidden md:block text-8xl animate-bounce-slow">🏪</div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="bg-green-50 border border-green-200 rounded-xl p-4 mb-6 flex items-center animate-pop-in">
                <span class="text-2xl mr-3">🎉</span>
                <p class="text-green-800 font-medium">@Model.SuccessMessage</p>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-6 flex items-center">
                <span class="text-2xl mr-3">⚠️</span>
                <p class="text-red-800 font-medium">@Model.ErrorMessage</p>
            </div>
        }

        <!-- Balance Cards - Enhanced -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <!-- Free Class Rewards -->
            <div class="bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl shadow-lg p-6 text-white transform hover:scale-102 transition relative overflow-hidden">
                <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/2"></div>
                <div class="relative">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-green-100 text-sm font-medium uppercase tracking-wide">Free Class Rewards</p>
                            <p class="text-5xl font-bold mt-2">@Model.AvailableTickets</p>
                            @if (Model.AvailableTickets > 0)
                            {
                                <p class="text-green-100 text-sm mt-2">You've earned @Model.AvailableTickets free class@(Model.AvailableTickets > 1 ? "es" : "")!</p>
                            }
                            else
                            {
                                <p class="text-green-100 text-sm mt-2">Exchange tokens to earn rewards</p>
                            }
                        </div>
                        <div class="text-6xl">🎁</div>
                    </div>
                    @if (Model.AvailableTickets > 0)
                    {
                        <a asp-action="MyClasses" class="mt-4 inline-flex items-center bg-white text-green-600 font-semibold px-4 py-2 rounded-lg hover:bg-green-50 transition">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            Apply to My Classes
                        </a>
                    }
                </div>
            </div>

            <!-- Tokens -->
            <div class="bg-gradient-to-br from-yellow-400 to-orange-500 rounded-2xl shadow-lg p-6 text-white transform hover:scale-102 transition relative overflow-hidden">
                <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/2"></div>
                <div class="relative">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-yellow-100 text-sm font-medium uppercase tracking-wide">Your Tokens</p>
                            <p class="text-5xl font-bold mt-2">@Model.TotalTokens</p>
                            <p class="text-yellow-100 text-sm mt-2">Earned from activities</p>
                        </div>
                        <div class="text-6xl">🪙</div>
                    </div>
                    <!-- Points Progress -->
                    <div class="mt-4 pt-4 border-t border-white/30">
                        <div class="flex justify-between text-sm mb-2">
                            <span class="text-yellow-100">Points to next token</span>
                            <span class="font-medium">@Model.PointProgressPercent / 100</span>
                        </div>
                        <div class="w-full bg-white/30 rounded-full h-3 overflow-hidden">
                            <div class="bg-white h-3 rounded-full transition-all relative" style="width: @Model.PointProgressPercent%">
                                <div class="absolute inset-0 bg-gradient-to-r from-transparent via-yellow-200 to-transparent opacity-50" style="animation: shimmer 2s ease-in-out infinite;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Store Item -->
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden mb-8 border-2 border-dashed border-indigo-200">
            <div class="px-6 py-4 bg-gradient-to-r from-indigo-50 to-purple-50 border-b border-gray-200">
                <div class="flex items-center">
                    <span class="text-2xl mr-2">🛒</span>
                    <h2 class="text-lg font-semibold text-gray-900">Token Exchange</h2>
                </div>
            </div>
            <div class="p-6">
                <!-- Free Class Reward Item -->
                <div class="relative bg-gradient-to-r from-green-50 to-emerald-50 rounded-xl p-6 border-2 @(Model.CanAffordTicket ? "border-green-300" : "border-gray-200")">
                    @if (Model.CanAffordTicket)
                    {
                        <div class="absolute -top-3 -right-3 bg-green-500 text-white text-xs font-bold px-3 py-1 rounded-full animate-pulse">
                            Available!
                        </div>
                    }
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="flex-shrink-0 h-20 w-20 bg-green-100 rounded-xl flex items-center justify-center">
                                <span class="text-4xl">🎁</span>
                            </div>
                            <div class="ml-5">
                                <h3 class="text-xl font-bold text-gray-900">Free Class Reward</h3>
                                <p class="text-gray-600">Earn a free class or discount on your next invoice</p>
                                <div class="flex items-center mt-2">
                                    <span class="text-3xl mr-2">🪙</span>
                                    <span class="text-2xl font-bold text-yellow-600">@Model.TicketTokenCost</span>
                                    <span class="text-gray-500 ml-1">tokens</span>
                                </div>
                            </div>
                        </div>
                        <div class="text-right">
                            @if (Model.CanAffordTicket)
                            {
                                <form asp-action="BuyTicketWithTokens" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 text-white font-bold py-3 px-6 rounded-xl shadow-lg transform hover:scale-105 transition">
                                        <span class="flex items-center">
                                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                                            </svg>
                                            Claim Reward
                                        </span>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <div class="bg-gray-100 rounded-xl p-4">
                                    <p class="text-gray-600 text-sm mb-1">Need <span class="font-bold text-yellow-600">@(Model.TicketTokenCost - Model.TotalTokens)</span> more tokens</p>
                                    <a asp-action="Progress" class="text-indigo-600 hover:underline text-sm font-medium">Earn more →</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ticket Breakdown -->
        @if (Model.TicketsBySource.Any())
        {
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden mb-8">
                <div class="px-6 py-4 border-b border-gray-200 flex items-center">
                    <span class="text-xl mr-2">📊</span>
                    <h2 class="text-lg font-semibold text-gray-900">Your Ticket Sources</h2>
                </div>
                <div class="p-6">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        @foreach (var source in Model.TicketsBySource)
                        {
                            var (bgColor, emoji, label) = source.Key switch
                            {
                                LakeCountrySpanish.Web.Models.Entities.TicketSource.TokenExchange => ("from-yellow-100 to-orange-100 text-yellow-800", "🪙", "From Tokens"),
                                LakeCountrySpanish.Web.Models.Entities.TicketSource.Purchased => ("from-blue-100 to-cyan-100 text-blue-800", "💳", "Purchased"),
                                LakeCountrySpanish.Web.Models.Entities.TicketSource.AdminGrant => ("from-purple-100 to-pink-100 text-purple-800", "🎁", "Gifted"),
                                LakeCountrySpanish.Web.Models.Entities.TicketSource.Subscription => ("from-green-100 to-emerald-100 text-green-800", "⭐", "Subscription"),
                                LakeCountrySpanish.Web.Models.Entities.TicketSource.LegacyMigration => ("from-gray-100 to-gray-200 text-gray-800", "📦", "Legacy"),
                                _ => ("from-gray-100 to-gray-200 text-gray-800", "🎫", source.Key.ToString())
                            };
                            <div class="bg-gradient-to-br @bgColor rounded-xl p-4 text-center transform hover:scale-105 transition">
                                <div class="text-3xl mb-2">@emoji</div>
                                <p class="text-3xl font-bold">@source.Value</p>
                                <p class="text-sm">@label</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Recent Activity -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
            <!-- Recent Token Transactions -->
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-200 bg-yellow-50 flex items-center">
                    <span class="text-xl mr-2">🪙</span>
                    <h2 class="text-lg font-semibold text-gray-900">Token Activity</h2>
                </div>
                <div class="divide-y divide-gray-100">
                    @if (Model.RecentTokenTransactions.Any())
                    {
                        @foreach (var txn in Model.RecentTokenTransactions.Take(5))
                        {
                            var isPositive = txn.Quantity > 0;
                            <div class="px-6 py-4 flex items-center hover:bg-gray-50 transition">
                                <div class="text-2xl mr-3">@(isPositive ? "📥" : "📤")</div>
                                <div class="flex-1">
                                    <p class="font-medium text-gray-900">@txn.Details</p>
                                    <p class="text-xs text-gray-500">@txn.CreatedAt.ToString("MMM d 'at' h:mm tt")</p>
                                </div>
                                <span class="text-lg font-bold @(isPositive ? "text-green-600" : "text-red-600")">
                                    @(isPositive ? "+" : "")@txn.Quantity
                                </span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="px-6 py-8 text-center">
                            <div class="text-4xl mb-2">🌱</div>
                            <p class="text-gray-600">No token activity yet</p>
                            <p class="text-sm text-gray-500">Complete activities to earn tokens!</p>
                        </div>
                    }
                </div>
                <div class="px-6 py-3 bg-gray-50 border-t border-gray-100">
                    <a asp-action="Progress" class="text-sm text-indigo-600 hover:text-indigo-800 font-medium">
                        View all activity →
                    </a>
                </div>
            </div>

            <!-- Recent Tickets -->
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-200 bg-green-50 flex items-center">
                    <span class="text-xl mr-2">🎫</span>
                    <h2 class="text-lg font-semibold text-gray-900">Recent Tickets</h2>
                </div>
                <div class="divide-y divide-gray-100">
                    @if (Model.RecentTickets.Any())
                    {
                        @foreach (var ticket in Model.RecentTickets.Take(5))
                        {
                            var (statusEmoji, statusClass) = ticket.IsUsed
                                ? ("✓", "text-gray-400")
                                : ticket.IsAvailable
                                    ? ("✨", "text-green-600")
                                    : ("⏰", "text-red-500");
                            var statusText = ticket.IsUsed ? "Used" : (ticket.IsAvailable ? "Available" : "Expired");
                            var sourceLabel = ticket.Source switch
                            {
                                LakeCountrySpanish.Web.Models.Entities.TicketSource.TokenExchange => "Token Exchange",
                                LakeCountrySpanish.Web.Models.Entities.TicketSource.Purchased => "Purchased",
                                LakeCountrySpanish.Web.Models.Entities.TicketSource.AdminGrant => "Gifted",
                                LakeCountrySpanish.Web.Models.Entities.TicketSource.Subscription => "Subscription",
                                LakeCountrySpanish.Web.Models.Entities.TicketSource.LegacyMigration => "Legacy",
                                _ => ticket.Source.ToString()
                            };
                            <div class="px-6 py-4 flex items-center hover:bg-gray-50 transition">
                                <div class="text-2xl mr-3">@statusEmoji</div>
                                <div class="flex-1">
                                    <p class="font-medium text-gray-900">@sourceLabel</p>
                                    <p class="text-xs text-gray-500">@ticket.AcquiredAt.ToString("MMM d, yyyy")</p>
                                </div>
                                <span class="text-sm font-medium @statusClass">@statusText</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="px-6 py-8 text-center">
                            <div class="text-4xl mb-2">🎯</div>
                            <p class="text-gray-600">No tickets yet</p>
                            <p class="text-sm text-gray-500">Earn tokens to get class tickets!</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- How It Works - Fun Infographic Style -->
        <div class="bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 rounded-2xl p-8 text-white">
            <h3 class="text-2xl font-bold mb-6 text-center">Earn Free Classes!</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-white/20 backdrop-blur rounded-xl p-6 text-center transform hover:scale-105 transition">
                    <div class="text-5xl mb-3">📚</div>
                    <div class="bg-white text-indigo-600 rounded-full w-8 h-8 flex items-center justify-center font-bold mx-auto mb-3">1</div>
                    <h4 class="font-bold text-lg mb-2">Earn Tokens</h4>
                    <p class="text-white/90 text-sm">Complete classes and assignments. Every 100 points = 1 token!</p>
                </div>
                <div class="bg-white/20 backdrop-blur rounded-xl p-6 text-center transform hover:scale-105 transition">
                    <div class="text-5xl mb-3">🪙</div>
                    <div class="bg-white text-purple-600 rounded-full w-8 h-8 flex items-center justify-center font-bold mx-auto mb-3">2</div>
                    <h4 class="font-bold text-lg mb-2">Exchange for Rewards</h4>
                    <p class="text-white/90 text-sm">Collect @Model.TicketTokenCost tokens to earn a free class reward!</p>
                </div>
                <div class="bg-white/20 backdrop-blur rounded-xl p-6 text-center transform hover:scale-105 transition">
                    <div class="text-5xl mb-3">🎁</div>
                    <div class="bg-white text-pink-600 rounded-full w-8 h-8 flex items-center justify-center font-bold mx-auto mb-3">3</div>
                    <h4 class="font-bold text-lg mb-2">Get Free Classes</h4>
                    <p class="text-white/90 text-sm">Apply rewards to get discounts or schedule extra free classes!</p>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    @@keyframes shimmer {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
    }
    .animate-bounce-slow {
        animation: bounce 2s infinite;
    }
    .animate-pop-in {
        animation: pop-in 0.3s ease-out;
    }
    @@keyframes pop-in {
        0% { transform: scale(0.9); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }
    .hover\:scale-102:hover {
        transform: scale(1.02);
    }
</style>
