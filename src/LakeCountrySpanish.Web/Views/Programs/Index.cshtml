@using LakeCountrySpanish.Web.Models.Entities
@model LakeCountrySpanish.Web.Models.ViewModels.ProgramsCalendarViewModel
@{
    ViewData["Title"] = "Programs";
    ViewData["MetaDescription"] = "Lake Country Spanish — after-school Spanish programs, camps, and open houses in the Lake Country area of Wisconsin.";
}

@functions {
    // Compact "5 days left" / "Enroll by Aug 15" copy.
    string DeadlineLabel(EnrollmentProgram p)
    {
        var days = (int)Math.Ceiling((p.EffectiveEnrollmentDeadline - DateTime.UtcNow).TotalDays);
        if (days <= 0) return "Enrollment closed";
        if (days == 1) return "1 day left";
        if (days <= 14) return $"{days} days left";
        return $"Enroll by {p.EffectiveEnrollmentDeadline:MMM d}";
    }

    string DeadlinePillClass(EnrollmentProgram p)
    {
        var days = (int)Math.Ceiling((p.EffectiveEnrollmentDeadline - DateTime.UtcNow).TotalDays);
        if (days <= 0) return "bg-gray-200 text-gray-700 border-gray-300";
        if (days <= 3) return "bg-red-100 text-red-800 border-red-200";
        if (days <= 7) return "bg-amber-100 text-amber-900 border-amber-300";
        return "bg-emerald-100 text-emerald-800 border-emerald-200";
    }

    string ComingSoonLabel(EnrollmentProgram p)
    {
        if (!p.EnrollmentStartsAt.HasValue) return string.Empty;
        var days = (int)Math.Ceiling((p.EnrollmentStartsAt.Value - DateTime.UtcNow).TotalDays);
        if (days <= 0) return "Enrollment opens today";
        if (days == 1) return "Opens tomorrow";
        if (days <= 14) return $"Opens in {days} days";
        return $"Opens {p.EnrollmentStartsAt.Value:MMM d}";
    }
}

<div class="bg-gray-100 min-h-screen">
    <!-- Hero -->
    <div class="bg-gradient-to-r from-primary-600 to-teal-600 py-16">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
            <h1 class="font-display text-4xl sm:text-5xl font-bold text-white drop-shadow">Our Programs</h1>
            <p class="mt-4 text-xl text-white/95 max-w-2xl mx-auto">
                Real Spanish, real culture, real fun. Browse upcoming programs and enroll online in minutes.
            </p>
        </div>
    </div>

    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">

        @if (!Model.HasAny)
        {
            <div class="bg-white rounded-2xl shadow-md border-2 border-dashed border-gray-300 p-12 text-center max-w-2xl mx-auto">
                <div class="text-5xl mb-3">📅</div>
                <p class="text-lg font-bold text-gray-800">No programs listed yet</p>
                <p class="text-sm text-gray-600 mt-2">
                    Interested in bringing a program to your school or community?
                    <a href="@Url.Action("Index", "Contact")" class="text-indigo-600 hover:text-indigo-800 font-semibold">Reach out</a>.
                </p>
            </div>
        }

        <!-- Enrolling now — grouped by program name.
             Aggregate stats banner up top provides the marketing "wow"
             signal ("N sessions across M schools"). Then each program
             card lists its locations/sessions inline so parents can pick
             the specific school + day that fits their kid without wading
             through 5 near-identical hero tiles. -->
        @if (Model.EnrollmentOpenGroups.Count > 0)
        {
            <section class="mb-12">
                <div class="flex items-baseline justify-between mb-4">
                    <h2 class="font-display text-2xl font-bold text-gray-900 flex items-center gap-3">
                        <span class="h-3 w-3 rounded-full bg-emerald-500 animate-pulse"></span>
                        Enrolling now
                    </h2>
                </div>

                @{
                    var stats = Model.OpenStats;
                }
                @if (stats.HasContent)
                {
                    <div class="mb-6 bg-white/70 backdrop-blur-sm rounded-xl border border-emerald-200 shadow-sm px-5 py-4">
                        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm sm:text-base">
                            <div class="flex items-baseline gap-1.5">
                                <span class="text-2xl font-black text-emerald-700">@stats.SessionCount</span>
                                <span class="text-gray-700">session@(stats.SessionCount == 1 ? "" : "s")</span>
                            </div>
                            <span class="text-gray-300" aria-hidden="true">·</span>
                            <div class="flex items-baseline gap-1.5">
                                <span class="text-2xl font-black text-primary-700">@stats.DistinctLocationCount</span>
                                <span class="text-gray-700">school@(stats.DistinctLocationCount == 1 ? "" : "s")</span>
                            </div>
                            @if (stats.DistinctProgramCount > 1)
                            {
                                <span class="text-gray-300" aria-hidden="true">·</span>
                                <div class="flex items-baseline gap-1.5">
                                    <span class="text-2xl font-black text-secondary-600">@stats.DistinctProgramCount</span>
                                    <span class="text-gray-700">distinct program@(stats.DistinctProgramCount == 1 ? "" : "s")</span>
                                </div>
                            }
                            @if (stats.SoonestStart.HasValue && stats.LatestEnd.HasValue)
                            {
                                <span class="text-gray-300" aria-hidden="true">·</span>
                                <div class="text-gray-700">
                                    <span class="font-semibold text-gray-900">Starting @stats.SoonestStart.Value.ToString("MMM d")</span>
                                    <span class="text-gray-500">through @stats.LatestEnd.Value.ToString("MMM d, yyyy")</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    @foreach (var group in Model.EnrollmentOpenGroups)
                    {
                        var rep = group.Representative;
                        var groupImage = rep.EventImagePath ?? rep.HeroImagePath;
                        var groupHasGrades = !string.IsNullOrEmpty(rep.GradeRange);
                        var groupHasAges = rep.AgeMin > 0;

                        <div class="flex flex-col bg-white rounded-2xl shadow-md border border-gray-200 overflow-hidden transition-all">
                            <!-- Header: image + program name + shared attributes -->
                            <div class="grid grid-cols-1 sm:grid-cols-5 gap-0">
                                <div class="sm:col-span-2 bg-white flex items-center justify-center p-3 sm:p-4 sm:min-h-[220px]">
                                    @if (!string.IsNullOrEmpty(groupImage))
                                    {
                                        <img src="@groupImage" alt="@rep.Name" class="max-w-full max-h-full object-contain" loading="lazy" />
                                    }
                                </div>
                                <div class="sm:col-span-3 p-5 sm:p-6 border-t sm:border-t-0 sm:border-l border-gray-100 flex flex-col">
                                    <h3 class="font-display text-xl sm:text-2xl font-bold text-gray-900 mb-1">@rep.Name</h3>
                                    @if (!string.IsNullOrEmpty(rep.TagLine))
                                    {
                                        <p class="text-sm text-gray-600 mb-3">@rep.TagLine</p>
                                    }
                                    <dl class="text-sm text-gray-700 space-y-1.5">
                                        @if (groupHasGrades || groupHasAges)
                                        {
                                            <div class="flex items-center gap-2">
                                                <span class="text-gray-400">🎒</span>
                                                <span>@(groupHasGrades ? $"Grades {rep.GradeRange}" : "")@(groupHasGrades && groupHasAges ? " · " : "")@(groupHasAges ? $"ages {rep.AgeMin}–{rep.AgeMax}" : "")</span>
                                            </div>
                                        }
                                        <div class="flex items-center gap-2">
                                            <span class="text-gray-400">💵</span>
                                            <span class="font-semibold text-gray-900">@group.PriceLabel</span>
                                            @if (rep.InstallmentsEnabled)
                                            {
                                                <span class="text-xs text-gray-500">· installments available</span>
                                            }
                                        </div>
                                        <div class="flex items-center gap-2 text-emerald-800 font-semibold">
                                            <span aria-hidden="true">✓</span>
                                            <span>@group.Sessions.Count session@(group.Sessions.Count == 1 ? "" : "s") enrolling now</span>
                                        </div>
                                    </dl>
                                </div>
                            </div>

                            <!-- Session roster: sub-grouped by school so each school gets its
                                 own poster thumbnail (Karen's per-school posters are the color
                                 that got lost when we deduped to a single card). Sessions at
                                 the same school stack under that school's subheader. -->
                            <div class="border-t-2 border-dashed border-gray-200 bg-gray-50/60">
                                <p class="px-5 sm:px-6 pt-4 pb-1 text-xs font-bold tracking-[0.15em] uppercase text-gray-500">Choose your school &amp; time</p>
                                @foreach (var schoolGroup in group.Sessions.GroupBy(s => s.LocationName, StringComparer.OrdinalIgnoreCase))
                                {
                                    var schoolSessions = schoolGroup.ToList();
                                    var schoolRep = schoolSessions.First();
                                    var schoolImage = schoolRep.EventImagePath ?? schoolRep.HeroImagePath;
                                    <div class="border-t border-gray-200/60">
                                        <div class="flex items-center gap-3 sm:gap-4 px-5 sm:px-6 py-3 bg-white/60">
                                            @if (!string.IsNullOrEmpty(schoolImage))
                                            {
                                                <img src="@schoolImage" alt="" aria-hidden="true"
                                                     class="flex-shrink-0 h-14 w-14 sm:h-16 sm:w-16 rounded-lg object-contain bg-white border border-gray-200 shadow-sm p-1" />
                                            }
                                            <div class="flex-1 min-w-0">
                                                <div class="text-base sm:text-lg font-bold text-primary-800 flex items-center gap-1.5">
                                                    <span aria-hidden="true">📍</span>
                                                    <span>@schoolRep.LocationName</span>
                                                </div>
                                                <div class="text-xs text-gray-500 mt-0.5">
                                                    @schoolSessions.Count session@(schoolSessions.Count == 1 ? "" : "s") · @schoolRep.LocationAddress
                                                </div>
                                            </div>
                                        </div>
                                        <ul class="divide-y divide-gray-200 px-5 sm:px-6 pb-2">
                                            @foreach (var s in schoolSessions)
                                            {
                                                // Ages preferred over grades (Karen has adult programs;
                                                // grades imply school-age kids only). Nothing shown when
                                                // neither is set.
                                                string? qualifier = null;
                                                if (s.AgeMin > 0)
                                                {
                                                    qualifier = $"ages {s.AgeMin}–{s.AgeMax}";
                                                }
                                                else if (!string.IsNullOrEmpty(s.GradeRange))
                                                {
                                                    qualifier = $"Grades {s.GradeRange}";
                                                }
                                                <li>
                                                    <a href="@Url.Action("Detail", "Programs", new { slug = s.Slug })"
                                                       class="block py-3 hover:bg-white/80 rounded-lg -mx-2 px-2 transition-colors group">
                                                        <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-4 items-center">
                                                            <div class="min-w-0 text-xs sm:text-sm text-gray-700">
                                                                <span class="font-semibold text-gray-900">@s.MeetingDays</span>
                                                                @s.StartTime.ToString("h:mm tt")–@s.EndTime.ToString("h:mm tt")
                                                                <span class="text-gray-400">·</span>
                                                                @s.StartDate.ToString("MMM d") – @s.EndDate.ToString("MMM d, yyyy")
                                                                @if (qualifier is not null)
                                                                {
                                                                    <span class="text-gray-400">·</span>
                                                                    <span class="font-medium">@qualifier</span>
                                                                }
                                                            </div>
                                                            <div class="flex items-center gap-2 flex-shrink-0">
                                                                <span class="text-sm font-bold text-gray-900">$@s.FullPrice.ToString("N0")</span>
                                                                <span class="inline-flex items-center gap-1 px-2 py-1 rounded-md text-xs font-bold border @DeadlinePillClass(s)">
                                                                    @DeadlineLabel(s)
                                                                </span>
                                                                <span class="text-sm font-bold text-secondary-600 group-hover:text-secondary-700 hidden sm:inline">Details →</span>
                                                            </div>
                                                        </div>
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        <!-- Coming soon — enrollment hasn't opened yet -->
        @if (Model.ComingSoon.Count > 0)
        {
            <section class="mb-12">
                <div class="flex items-baseline justify-between mb-6">
                    <h2 class="font-display text-2xl font-bold text-gray-900 flex items-center gap-3">
                        <span class="h-3 w-3 rounded-full bg-amber-400"></span>
                        Coming soon
                    </h2>
                    <span class="text-sm text-gray-500 font-medium">@Model.ComingSoon.Count program@(Model.ComingSoon.Count == 1 ? "" : "s")</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    @foreach (var p in Model.ComingSoon)
                    {
                        <a href="@Url.Action("Detail", "Programs", new { slug = p.Slug })"
                           class="group flex flex-col bg-white rounded-2xl shadow-md hover:shadow-lg border border-gray-200 hover:border-amber-400 overflow-hidden transition-all duration-200 ease-out hover:-translate-y-1">
                            <div class="aspect-[16/10] relative bg-gradient-to-br from-amber-300 to-amber-500 overflow-hidden">
                                @{
                                    var soonImage = p.EventImagePath ?? p.HeroImagePath;
                                }
                                @if (!string.IsNullOrEmpty(soonImage))
                                {
                                    <img src="@soonImage" alt="@p.Name" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                                }
                                <div class="absolute top-3 left-3 inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold border shadow-sm bg-amber-100 text-amber-900 border-amber-300">
                                    🗓 @ComingSoonLabel(p)
                                </div>
                            </div>
                            <div class="flex-1 flex flex-col p-5">
                                <div class="mb-3 inline-flex self-start items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-50 text-amber-900 border-2 border-amber-200 text-sm font-bold group-hover:bg-amber-100 group-hover:border-amber-400 transition-colors">
                                    <span aria-hidden="true">📍</span>
                                    <span>@p.LocationName</span>
                                </div>
                                <h3 class="font-display text-xl font-bold text-gray-900 mb-1">@p.Name</h3>
                                @if (!string.IsNullOrEmpty(p.TagLine))
                                {
                                    <p class="text-sm text-gray-600 mb-3">@p.TagLine</p>
                                }
                                <dl class="text-sm text-gray-700 space-y-1.5 mb-4">
                                    <div class="flex items-center gap-2">
                                        <span class="text-gray-400">📅</span>
                                        <span>@p.StartDate.ToString("MMM d") – @p.EndDate.ToString("MMM d, yyyy")</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-gray-400">🕐</span>
                                        <span>@p.MeetingDays · @p.StartTime.ToString("h:mm tt")–@p.EndTime.ToString("h:mm tt")</span>
                                    </div>
                                </dl>
                                <div class="mt-auto pt-4 border-t border-gray-100">
                                    <p class="text-xs text-gray-500">
                                        <span class="font-semibold text-amber-800">Come back @p.EnrollmentStartsAt!.Value.ToString("MMM d")</span> to sign up, or view details now.
                                    </p>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </section>
        }

        <!-- Closed enrollment but program still upcoming -->
        @if (Model.ClosedButUpcoming.Count > 0)
        {
            <section class="mb-12">
                <div class="flex items-baseline justify-between mb-6">
                    <h2 class="font-display text-2xl font-bold text-gray-800 flex items-center gap-3">
                        <span class="h-3 w-3 rounded-full bg-gray-400"></span>
                        Enrollment closed — in session
                    </h2>
                    <span class="text-sm text-gray-500 font-medium">@Model.ClosedButUpcoming.Count program@(Model.ClosedButUpcoming.Count == 1 ? "" : "s")</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    @foreach (var p in Model.ClosedButUpcoming)
                    {
                        <a href="@Url.Action("Detail", "Programs", new { slug = p.Slug })"
                           class="flex flex-col bg-white rounded-2xl shadow-sm border border-gray-200 hover:border-gray-400 hover:shadow-md overflow-hidden opacity-80 hover:opacity-100 transition-all duration-200 ease-out hover:-translate-y-1">
                            <div class="aspect-[16/10] relative bg-gradient-to-br from-gray-400 to-gray-500 overflow-hidden">
                                @{
                                    var closedCardImage = p.EventImagePath ?? p.HeroImagePath;
                                }
                                @if (!string.IsNullOrEmpty(closedCardImage))
                                {
                                    <img src="@closedCardImage" alt="@p.Name" class="absolute inset-0 w-full h-full object-cover grayscale" loading="lazy" />
                                }
                                <div class="absolute top-3 left-3 inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold border bg-gray-200 text-gray-700 border-gray-300 shadow-sm">
                                    Enrollment closed
                                </div>
                            </div>
                            <div class="flex-1 flex flex-col p-5">
                                <div class="mb-3 inline-flex self-start items-center gap-1.5 px-3 py-1.5 rounded-lg bg-gray-100 text-gray-700 border-2 border-gray-200 text-sm font-bold">
                                    <span aria-hidden="true">📍</span>
                                    <span>@p.LocationName</span>
                                </div>
                                <h3 class="font-display text-lg font-bold text-gray-800 mb-1">@p.Name</h3>
                                <p class="text-sm text-gray-600">@p.StartDate.ToString("MMM d") – @p.EndDate.ToString("MMM d, yyyy")</p>
                                <p class="text-xs text-gray-500 mt-3">Interested in the next session? Contact us from the details page.</p>
                            </div>
                        </a>
                    }
                </div>
            </section>
        }

        <!-- Past programs -->
        @if (Model.Past.Count > 0)
        {
            <section>
                <div class="flex items-baseline justify-between mb-6">
                    <h2 class="font-display text-2xl font-bold text-gray-700 flex items-center gap-3">
                        <span class="h-3 w-3 rounded-full bg-gray-300"></span>
                        Recent programs
                    </h2>
                    <span class="text-sm text-gray-500 font-medium">@Model.Past.Count program@(Model.Past.Count == 1 ? "" : "s")</span>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                    @foreach (var p in Model.Past.Take(8))
                    {
                        <a href="@Url.Action("Detail", "Programs", new { slug = p.Slug })"
                           class="bg-white rounded-xl shadow-sm border border-gray-200 hover:border-gray-400 hover:shadow-md overflow-hidden opacity-70 hover:opacity-100 transition-all duration-200 ease-out hover:-translate-y-1">
                            <div class="aspect-[4/3] relative bg-gray-200 overflow-hidden">
                                @{
                                    var pastCardImage = p.EventImagePath ?? p.HeroImagePath;
                                }
                                @if (!string.IsNullOrEmpty(pastCardImage))
                                {
                                    <img src="@pastCardImage" alt="@p.Name" class="absolute inset-0 w-full h-full object-cover grayscale" loading="lazy" />
                                }
                            </div>
                            <div class="p-3">
                                <h3 class="text-sm font-bold text-gray-800 truncate">@p.Name</h3>
                                <p class="text-xs text-gray-500 mt-0.5">@p.LocationName</p>
                                <p class="text-xs text-gray-500">@p.StartDate.ToString("MMM yyyy")</p>
                            </div>
                        </a>
                    }
                </div>
                <p class="text-center mt-6 text-sm text-gray-500">
                    Want us to run something like this at your school? <a href="@Url.Action("Index", "Contact")" class="text-indigo-600 font-semibold hover:underline">Let's talk</a>.
                </p>
            </section>
        }
    </div>
</div>
