@using LakeCountrySpanish.Web.Models.Entities
@model EnrollmentProgram
@{
    var p = Model;
    ViewData["Title"] = p.Name;
    ViewData["MetaDescription"] = string.IsNullOrEmpty(p.TagLine)
        ? $"{p.Name} — after-school Spanish program in {p.LocationName} with Lake Country Spanish."
        : p.TagLine;

    // Hero banner prefers the HeroImagePath (general brand image), falls back
    // to the event image so unset-hero programs still get a visual.
    var bannerImage = !string.IsNullOrEmpty(p.HeroImagePath) ? p.HeroImagePath : p.EventImagePath;
    var heroStyle = string.IsNullOrEmpty(bannerImage)
        ? "background: linear-gradient(135deg, #4361ee 0%, #e85a42 100%);"
        : $"background-image: linear-gradient(135deg, rgba(30,58,95,0.55), rgba(232,90,66,0.45)), url('{bannerImage}'); background-size: cover; background-position: center;";

    // Inline event image only when it's DIFFERENT from what we already showed
    // in the banner — otherwise we'd duplicate the same photo twice on the page.
    var showInlineEventImage = !string.IsNullOrEmpty(p.EventImagePath) && p.EventImagePath != bannerImage;

    int daysLeft = (int)Math.Ceiling((p.EffectiveEnrollmentDeadline - DateTime.UtcNow).TotalDays);
    bool canEnroll = !p.IsEnrollmentClosed && p.IsActive;
}

@functions {
    string DeadlineLabel(EnrollmentProgram p)
    {
        var days = (int)Math.Ceiling((p.EffectiveEnrollmentDeadline - DateTime.UtcNow).TotalDays);
        if (days <= 0) return "Enrollment closed";
        if (days == 1) return "1 day left to enroll";
        if (days <= 14) return $"{days} days left to enroll";
        return $"Enroll by {p.EffectiveEnrollmentDeadline:MMM d, yyyy}";
    }
    string DeadlinePillClass(EnrollmentProgram p)
    {
        var days = (int)Math.Ceiling((p.EffectiveEnrollmentDeadline - DateTime.UtcNow).TotalDays);
        if (days <= 0) return "bg-gray-200 text-gray-700 border-gray-300";
        if (days <= 3) return "bg-red-100 text-red-800 border-red-200";
        if (days <= 7) return "bg-amber-100 text-amber-900 border-amber-300";
        return "bg-emerald-100 text-emerald-800 border-emerald-200";
    }
}

<div class="bg-gray-100 min-h-screen">

    <!-- Hero -->
    <div class="relative py-20 text-white" style="@heroStyle">
        <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
            <a href="@Url.Action("Index", "Programs")" class="inline-flex items-center gap-1 text-sm font-semibold text-white/95 hover:text-white mb-4 drop-shadow">
                ← All programs
            </a>
            <h1 class="font-display text-4xl sm:text-5xl font-bold drop-shadow">@p.Name</h1>
            @if (!string.IsNullOrEmpty(p.TagLine))
            {
                <p class="mt-3 text-xl text-white/95 max-w-3xl">@p.TagLine</p>
            }
            <div class="mt-6 inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-sm font-bold border shadow-sm @DeadlinePillClass(p)">
                ⏱ @DeadlineLabel(p)
            </div>
        </div>
    </div>

    <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <!-- Left column: description + waiver preview -->
            <div class="lg:col-span-2 space-y-6">
                @if (!string.IsNullOrEmpty(p.Description) || showInlineEventImage)
                {
                    <section class="bg-white rounded-2xl shadow-md p-6 md:p-8">
                        @if (showInlineEventImage)
                        {
                            <figure class="mb-6 md:mb-0 md:float-right md:ml-6 md:w-64">
                                <button type="button" class="event-image-trigger group block w-full text-left" data-src="@p.EventImagePath" data-alt="@p.Name" aria-label="Open larger image">
                                    <img src="@p.EventImagePath" alt="@p.Name" class="rounded-xl border border-gray-200 shadow-sm w-full h-auto transition-all duration-200 ease-out group-hover:shadow-xl group-hover:-translate-y-1 group-hover:scale-[1.02] group-hover:brightness-95" loading="lazy" />
                                    <figcaption class="mt-2 text-xs text-gray-500 text-center group-hover:text-gray-700 transition-colors">Click to enlarge</figcaption>
                                </button>
                            </figure>
                        }
                        @if (!string.IsNullOrEmpty(p.Description))
                        {
                            <div class="prose prose-slate max-w-none">
                                @Html.Raw(Markdig.Markdown.ToHtml(p.Description))
                            </div>
                        }
                        <div class="clear-both"></div>
                    </section>
                }

                <!-- Waiver preview (read-only) -->
                @if (!string.IsNullOrEmpty(p.WaiverText))
                {
                    <section class="bg-white rounded-2xl shadow-md border-l-4 border-emerald-500 overflow-hidden">
                        <header class="border-b border-gray-100 px-6 py-4 bg-emerald-50/40">
                            <h2 class="font-display text-lg font-bold text-gray-900 flex items-center gap-2">
                                <span class="text-emerald-600">📄</span> Waiver preview
                            </h2>
                            <p class="text-xs text-gray-600 mt-0.5">You'll be asked to accept this when you enroll.</p>
                        </header>
                        <div class="p-6">
                            <div class="prose prose-sm max-w-none text-gray-700 bg-gray-50 p-4 rounded-lg border border-gray-200 max-h-64 overflow-y-auto">
                                @Html.Raw(Markdig.Markdown.ToHtml(p.WaiverText))
                            </div>
                        </div>
                    </section>
                }
            </div>

            <!-- Right column: sticky enroll card -->
            <div class="lg:col-span-1">
                <div class="lg:sticky lg:top-6 space-y-4">

                    <section class="bg-white rounded-2xl shadow-md border-l-4 border-indigo-500 overflow-hidden">
                        <header class="border-b border-gray-100 px-6 py-4 bg-indigo-50/40">
                            <h2 class="font-display text-lg font-bold text-gray-900 flex items-center gap-2">
                                <span class="text-indigo-600">ⓘ</span> Program details
                            </h2>
                        </header>
                        <dl class="p-6 text-sm text-gray-700 divide-y divide-gray-100">
                            <div class="py-2.5">
                                <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Location</dt>
                                <dd class="mt-1 font-semibold text-gray-900">@p.LocationName</dd>
                                <dd class="text-xs text-gray-600">@p.LocationAddress</dd>
                            </div>
                            <div class="py-2.5">
                                <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Dates</dt>
                                <dd class="mt-1 font-semibold text-gray-900">@p.StartDate.ToString("MMM d") – @p.EndDate.ToString("MMM d, yyyy")</dd>
                            </div>
                            <div class="py-2.5">
                                <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Meets</dt>
                                <dd class="mt-1 font-semibold text-gray-900">@p.MeetingDays</dd>
                                <dd class="text-xs text-gray-600">@p.StartTime.ToString("h:mm tt") – @p.EndTime.ToString("h:mm tt")</dd>
                            </div>
                            @if (!string.IsNullOrEmpty(p.GradeRange) || p.AgeMin > 0)
                            {
                                <div class="py-2.5">
                                    <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Ages / Grades</dt>
                                    <dd class="mt-1 font-semibold text-gray-900">
                                        @(!string.IsNullOrEmpty(p.GradeRange) ? $"Grades {p.GradeRange}" : "")
                                        @(p.AgeMin > 0 ? $"· ages {p.AgeMin}–{p.AgeMax}" : "")
                                    </dd>
                                </div>
                            }
                            <div class="py-2.5">
                                <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Full price</dt>
                                <dd class="mt-1 font-bold text-2xl text-gray-900">$@p.FullPrice.ToString("N2")</dd>
                                @if (p.InstallmentsEnabled)
                                {
                                    <dd class="text-xs text-gray-600 mt-0.5">or @p.InstallmentCount installments of $@p.InstallmentAmount.ToString("N2")</dd>
                                }
                                @if (p.CashOptionEnabled)
                                {
                                    <dd class="text-xs text-gray-600 mt-0.5">cash / check accepted at the booth</dd>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(p.RefundPolicyText))
                            {
                                <div class="py-2.5">
                                    <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Refund policy</dt>
                                    <dd class="mt-1 text-xs text-gray-600 italic">@p.RefundPolicyText</dd>
                                </div>
                            }
                        </dl>
                    </section>

                    <!-- Enroll CTA -->
                    @if (canEnroll)
                    {
                        <a href="@Url.Action("Landing", "Join", new { slug = p.Slug })"
                           class="block w-full text-center px-6 py-4 bg-secondary-500 text-white text-lg font-bold rounded-2xl shadow-lg shadow-secondary-500/30 hover:bg-secondary-600 hover:shadow-secondary-500/40 focus:outline-none focus:ring-4 focus:ring-secondary-500/30 transition-all">
                            Sign up now →
                        </a>
                        <p class="text-xs text-center text-gray-500">Enroll online in a few minutes.</p>
                    }
                    else
                    {
                        <div class="w-full text-center px-6 py-4 bg-gray-200 text-gray-600 text-lg font-bold rounded-2xl">
                            Enrollment closed
                        </div>
                        <a href="@Url.Action("Index", "Contact")" class="block text-center text-sm text-indigo-600 hover:text-indigo-800 font-semibold">
                            Contact us about the next session →
                        </a>
                    }

                    <!-- Contact info -->
                    @if (!string.IsNullOrEmpty(p.ContactPhone) || !string.IsNullOrEmpty(p.ContactEmail))
                    {
                        <div class="text-xs text-center text-gray-500">
                            Questions?
                            @if (!string.IsNullOrEmpty(p.ContactPhone))
                            {
                                <a href="tel:@p.ContactPhone" class="text-indigo-600 font-semibold hover:underline">@p.ContactPhone</a>
                            }
                            @if (!string.IsNullOrEmpty(p.ContactPhone) && !string.IsNullOrEmpty(p.ContactEmail))
                            {
                                <span>·</span>
                            }
                            @if (!string.IsNullOrEmpty(p.ContactEmail))
                            {
                                <a href="mailto:@p.ContactEmail" class="text-indigo-600 font-semibold hover:underline">@p.ContactEmail</a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lightbox modal — vanilla, no dependencies. Opens when any .event-image-trigger
     button is clicked. Close via backdrop click, X button, or Esc. -->
<div id="event-image-lightbox"
     class="fixed inset-0 z-50 hidden items-center justify-center bg-black/85 backdrop-blur-sm p-4"
     role="dialog" aria-modal="true" aria-label="Enlarged program image">
    <button type="button" id="event-image-lightbox-close"
            class="absolute top-4 right-4 h-12 w-12 flex items-center justify-center rounded-full bg-white/10 text-white text-2xl hover:bg-white/20 focus:outline-none focus:ring-4 focus:ring-white/30 transition"
            aria-label="Close">
        ✕
    </button>
    <img id="event-image-lightbox-img" src="" alt=""
         class="max-h-[90vh] max-w-[95vw] rounded-lg shadow-2xl object-contain" />
</div>

<script>
    (function () {
        const lightbox = document.getElementById('event-image-lightbox');
        const lightboxImg = document.getElementById('event-image-lightbox-img');
        const closeBtn = document.getElementById('event-image-lightbox-close');
        const triggers = document.querySelectorAll('.event-image-trigger');
        if (!lightbox || triggers.length === 0) return;

        let lastFocused = null;

        function open(src, alt) {
            lastFocused = document.activeElement;
            lightboxImg.src = src;
            lightboxImg.alt = alt || '';
            lightbox.classList.remove('hidden');
            lightbox.classList.add('flex');
            document.body.style.overflow = 'hidden';
            closeBtn.focus();
        }

        function close() {
            lightbox.classList.add('hidden');
            lightbox.classList.remove('flex');
            lightboxImg.src = '';
            document.body.style.overflow = '';
            if (lastFocused && typeof lastFocused.focus === 'function') {
                lastFocused.focus();
            }
        }

        triggers.forEach(function (t) {
            t.addEventListener('click', function () {
                open(t.dataset.src, t.dataset.alt);
            });
        });

        closeBtn.addEventListener('click', close);

        // Backdrop click (but not clicks on the image itself)
        lightbox.addEventListener('click', function (e) {
            if (e.target === lightbox) close();
        });

        // Esc to close
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) close();
        });
    })();
</script>
