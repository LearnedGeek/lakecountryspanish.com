@model LakeCountrySpanish.Web.Models.ViewModels.CurriculumUploadViewModel
@{
    ViewData["Title"] = "Upload Lesson";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-8">

        <div class="mb-6">
            <a asp-action="Days" class="text-sm text-secondary-600 hover:text-secondary-700">← Days</a>
            <h1 class="text-2xl font-bold text-gray-900 mt-2">Upload Lesson from .docx</h1>
            <p class="mt-1 text-sm text-gray-600">
                Upload a lesson authored in the LCS template (.docx). The parser pulls
                metadata, vocab tiers, songs, materials, and standards; the body sections
                land in a single Raw Markdown block you can split up in the editor.
            </p>
            <p class="mt-3 text-sm">
                Don't have the template?
                <a href="/curriculum/lesson-template.docx" download
                   class="font-medium text-secondary-600 hover:text-secondary-700">Download lesson-template.docx</a>
                · or
                <a href="/curriculum/sample-la-familia.docx" download
                   class="font-medium text-gray-600 hover:text-gray-800">grab the filled-in La Familia sample</a>
            </p>
        </div>

        @if (TempData["ErrorMessage"] is string err)
        {
            <div class="mb-4 p-4 rounded-lg bg-red-50 border border-red-200 text-sm text-red-800">@err</div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mb-4 p-4 rounded-lg bg-red-50 border border-red-200 text-sm text-red-800">@Model.ErrorMessage</div>
        }

        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="bg-white rounded-xl shadow p-6 space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1" for="DocxFile">Lesson .docx</label>
                <input type="file" id="DocxFile" name="DocxFile" accept=".docx"
                       class="block w-full text-sm text-gray-700 border border-gray-300 rounded-lg cursor-pointer file:mr-3 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-medium file:bg-secondary-500 file:text-white hover:file:bg-secondary-600" />
                <span asp-validation-for="DocxFile" class="block mt-1 text-sm text-red-600"></span>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1" for="UnitId">Parent Unit</label>
                <select id="UnitId" name="UnitId"
                        class="block w-full border border-gray-300 rounded-lg px-3 py-2 text-sm">
                    <option value="">— Auto: match by document, or create if new —</option>
                    @foreach (var u in Model.AvailableUnits)
                    {
                        <option value="@u.Id">@u.Title</option>
                    }
                </select>
                <p class="mt-1 text-xs text-gray-500">
                    Leave on auto and we'll match the Unit cell in the document. If no Unit by that name exists yet,
                    we create one under the first LearningPath that fits the grade band. Override here to file
                    this lesson under a specific Unit.
                </p>
            </div>

            <div class="pt-2 flex justify-end gap-3">
                <a asp-action="Days" class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">Cancel</a>
                <button type="submit" class="px-4 py-2 rounded-lg text-sm font-semibold text-white bg-secondary-500 hover:bg-secondary-600 transition">Upload &amp; Parse</button>
            </div>
        </form>

        <details class="mt-6 text-sm text-gray-600">
            <summary class="cursor-pointer font-medium text-gray-700">What the parser expects (template structure)</summary>
            <div class="mt-3 space-y-2 pl-4">
                <p>The .docx must use Word <strong>Heading 1</strong> style for each major section. Required sections + their expected content:</p>
                <ul class="list-disc list-inside space-y-1">
                    <li><strong>Metadata</strong> — 2-column table: <code>Title</code>, <code>Unit</code>, <code>Grade Band</code>, <code>Sessions</code>, <code>Trimester</code>, <code>Theme</code>, <code>Objective</code>, <code>Duration Minutes</code></li>
                    <li><strong>Vocabulary</strong> — 2-column table: <code>Tier</code> (Core / Stretch / Challenge) + <code>Word</code></li>
                    <li><strong>Materials</strong> — bullet list</li>
                    <li><strong>Songs</strong> — 3-column table: <code>Title</code>, <code>Role</code> (Opening / Presentation / Closing / Supplemental), <code>URL</code></li>
                    <li><strong>Standards</strong> (optional) — WI code in column 1 (the rest is reference; we attach by code lookup)</li>
                    <li>Body sections (Apertura / Presentación / Extensión / Actividad / Juegos / Cultura / Cierre) — prose paragraphs</li>
                </ul>
                <p class="text-xs text-gray-500 pt-2">Both Spanish and English heading names are accepted (e.g. <em>Songs</em> or <em>Canciones</em>).</p>
            </div>
        </details>
    </div>
</div>
