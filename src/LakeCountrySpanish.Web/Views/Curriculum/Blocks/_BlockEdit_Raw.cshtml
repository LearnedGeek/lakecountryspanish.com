@using LakeCountrySpanish.Web.Models.ViewModels
@using LakeCountrySpanish.Web.Services.Curriculum.Blocks
@model BlockItemViewModel
@{
    var r = (RawMarkdownBlock)Model.Block;
    var saveUrl = Url.Action("SaveBlock", "Curriculum", new { dayId = Model.DayId, blockId = r.Id });
    var cancelUrl = Url.Action("ViewBlock", "Curriculum", new { dayId = Model.DayId, blockId = r.Id });
    var blockDom = $"block-{r.Id}";
}
<div id="@blockDom" class="bg-yellow-50 border border-yellow-300 rounded-lg p-3">
    <div class="text-xs font-semibold uppercase tracking-wide text-yellow-800 mb-2">Editing — Raw Markdown (advanced)</div>

    <form hx-post="@saveUrl" hx-target="#@blockDom" hx-swap="outerHTML" class="space-y-2">
        <p class="text-xs text-gray-600">
            Use this block when the visual palette doesn't cover what you need —
            e.g. <code>:::bingo-card</code>, <code>:::trace-card</code>, or any
            other LCS container. Most authors won't need this.
        </p>
        <textarea name="markdown" rows="10"
                  class="block w-full rounded border-gray-300 text-sm font-mono"
                  spellcheck="false" autofocus>@r.Markdown</textarea>
        <div class="flex items-center gap-2">
            <button type="submit" class="px-3 py-1 text-sm bg-yellow-600 text-white rounded hover:bg-yellow-700">Save</button>
            <button type="button"
                    hx-get="@cancelUrl"
                    hx-target="#@blockDom"
                    hx-swap="outerHTML"
                    class="px-3 py-1 text-sm bg-white border border-gray-300 rounded hover:bg-gray-50">Cancel</button>
        </div>
    </form>
</div>
