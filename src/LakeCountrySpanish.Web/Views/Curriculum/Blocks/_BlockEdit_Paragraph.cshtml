@using LakeCountrySpanish.Web.Models.ViewModels
@using LakeCountrySpanish.Web.Services.Curriculum.Blocks
@model BlockItemViewModel
@{
    var p = (ParagraphBlock)Model.Block;
    var saveUrl = Url.Action("SaveBlock", "Curriculum", new { dayId = Model.DayId, blockId = p.Id });
    var cancelUrl = Url.Action("ViewBlock", "Curriculum", new { dayId = Model.DayId, blockId = p.Id });
    var blockDom = $"block-{p.Id}";

    // The named lesson-flow sections Karen most commonly reaches for.
    string[] containerOptions = new[] { "", "warmup", "teach", "practice", "assess", "extend",
                                        "cultural-note", "teacher-note", "materials-checklist" };
}
<div id="@blockDom" class="bg-indigo-50 border border-indigo-200 rounded-lg p-3">
    <div class="text-xs font-semibold uppercase tracking-wide text-indigo-700 mb-2">Editing — Prose / lesson-flow section</div>

    <form hx-post="@saveUrl" hx-target="#@blockDom" hx-swap="outerHTML" class="space-y-2">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <div>
                <label class="block text-xs font-medium text-gray-600">Section type</label>
                <select name="containerKind" class="mt-0.5 block w-full rounded border-gray-300 text-sm">
                    @foreach (var opt in containerOptions)
                    {
                        var label = string.IsNullOrEmpty(opt) ? "— Plain prose (no container) —" : char.ToUpperInvariant(opt[0]) + opt[1..];
                        if (string.Equals(p.ContainerKind ?? "", opt, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@opt" selected>@label</option>
                        }
                        else
                        {
                            <option value="@opt">@label</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-600">Time hint (optional)</label>
                <input type="text" name="time" value="@p.Time" placeholder="e.g. 3 min"
                       class="mt-0.5 block w-full rounded border-gray-300 text-sm" />
            </div>
        </div>

        <div>
            <label class="block text-xs font-medium text-gray-600">Content (Markdown allowed for bold/italic/lists/links)</label>
            <textarea name="text" rows="6"
                      class="mt-0.5 block w-full rounded border-gray-300 text-sm font-mono"
                      spellcheck="true"
                      autofocus>@p.Text</textarea>
        </div>

        <div class="flex items-center gap-2">
            <button type="submit" class="px-3 py-1 text-sm bg-indigo-600 text-white rounded hover:bg-indigo-700">Save</button>
            <button type="button"
                    hx-get="@cancelUrl"
                    hx-target="#@blockDom"
                    hx-swap="outerHTML"
                    class="px-3 py-1 text-sm bg-white border border-gray-300 rounded hover:bg-gray-50">Cancel</button>
        </div>
    </form>
</div>
