@using LakeCountrySpanish.Web.Models.ViewModels
@model BlockListViewModel
@{
    var addUrl = Url.Action("AddBlock", "Curriculum", new { dayId = Model.DayId })!;
}
<div id="block-list" class="space-y-2">
    @foreach (var block in Model.Blocks)
    {
        @await Html.PartialAsync("Blocks/_BlockItem",
            new BlockItemViewModel { DayId = Model.DayId, Block = block })
    }
</div>

<div class="mt-3 bg-white border border-dashed border-gray-300 rounded-lg p-2 flex flex-wrap items-center gap-2">
    <span class="text-xs font-semibold text-gray-500 mr-1">+ Add block:</span>
    <button type="button"
            hx-post="@addUrl"
            hx-vals='{ "kind": "paragraph" }'
            hx-target="#block-list"
            hx-swap="beforeend"
            class="px-2 py-1 text-xs bg-gray-100 hover:bg-gray-200 rounded">
        Prose / lesson-flow section
    </button>
    <button type="button"
            hx-post="@addUrl"
            hx-vals='{ "kind": "vocab" }'
            hx-target="#block-list"
            hx-swap="beforeend"
            class="px-2 py-1 text-xs bg-purple-100 hover:bg-purple-200 rounded">
        Vocabulary table
    </button>
    <button type="button"
            hx-post="@addUrl"
            hx-vals='{ "kind": "raw" }'
            hx-target="#block-list"
            hx-swap="beforeend"
            class="px-2 py-1 text-xs bg-yellow-100 hover:bg-yellow-200 rounded">
        Raw Markdown
    </button>
</div>
