@model LakeCountrySpanish.Web.Models.ViewModels.CurriculumDayListViewModel
@{
    ViewData["Title"] = "Curriculum";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

        <div class="flex items-start justify-between mb-6 gap-4 flex-wrap">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Curriculum</h1>
                <p class="text-sm text-gray-600 mt-1">@Model.Days.Count lesson@(Model.Days.Count == 1 ? "" : "s") authored.</p>
            </div>
            <div class="flex gap-2 flex-wrap">
                <a href="@Url.Action("Upload")" class="inline-flex items-center px-4 py-2 bg-secondary-500 text-white rounded-md hover:bg-secondary-600 font-medium text-sm">Upload .docx</a>
                <a href="@Url.Action("CreateDay")" class="inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-gray-700 rounded-md hover:bg-gray-50 text-sm">+ New (manual)</a>
            </div>
        </div>

        <div class="mb-6 p-4 bg-white border border-gray-200 rounded-lg shadow-sm">
            <p class="text-sm font-semibold text-gray-900 mb-1">Authoring a new lesson?</p>
            <p class="text-sm text-gray-600 mb-3">
                Download the LCS lesson template (Word), fill it in, then upload it above.
                The sample is a fully-completed lesson you can open side-by-side as a reference.
            </p>
            <div class="flex gap-2 flex-wrap">
                <a href="/curriculum/lesson-template.docx" download
                   class="inline-flex items-center gap-1 px-3 py-1.5 bg-indigo-50 text-indigo-700 border border-indigo-200 rounded text-sm font-medium hover:bg-indigo-100">
                    📄 Download blank template
                </a>
                <a href="/curriculum/sample-la-familia.docx" download
                   class="inline-flex items-center gap-1 px-3 py-1.5 bg-white text-gray-700 border border-gray-300 rounded text-sm hover:bg-gray-50">
                    📄 Download sample (La Familia)
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] is string ok)
        {
            <div class="mb-4 px-4 py-3 rounded bg-green-50 text-green-800 border border-green-200">@ok</div>
        }
        @if (TempData["ErrorMessage"] is string err)
        {
            <div class="mb-4 px-4 py-3 rounded bg-red-50 text-red-800 border border-red-200">@err</div>
        }

        <form method="get" class="bg-white rounded-lg shadow p-3 mb-4 flex flex-wrap gap-3 items-end">
            <div>
                <label class="block text-xs font-medium text-gray-600">Unit</label>
                <select name="unitId" class="rounded border-gray-300 text-sm">
                    <option value="">— All units —</option>
                    @foreach (var u in Model.AvailableUnits)
                    {
                        if (Model.UnitFilter == u.Id) { <option value="@u.Id" selected>@u.Title</option> }
                        else                          { <option value="@u.Id">@u.Title</option> }
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-600">Grade band</label>
                <select name="gradeBand" class="rounded border-gray-300 text-sm">
                    <option value="">— All grades —</option>
                    @foreach (var g in Enum.GetValues<LakeCountrySpanish.Web.Models.Entities.GradeBand>())
                    {
                        if (Model.GradeBandFilter == g) { <option value="@g" selected>@g</option> }
                        else                            { <option value="@g">@g</option> }
                    }
                </select>
            </div>
            <button type="submit" class="px-3 py-2 bg-gray-700 text-white rounded text-sm">Apply</button>
        </form>

        @if (Model.Days.Count == 0)
        {
            <div class="bg-white rounded-lg shadow p-12 text-center text-gray-500">
                <p class="text-lg mb-2">No lessons yet.</p>
                <p class="text-sm">Download the template above, fill it in, and upload to get started.</p>
            </div>
        }
        else
        {
            <div class="bg-white rounded-lg shadow overflow-hidden">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Unit / Lesson #</th>
                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Title</th>
                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Grade</th>
                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Theme</th>
                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Min</th>
                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Updated</th>
                            <th class="px-4 py-2"></th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-100">
                        @foreach (var d in Model.Days)
                        {
                            <tr>
                                <td class="px-4 py-2 text-sm text-gray-700">@d.UnitTitle · #@d.DayNumberInUnit</td>
                                <td class="px-4 py-2 text-sm font-medium text-gray-900">@d.Title</td>
                                <td class="px-4 py-2 text-sm text-gray-600">@d.GradeBand</td>
                                <td class="px-4 py-2 text-sm text-gray-600">@d.Theme</td>
                                <td class="px-4 py-2 text-sm text-gray-600">@d.EstimatedDurationMinutes</td>
                                <td class="px-4 py-2 text-sm">
                                    <form asp-action="ToggleActive" asp-route-id="@d.Id" method="post" class="inline-flex items-center gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnTo" value="list" />
                                        @if (d.IsActive)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Active</span>
                                            <button type="submit" class="text-xs text-gray-500 hover:text-yellow-700 underline" title="Move back to draft">Deactivate</button>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Draft</span>
                                            <button type="submit" class="text-xs text-gray-500 hover:text-green-700 underline" title="Approve &amp; activate">Activate</button>
                                        }
                                    </form>
                                </td>
                                <td class="px-4 py-2 text-xs text-gray-500">@((d.LastModifiedAt ?? d.CreatedAt).ToString("MMM d, yyyy"))</td>
                                <td class="px-4 py-2 text-sm text-right">
                                    <a href="@Url.Action("ReviewDay", new { id = d.Id })" class="text-indigo-600 hover:text-indigo-800">Review</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
