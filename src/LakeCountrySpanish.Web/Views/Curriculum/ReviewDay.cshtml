@model LakeCountrySpanish.Web.Models.ViewModels.CurriculumDayReviewViewModel
@{
    ViewData["Title"] = $"Review — {Model.Title}";
}
<link rel="stylesheet" href="~/themes/@(Model.ThemeName)/@(Model.ThemeName).css" />

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">

        <div class="flex items-center justify-between mb-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">@Model.Title</h1>
                <p class="text-sm text-gray-600 mt-1">@Model.UnitTitle · @Model.GradeBand · @Model.EstimatedDurationMinutes min · @Model.Theme</p>
            </div>
            <a href="@Url.Action("Days")" class="text-sm text-indigo-600 hover:text-indigo-800">← Back to Days</a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">

            <!-- Rendered lesson -->
            <div class="lg:col-span-9">
                <div class="bg-white rounded-lg shadow p-2">
                    <div class="lcs-document" style="max-width:none; padding:1in 1.25in;">
                        @Html.Raw(Model.RenderedHtml)
                    </div>
                </div>
            </div>

            <!-- Sidebar: status + actions -->
            <div class="lg:col-span-3">
                <div class="bg-white rounded-lg shadow p-4 sticky top-4 space-y-4">
                    <div>
                        <h2 class="text-xs font-semibold uppercase text-gray-500 tracking-wide">Status</h2>
                        @if (Model.IsActive)
                        {
                            <p class="mt-1 inline-flex items-center gap-1 text-sm text-green-700 font-semibold">
                                ✓ Active
                            </p>
                        }
                        else
                        {
                            <p class="mt-1 inline-flex items-center gap-1 text-sm text-yellow-700 font-semibold">
                                ◷ Draft (not yet activated)
                            </p>
                        }
                    </div>

                    @if (Model.WiStandardCodes.Count > 0)
                    {
                        <div>
                            <h2 class="text-xs font-semibold uppercase text-gray-500 tracking-wide">WI standards</h2>
                            <ul class="mt-1 text-xs text-gray-700 space-y-0.5">
                                @foreach (var code in Model.WiStandardCodes)
                                {
                                    <li class="font-mono">@code</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="space-y-2 pt-2 border-t border-gray-100">
                        @if (!Model.IsActive)
                        {
                            <form asp-action="ApproveDay" asp-route-id="@Model.DayId" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="w-full px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 text-sm">Approve &amp; activate</button>
                            </form>
                        }

                        <a href="@Url.Action("EditDay", new { id = Model.DayId })"
                           class="block w-full text-center px-4 py-2 bg-white border border-gray-300 rounded hover:bg-gray-50 text-sm text-gray-700">
                            Edit in power-user mode
                        </a>

                        <a href="@Url.Action("Days")"
                           class="block w-full text-center text-xs text-gray-500 hover:text-gray-700 pt-1">
                            Done — back to list
                        </a>
                    </div>

                    <p class="text-xs text-gray-400 pt-2 border-t border-gray-100">
                        Per-block refinement (click any section to change it with natural language) ships in Phase 3b.
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>
