@using LakeCountrySpanish.Web.Models.ViewModels
@using LakeCountrySpanish.Web.Services.Curriculum.Blocks
@model CurriculumDayFormViewModel
@inject LakeCountrySpanish.Web.Services.Curriculum.Blocks.IBlockCompiler BlockCompiler
@{
    ViewData["Title"] = Model.PageTitle;
    var formAction = Model.IsEdit ? Url.Action("EditDay", new { id = Model.Id }) : Url.Action("CreateDay");

    IReadOnlyList<Block> blocks = Array.Empty<Block>();
    if (Model.IsEdit)
    {
        blocks = BlockCompiler.Deserialize(Model.BodyBlocksJson);
    }

    var unitLabel = Model.AvailableUnits.FirstOrDefault(u => u.Id == Model.UnitId)?.Title ?? "(no unit)";
}
<link rel="stylesheet" href="~/themes/teacher-binder/teacher-binder.css" />

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">

        <div class="flex items-center justify-between mb-4">
            <h1 class="text-2xl font-bold text-gray-900">@Model.PageTitle</h1>
            <a href="@Url.Action("Lessons")" class="text-sm text-indigo-600 hover:text-indigo-800">← Back to Curriculum</a>
        </div>

        @if (Model.IsEdit)
        {
            <!-- Compact metadata summary bar — keeps the block editor above the fold.
                 Click "Edit metadata" to expand the full form below. -->
            <details class="bg-white rounded-lg shadow mb-4 group">
                <summary class="px-4 py-3 cursor-pointer flex flex-wrap items-center gap-3 list-none">
                    <span class="text-base font-semibold text-gray-900">@Model.Title</span>
                    <span class="text-xs px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-700">@unitLabel · Lesson #@Model.DayNumberInUnit</span>
                    <span class="text-xs px-2 py-0.5 rounded-full bg-gray-100 text-gray-700">@Model.GradeBand</span>
                    @if (!string.IsNullOrEmpty(Model.Theme))
                    {
                        <span class="text-xs px-2 py-0.5 rounded-full bg-purple-100 text-purple-700">@Model.Theme</span>
                    }
                    <span class="text-xs px-2 py-0.5 rounded-full bg-yellow-100 text-yellow-700">@Model.EstimatedDurationMinutes min</span>
                    @if (!Model.IsActive)
                    {
                        <span class="text-xs px-2 py-0.5 rounded-full bg-red-100 text-red-700">Inactive</span>
                    }
                    <span class="ml-auto text-xs text-indigo-600 group-open:hidden">Edit metadata ▾</span>
                    <span class="ml-auto text-xs text-indigo-600 hidden group-open:inline">Hide metadata ▴</span>
                </summary>
                <div class="border-t border-gray-100 px-4 py-3">
                    @await Html.PartialAsync("_DayMetadataForm", Model)
                </div>
            </details>
        }
        else
        {
            <!-- Create mode: full metadata form is the only thing on screen.
                 After save we land on edit mode (block editor visible). -->
            <div class="bg-white rounded-lg shadow p-4 mb-4">
                @await Html.PartialAsync("_DayMetadataForm", Model)
            </div>
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-3 text-sm text-blue-800">
                Create the lesson first. After save you'll land on the block editor where you add the lesson content.
            </div>
        }

        @if (Model.IsEdit)
        {
            <!-- Block editor + live preview, side-by-side. Each block action is an
                 HTMX round-trip under /Curriculum/Lessons/{dayId}/Blocks/... -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">

                <div class="lg:col-span-7">
                    <div class="bg-white rounded-lg shadow p-4">
                        <h2 class="text-sm font-semibold text-gray-700 mb-2">Lesson blocks</h2>
                        <p class="text-xs text-gray-500 mb-3">Click <em>+ Add block</em> to insert a section. Edits save inline.</p>

                        @await Html.PartialAsync("Blocks/_BlockList",
                            new BlockListViewModel { DayId = Model.Id, Blocks = blocks })
                    </div>
                </div>

                <div class="lg:col-span-5">
                    <div class="bg-white rounded-lg shadow p-3 sticky top-4">
                        <div class="flex items-center justify-between mb-2">
                            <h2 class="text-sm font-semibold text-gray-700">Preview</h2>
                            <button type="button"
                                    hx-get="@Url.Action("PreviewDayBlocks", new { dayId = Model.Id })"
                                    hx-target="#preview-pane"
                                    hx-swap="innerHTML"
                                    class="text-xs text-indigo-600 hover:text-indigo-800">Refresh</button>
                        </div>
                        <div id="preview-pane"
                             hx-get="@Url.Action("PreviewDayBlocks", new { dayId = Model.Id })"
                             hx-trigger="load, every 5s"
                             hx-swap="innerHTML"
                             class="border border-gray-200 rounded bg-gray-50 max-h-[80vh] overflow-y-auto">
                            <p class="p-3 text-sm text-gray-500">Loading preview…</p>
                        </div>
                    </div>
                </div>

            </div>
        }
    </div>
</div>
