@model LakeCountrySpanish.Web.Models.ViewModels.CurriculumDraftBriefViewModel
@{
    ViewData["Title"] = "Draft a lesson";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-4">
            <h1 class="text-2xl font-bold text-gray-900">Draft a lesson</h1>
            <a href="@Url.Action("Days")" class="text-sm text-indigo-600 hover:text-indigo-800">← Back to Days</a>
        </div>

        <!-- Orientation banner: a non-technical author needs a sentence of context
             before staring at the textarea. -->
        <div class="mb-4 px-4 py-3 rounded-lg bg-indigo-50 border border-indigo-100 text-sm text-indigo-900">
            <p>Describe a lesson in your own words — themes, activities, who it's for. The drafter creates a structured lesson you can review, print, and refine.</p>
            <details class="mt-2">
                <summary class="cursor-pointer text-xs font-medium text-indigo-700 hover:text-indigo-900">Show example briefs</summary>
                <div class="mt-2 space-y-2 text-xs">
                    <div class="p-2 bg-white rounded border border-indigo-100">
                        <em>"25-minute K4-2 lesson on the six basic colors (rojo, azul, amarillo, verde, anaranjado, morado). Colored-card warm-up, vocab table with pronunciation, a 'touch the color' game, Bingo de Colores, a Peru-flag cultural note, thumbs-up exit check."</em>
                    </div>
                    <div class="p-2 bg-white rounded border border-indigo-100">
                        <em>"30-minute lesson for 2nd graders on Amazon rainforest animals — jaguar, mono, rana, tucán, serpiente, perezosa. Want a song or chant, a flashcard matching game, and a brief cultural note about kids in Peruvian Amazon communities."</em>
                    </div>
                    <div class="p-2 bg-white rounded border border-indigo-100">
                        <em>"K5 lesson on greetings: hola, adiós, buenos días, buenas noches. Make it interactive with a partner-greeting practice. Add a cultural moment about how Spanish-speakers greet with two cheek kisses in many countries."</em>
                    </div>
                </div>
            </details>
        </div>

        @if (!Model.DrafterAvailable)
        {
            <div class="mb-4 px-4 py-3 rounded bg-yellow-50 border border-yellow-200 text-yellow-900 text-sm">
                AI drafting is currently unavailable. Please try again later, or contact your admin if this continues.
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mb-4 px-4 py-3 rounded bg-red-50 border border-red-200 text-red-900 text-sm">
                @Model.ErrorMessage
            </div>
        }

        <form method="post" id="draft-form" class="bg-white rounded-lg shadow p-5 space-y-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

            <div>
                <label asp-for="Brief" class="block text-sm font-medium text-gray-700 mb-1">Describe your lesson</label>
                <textarea asp-for="Brief" rows="10"
                          class="block w-full rounded border-gray-300 shadow-sm text-sm leading-relaxed"
                          placeholder="Write in plain English. What's the theme? Who is it for (K4, 2nd grade, 5th grade)? How long? What activities or games do you have in mind? Any cultural moment to include?"></textarea>
                <span asp-validation-for="Brief" class="text-xs text-red-600"></span>
                <p class="mt-1 text-xs text-gray-500">Say what you want; the drafter handles the structure.</p>
            </div>

            <details class="bg-gray-50 rounded border border-gray-200 p-3">
                <summary class="cursor-pointer text-sm font-medium text-gray-700">Optional — guide the drafter</summary>
                <p class="text-xs text-gray-500 mt-2">Leave these alone and the drafter picks for you based on your description.</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3">
                    <div>
                        <label asp-for="UnitId" class="block text-xs font-medium text-gray-600">Pick a Unit</label>
                        <select asp-for="UnitId" class="mt-1 block w-full rounded border-gray-300 text-sm">
                            <option value="">— Let drafter pick —</option>
                            @foreach (var u in Model.AvailableUnits)
                            {
                                if (Model.UnitId == u.Id) { <option value="@u.Id" selected>@u.Title</option> }
                                else                      { <option value="@u.Id">@u.Title</option> }
                            }
                        </select>
                    </div>
                    <div>
                        <label asp-for="GradeBand" class="block text-xs font-medium text-gray-600">Set a grade</label>
                        <select asp-for="GradeBand" class="mt-1 block w-full rounded border-gray-300 text-sm">
                            <option value="">— Let drafter infer —</option>
                            @foreach (var g in Enum.GetValues<LakeCountrySpanish.Web.Models.Entities.GradeBand>())
                            {
                                if (Model.GradeBand == g) { <option value="@g" selected>@g</option> }
                                else                       { <option value="@g">@g</option> }
                            }
                        </select>
                    </div>
                </div>
            </details>

            <div class="flex items-center gap-3 pt-2">
                <button type="submit" id="draft-button" class="px-5 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700 disabled:opacity-60"
                        @(Model.DrafterAvailable ? "" : "disabled")>
                    Draft this
                </button>
                <span id="drafting-indicator" class="hidden text-sm text-gray-600">
                    <span class="inline-block animate-pulse">●</span> Drafting your lesson — this takes 8 to 15 seconds…
                </span>
            </div>
        </form>
    </div>
</div>

<script>
(function () {
    var form = document.getElementById('draft-form');
    var button = document.getElementById('draft-button');
    var indicator = document.getElementById('drafting-indicator');
    if (!form) return;

    form.addEventListener('submit', function () {
        button.disabled = true;
        button.textContent = 'Drafting…';
        indicator.classList.remove('hidden');
    });
})();
</script>
