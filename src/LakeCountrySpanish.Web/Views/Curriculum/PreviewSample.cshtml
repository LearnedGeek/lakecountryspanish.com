@model LakeCountrySpanish.Web.Services.RenderedDocument
@{
    Layout = null;
    var fm = Model.Frontmatter;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(fm.Title ?? "Curriculum preview") — Lake Country Spanish</title>
    <link rel="stylesheet" href="~/themes/@(Model.ThemeName)/@(Model.ThemeName).css" />
</head>
<body>
    <main class="lcs-document">
        <header class="lcs-cover">
            <h1>@fm.Title</h1>
            @if (!string.IsNullOrEmpty(fm.Unit))
            {
                <div class="lcs-subtitle">@fm.Unit</div>
            }
            <div class="lcs-meta">
                @if (!string.IsNullOrEmpty(fm.GradeBand)) { <span>@fm.GradeBand</span> }
                @if (!string.IsNullOrEmpty(fm.Level))     { <span>@fm.Level</span> }
                @if (fm.DurationMin.HasValue)             { <span>@fm.DurationMin min</span> }
                @if (!string.IsNullOrEmpty(fm.Theme))     { <span>@fm.Theme</span> }
            </div>
        </header>

        @Html.Raw(Model.BodyHtml)

        @if (fm.WiStandards.Count > 0)
        {
            <section class="block block-teacher-note" data-wi-standards>
                <strong>WI standards covered:</strong>
                <ul>
                    @foreach (var code in fm.WiStandards)
                    {
                        <li>@code</li>
                    }
                </ul>
            </section>
        }
    </main>
</body>
</html>
