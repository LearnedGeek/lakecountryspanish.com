@model LakeCountrySpanish.Web.Models.ViewModels.LessonPrintViewModel
@{
    ViewData["Title"] = $"{Model.Title} — Lake Country Spanish";
}
<link rel="stylesheet" href="~/themes/teacher-binder/teacher-binder.css" />

<div class="bg-gray-50 py-8">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

        <div class="flex justify-end mb-4 no-print">
            <button onclick="window.print()" class="px-4 py-2 bg-primary-700 text-white text-sm font-medium rounded-md hover:bg-primary-800 shadow-sm">
                Print / Save as PDF
            </button>
        </div>

        <div class="bg-white rounded-lg shadow">
            @await Html.PartialAsync("~/Views/Curriculum/_LessonPrint.cshtml", Model)
        </div>
    </div>
</div>

<style>
    @@media print {
        body { background: white !important; }
        nav, header, footer, .no-print { display: none !important; }
        .bg-gray-50, .bg-white { background: white !important; box-shadow: none !important; }
    }
</style>
