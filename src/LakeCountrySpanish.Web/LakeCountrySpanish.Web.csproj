<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Use out-of-process hosting for SmarterASP.NET IIS compatibility -->
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
    <UserSecretsId>26045aa1-5a1a-4efc-977f-0f5a86628e25</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core pinned to 10.0.0 to match Allevo's known-good setup; floating
         minor patches caused dotnet-ef MissingMethodException due to internal
         AbstractionsStrings API drift between 10.0.0 and 10.0.8. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.116.1" />
    <PackageReference Include="Stripe.net" Version="50.1.0" />
    <PackageReference Include="Markdig" Version="0.38.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <!-- SQL data-migration scripts: copy alongside the assembly so MigrationHelper
       can load them at runtime via Migrations/Scripts/{Name}.{sql|rollback.sql}.
       Mirrors the Allevo pattern. -->
  <ItemGroup>
    <Content Include="Migrations\Scripts\*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Migrations\Scripts\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
