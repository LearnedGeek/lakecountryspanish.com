@model SpanishScheduler.Web.Models.ViewModels.ManageTimeSlotsViewModel
@{
    ViewData["Title"] = "Time Slots";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8 flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Time Slots</h1>
                <p class="mt-2 text-gray-600">Manage your available teaching hours.</p>
            </div>
            <a asp-action="CreateTimeSlot" class="bg-primary-600 hover:bg-primary-700 text-white rounded-lg px-4 py-2 font-medium transition">
                Add Time Slot
            </a>
        </div>

        <div class="bg-white rounded-lg shadow">
            @if (Model.TimeSlots.Any())
            {
                <div class="divide-y divide-gray-200">
                    @foreach (var slot in Model.TimeSlots)
                    {
                        <div class="p-6 flex items-center justify-between">
                            <div>
                                <p class="font-medium text-gray-900">
                                    @if (slot.IsRecurring && slot.DayOfWeek.HasValue)
                                    {
                                        <span>Every @slot.DayOfWeek.Value</span>
                                    }
                                    else if (slot.SpecificDate.HasValue)
                                    {
                                        <span>@slot.SpecificDate.Value.ToString("MMMM d, yyyy")</span>
                                    }
                                </p>
                                <p class="text-sm text-gray-500">
                                    @(DateTime.Today.Add(slot.StartTime).ToString("h:mm tt")) - @(DateTime.Today.Add(slot.EndTime).ToString("h:mm tt"))
                                </p>
                            </div>
                            <div class="flex items-center space-x-4">
                                @if (slot.IsActive)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Active</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">Inactive</span>
                                }
                                <form asp-action="DeleteTimeSlot" method="post">
                                    <input type="hidden" name="id" value="@slot.Id" />
                                    <button type="submit" class="text-red-600 hover:text-red-800 text-sm font-medium"
                                            onclick="return confirm('Are you sure you want to deactivate this time slot?')">
                                        Deactivate
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="p-12 text-center">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <p class="mt-2 text-gray-500">No time slots configured</p>
                    <a asp-action="CreateTimeSlot" class="mt-4 inline-flex items-center text-primary-600 hover:text-primary-700 font-medium">
                        Add your first time slot
                    </a>
                </div>
            }
        </div>
    </div>
</div>
