@model SpanishScheduler.Web.Models.ViewModels.PaymentHistoryViewModel
@{
    ViewData["Title"] = "Payment History";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a asp-action="Dashboard" class="text-primary-600 hover:text-primary-700 flex items-center text-sm mb-4">
                <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
                Back to Dashboard
            </a>
            <h1 class="text-3xl font-bold text-gray-900">Payment History</h1>
        </div>

        <!-- Summary Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
            <div class="bg-white rounded-lg shadow p-6">
                <p class="text-sm text-gray-500">Total Paid</p>
                <p class="text-3xl font-bold text-green-600">$@Model.TotalPaid.ToString("0.00")</p>
            </div>
            <div class="bg-white rounded-lg shadow p-6">
                <p class="text-sm text-gray-500">Outstanding Balance</p>
                <p class="text-3xl font-bold text-@(Model.OutstandingBalance > 0 ? "yellow-600" : "gray-900")">$@Model.OutstandingBalance.ToString("0.00")</p>
                @if (Model.OutstandingBalance > 0)
                {
                    <a asp-controller="Payment" asp-action="Checkout" class="mt-4 inline-block text-primary-600 hover:text-primary-700 text-sm font-medium">
                        Pay Now
                    </a>
                }
            </div>
        </div>

        <!-- Payment History -->
        <div class="bg-white rounded-lg shadow">
            <div class="p-6 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-900">Transaction History</h2>
            </div>
            <div class="divide-y divide-gray-200">
                @if (Model.Payments.Any())
                {
                    @foreach (var payment in Model.Payments)
                    {
                        <div class="p-6 flex items-center justify-between">
                            <div>
                                <p class="font-medium text-gray-900">@payment.Description</p>
                                <p class="text-sm text-gray-500">@payment.CreatedAt.ToString("MMMM d, yyyy 'at' h:mm tt")</p>
                            </div>
                            <div class="text-right">
                                <p class="font-semibold text-gray-900">$@payment.Amount.ToString("0.00")</p>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                    @(payment.Status == SpanishScheduler.Web.Models.Entities.PaymentStatusType.Completed ? "bg-green-100 text-green-800" :
                                      payment.Status == SpanishScheduler.Web.Models.Entities.PaymentStatusType.Pending ? "bg-yellow-100 text-yellow-800" :
                                      payment.Status == SpanishScheduler.Web.Models.Entities.PaymentStatusType.Failed ? "bg-red-100 text-red-800" :
                                      "bg-gray-100 text-gray-800")">
                                    @payment.Status
                                </span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-8 text-center">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
                        </svg>
                        <p class="mt-2 text-gray-500">No payment history yet</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
