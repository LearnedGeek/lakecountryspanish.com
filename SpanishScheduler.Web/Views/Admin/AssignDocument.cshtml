@model SpanishScheduler.Web.Models.ViewModels.AssignDocumentViewModel
@{
    ViewData["Title"] = "Assign Document";
}

<div class="bg-gray-50 min-h-screen">
    <div class="mx-auto max-w-2xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a asp-action="Documents" class="text-primary-600 hover:text-primary-700 flex items-center text-sm mb-4">
                <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
                Back to Documents
            </a>
            <h1 class="text-3xl font-bold text-gray-900">Assign Document</h1>
            <p class="mt-2 text-gray-600">Assigning: @Model.DocumentTitle</p>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <form asp-action="AssignDocument" method="post">
                <input type="hidden" name="documentId" value="@Model.DocumentId" />

                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Select Students</label>
                    <div class="max-h-96 overflow-y-auto border border-gray-200 rounded-md">
                        @foreach (var student in Model.Students)
                        {
                            <label class="flex items-center py-3 px-4 hover:bg-gray-50 border-b border-gray-100 last:border-0">
                                <input type="checkbox" name="studentIds" value="@student.StudentId"
                                       checked="@student.IsAssigned"
                                       class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
                                <span class="ml-3 text-sm text-gray-700">@student.StudentName</span>
                            </label>
                        }
                    </div>
                </div>

                <div class="flex space-x-4">
                    <button type="submit"
                            class="flex-1 flex justify-center rounded-md bg-primary-600 py-3 px-4 text-sm font-semibold text-white hover:bg-primary-700 transition">
                        Save Assignments
                    </button>
                    <a asp-action="Documents"
                       class="flex-1 flex justify-center rounded-md bg-gray-200 py-3 px-4 text-sm font-semibold text-gray-700 hover:bg-gray-300 transition">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
